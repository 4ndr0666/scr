tui_select() {
	_prompt=$1
	shift
	if [ "${OPT_NONINTERACTIVE:-0}" -eq 1 ]; then
		printf '%s\n' "$1"
		return 0
	fi
	if have_cmd fzf && [ -t 0 ] && [ -t 2 ]; then
		_rc=0
		_choice=$(
			for _item in "$@"; do printf '%s\n' "$_item"; done | fzf \
				--ansi --no-multi --height=40% --layout=reverse --border=rounded \
				--prompt="${_prompt} > " \
				--header="=== MKPLAYLIST === (Enter to confirm, Esc for default)" \
				--color="$FZF_COLORS"
		) || _rc=$?
		if [ "$_rc" -eq 0 ] && [ -n "$_choice" ]; then
			printf '%s\n' "$_choice"
			return 0
		elif [ "$_rc" -eq 1 ] || [ "$_rc" -eq 130 ]; then
			printf '%s\n' "$1"
			return 0
		fi
	fi
	if [ -t 0 ] && [ -t 2 ]; then
		bold_msg "=== ${_prompt} ==="
		_idx=1
		for _item in "$@"; do
			printf '%s  [%d] %s%s\n' "$C_THEME" "$_idx" "$_item" "$C_RST" >&2
			_idx=$((_idx + 1))
		done
		printf '%sSelect [1-%d] (default: 1): %s' "$C_BOLD" "$#" "$C_RST" >&2
		IFS= read -r _ans || _ans=""
		case $_ans in ''|*[!0-9]*) _ans=1 ;; esac
		_ans=$(printf '%s' "$_ans" | sed 's/^0*//')
		[ -n "$_ans" ] || _ans=1
		_cur=1
		for _item in "$@"; do
			if [ "$_cur" = "$_ans" ]; then printf '%s\n' "$_item"; return 0; fi
			_cur=$((_cur + 1))
		done
	fi
	printf '%s\n' "$1"
}

tui_input() {
	_label=$1
	_def=$2
	if [ "${OPT_NONINTERACTIVE:-0}" -eq 0 ] && [ -t 0 ] && [ -t 2 ]; then
		printf '%s%s [%s]: %s' "$C_BOLD" "$_label" "$_def" "$C_RST" >&2
		IFS= read -r _val || _val=""
		printf '%s\n' "${_val:-$_def}"
	else
		printf '%s\n' "$_def"
	fi
}

detect_lan_ip() {
	if have_cmd ip; then
		_wg_devs=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 | tr '\n' ' ' || true)
		_bcast_devs=$(ip -o link show up 2>/dev/null | awk -F': ' '/BROADCAST/ && !/POINTOPOINT/ {print $2}' | cut -d'@' -f1 | tr '\n' ' ' || true)
		_lan_dev=$(ip -4 route show table main default 2>/dev/null | awk -v bcast=" $_bcast_devs " -v wg=" $_wg_devs " '
			{
				for (i = 1; i <= NF; i++) {
					if ($i == "dev") {
						d = $(i+1)
						if ($0 !~ /linkdown/ && d != "lo" && d !~ /^(tun|tap|wg|ppp|docker|br-|veth|virbr)/ && index(wg, " " d " ") == 0 && index(bcast, " " d " ") > 0) {
							print d; exit
						}
					}
				}
			}')
		if [ -n "$_lan_dev" ]; then
			_ip=$(ip -o -4 addr show dev "$_lan_dev" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
			if [ -n "$_ip" ]; then printf '%s\n' "$_ip"; return 0; fi
		fi
		_ip=$(ip -o -4 addr show up scope global 2>/dev/null | awk -v bcast=" $_bcast_devs " -v wg=" $_wg_devs " '
			{
				d = $2
				if (d == "lo" || d ~ /^(tun|tap|wg|ppp|docker|br-|veth|virbr)/) next
				if (index(wg, " " d " ") > 0 || index(bcast, " " d " ") == 0) next
				split($4, a, "/")
				if (a[2] != "32") { print a[1]; exit }
			}')
		if [ -n "$_ip" ]; then printf '%s\n' "$_ip"; return 0; fi
	fi
	return 1
}

detect_vpn_ip() {
	if have_cmd ip; then
		for _wg_dev in $(ip -o link show up type wireguard 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 || true); do
			_vip=$(ip -o -4 addr show dev "$_wg_dev" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
			if [ -n "$_vip" ]; then printf '%s\n' "$_vip"; return 0; fi
		done
	fi
	return 1
}

sanitize_bind_ips() {
	_raw_bind=$1
	[ "$_raw_bind" = "all" ] && { printf 'all\n'; return 0; }
	_out_bind=""
	for _tok in $_raw_bind; do
		case $_tok in
			192.1.168.*)
				_fixed="192.168.1.${_tok#192.1.168.}"
				warn_msg "Auto-corrected transposed LAN octet '$_tok' -> '$_fixed'"
				_tok=$_fixed
				;;
		esac
		_out_bind="${_out_bind:+$_out_bind }$_tok"
	done
	printf '%s\n' "$_out_bind"
}

normalize_type() {
	case $1 in
		videos|video|v) printf 'videos\n' ;;
		images|image|i) printf 'images\n' ;;
		both|all|b)     printf 'both\n' ;;
		*) die "Invalid playlist type '$1' (expected: videos, images, or both)" ;;
	esac
}

normalize_sort() {
	case $1 in
		date|time|mtime|d)          printf 'date\n' ;;
		size|bytes|s)               printf 'size\n' ;;
		name|alpha|n)               printf 'name\n' ;;
		shuffle|random|rand|shuf|r) printf 'shuffle\n' ;;
		*) die "Invalid sort field '$1' (expected: date, size, name, or shuffle)" ;;
	esac
}

normalize_order() {
	case $1 in
		desc|descending|r) printf 'desc\n' ;;
		asc|ascending|a)   printf 'asc\n' ;;
		*) die "Invalid sort order '$1' (expected: desc or asc)" ;;
	esac
}

