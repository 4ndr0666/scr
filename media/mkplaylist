#!/bin/sh
# === MKPLAYLIST === (c) 2026 - 4ndr0666
# Usage: mkplaylist <dir>

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

[ -n "$1" ] || die "usage: ${0##*/} <path>"
[ -e "$1" ] || die "${0##*/}: $1: no such file or directory"

[ -d "$1" ] && dir=$1 || dir=$(dirname -- "$1")
cd -- "$dir" || exit 1

out="$PWD/playlist.m3u"

{
	printf '#EXTM3U\n'
	find . -maxdepth 3 -type f \( \
		-iname '*.mp4' -o -iname '*.wmv' -o -iname '*.mkv' -o \
		-iname '*.avi' -o -iname '*.mov' -o -iname '*.mpeg' -o \
		-iname '*.m4v' -o -iname '*.gif' -o -iname '*.webm' -o \
		-iname '*.mp3' -o -iname '*.flac' -o -iname '*.ts' \) \
		| sed 's|^\./||' | sort
} > "$out"

printf '%s\n' "$out"
