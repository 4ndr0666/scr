#!/bin/sh
# n_m3u8dl_orchestrator - POSIX stream extraction wrapper

set -eu

# -----------------------------------------------------------------------------
# Global State & XDG Base Directories
# -----------------------------------------------------------------------------
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/m3u8/m3u8.conf"
CONFIG_DIR="${CONFIG_FILE%/*}"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/logs"
TMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/m3u8dl/$$"
SAVE_DIR="$HOME/streamdir"
SAVE_NAME=""
PROXY_URL=""
TARGET_URL=""
BIN_M3U8=""

THREAD_COUNT=8
RETRY_COUNT=5

# Boolean switches (1 = enabled, 0 = disabled)
AUTO_SELECT=1
SKIP_MERGE=0
DEL_AFTER_DONE=1
USE_FFMPEG_CONCAT=0
LIVE_REAL_TIME_MERGE=1
LIVE_PERFORM_AS_VOD=1

# Presets
PRESET_URL_1="https://example.com"
PRESET_LABEL_1="Example 1"
PRESET_URL_2="https://example.com"
PRESET_LABEL_2="Example 2"

# -----------------------------------------------------------------------------
# Output & Validation Helpers
# -----------------------------------------------------------------------------
if [ -t 1 ]; then
	C_RED='\033[1;31m'
	C_GRN='\033[1;32m'
	C_CYN='\033[38;2;21;255;255m'
	C_YLW='\033[1;33m'
	C_RST='\033[0m'
else
	C_RED='' C_GRN='' C_CYN='' C_YLW='' C_RST=''
fi

info() { printf '%b[Ψ] %s%b\n' "$C_CYN" "$*" "$C_RST"; }
ok() { printf '%b[+] %s%b\n' "$C_GRN" "$*" "$C_RST"; }
warn() { printf '%b[*] %s%b\n' "$C_YLW" "$*" "$C_RST" >&2; }
err() { printf '%b[!] %s%b\n' "$C_RED" "$*" "$C_RST" >&2; }
die() {
	err "$*"
	exit 1
}

is_uint() {
	case ${1:-} in
	'' | *[!0-9]* | 0*) return 1 ;;
	*) return 0 ;;
	esac
}

ensure_dir() {
	mkdir -p -- "$1" 2>/dev/null || {
		err "Cannot create directory: $1"
		return 1
	}
	[ -w "$1" ] || {
		err "Directory not writable: $1"
		return 1
	}
}

cleanup() {
	[ -d "$TMP_DIR" ] && rm -rf -- "$TMP_DIR"
}
trap cleanup EXIT INT TERM

# -----------------------------------------------------------------------------
# Dependency & Configuration Management
# -----------------------------------------------------------------------------
check_deps() {
	for bin in N_m3u8DL-RE n-m3u8dl-re N-m3u8DL-RE n-m3u8dl-re-git N-m3u8dl-RE-git; do
		if command -v "$bin" >/dev/null 2>&1; then
			BIN_M3U8=$bin
			break
		fi
	done

	missing=""
	[ -n "$BIN_M3U8" ] || missing="N_m3u8DL-RE"
	command -v ffmpeg >/dev/null 2>&1 || missing="${missing:+$missing }ffmpeg"

	[ -z "$missing" ] || die "Missing dependencies: $missing"
}

load_config() {
	[ -f "$CONFIG_FILE" ] || return 0
	while IFS='=' read -r key val || [ -n "$key" ]; do
		case $key in
		'' | \#*) continue ;;
		esac
		val=${val#\"}
		val=${val%\"}
		case $key in
		THREAD_COUNT) is_uint "$val" && THREAD_COUNT=$val || warn "Ignored invalid THREAD_COUNT in config" ;;
		RETRY_COUNT) is_uint "$val" && RETRY_COUNT=$val || warn "Ignored invalid RETRY_COUNT in config" ;;
		SAVE_DIR) [ -n "$val" ] && SAVE_DIR=$val ;;
		TMP_DIR) [ -n "$val" ] && TMP_DIR=$val ;;
		PROXY_URL) PROXY_URL=$val ;;
		esac
	done <"$CONFIG_FILE"
}

save_config() {
	ensure_dir "$CONFIG_DIR" || return 1
	cat <<EOF >"$CONFIG_FILE"
# Ψ-4ndr0666 N_m3u8DL-RE Orchestrator Configuration
THREAD_COUNT="$THREAD_COUNT"
RETRY_COUNT="$RETRY_COUNT"
SAVE_DIR="$SAVE_DIR"
TMP_DIR="$TMP_DIR"
PROXY_URL="$PROXY_URL"
EOF
	ok "Configuration locked at $CONFIG_FILE"
}

# -----------------------------------------------------------------------------
# Execution Engine (POSIX Positional Vector)
# -----------------------------------------------------------------------------
extract() {
	[ -n "$TARGET_URL" ] || {
		err "TARGET_URL is empty."
		return 1
	}
	[ -n "$BIN_M3U8" ] || {
		err "BIN_M3U8 is unset."
		return 1
	}

	ensure_dir "$SAVE_DIR" || return 1
	ensure_dir "$TMP_DIR" || return 1
	ensure_dir "$LOG_DIR" || return 1

	set -- "$BIN_M3U8" "$TARGET_URL" \
		--log-file-path "$LOG_DIR/n-m3u8dl-re.log" \
		--thread-count "$THREAD_COUNT" \
		--download-retry-count "$RETRY_COUNT" \
		--tmp-dir "$TMP_DIR" \
		--save-dir "$SAVE_DIR"

	[ "$SKIP_MERGE" = 1 ] && set -- "$@" --skip-merge
	[ "$DEL_AFTER_DONE" = 1 ] && set -- "$@" --del-after-done
	[ "$AUTO_SELECT" = 1 ] && set -- "$@" --auto-select
	[ "$USE_FFMPEG_CONCAT" = 1 ] && set -- "$@" --use-ffmpeg-concat-demuxer
	[ "$LIVE_REAL_TIME_MERGE" = 1 ] && set -- "$@" --live-real-time-merge
	[ "$LIVE_PERFORM_AS_VOD" = 1 ] && set -- "$@" --live-perform-as-vod
	[ -n "$SAVE_NAME" ] && set -- "$@" --save-name "$SAVE_NAME"
	[ -n "$PROXY_URL" ] && set -- "$@" --custom-proxy "$PROXY_URL"

	info "Target: $TARGET_URL (Threads: $THREAD_COUNT | Retries: $RETRY_COUNT)"
	info "Executing: $*"

	if "$@"; then
		ok "Extraction complete: $SAVE_DIR"
	else
		rc=$?
		err "Extraction failed (exit $rc). Check $LOG_DIR/n-m3u8dl-re.log"
		return "$rc"
	fi
}

# -----------------------------------------------------------------------------
# Interactive TUI Fallback
# -----------------------------------------------------------------------------
configure_advanced() {
	while :; do
		printf '\n%b--- Advanced Configuration ---%b\n' "$C_CYN" "$C_RST"
		printf '1. Thread Count (Current: %s)\n' "$THREAD_COUNT"
		printf '2. Retry Count  (Current: %s)\n' "$RETRY_COUNT"
		printf '3. Skip Merge   (Current: %s)\n' "$SKIP_MERGE"
		printf '4. Output Dir   (Current: %s)\n' "$SAVE_DIR"
		printf '5. Return\n> '
		read -r opt || return 0

		case $opt in
		1)
			printf 'Thread Count: '
			read -r val || continue
			if is_uint "$val"; then THREAD_COUNT=$val; else err "Must be a positive integer."; fi
			;;
		2)
			printf 'Retry Count: '
			read -r val || continue
			if is_uint "$val"; then RETRY_COUNT=$val; else err "Must be a positive integer."; fi
			;;
		3)
			SKIP_MERGE=$((1 - SKIP_MERGE))
			ok "Skip Merge set to $SKIP_MERGE"
			;;
		4)
			printf 'Output Directory: '
			read -r val || continue
			if [ -n "$val" ] && ensure_dir "$val"; then SAVE_DIR=$val; fi
			;;
		5) return 0 ;;
		*) warn "Invalid input." ;;
		esac
	done
}

interactive_menu() {
	while :; do
		printf '\n      === //%b M3 %b// ===\n\n' "$C_CYN" "$C_RST"
		printf '1. Preset: %s\n' "$PRESET_LABEL_1"
		printf '2. Preset: %s\n' "$PRESET_LABEL_2"
		printf '3. Enter URL\n4. Settings\n5. Save Settings\nq. Quit\n\nΨ '
		read -r choice || exit 0

		case $choice in
		1)
			TARGET_URL=$PRESET_URL_1
			extract || :
			;;
		2)
			TARGET_URL=$PRESET_URL_2
			extract || :
			;;
		3)
			printf 'M3U8/MPD URL: '
			read -r TARGET_URL || continue
			[ -n "$TARGET_URL" ] && { extract || :; } || warn "URL cannot be empty."
			;;
		4) configure_advanced ;;
		5) save_config ;;
		q | Q)
			info "─── ⊰ 💀 • - ⦑4NDR0666OS⦒ - • 💀 ⊱ ───"
			exit 0
			;;
		*) warn "Invalid directive." ;;
		esac
	done
}

# -----------------------------------------------------------------------------
# CLI Argument Parsing & Boot Sequence
# -----------------------------------------------------------------------------
usage() {
	cat <<EOF
Usage: ${0##*/} [options] [URL]

Options:
  -h, --help            Show this help message
  -t, --threads NUM     Set thread count (Default: $THREAD_COUNT)
  -r, --retries NUM     Set retry count (Default: $RETRY_COUNT)
  -d, --save-dir DIR    Set output directory (Default: $SAVE_DIR)
  -o, --output NAME     Set output filename without extension
  -c, --create-config   Write current settings to $CONFIG_FILE and exit
EOF
}

load_config

while [ $# -gt 0 ]; do
	case $1 in
	-h | --help)
		usage
		exit 0
		;;
	-c | --create-config)
		save_config
		exit 0
		;;
	-t | --threads)
		[ $# -ge 2 ] && is_uint "$2" || die "--threads requires a positive integer"
		THREAD_COUNT=$2
		shift 2
		;;
	-r | --retries)
		[ $# -ge 2 ] && is_uint "$2" || die "--retries requires a positive integer"
		RETRY_COUNT=$2
		shift 2
		;;
	-d | --save-dir)
		[ $# -ge 2 ] && [ -n "$2" ] || die "--save-dir requires a path"
		SAVE_DIR=$2
		shift 2
		;;
	-o | --output)
		[ $# -ge 2 ] && [ -n "$2" ] || die "--output requires a name"
		SAVE_NAME=$2
		shift 2
		;;
	--)
		shift
		break
		;;
	-*)
		die "Unknown option: $1 (see --help)"
		;;
	*)
		TARGET_URL=$1
		shift
		;;
	esac
done

# Remaining positional argument after '--'
[ $# -gt 0 ] && [ -z "$TARGET_URL" ] && TARGET_URL=$1

check_deps

if [ -n "$TARGET_URL" ]; then
	extract
else
	interactive_menu
fi
