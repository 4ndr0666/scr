# POSIX-shell TUI; embedded Python engine for lossless traversal and publication.
set -eu
set -f
umask 077
LC_ALL=C
export LC_ALL
VERSION=3.0.1
PYTHON_BIN=${PYTHON_BIN:-python3}
HEX_FG="#15ffff"
HEX_BG="#000000"
HEX_HL="#00d7ff"
HEX_BG_ALT="#071a1a"

if [ -t 1 ] || [ -t 2 ]; then
	C_THEME=$(printf '\033[38;2;21;255;255m\033[48;2;0;0;0m')
	C_BOLD=$(printf '\033[1m\033[38;2;21;255;255m\033[48;2;0;0;0m')
	C_DIM=$(printf '\033[38;2;15;165;165m\033[48;2;0;0;0m')
	C_ERR=$(printf '\033[1m\033[38;2;255;85;85m\033[48;2;0;0;0m')
	C_RST=$(printf '\033[0m')
else
	C_THEME=""
	C_BOLD=""
	C_DIM=""
	C_ERR=""
	C_RST=""
fi

FZF_COLORS="bg:${HEX_BG},bg+:${HEX_BG_ALT},fg:${HEX_FG},fg+:${HEX_FG},hl:${HEX_HL},hl+:${HEX_FG},info:${HEX_FG},prompt:${HEX_FG},pointer:${HEX_FG},marker:${HEX_FG},spinner:${HEX_FG},header:${HEX_FG},border:${HEX_FG},gutter:${HEX_BG}"

bold_msg() {
	printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RST" >&2
}

die() {
	printf '%s[ERROR] %s%s\n' "$C_ERR" "$*" "$C_RST" >&2
	exit 1
}

have_cmd() {
	command -v "$1" >/dev/null 2>&1
}

show_help() {
    cat <<EOF
${C_BOLD}=== MKPLAYLIST === (c) 2026 - 4ndr0666 | ${VERSION}${C_RST}
${C_THEME}Usage: ${0##*/} [options] <dir_or_file>${C_RST}

Scans all subdirectories by default and creates playlist.m3u. A regular file
argument selects its parent directory. With a terminal, unresolved choices use
fzf (electric cyan on black) or numbered prompts. No arguments displays help.

  -t <type>   videos (video + audio), images, or both (default: both)
  -s <field>  date, size, name, shuffle (default: date)
  -o <order>  desc or asc (default: desc; ignored for shuffle)
  -r          Shuffle every discovered file exactly once per generation
  -d <depth>  Maximum file depth; 0 = unlimited (default), 1 = root files only
  -K          Keep all existing files; reuse matching numbered variants
  -e          Explicitly allow an empty playlist
  -c          Generate a Caddyfile serving this exact playlist and media root
  -a <port>   Caddy listen port (default: :3000; implies -c)
  -b <ips>    Caddy bind IPs, or all (default: loopback without a terminal)
  -v          Require Caddy validation before publishing either output
  -V          Explicitly skip Caddy validation
  -n          No interactive prompts
  -h          Help (--help and --version also supported)

Requires POSIX sh and Python 3.9+ on a POSIX filesystem with hard links/flock.
Commands used: awk cut sed tr. Optional: caddy (validation), fzf (menus), ip (LAN detection).
PYTHON_BIN and CADDY_BIN select the executables. No Caddy daemon is started.

Coverage includes common video/audio containers, AAC, WAV, Opus, M4A, M2TS,
HEIF, APNG and JXL, plus all original extensions. Detection uses extensions;
codec decodability depends on the player. Symlinks are skipped; hard links to
one media inode appear once. Read/stat failures abort publication.

Output uses UTF-8 byte-percent-encoded relative URI paths (./...), preserving
spaces, Unicode, percent signs, tabs and newlines without splitting records.
The playlist location must stay alongside its media tree. Use a URI-aware player.

An unchanged playlist keeps its inode and timestamp. Changed output refreshes
playlist.m3u atomically after preserving the old contents as playlist.N.m3u.
-K retains the original never-overwrite behavior. Caddyfiles always preserve
existing contents and reuse matching variants. Deploy the printed Caddyfile;
configuration files are mode 0600, playlists are 0644. Grant service access as
needed. Concurrent runs serialize on the media directory without a lock file.
With -c, paths the generated Caddyfile hides (*.bak, Caddyfile*, and the always-skipped
.git/.env/.DS_Store) are omitted from the playlist so every entry is servable; without -c
only the always-skipped names are omitted. Caddy's own logs are shown only on failure.
Shuffle intentionally changes ordering; it never samples a subset of files.
${C_DIM}Theme: #15FFFF on #000000${C_RST}
EOF
}
tui_select() {
	_prompt=$1
	shift

	if [ "${OPT_NONINTERACTIVE:-0}" -eq 1 ]; then
		printf '%s\n' "$1"
		return 0
	fi

	if have_cmd fzf && [ -t 0 ] && [ -t 2 ]; then
		_choice=$(
			for _item in "$@"; do
				printf '%s\n' "$_item"
			done | fzf \
				--ansi \
				--no-multi \
				--height=40% \
				--layout=reverse \
				--border=rounded \
				--prompt="${_prompt} > " \
				--header="=== MKPLAYLIST === (Enter to confirm, Esc for default)" \
				--color="$FZF_COLORS" \
				2>/dev/tty || true
		)
		if [ -n "$_choice" ]; then
			printf '%s\n' "$_choice"
			return 0
		fi
	fi

	if [ -t 0 ] && [ -t 2 ]; then
		bold_msg "=== ${_prompt} ==="
		_idx=1
		for _item in "$@"; do
			printf '%s  [%d] %s%s\n' "$C_THEME" "$_idx" "$_item" "$C_RST" >&2
			_idx=$((_idx + 1))
		done
		printf '%sSelect [1-%d] (default: 1): %s' "$C_BOLD" "$#" "$C_RST" >&2
		IFS= read -r _ans </dev/tty || _ans=""
		case $_ans in
			''|*[!0-9]*) _ans=1 ;;
		esac
		_ans=$(printf '%s' "$_ans" | sed 's/^0*//')
		[ -n "$_ans" ] || _ans=1
		_cur=1
		for _item in "$@"; do
			if [ "$_cur" = "$_ans" ]; then
				printf '%s\n' "$_item"
				return 0
			fi
			_cur=$((_cur + 1))
		done
	fi

	printf '%s\n' "$1"
}

# ---------------------------------------------------------------------------
# Prompt Input Helper (with default value)
# Usage: tui_input "Prompt text" "default_value"
# ---------------------------------------------------------------------------
tui_input() {
	_label=$1
	_def=$2
	if [ "${OPT_NONINTERACTIVE:-0}" -eq 0 ] && [ -t 0 ] && [ -t 2 ]; then
		printf '%s%s [%s]: %s' "$C_BOLD" "$_label" "$_def" "$C_RST" >&2
		IFS= read -r _val </dev/tty || _val=""
		if [ -n "$_val" ]; then
			printf '%s\n' "$_val"
		else
			printf '%s\n' "$_def"
		fi
	else
		printf '%s\n' "$_def"
	fi
}

detect_lan_ip() {
	if have_cmd ip; then
		_wg_devs=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 | tr '\n' ' ' || true)

		# 1. Prefer the default-route physical interface in the main table
		_lan_dev=$(ip -4 route show table main default 2>/dev/null | awk -v wg=" $_wg_devs " '
			{
				for (i = 1; i <= NF; i++) {
					if ($i == "dev") {
						d = $(i+1)
						if ($0 !~ /linkdown/ && d != "lo" && d !~ /^(tun|tap|wg|ppp|docker|br-|veth|virbr)/ && index(wg, " " d " ") == 0) {
							print d
							exit
						}
					}
				}
			}')
		if [ -n "$_lan_dev" ]; then
			_ip=$(ip -o -4 addr show dev "$_lan_dev" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
			if [ -n "$_ip" ] && ip -o link show dev "$_lan_dev" 2>/dev/null | awk '/BROADCAST/ && !/POINTOPOINT/ {ok=1} END {exit !ok}'; then
				printf '%s\n' "$_ip"
				return 0
			fi
		fi

		# 2. Fallback: first UP BROADCAST Ethernet/Wi-Fi interface (excludes POINTOPOINT VPN tunnels)
		_bcast_devs=$(ip -o link show up 2>/dev/null | awk -F': ' '/BROADCAST/ && !/POINTOPOINT/ {print $2}' | cut -d'@' -f1 | tr '\n' ' ' || true)
		_ip=$(ip -o -4 addr show up scope global 2>/dev/null | awk -v bcast=" $_bcast_devs " -v wg=" $_wg_devs " '
			{
				d = $2
				if (d == "lo" || d ~ /^(tun|tap|wg|ppp|docker|br-|veth|virbr)/) next
				if (index(wg, " " d " ") > 0) next
				if (index(bcast, " " d " ") == 0) next
				split($4, a, "/")
				if (a[2] != "32") {
					print a[1]
					exit
				}
			}')
		if [ -n "$_ip" ]; then
			printf '%s\n' "$_ip"
			return 0
		fi
	fi

	return 1
}

# Detect active WireGuard / POINTOPOINT VPN IPv4 address (if any) so the user can
# optionally bind LAN + VPN + loopback together when behind a tunnel.
detect_vpn_ip() {
	if have_cmd ip; then
		_wg_dev=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2; exit}' | cut -d'@' -f1 || true)
		if [ -n "$_wg_dev" ]; then
			_vip=$(ip -o -4 addr show dev "$_wg_dev" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
			if [ -n "$_vip" ]; then
				printf '%s\n' "$_vip"
				return 0
			fi
		fi
		_ptp_dev=$(ip -o link show up 2>/dev/null | awk -F': ' '/POINTOPOINT/ {print $2; exit}' | cut -d'@' -f1 || true)
		if [ -n "$_ptp_dev" ]; then
			_vip=$(ip -o -4 addr show dev "$_ptp_dev" scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
			if [ -n "$_vip" ]; then
				printf '%s\n' "$_vip"
				return 0
			fi
		fi
	fi
	return 1
}

# Argument Parsing
if [ "$#" -eq 0 ]; then show_help; exit 0; fi
case ${1:-} in
    --help) show_help; exit 0 ;;
    --version) printf '%s\n' "$VERSION"; exit 0 ;;
esac
OPT_TYPE=""
OPT_SORT=""
OPT_ORDER=""
OPT_DEPTH=0
OPT_CADDY=""
OPT_NONINTERACTIVE=0
OPT_KEEP=no
OPT_EMPTY=no
OPT_PORT=""
OPT_BIND=""
OPT_VALIDATE=auto
while getopts ":t:s:o:rd:cnheKa:b:vV" opt; do
    case $opt in
        t) OPT_TYPE=$OPTARG ;;
        s) OPT_SORT=$OPTARG ;;
        o) OPT_ORDER=$OPTARG ;;
        r) OPT_SORT=shuffle ;;
        d) OPT_DEPTH=$OPTARG ;;
        c) OPT_CADDY=yes ;;
        n) OPT_NONINTERACTIVE=1 ;;
        K) OPT_KEEP=yes ;;
        e) OPT_EMPTY=yes ;;
        a) OPT_PORT=$OPTARG; OPT_CADDY=yes ;;
        b) OPT_BIND=$OPTARG; OPT_CADDY=yes ;;
        v) OPT_VALIDATE=required ;;
        V) OPT_VALIDATE=skip ;;
        h) show_help; exit 0 ;;
        :) die "Option -$OPTARG requires an argument" ;;
        \?) die "Invalid option: -$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 1 ] || die "Expected one directory or regular file; use -h for help"
TARGET_ARG=$1
[ "$OPT_VALIDATE" = auto ] || [ "$OPT_CADDY" = yes ] || die "-v and -V require -c (or -a/-b)"
case $OPT_DEPTH in ''|*[!0-9]*) die "Depth must be a nonnegative integer (0=unlimited)" ;; esac
have_cmd "$PYTHON_BIN" || die "Python 3.9+ is required: $PYTHON_BIN"
"$PYTHON_BIN" -c 'import sys; sys.exit(sys.version_info < (3, 9))' || die "Python 3.9+ is required"
# Interactive TUI vs Defaults Resolution
# ---------------------------------------------------------------------------
IS_INTERACTIVE=0
if [ "$OPT_NONINTERACTIVE" -eq 0 ] && [ -t 0 ] && [ -t 2 ]; then
	IS_INTERACTIVE=1
fi

# 1. Resolve Media Type (videos | images | both)
if [ -z "$OPT_TYPE" ]; then
	if [ "$IS_INTERACTIVE" -eq 1 ]; then
		_sel_type=$(tui_select "Playlist Media Kind" \
			"both   - Videos/Audio + Images" \
			"videos - Videos & Audio only" \
			"images - Images only")
		case $_sel_type in
			videos*) OPT_TYPE="videos" ;;
			images*) OPT_TYPE="images" ;;
			*)       OPT_TYPE="both" ;;
		esac
	else
		OPT_TYPE="both"
	fi
else
	case $OPT_TYPE in
		videos|video|v) OPT_TYPE="videos" ;;
		images|image|i) OPT_TYPE="images" ;;
		both|all|b)     OPT_TYPE="both" ;;
		*) die "Invalid playlist type '$OPT_TYPE' (expected: videos, images, or both)" ;;
	esac
fi

# 2. Resolve Sort Field & Order (default: date desc, plus shuffle/random)
if [ -z "$OPT_SORT" ] && [ -z "$OPT_ORDER" ]; then
	if [ "$IS_INTERACTIVE" -eq 1 ]; then
		_sel_sort=$(tui_select "Sort Order (Default: Date Descending)" \
			"date:desc - Date Descending (newest first) [DEFAULT]" \
			"date:asc  - Date Ascending (oldest first)" \
			"size:desc - Size Descending (largest first)" \
			"size:asc  - Size Ascending (smallest first)" \
			"name:asc  - Name Ascending (A -> Z)" \
			"name:desc - Name Descending (Z -> A)" \
			"shuffle   - Shuffle / Random order")
		case $_sel_sort in
			date:asc*)  OPT_SORT="date"; OPT_ORDER="asc" ;;
			size:desc*) OPT_SORT="size"; OPT_ORDER="desc" ;;
			size:asc*)  OPT_SORT="size"; OPT_ORDER="asc" ;;
			name:asc*)  OPT_SORT="name"; OPT_ORDER="asc" ;;
			name:desc*) OPT_SORT="name"; OPT_ORDER="desc" ;;
			shuffle*)   OPT_SORT="shuffle"; OPT_ORDER="random" ;;
			*)          OPT_SORT="date"; OPT_ORDER="desc" ;;
		esac
	else
		OPT_SORT="date"
		OPT_ORDER="desc"
	fi
else
	[ -n "$OPT_SORT" ] || OPT_SORT="date"
	[ -n "$OPT_ORDER" ] || OPT_ORDER="desc"
	case $OPT_SORT in
		date|time|mtime|d)          OPT_SORT="date" ;;
		size|bytes|s)               OPT_SORT="size" ;;
		name|alpha|n)               OPT_SORT="name" ;;
		shuffle|random|rand|shuf|r) OPT_SORT="shuffle" ;;
		*) die "Invalid sort field '$OPT_SORT' (expected: date, size, name, or shuffle)" ;;
	esac
	if [ "$OPT_SORT" != "shuffle" ]; then
		case $OPT_ORDER in
			desc|descending|r) OPT_ORDER="desc" ;;
			asc|ascending|a)   OPT_ORDER="asc" ;;
			*) die "Invalid sort order '$OPT_ORDER' (expected: desc or asc)" ;;
		esac
	fi
fi

# 3. Resolve Coinciding Caddyfile Option
if [ -z "$OPT_CADDY" ]; then
	if [ "$IS_INTERACTIVE" -eq 1 ]; then
		_sel_caddy=$(tui_select "Generate Coinciding Caddyfile?" \
			"no  - Playlist only" \
			"yes - Configure & output coinciding Caddyfile")
		case $_sel_caddy in
			yes*) OPT_CADDY="yes" ;;
			*)    OPT_CADDY="no" ;;
		esac
	else
		OPT_CADDY="no"
	fi
fi


# Coinciding config serves the generated snapshot, retaining sort and shuffle.
# Root selection belongs to the target argument, so discovery and serving agree.
if [ "$OPT_CADDY" = yes ]; then
    if [ -z "$OPT_PORT" ]; then
        _choice=$(tui_select "Caddy Listen Port" ":3000 (default)" ":8080 (alt HTTP)" ":8000 (media server)" "Custom port...")
        case $_choice in
            :3000*) OPT_PORT=:3000 ;;
            :8080*) OPT_PORT=:8080 ;;
            :8000*) OPT_PORT=:8000 ;;
            *) OPT_PORT=$(tui_input "Enter listen port" ":3000") ;;
        esac
    fi
    if [ -z "$OPT_BIND" ]; then
        OPT_BIND=127.0.0.1
        if [ "$IS_INTERACTIVE" -eq 1 ]; then
            _lan=$(detect_lan_ip || printf '%s\n' 127.0.0.1)
            _vpn=$(detect_vpn_ip || true)
            # Offer only choices that exist on this host: no duplicate loopback entry
            # when no LAN address was found, and a VPN entry only when a tunnel is up.
            if [ "$_lan" = 127.0.0.1 ]; then
                _choice=$(tui_select "Caddy Bind Addresses" "127.0.0.1 (loopback only)" "all (all interfaces)" "0.0.0.0 (all IPv4)" "Custom...")
            elif [ -n "$_vpn" ] && [ "$_vpn" != "$_lan" ]; then
                _choice=$(tui_select "Caddy Bind Addresses" "${_lan} 127.0.0.1 (LAN + loopback)" "${_lan} ${_vpn} 127.0.0.1 (LAN + VPN + loopback)" "all (all interfaces)" "0.0.0.0 (all IPv4)" "127.0.0.1 (loopback only)" "Custom...")
            else
                _choice=$(tui_select "Caddy Bind Addresses" "${_lan} 127.0.0.1 (LAN + loopback)" "all (all interfaces)" "0.0.0.0 (all IPv4)" "127.0.0.1 (loopback only)" "Custom...")
            fi
            case $_choice in
                all*) OPT_BIND=all ;;
                Custom*) OPT_BIND=$(tui_input "Space-separated IP addresses, or all" 127.0.0.1) ;;
                *) OPT_BIND=${_choice%% (*} ;;
            esac
        fi
    fi
fi
exec "$PYTHON_BIN" - "$TARGET_ARG" "$OPT_TYPE" "$OPT_SORT" "$OPT_ORDER" "$OPT_DEPTH" "$OPT_KEEP" "$OPT_EMPTY" "$OPT_CADDY" "$OPT_PORT" "$OPT_BIND" "$OPT_VALIDATE" <<'PYTHON_ENGINE'
import contextlib
