# Globs the generated Caddyfile hides from file_server. With -c, discovery omits the
# same names so every playlist entry is servable; unconditional skips stay as before.
SERVED_HIDDEN = ('.git', '.env', '.DS_Store', '*.bak', '.mkplaylist.*', '.mkcaddy.*', 'Caddyfile', 'Caddyfile.*')

VIDEO = frozenset('mp4 wmv mkv avi mov mpeg mpg mpe m4v webm ts flv ogv 3gp 3g2 m2ts mts m2v vob vro mxf asf divx f4v mp3 flac aac m4a m4b ogg oga opus wav wave aif aiff aifc au snd wma ac3 eac3 dts amr ape alac tak wv caf mka'.split())
IMAGE = frozenset('jpg jpeg jpe png gif webp bmp dib tiff tif svg avif heic heif apng jxl ico'.split())


def log(message):
    print(message, file=sys.stderr)


def discover(root, kind, depth, hidden=()):
    extensions = VIDEO if kind == 'videos' else IMAGE if kind == 'images' else VIDEO | IMAGE
    pending = [(root, 0)]
    records = {}
    omitted = 0
    info = root.stat()
    directories = {(info.st_dev, info.st_ino)}
    while pending:
        folder, level = pending.pop()
        # Errors abort the scan; a partial playlist must never replace a good one.
        with os.scandir(folder) as entries:
            entries = sorted(entries, key=lambda entry: os.fsencode(entry.name))
        children = []
        for entry in entries:
            if entry.name in ('.git', '.env', '.DS_Store') or entry.name.startswith(('.mkplaylist.', '.mkcaddy.')):
                continue
            info = entry.stat(follow_symlinks=False)
            if hidden and any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in hidden):
                if stat.S_ISDIR(info.st_mode) or (stat.S_ISREG(info.st_mode) and '.' in entry.name
                                                  and entry.name.rsplit('.', 1)[-1].lower() in extensions):
                    omitted += 1
                continue
            if stat.S_ISDIR(info.st_mode):
                identity = (info.st_dev, info.st_ino)
                if (depth == 0 or level + 1 < depth) and identity not in directories:
                    directories.add(identity)
                    children.append((Path(entry.path), level + 1))
            elif stat.S_ISREG(info.st_mode) and '.' in entry.name and entry.name.rsplit('.', 1)[-1].lower() in extensions:
                identity = (info.st_dev, info.st_ino)
                relative = os.path.relpath(entry.path, root)
                if identity not in records or os.fsencode(relative) < os.fsencode(records[identity][0]):
                    records[identity] = (relative, info.st_mtime_ns, info.st_size)
        pending.extend(reversed(children))
    return list(records.values()), omitted


def order_records(records, field, direction):
    records.sort(key=lambda row: os.fsencode(row[0]))
    if field == 'shuffle':
        random.SystemRandom().shuffle(records)
    elif field in ('date', 'size'):
        records.sort(key=lambda row: row[1 if field == 'date' else 2], reverse=direction == 'desc')
    elif direction == 'desc':
        records.reverse()
    return records


def regular_bytes(path):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except (FileNotFoundError, IsADirectoryError):
        return None
    except OSError:
        if path.is_symlink():
            return None
        raise
    with os.fdopen(descriptor, 'rb') as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            return None
        return source.read()


def variants(primary):
    base, extension = (primary.stem, primary.suffix) if primary.name.endswith('.m3u') else (primary.name, '')
    pattern = re.compile(re.escape(base) + r'\.([1-9][0-9]*)' + re.escape(extension) + r'\Z')
    occupied = {}
    for entry in primary.parent.iterdir():
        match = pattern.fullmatch(entry.name)
        if match:
            occupied[int(match[1])] = entry
    return base, extension, occupied


def matching_or_free(primary, content, include_primary=True):
    base, extension, occupied = variants(primary)
    if include_primary and regular_bytes(primary) == content:
        return primary
    for number in sorted(occupied):
        if regular_bytes(occupied[number]) == content:
            return occupied[number]
    if include_primary and not os.path.lexists(primary):
        return primary
    number = 1
    while number in occupied:
        number += 1
    return primary.with_name(f'{base}.{number}{extension}')


def stage(directory, content, mode):
    descriptor, name = tempfile.mkstemp(prefix='.mkplaylist.', dir=directory)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            os.fchmod(output.fileno(), mode)
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        return Path(name)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name)
        raise


def publish(primary, content, refresh, mode):
    existing = regular_bytes(primary)
    if existing == content:
        log(f'[IDEMPOTENT] {primary}')
        return primary
    if refresh:
        if os.path.lexists(primary):
            if primary.is_symlink() or not primary.is_file():
                raise ValueError(f'Refusing to replace non-regular output: {primary}')
            if existing is None:
                raise ValueError(f'Cannot preserve existing output: {primary}')
            archive = matching_or_free(primary, existing, include_primary=False)
            if not os.path.lexists(archive):
                os.link(primary, archive, follow_symlinks=False)
                log(f'[BACKUP] {archive}')
        destination = primary
    else:
        destination = matching_or_free(primary, content)
        if regular_bytes(destination) == content:
            log(f'[IDEMPOTENT] {destination}')
            return destination
    temporary = stage(primary.parent, content, mode)
    try:
        if refresh:
            # Preserve operator edits from a non-cooperating writer detected after planning.
            if regular_bytes(primary) != existing:
                raise ValueError(f'Output changed concurrently: {primary}; rerun the command')
            os.replace(temporary, destination)
        else:
            os.link(temporary, destination, follow_symlinks=False)
        log(f'[CREATED] {destination}')
    finally:
        temporary.unlink(missing_ok=True)
    return destination


def caddy_quote(value):
    """Quote one literal Caddyfile argument.

    Caddy's lexer treats backslash literally (only backslash-quote is an escape), and
    its replacer treats an unescaped brace pair as a placeholder, so braces are escaped
    and backslashes are never doubled. A trailing backslash, or a backslash before a
    quote, cannot live in a double-quoted token; those use a raw backtick token.
    """
    if not value or any(ord(char) < 32 or ord(char) == 127 for char in value) or '{$' in value:
        raise ValueError('Caddy arguments must be nonempty single lines without control characters or {$ substitutions')
    escaped = value.replace('{', '\\{')
    if not escaped.endswith('\\') and '\\"' not in escaped:
        return '"' + escaped.replace('"', '\\"') + '"'
    if '`' not in escaped:
        return '`' + escaped + '`'
    raise ValueError('Caddy argument combines a backtick with a trailing backslash or a backslash before a quote; it cannot be quoted')


def caddy_config(root, playlist, port, bind):
    port = port.removeprefix(':')
    if not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
        raise ValueError('Listen port must be an integer from 1 to 65535')
    addresses = [] if bind == 'all' else bind.split()
    if not addresses and bind != 'all':
        raise ValueError('Bind addresses must be IP literals, or all')
    addresses = list(dict.fromkeys(str(ipaddress.ip_address(address)) for address in addresses))
    binding = '\tbind ' + ' '.join(addresses) + '\n' if addresses else ''
    endpoint = '/' + quote_from_bytes(os.fsencode(playlist.name), safe='-._~')
    return (f':{int(port)} {{\n{binding}\troot * {caddy_quote(str(root))}\n'
            f'\thandle {caddy_quote(endpoint)} {{\n'
            '\t\theader Content-Type "audio/x-mpegurl; charset=utf-8"\n'
            '\t\theader Cache-Control "no-cache, no-store, must-revalidate"\n'
            '\t\tfile_server\n\t}\n'
            '\thandle {\n\t\tfile_server {\n'
            '\t\t\thide ' + ' '.join(SERVED_HIDDEN) + '\n'
            '\t\t}\n\t}\n}\n').encode('utf-8')


def validate_caddy(root, content, policy):
    if policy == 'skip':
        log('[UNVALIDATED] Caddy validation explicitly skipped')
        return
    binary = os.environ.get('CADDY_BIN', 'caddy')
    if not shutil.which(binary):
        if policy == 'required':
            raise ValueError(f'Caddy is required for -v validation: {binary}')
        log('[UNVALIDATED] Caddy unavailable; use -v to require validation before publishing')
        return
    with tempfile.TemporaryDirectory(prefix='.mkplaylist.', dir=root) as directory:
        config = Path(directory) / 'Caddyfile'
        config.write_bytes(content)
        config.chmod(0o600)
        try:
            process = subprocess.run([binary, 'adapt', '--config', str(config), '--adapter', 'caddyfile', '--validate'],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=False, timeout=60)
        except subprocess.TimeoutExpired as error:
            raise ValueError('Caddy validation timed out after 60 seconds; no outputs published') from error
        if process.returncode:
            # Caddy's own diagnostics are shown only on failure; success-path logs are noise.
            log(process.stderr.decode('utf-8', 'replace').rstrip())
            raise ValueError('Caddy rejected the configuration; no outputs published')
    log('[VALIDATED] Caddy accepted the configuration')


def main():
    target, kind, field, direction, depth, keep, empty, caddy, port, bind, validation = sys.argv[1:]
    given = Path(target)
    info = given.stat()
    if stat.S_ISDIR(info.st_mode):
        root = given.resolve(strict=True)
    elif stat.S_ISREG(info.st_mode):
        root = given.parent.resolve(strict=True)
    else:
        raise ValueError('Target must be a directory or a regular file')
    # Lock the directory inode: no persistent lock file and no stale-lock recovery.
    descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        found, omitted = discover(root, kind, int(depth), SERVED_HIDDEN if caddy == 'yes' else ())
        if omitted:
            log(f'[HIDDEN] {omitted} path(s) hidden by the generated Caddyfile were omitted from the playlist')
        records = order_records(found, field, direction)
        if not records and empty != 'yes':
            raise ValueError('No matching media found; existing outputs preserved (use -e to allow an empty playlist)')
        lines = ['./' + quote_from_bytes(os.fsencode(row[0]), safe='/-._~') for row in records]
        content = ('#EXTM3U\n' + ''.join(line + '\n' for line in lines)).encode('ascii')
        primary = root / 'playlist.m3u'
        planned = matching_or_free(primary, content) if keep == 'yes' else primary
        config = caddy_config(root, planned, port, bind) if caddy == 'yes' else None
        if config is not None:
            validate_caddy(root, config, validation)
        output = publish(primary, content, refresh=keep != 'yes', mode=0o644)
        outputs = [output]
        if config is not None:
            outputs.append(publish(root / 'Caddyfile', config, refresh=False, mode=0o600))
        os.fsync(descriptor)
        log(f'[MEDIA] {len(records)} unique file(s); {kind}; {field}:{direction}; depth={depth} (0=unlimited)')
        for output in outputs:
            print(output)
    finally:
        os.close(descriptor)


if __name__ == '__main__':
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, lambda number, frame: sys.exit(128 + number))
    try:
        main()
    except (OSError, ValueError, OverflowError) as error:
        log(f'[ERROR] {error}')
        sys.exit(1)
