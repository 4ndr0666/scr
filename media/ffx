display_usage() {
    printf '%b# === FFX v%s ===%b\n\n' "${CYAN}${BOLD}" "${FFX_VERSION}" "${RESET}"
    cat <<'HELPEOF'
Usage: ffx [global options] <command> [arguments]
       ffx                              Interactive fzf menu (requires fzf +
                                         a terminal; falls back to this text
                                         otherwise).

Global Options:
  -A, --advanced             Interactive encoding prompt (persisted to XDG config).
  -v, --verbose              Verbose FFmpeg output + live log.
  --dry-run                  Print FFmpeg commands without executing.
  -b, --bulk                 Process inputs independently, or glob the merge directory.
  -an, --remove-audio        Strip all audio from output.
  -C, --composite            Composite mode for 'merge' (delegates to composite cmd).
  -P, --max-1080             Fit process output within 1920x1080 without upscaling.
  -i, --interpolate          Motion interpolation for process/merge/composite/temporal effects.
  --no-interpolate           Disable interpolation (the common default).
  -o, --output-dir <dir>     Output directory / file path (default: cwd).
  -f, --fps <val>            Force output FPS (decimal or rational, e.g. 30000/1001).
  -p, --pts <val>            PTS slow-motion factor (e.g. 2 = half speed).
  --speed <val>              Playback speed (0.5 = half speed); reciprocal of --pts.
  --layout <default|vertical3> Three-input arrangement; vertical3 uses fixed mode.
  --audio-mode <mix|merge>   Composite audio: stereo mix or separate channels.
  --timeout <sec>            Per-operation FFmpeg timeout for a SINGLE ffmpeg
                             invocation acting on ONE input file — probe/process/
                             filter/slowmo/looperang, and every per-input
                             normalize step inside merge/composite (0 = no
                             limit; default 300). This is the flag to raise if
                             a batch job times out on individual files.
  --audio-rate <Hz>          Audio sample rate merge/composite/looperang normalise to
                             (default 48000; env FFX_AUDIO_RATE).
  --timeout-per-file <sec>   Per-input budget that SCALES the timeout for the
                             small set of operations whose ffmpeg work grows
                             with file COUNT, not per-file duration: merge's
                             fast-path/final concat, composite's final concat,
                             and composite_batch. A 50-file concat gets 50x
                             this value as its ceiling. Does NOT affect
                             per-input normalize steps — those are governed by
                             --timeout alone, regardless of how many files are
                             in the batch.
  --retry <n>                Automatic retries on a transient (non-timeout)
                             ffmpeg failure before giving up (default 1).
  -r, --resume               Resume the latest interrupted merge/composite job
                             (or select via fzf when multiple exist).
  --no-resume                Ignore any existing resume checkpoint for this job
                             and reprocess every input from scratch.
  -T, --tmp-dir <dir>        Directory for ephemeral session scratch files
                             (overrides FFX_TMP_DIR / FFX_SCRATCH_DIR).
  --cache-dir <dir>          Directory for persistent checkpoints & cache
                             (overrides FFX_CACHE_DIR).
  -y, --overwrite            Overwrite explicit output file (-o) instead of
                             appending _1, _2 suffixes.
  --quality <crf|qp0>         Guided quality mode.
  --crf <value>              Guided CRF quality value.
  --bitrate <rate>           Target bitrate for two-pass mode.
  --preset <name>            Encoder speed preset.
  --pixel-format <name>      Output pixel format.
  --multipass                Enable two-pass bitrate mode for process.
  --container <ext>          Output container override (mp4/mkv/mov).
  --resolution <WxH>         Override output resolution (e.g. 1920x1080).
  --codec <encoder>          Override video encoder (e.g. libx265).
  --layout-mode <mode>       Composite layout: fixed (default) or random.
  --version                  Print wrapper version without side effects.
  -h, --help                 This message.

Native mode delegates option/output/device semantics to FFmpeg; it does not reserve
output names or rewrite mappings. --dry-run prints the native argv without execution.
FFX_PROBE_TIMEOUT bounds metadata/capability calls (default 30s).
FFX_THREADS/FFX_FILTER_THREADS optionally bound built-in worker parallelism (0=auto).
FFX_AUTO_INSTALL=true explicitly enables the retained dependency installer.

Commands:
  web        <input> [output]             Guide profile: H.264 High/yuv420p, AAC stereo,
                                         CFR, 1080 short-edge cap, 2s keyframes,
                                         capped bitrate, HDR tone-map, faststart.
  ffmpeg     [--] <native args...>       All FFmpeg features using exact argv (alias: run).
  ffprobe    [--] <native args...>       Native ffprobe output and options.
  capabilities [category]               Inspect installed encoders/decoders/filters/
                                        formats/muxers/demuxers/protocols/devices/
                                        hwaccels/pix_fmts/sample_fmts/layouts/bsfs.
  probe      [<input>] [--full|--json]     Summary or complete stream/format metadata.
  process    <input> [output]             Re-encode/scale; auto-deinterlace; lanczos.
  resume     [--list|--latest|<id>]       Resume an interrupted merge/composite job
                                           without re-typing the original command or
                                           file list.
  merge      [files...] [-o <out>]        Concat. -C composites; -b globs directory.
                                           Resumable via `ffx resume` or by re-running
                                           (segments are cached by content metadata).
  composite  [files...] [-o <base>]       Layout composite (fixed or random mode).
                                           Resumable per-batch, same as merge.
  looperang  <input> [output]             Forward+reverse palindrome.
  slowmo     <input> [output] [factor]    Slow motion. -i enables interpolation.
  filter     <input> [output]             Apply colour/enhancement filter preset.
  fix        <input> [output]             Repair timestamps; --cfr re-encodes;
                                         --reference FILE enables optional untrunc recovery.
  carve      <input> [output]             Extract an H.264/HEVC Annex-B elementary stream.
  clean      <input> [output]             Strip metadata (stream-copy + reencode fallback).
  clean-fast <input> [output]             Strip metadata (stream-copy only).
  clip       <input> [output]             Trim using --start/--end or interactive input.
  clip       <input> <start> <end> [out]   Positional trim times.
  config     [show|save]                  Inspect or atomically save encoder defaults.
  cache-clean [--yes] [--include-legacy]  Remove managed cache; optional old ffxd dirs.
  cleanmeta  <input> [output]             Alias for clean.
  manifest   [save|verify|show]           Self-audit SHA-256 manifest.
  help                                    This message.

Filter Presets (cmd filter --preset NAME):
  enhance      General brightness+contrast+saturation boost.
  skintone     Fix dim video with red-hue skin tones.
  denoise      hqdn3d spatial+temporal denoising.
  cross_process Film cross-processing colour look.
  hdr2sdr      HDR->SDR via Hable tone-mapping (requires libzimg).
  smooth       Frame-blending smoothness (minterpolate).
  whitecal     White balance: reduce warm/red cast.

Composite Layouts:
  fixed mode  (default):
    1 file  -> fullscreen (1920x1080)
    2 files -> lossless hstack via composite_pair_lossless
    3 files -> 1 top + 2 bottom
    4 files -> 2x2 grid
    >4      -> auto-batched
  random mode (--layout-mode random):
    AR fitness engine selects optimal layout from 9 candidates.
    Layouts: fullscreen, hstack, vstack, top1_bot2, top2_bot1,
             left1_right2, left2_right1, grid2x2, row4.

Large Batch Jobs (merge / composite):
  --timeout-per-file only scales the CONCAT steps (whose cost grows with file
  count). If a batch job is timing out during per-file normalization instead
  (every input failing with "FFmpeg timed out after Ns"), raise --timeout —
  that is the single-file budget every normalize call uses regardless of how
  many files are in the batch. If a batch job is interrupted or fails
  partway through, every input successfully processed so far is checkpointed
  under FFX_CACHE_DIR/checkpoints/; re-running the exact same command resumes
  from the first unprocessed input rather than starting over. Pass
  --no-resume to force a clean restart.

  Before any ffmpeg call, merge/composite estimate how much disk the job
  will need (scratch + cache + output combined) and fail immediately if any
  backing filesystem doesn't have the room — instead of burning time
  encoding partway through a batch and then failing on a generic ffmpeg
  write error. See FFX_SKIP_SPACE_CHECK / FFX_SPACE_SAFETY_FACTOR below if
  this misfires on a filesystem `df` can't size correctly.

Directories (all overridable in the environment or in Config, below):
  FFX_SCRATCH_DIR          Base dir for the per-run scratch directory, wiped
                            on every exit (default: $XDG_RUNTIME_DIR, usually
                            /run/user/<uid> or $TMPDIR).
  FFX_CACHE_DIR             Persistent cache: resume checkpoints, self-audit
                            manifests (default: ~/.cache/ffx). Move this
                            (and/or FFX_SCRATCH_DIR) to a different disk with
                            more room, e.g.:
                              export FFX_CACHE_DIR=/bigdisk/ffx-cache
                              export FFX_SCRATCH_DIR=/bigdisk/tmp
                            Avoid pointing FFX_CACHE_DIR at a path literally
                            named/patterned "tmp" — checkpoints must survive
                            for the lifetime of a single long-running job,
                            and a path like that is the conventional target
                            of external tmp-reaping policies (systemd-tmpfiles,
                            tmpwatch, cron). FFX_SCRATCH_DIR is fine there;
                            it's wiped by ffx itself on every exit anyway.
  FFX_SKIP_SPACE_CHECK      Set to "true" to bypass the disk-space preflight
                            entirely (default: false). Use if `df` can't
                            size one of your filesystems correctly (some
                            network mounts).
  FFX_SPACE_SAFETY_FACTOR   Headroom multiplier applied to the raw space
                            estimate before checking it against free space
                            (default: 1.3, i.e. 30% headroom).

Config:  ~/.config/ffx/defaults   (or $XDG_CONFIG_HOME/ffx/defaults)
Paths:   ~/.config/ffx/paths.conf  KEY=VALUE lines (FFX_SCRATCH_DIR, FFX_CACHE_DIR,
         FFX_SKIP_SPACE_CHECK, FFX_SPACE_SAFETY_FACTOR); parsed, never sourced;
         environment variables win.
Output:  MP4-family outputs (mp4/m4v/mov/m4a/3gp/f4v) always have the moov atom
         first (+faststart) and keep audio unless -an is given.
Log:     ~/.local/share/ffx/ffx.log
Cache:   ~/.cache/ffx              (override: FFX_CACHE_DIR)
Checkpoints: <cache dir>/checkpoints/
HELPEOF
    exit 0
}

# =============================================================================
# ARGUMENT PARSING
#
# CHANGED: adds --timeout-per-file, --retry, --no-resume. All three are
# superset additions — every previously-valid invocation parses identically;
# these are new optional flags with safe defaults (set in default_config),
# not replacements for any existing flag.
# =============================================================================
interpolation_filter() {
    local duration
    duration=$(probe_duration "$1") || return 1
    duration=$(awk -v d="$duration" -v f="$2" -v n="${4:-1}" 'BEGIN{printf "%.9f",d*f*n}')
    # minterpolate needs future frames. Extend with clones, then trim to the
    # intended timeline so the final buffered frames and short clips survive EOF.
    printf 'tpad=stop_mode=clone:stop_duration=1,minterpolate=fps=%s:mi_mode=mci:mc_mode=aobmc:vsbmc=1,trim=duration=%s' "$3" "$duration"
}

apply_timing() {
    [[ -n "$PTS_FACTOR" || "$INTERPOLATE" == true ]] || return 0
    local file="$1" count="${2:-1}" stage fps="${SPECIFIC_FPS:-$ADV_FPS}"
    local vf="setpts=${PTS_FACTOR:-1}*(PTS-STARTPTS)"
    [[ "$INTERPOLATE" != true ]] || vf+=",$(interpolation_filter "$file" "${PTS_FACTOR:-1}" "$fps")"
    if [[ "$DRY_RUN" == true ]]; then stage="$file.timing.${file##*.}"; else stage=$(sibling_tmp "$file") || return 1; fi
    local -a audio=(-an)
    if [[ "$REMOVE_AUDIO" != true ]] && has_audio "$file"; then
        audio=(-map 0:a:0 -c:a aac -ar "$FFX_AUDIO_RATE")
        [[ -z "$PTS_FACTOR" ]] || audio+=(-af "$(tempo_filter "$PTS_FACTOR")")
    fi
    run_ffmpeg --ffx-timeout "$(compute_batch_timeout "$count")" --ffx-output "$stage" -y -i "$file" -map 0:v:0 \
        -vf "$vf" -r "$fps" -c:v "$ADV_CODEC" -qp 0 -preset ultrafast "${audio[@]}" "$stage" || return 1
    [[ "$DRY_RUN" == true ]] || mv -f -- "$stage" "$file"
}

tempo_filter() {
    is_positive_number "$1" || return 1
    awk -v f="$1" 'BEGIN{s=1/f; while(s<0.5){printf "atempo=0.5,";s/=0.5} while(s>2){printf "atempo=2,";s/=2} printf "atempo=%.12g",s}'
}

# Public helper contracts retained from beta and ffxd, sharing the engine primitives.
detect_max_res() {
    local f w h mw=0 mh=0
    for f; do
        IFS=' ' read -r w h < <(probe_wh "$f")
        ((w>mw)) && mw=$w
        ((h>mh)) && mh=$h
    done
    printf '%d %d\n' "$mw" "$mh"
}

check_container_first() {
    ffprobe -v error -show_entries format=format_name -of default=nw=1:nk=1 "$1" | awk -F, '{print $1}'
}

log_verbose() { verbose_log "$*"; }
log_error() { warn "$*"; }
show_help() { display_usage; }

build_ffmpeg_options() {
    # NUL-delimited argv preserves spaces in filter expressions. Use mapfile -d ''.
    local -a options=() filters=()
    [[ "${NOAUDIO:-$REMOVE_AUDIO}" != true ]] || options+=(-an)
    [[ "${MAX1080:-$MAX_1080}" != true ]] || filters+=("scale=w='min(1920,iw)':h='min(1080,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2")
    local fps="${FPS:-${SPECIFIC_FPS:-$ADV_FPS}}" pts="${PTS:-$PTS_FACTOR}"
    if [[ -n "$pts" ]]; then
        is_positive_number "$pts" || return 1
        filters+=("setpts=${pts}*(PTS-STARTPTS)")
        [[ "${NOAUDIO:-$REMOVE_AUDIO}" == true ]] || options+=(-af "$(tempo_filter "$pts")" -c:a aac)
    fi
    [[ "$INTERPOLATE" != true ]] || filters+=("minterpolate=fps=${fps}:mi_mode=mci:mc_mode=aobmc:vsbmc=1")
    if ((${#filters[@]})); then local joined; joined=$(IFS=,; printf '%s' "${filters[*]}"); options+=(-vf "$joined"); fi
    options+=(-r "$fps")
    [[ "${VERBOSE:-$VERBOSE_MODE}" != true ]] || options+=(-v info)
    printf '%s\0' "${options[@]}"
}

recover_container() {
    local input="$1" reference="$2"
    [[ -s "$reference" ]] || { warn "Reference is missing or empty: $reference"; return 1; }
    if check_moov_atom "$input"; then printf '%s' "$input"; return 0; fi
    if [[ "$DRY_RUN" == true ]]; then
        printf '[DRY-RUN] untrunc %q %q\n' "$reference" "$input" >&2
        printf '%s' "$input"; return 0
    fi
    command_exists untrunc || { warn "Unreadable container needs the optional untrunc executable and a matching reference"; return 1; }
    local dir target recovered="" file status=0
    dir=$(mktemp -d -p "$FFX_RUN_DIR" recovery.XXXXXXXX) || return 1
    target="$dir/damaged.${input##*.}"
    cp -- "$input" "$target" || return 1
    timeout --kill-after=5 "$FFX_TIMEOUT" untrunc "$(absolute_path "$reference")" "$target" >&2 &
    FFX_WORKER_PID=$!
    wait "$FFX_WORKER_PID" || status=$?
    FFX_WORKER_PID=""
    ((status==0)) || return "$status"
    for file in "${target}_fixed.mp4" "${target%.*}_fixed.mp4" "${target}_fixed.${target##*.}"; do
        if [[ -s "$file" ]] && check_moov_atom "$file"; then recovered="$file"; break; fi
    done
    [[ -n "$recovered" ]] || { warn "untrunc produced no readable repaired container"; return 1; }
    printf '%s' "$recovered"
}

cmd_carve() {
    local input="${1:-}" output="${2:-${GLOBAL_OUTPUT_FILE:-}}" codec bsf
    [[ -s "$input" ]] || die "carve requires a nonempty input"
    codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 "$input") || die "Container cannot be demuxed; use fix --reference for missing moov"
    case "$codec" in h264) bsf=h264_mp4toannexb ;; hevc) bsf=hevc_mp4toannexb ;; *) die "Annex-B carving supports H.264 and HEVC" ;; esac
    if [[ -z "$output" ]]; then
        local ext=h264; [[ "$codec" != hevc ]] || ext=h265
        output=$(get_default_filename "$(basename "${input%.*}")" carved "$ext")
    else output=$(ensure_unique_output "$output"); fi
    run_ffmpeg --ffx-output "$output" -y -i "$input" -map 0:v:0 -an -c:v copy -bsf:v "$bsf" -f "$codec" "$output" || die "Bitstream carving failed" "$output"
    say "Carved: $output"
}

# All formerly entry-specific choices are options in this command's parser.
set_composite_option() {
    case "$1:$2" in
        --layout:default) COMPOSITE_LAYOUT="" ;;
        --layout:vertical3) COMPOSITE_LAYOUT=vertical3; LAYOUT_MODE=fixed ;;
        --audio-mode:mix|--audio-mode:merge) COMPOSITE_AUDIO="$2" ;;
        *) die "Invalid $1 value: $2 (layout: default/vertical3; audio-mode: mix/merge)" ;;
    esac
}

speed_to_pts() {
    [[ "${1:-}" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$ ]] || return 1
    local value
    value=$(awk -v speed="$1" 'BEGIN{if(speed+0<=0)exit 1; printf "%.15f",1/speed}') || return 1
    is_positive_number "$value" || return 1
    printf '%s' "$value"
}

parse_global_options() {
    REMAINING_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -A|-a|--advanced)   ADVANCED_MODE=true;  shift ;;
        -v|--verbose)       VERBOSE_MODE=true;   shift ;;
        --dry-run)          DRY_RUN=true;         shift ;;
        -b|--bulk)          BULK_MODE=true;       shift ;;
        -an|-n|--remove-audio|--noaudio) REMOVE_AUDIO=true; shift ;;
        -C|--composite)     COMPOSITE_MODE=true; shift ;;
        -P|-m|--max-1080|--max1080) MAX_1080=true; shift ;;
        -i|--interpolate)   INTERPOLATE=true;    shift ;;
        --no-interpolate)  INTERPOLATE=false; shift ;;
        -r|--resume)
            RESUME_MODE=true; shift ;;
        --no-resume)
            NO_RESUME_GLOBAL=true; shift ;;
        -y|--overwrite)
            OVERWRITE_OUTPUT=true; shift ;;
        -T|--tmp-dir|--scratch-dir)
            [[ -z "${2:-}" ]] && die "Option '$1' requires a directory path."
            FFX_TMP_DIR="$2"; FFX_SCRATCH_DIR="$2"; shift 2 ;;
        --cache-dir)
            [[ -z "${2:-}" ]] && die "Option '$1' requires a directory path."
            FFX_CACHE_DIR="$2"; shift 2 ;;
        -B|--batch-size)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an integer."
            [[ "$2" =~ ^[0-9]{1,9}$ ]] || die "Batch size must be a bounded non-negative integer"
            BATCH_SIZE="$((10#$2))"; shift 2 ;;
        -o|--output-dir|--output)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            if [[ "$1" == --output-dir || -d "$2" || "$2" == */ ]]; then
                OUTPUT_DIR="${2%/}"; [[ -n "$OUTPUT_DIR" ]] || OUTPUT_DIR="/"
                GLOBAL_OUTPUT_FILE=""
            else
                OUTPUT_DIR="$(dirname -- "$2")"; GLOBAL_OUTPUT_FILE="$2"
            fi
            shift 2 ;;
        -f|--fps)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            is_positive_rate "$2" || die "Frame rate must be positive"; SPECIFIC_FPS="$2"; shift 2 ;;
        --speed)
            [[ $# -ge 2 ]] || die "Missing playback speed"
            PTS_FACTOR=$(speed_to_pts "$2") || die "Playback speed must be finite and positive"; shift 2 ;;
        --layout|--audio-mode)
            [[ $# -ge 2 ]] || die "Missing $1 operand"; set_composite_option "$1" "$2"; shift 2 ;;
        -p|--pts)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            [[ "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--pts requires a numeric value."
            PTS_FACTOR="$2"; shift 2 ;;
        --timeout)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            is_nonneg_int "$2" || die "--timeout requires a non-negative integer."
            FFX_TIMEOUT="$2"; shift 2 ;;
        --timeout-per-file)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            is_nonneg_int "$2" || die "--timeout-per-file requires a non-negative integer."
            FFX_TIMEOUT_PER_FILE="$2"; shift 2 ;;
        --retry)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            is_nonneg_int "$2" || die "--retry requires a non-negative integer."
            FFX_RETRY="$2"; shift 2 ;;
        --audio-rate)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            is_nonneg_int "$2" && (( $2 > 0 )) || die "--audio-rate requires a positive integer (Hz)."
            FFX_AUDIO_RATE="$2"; shift 2 ;;
        --quality|--crf|--bitrate|--preset|--pixel-format)
            [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument"
            case "$1" in
                --quality) ADV_QUALITY_MODE="$2" ;;
                --crf) ADV_CRF="$2" ;;
                --bitrate) ADV_BR="$2" ;;
                --preset) ADV_PRESET="$2" ;;
                --pixel-format) ADV_PIX_FMT="$2" ;;
            esac
            shift 2 ;;
        --multipass) ADV_MULTIPASS=true; shift ;;
        --default-fps)
            [[ $# -ge 2 ]] || die "Missing default frame rate"
            is_positive_rate "$2" || die "Default frame rate must be positive"
            ADV_FPS="$2"; shift 2 ;;
        --container)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            ADV_CONTAINER="$2"; shift 2 ;;
        --resolution)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            [[ "$2" =~ ^[0-9]+x[0-9]+$ ]] || die "--resolution requires WxH format (e.g. 1920x1080)."
            ADV_RES="$2"; EXPLICIT_RES=true; shift 2 ;;
        --codec)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            ADV_CODEC="$2"; shift 2 ;;
        --layout-mode)
            [[ -z "${2:-}" ]] && die "Option '$1' requires an argument."
            case "${2,,}" in
                fixed|random) LAYOUT_MODE="${2,,}"; shift 2 ;;
                *) die "--layout-mode requires 'fixed' or 'random'." ;;
            esac ;;
        --version) printf '%s\n' "$FFX_VERSION"; exit 0 ;;
        -h|--help|help) display_usage ;;
        --) shift; REMAINING_ARGS+=("$@"); break ;;
        -*) die "Unknown option: '$1'. Run 'ffx help'." ;;
        *)  REMAINING_ARGS+=("$@"); break ;;
        esac
    done
}

cmd_web() {
    local input="" output="${GLOBAL_OUTPUT_FILE:-}" fps="${SPECIFIC_FPS:-30}"
    while (($#)); do
        case "$1" in
            -o|--output) [[ $# -ge 2 ]] || die "web requires an output operand"; output="$2"; shift 2 ;;
            -f|--fps) [[ $# -ge 2 ]] || die "web requires an FPS operand"; fps="$2"; shift 2 ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            --) shift; input="${1:-}"; output="${output:-${2:-}}"; break ;;
            -*) die "Unknown web option: $1" ;;
            *) if [[ -z "$input" ]]; then input="$1"; else output="$1"; fi; shift ;;
        esac
    done
    [[ -s "$input" ]] || die "web requires a nonempty input"
    is_positive_rate "$fps" || die "web FPS must be positive"
    [[ -n "$output" ]] && output=$(ensure_unique_output "$output") || output=$(get_default_filename "$(basename "${input%.*}")" web mp4)
    [[ "${output##*.}" == mp4 ]] || die "web output must use .mp4" "$output"
    local scale="scale=w='if(gte(iw,ih),-2,min(1080,trunc(iw/2)*2))':h='if(gte(iw,ih),min(1080,trunc(ih/2)*2),-2)',setsar=1"
    local transfer; transfer=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=nw=1:nk=1 "$input") || die "Cannot probe web source"
    case "$transfer" in
        smpte2084|arib-std-b67) scale="zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable,zscale=t=bt709:m=bt709:r=tv,format=yuv420p,$scale" ;;
    esac
    local cap=6M buf=12M
    if awk -v n="$fps" 'BEGIN{split(n,a,"/"); v=a[2]?a[1]/a[2]:n+0; exit !(v>30)}'; then cap=8M; buf=16M; fi
    local -a audio=(-an)
    if [[ "$REMOVE_AUDIO" != true ]]; then audio=(-map '0:a:0?' -c:a aac -profile:a aac_low -b:a 160k -ar "$FFX_AUDIO_RATE" -ac 2); fi
    run_ffmpeg --ffx-output "$output" -y -i "$input" -map 0:v:0 "${audio[@]}" -vf "$scale" \
        -r "$fps" -fps_mode cfr -c:v libx264 -preset medium -crf 21 -maxrate "$cap" -bufsize "$buf" \
        -pix_fmt yuv420p -profile:v high -force_key_frames 'expr:gte(t,n_forced*2)' \
        -color_trc bt709 -color_primaries bt709 -colorspace bt709 -map_metadata -1 -movflags +faststart "$output" || die "web encode failed" "$output"
    say "Web-ready: $output"
}

cmd_ffmpeg() {
    [[ "${1:-}" != -- ]] || shift
    if [[ "$DRY_RUN" == true ]]; then
        { printf '[DRY-RUN] ffmpeg -nostdin'; printf ' %q' "$@"; printf '\n'; } >&2
        return 0
    fi
    timeout --kill-after=5 "$FFX_TIMEOUT" ffmpeg -nostdin "$@" <&0 &
    FFX_WORKER_PID=$!
    local status=0
    wait "$FFX_WORKER_PID" || status=$?
    FFX_WORKER_PID=""
    return "$status"
}

cmd_ffprobe() {
    [[ "${1:-}" != -- ]] || shift
    if [[ "$DRY_RUN" == true ]]; then
        { printf '[DRY-RUN] ffprobe'; printf ' %q' "$@"; printf '\n'; } >&2
        return 0
    fi
    ffprobe "$@"
}

cmd_capabilities() {
    local category="${1:-encoders}"
    case "$category" in encoders|decoders|filters|formats|muxers|demuxers|protocols|devices|hwaccels|pix_fmts|sample_fmts|layouts|bsfs) ;; *) die "Unknown capability category: $category" ;; esac
    timeout --kill-after=5 "${FFX_PROBE_TIMEOUT:-30}" ffmpeg -hide_banner "-$category"
}

is_positive_rate() {
    if [[ "${1:-}" =~ ^[0-9]{1,9}/[0-9]{1,9}$ ]]; then
        awk -v r="$1" 'BEGIN{split(r,a,"/"); exit !(a[1]+0>0 && a[2]+0>0)}'
    else is_positive_number "${1:-}"; fi
}

is_positive_number() { [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v n="$1" 'BEGIN{exit !(n+0>0)}'; }

validate_settings() {
    local key
    : "${FFX_PROBE_TIMEOUT:=30}" "${FFX_THREADS:=0}" "${FFX_FILTER_THREADS:=0}"
    for key in FFX_TIMEOUT FFX_TIMEOUT_PER_FILE FFX_RETRY FFX_AUDIO_RATE BATCH_SIZE FFX_PROBE_TIMEOUT FFX_THREADS FFX_FILTER_THREADS; do
        [[ "${!key}" =~ ^[0-9]{1,9}$ ]] || die "$key requires a bounded non-negative integer"
        printf -v "$key" '%d' "$((10#${!key}))"
    done
    (( FFX_AUDIO_RATE > 0 )) || die "Audio sample rate must be positive"
    is_positive_rate "$ADV_FPS" || die "Frame rate must be positive"
    [[ -z "$SPECIFIC_FPS" ]] || is_positive_rate "$SPECIFIC_FPS" || die "Frame rate must be positive"
    [[ -z "$PTS_FACTOR" ]] || is_positive_number "$PTS_FACTOR" || die "PTS factor must be positive"
    [[ "$ADV_RES" =~ ^([0-9]{1,5})x([0-9]{1,5})$ ]] || die "Resolution must be WxH"
    local w=$((10#${BASH_REMATCH[1]})) h=$((10#${BASH_REMATCH[2]}))
    ((w>0 && h>0 && w%2==0 && h%2==0)) || die "Resolution must have positive even dimensions"
    ADV_RES="${w}x${h}"
    [[ "$ADV_CRF" =~ ^[0-9]{1,2}$ ]] && ((10#$ADV_CRF<=63)) || die "Invalid CRF"
    [[ "$ADV_BR" =~ ^[0-9]+([.][0-9]+)?[kKmMgG]?$ ]] || die "Invalid target bitrate"
    case "$(codec_family "$ADV_CODEC")" in h264|hevc) ((10#$ADV_CRF<=51)) || die "CRF must be 0-51 for H.264/HEVC" ;; esac
    case "$ADV_QUALITY_MODE" in crf|qp0) ;; *) die "Quality mode must be crf or qp0" ;; esac
    case "$LAYOUT_MODE" in fixed|random) ;; *) die "Layout mode must be fixed or random" ;; esac
    [[ "$COMPOSITE_LAYOUT" != vertical3 || "$LAYOUT_MODE" == fixed ]] || die "vertical3 requires fixed layout mode"
    case "$ADV_MULTIPASS" in true|false) ;; *) die "Multipass must be true or false" ;; esac
    [[ "$ADV_CONTAINER" =~ ^[a-zA-Z0-9]+$ ]] || die "Invalid container extension"
}

# =============================================================================
# DISPATCH & MAIN
#
# CHANGED: if --no-resume was given as a GLOBAL option (before the command),
# forward it into REMAINING_ARGS as a command-level flag too, so `ffx
# --no-resume merge ...` and `ffx merge --no-resume ...` behave identically —
# cmd_merge/cmd_composite only look for it in their own argv. This keeps the
# new flag's parsing local to the commands that use it (no global state they
# need to reach across), while still accepting it in the conventional
# "global option before the subcommand" position users expect.
# =============================================================================
NO_RESUME_GLOBAL=false

main_dispatch() {
    local cmd="${1:-help}"; shift || true
    if [[ "$NO_RESUME_GLOBAL" == true ]]; then
        case "$cmd" in
            merge|composite) set -- "$@" "--no-resume" ;;
        esac
    fi
    if [[ "${RESUME_MODE:-false}" == true ]]; then
        case "$cmd" in
            merge|composite) set -- "$@" "--resume" ;;
        esac
    fi
    case "$cmd" in
        resume)      cmd_resume "$@" ;;
        web)         cmd_web    "$@" ;;
        carve)       cmd_carve  "$@" ;;
        ffmpeg|run)  cmd_ffmpeg "$@" ;;
        ffprobe)     cmd_ffprobe "$@" ;;
        capabilities) cmd_capabilities "$@" ;;
        probe)       cmd_probe       "$@" ;;
        process)
            if [[ "$COMPOSITE_MODE" == true ]]; then cmd_composite "$@"
            else cmd_process "$@"; fi ;;
        merge)       cmd_merge       "$@" ;;
        composite)   cmd_composite   "$@" ;;
        looperang)   cmd_looperang   "$@" ;;
        slowmo)      cmd_slowmo      "$@" ;;
        filter)      cmd_filter      "$@" ;;
        fix)         cmd_fix         "$@" ;;
        clean)       cmd_cleanmeta   "$@" ;;
        clean-fast)  cmd_clean       "$@" ;;
        cleanmeta)   cmd_cleanmeta   "$@" ;;
        config)      cmd_config      "$@" ;;
        manifest)    cmd_manifest    "$@" ;;
        clip)        cmd_clip        "$@" ;;
        cache-clean) cmd_cache_clean "$@" ;;
        help)        display_usage        ;;
        *)           die "Unrecognized command: '$cmd'. Run 'ffx help'." ;;
    esac
}

main() {
    load_defaults
    parse_global_options "$@"
    validate_settings
    if (( ${#REMAINING_ARGS[@]} == 0 )) && [[ "${RESUME_MODE:-false}" == true ]]; then
        REMAINING_ARGS=(resume)
    fi
    if (( ${#REMAINING_ARGS[@]} == 0 )); then
        if ! tui_available; then display_usage; fi
    fi
    # Configuration inspection/save is independent of media providers and sessions.
    if [[ "${REMAINING_ARGS[0]:-}" == config ]]; then
        cmd_config "${REMAINING_ARGS[@]:1}"
        return
    fi
    init_session
    check_deps
    if [[ "$DRY_RUN" != true ]]; then
        mkdir -p -- "$OUTPUT_DIR" || die "Cannot create output directory: $OUTPUT_DIR"
    fi
    if (( ${#REMAINING_ARGS[@]} < 1 )); then
        run_tui
        return
    fi
    main_dispatch "${REMAINING_ARGS[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi