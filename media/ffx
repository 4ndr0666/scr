# =============================================================================
# BATCH TIMEOUT SCALING (NEW unit — extracted to make the fix testable and
# reusable across cmd_merge / cmd_composite rather than inlining the arithmetic
# at every call site)
# =============================================================================
# compute_batch_timeout <file_count>
# Returns a timeout ceiling for an operation whose cost scales with file_count
# (concat assembly, multi-file composite passes). Uses FFX_TIMEOUT_PER_FILE as
# the per-unit budget, with FFX_TIMEOUT itself as a floor so a 1-2 file batch
# never gets LESS time than a normal single-file operation would.
# This is what makes "many files -> timeout kills everything" structurally
# impossible to regress to: the budget is derived from input size, not a
# constant guessed for the common case.
compute_batch_timeout() {
    local count="${1:-1}"
    if (( FFX_TIMEOUT == 0 || FFX_TIMEOUT_PER_FILE == 0 )); then printf '0'; return 0; fi
    (( count < 1 )) && count=1
    local scaled=$(( count * FFX_TIMEOUT_PER_FILE ))
    if (( scaled < FFX_TIMEOUT )); then
        printf '%d' "$FFX_TIMEOUT"
    else
        printf '%d' "$scaled"
    fi
}

# =============================================================================
# FFMPEG RUNNER
# CONTRACT: returns 0 on success, 1 on failure.
# Every call site MUST check return value and call die() or handle explicitly.
#
# run_ffmpeg(): CHANGED unit (Golden-Unit §3 — superset of prior contract).
#
# OLD DIGEST (v8.1.0-v8.2.0): Runs ffmpeg under either FFX_TIMEOUT or an
# --ffx-timeout override, with retry and --ffx-output cleanup. On timeout
# (exit 124), the warning text was IDENTICAL regardless of whether the call
# had an --ffx-timeout override: "Use --timeout/--timeout-per-file to
# extend." For calls with no override (every per-input normalize call in
# cmd_merge/cmd_process/cmd_filter/etc — the majority of call sites in this
# script), FFX_TIMEOUT_PER_FILE has no effect whatsoever: it is never read
# outside compute_batch_timeout(), and compute_batch_timeout() is only ever
# called at the small number of concat/batch call sites that explicitly pass
# --ffx-timeout. So the message told users a flag would help when it
# structurally could not — verified live with a stubbed slow ffmpeg: setting
# FFX_TIMEOUT_PER_FILE=999 had zero effect on a no-override call, which still
# timed out at the plain FFX_TIMEOUT ceiling.
#
# NEW DIGEST: Identical timeout/retry/cleanup behavior — no functional
# change to when or how a call times out. Only the diagnostic text changes:
# it now branches on whether this specific call received an --ffx-timeout
# override (i.e. is provably one of the compute_batch_timeout call sites) and
# names only the flag that actually governs THIS call — --timeout for
# per-input operations, --timeout-per-file (with --timeout as its floor) for
# batch/concat operations.
#
# Architectural Gate 4.2 (hard timeout on every external execution): PASS —
#   unchanged; timeout is still sized to the operation.
# Architectural Gate 4.6 (EAFP over defensive LBYL): PASS — unchanged.
# =============================================================================
run_ffmpeg() {
    local override_timeout="" output_path=""
    while [[ "${1:-}" == --ffx-* ]]; do
        [[ $# -ge 2 ]] || { warn "Missing runner option operand: $1"; return 1; }
        case "$1" in
            --ffx-timeout) override_timeout="$2"; shift 2 ;;
            --ffx-output) output_path="$2"; shift 2 ;;
            *) warn "Unknown runner option: $1"; return 1 ;;
        esac
    done
    local effective_timeout="${override_timeout:-$FFX_TIMEOUT}"
    debug_log "ffmpeg $(printf '%q ' "$@")"
    local ec=0 attempt=0 max_attempts=$((FFX_RETRY+1)) stage="" log
    local -a args=("$@") base=(ffmpeg -nostdin -hide_banner) status=()
    local encoded_with_x265=false qp_zero=false arg_index
    for ((arg_index=0; arg_index+1<${#args[@]}; arg_index++)); do
        [[ "${args[$arg_index]}" != -c:v || "${args[$((arg_index+1))]}" != libx265 ]] || encoded_with_x265=true
        [[ "${args[$arg_index]}" != -qp || "${args[$((arg_index+1))]}" != 0 ]] || qp_zero=true
    done
    if [[ "$encoded_with_x265" == true ]]; then
        local x265_params=""
        [[ "$qp_zero" != true ]] || x265_params="lossless=1"
        if [[ "${FFX_THREADS:-0}" != 0 ]]; then
            x265_params+="${x265_params:+:}pools=$FFX_THREADS:frame-threads=$FFX_THREADS"
        fi
        [[ -z "$x265_params" ]] || args=("${args[@]:0:${#args[@]}-1}" -x265-params "$x265_params" "${args[-1]}")
    fi
    if [[ "$DRY_RUN" == true ]]; then
        { printf '[DRY-RUN] ffmpeg -nostdin'; printf ' %q' "${args[@]}"; printf '\n'; } >&2
        return 0
    fi
    [[ "$VERBOSE_MODE" == true ]] && base+=(-v info) || base+=(-v error)
    if [[ "${FFX_FILTER_THREADS:-0}" != 0 ]]; then
        base+=(-filter_threads "$FFX_FILTER_THREADS" -filter_complex_threads "$FFX_FILTER_THREADS")
    fi
    if [[ -n "$output_path" ]]; then
        [[ "${args[-1]}" == "$output_path" ]] || { warn "Runner output must be the final argument"; return 1; }
        stage=$(sibling_tmp "$output_path") || return 1
        args[-1]="$stage"
        local -a fs=(); mapfile -t fs < <(faststart_flags_for "$output_path")
        args=("${args[@]:0:${#args[@]}-1}" "${fs[@]}" "$stage")
        if [[ "${FFX_THREADS:-0}" != 0 ]]; then
            args=("${args[@]:0:${#args[@]}-1}" -threads "$FFX_THREADS" "$stage")
        fi
    fi
    log=$(mktemp_ffx .ffmpeg.log) || return 1
    while ((attempt < max_attempts)); do
        attempt=$((attempt+1))
        timeout --kill-after=5 "$effective_timeout" "${base[@]}" "${args[@]}" >"$log" 2>&1 &
        FFX_WORKER_PID=$!
        if [[ "$VERBOSE_MODE" == true ]]; then
            tail -n +1 -f -s 0.1 --pid="$FFX_WORKER_PID" "$log" >&2 &
            FFX_LOG_PID=$!
        fi
        if wait "$FFX_WORKER_PID"; then ec=0; else ec=$?; fi
        FFX_WORKER_PID=""
        if [[ -n "${FFX_LOG_PID:-}" ]]; then
            wait "$FFX_LOG_PID" || { warn "Live logging failed"; ec=1; }
            FFX_LOG_PID=""
        fi
        cat -- "$log" >> "$LOG_FILE" || { warn "Cannot append FFmpeg log: $LOG_FILE"; return 1; }
        if ((ec==0)) && [[ -n "$stage" ]]; then
            if [[ -s "$stage" ]] && check_moov_atom "$stage" && mv -f -- "$stage" "$output_path"; then
                return 0
            fi
            ec=1
            warn "FFmpeg returned success without a readable complete artifact: $output_path"
        elif ((ec==0)); then
            return 0
        fi
        [[ -z "$stage" ]] || rm -f -- "$stage" 2>/dev/null || true
        if ((ec==124 || ec==137)); then
            if [[ -n "$override_timeout" ]]; then
                warn "FFmpeg timed out after ${effective_timeout}s (scaled via --timeout-per-file; --timeout is its floor)."
            else
                warn "FFmpeg timed out after ${effective_timeout}s; raise --timeout (per input operation)."
            fi
            break
        fi
        ((attempt>=max_attempts)) || verbose_log "FFmpeg failed ($ec); retrying ${attempt}/${max_attempts}."
    done
    [[ -z "$stage" ]] || rm -f -- "$stage" 2>/dev/null || true
    tail -n 20 "$log" >&2 || true
    rm -f -- "$log" 2>/dev/null || true
    warn "FFmpeg failed (exit $ec), log: $LOG_FILE"
    return 1
}

# =============================================================================
# DISK-SPACE PREFLIGHT (NEW unit — orchestrator class)
#
# THE FLAW this closes: free space on FFX_RUN_DIR / FFX_CACHE_DIR / the
# output directory was never checked anywhere. The first symptom of running
# out was always a generic ffmpeg write error, discovered only after
# run_ffmpeg had already burned real wall-clock time encoding however many
# files DID fit — and run_ffmpeg's retry loop would retry the failing write
# up to FFX_RETRY times, since nothing distinguished "transient failure" from
# "this filesystem is full and retrying changes nothing." That is exactly
# the kind of wasted time this script exists to prevent elsewhere (timeouts,
# checkpointed resume); a space check closes the same hole for disk.
#
# THE FIX: one pass, before any ffmpeg invocation for a given job, that (1)
# sums the input files' sizes, (2) applies a conservative per-operation
# multiplier for how many copies of that data this specific operation will
# write, and (3) resolves every directory actually written to onto its
# backing filesystem and fails closed — via die(), before a single frame is
# encoded — if that filesystem doesn't have the estimated room.
#
# FFX_RUN_DIR, FFX_CACHE_DIR and a job's output directory routinely resolve
# to the SAME filesystem (same disk, or the operator pointed more than one
# at the same override). Requirements are accumulated per resolved
# mountpoint, not per path, so a shared disk is checked against the SUM of
# what all three need on it, not each in isolation as if it had the whole
# disk to itself — checking them independently would under-detect a shared
# disk running out.
#
# This is a deliberate, bounded exception to Gate 4.6 (EAFP over LBYL): a
# multi-minute-to-multi-hour batch encode is expensive enough to redo that
# failing fast on an answerable precondition is worth more here than it
# costs elsewhere (a single file write, where EAFP is strictly better). It
# is one check, run once per job, not a recursive/per-file existence scan.
# =============================================================================
FFX_SPACE_SAFETY_FACTOR="${FFX_SPACE_SAFETY_FACTOR:-1.3}"  # 30% headroom over the raw estimate
FFX_SKIP_SPACE_CHECK="${FFX_SKIP_SPACE_CHECK:-false}"       # escape hatch for filesystems df can't size (e.g. some network mounts)

human_size() {
    if command_exists numfmt; then
        numfmt --to=iec --suffix=B -- "$1" 2>/dev/null || printf '%sB' "$1"
    else
        printf '%sB' "$1"
    fi
}

# fs_mountpoint(): resolves PATH to its backing filesystem's mount target.
# PATH need not exist yet — df resolves through to the nearest existing
# ancestor directory on the same filesystem a not-yet-created path would
# land on.
fs_mountpoint() {
    local p="$1"
    while [[ ! -e "$p" && "$p" != "/" ]]; do p="$(dirname -- "$p")"; done
    df --output=target -- "$p" 2>/dev/null | tail -n1
}

fs_avail_bytes() {
    df -Pk -- "$1" 2>/dev/null | awk 'NR==2 { printf "%.0f\n", $4 * 1024 }'
}

sum_input_bytes() {
    local total=0 f sz
    for f in "$@"; do
        sz="$(stat -c%s -- "$f" 2>/dev/null)" || continue
        [[ "$sz" =~ ^[0-9]+$ ]] && total=$(( total + sz ))
    done
    printf '%d' "$total"
}

declare -A _FFX_SPACE_REQUIRED=()

# register_space_requirement PATH BYTES: accumulates BYTES against the
# mountpoint PATH resolves to. Call once per (directory, estimated-bytes)
# pair for a job; call verify_space_requirements() once after all of a
# job's requirements are registered.
register_space_requirement() {
    local path="$1" bytes="$2"
    [[ "$FFX_SKIP_SPACE_CHECK" == true ]] && return 0
    (( bytes > 0 )) || return 0
    local mnt; mnt="$(fs_mountpoint "$path")"
    if [[ -z "$mnt" ]]; then
        warn "Could not resolve the filesystem backing '$path'; skipping its space check."
        return 0
    fi
    _FFX_SPACE_REQUIRED["$mnt"]=$(( ${_FFX_SPACE_REQUIRED[$mnt]:-0} + bytes ))
}

# verify_space_requirements(): checks every mountpoint registered since the
# last call against its current free space, dies with a specific, actionable
# message on the first shortfall, and always resets the registry — call
# exactly once per job, after all of that job's register_space_requirement
# calls, before the first ffmpeg invocation for it.
verify_space_requirements() {
    if [[ "$FFX_SKIP_SPACE_CHECK" == true ]]; then
        _FFX_SPACE_REQUIRED=()
        return 0
    fi
    local mnt required avail
    for mnt in "${!_FFX_SPACE_REQUIRED[@]}"; do
        required="${_FFX_SPACE_REQUIRED[$mnt]}"
        avail="$(fs_avail_bytes "$mnt")"
        if [[ ! "$avail" =~ ^[0-9]+$ ]]; then
            warn "Could not determine free space on '$mnt'; proceeding without a space guarantee for it."
            continue
        fi
        if (( avail < required )); then
            _FFX_SPACE_REQUIRED=()
            die "Not enough free space on '$mnt': need an estimated $(human_size "$required"), only $(human_size "$avail") free. Free up space on '$mnt', point FFX_CACHE_DIR/FFX_SCRATCH_DIR/-o at a filesystem with more room, or set FFX_SKIP_SPACE_CHECK=true to bypass this check (not recommended)."
        fi
        verbose_log "space check: '$mnt' has $(human_size "$avail") free against an estimated $(human_size "$required") requirement."
    done
    _FFX_SPACE_REQUIRED=()
}

# preflight_space(OUT_DIR, MULTIPLIER, FILE...): the one call site every
# batch command needs. MULTIPLIER is how many full copies of the summed
# input bytes THIS operation will write in total across RUN_DIR, CACHE_DIR
# and OUT_DIR combined (e.g. 1 for a stream-copy-only fast path that writes
# just the final output; 3 for a normalize path that writes one tmp per
# input into FFX_RUN_DIR, a checkpointed copy of each into FFX_CACHE_DIR,
# and the final concat into OUT_DIR). The total is split evenly across the
# three directories' own mountpoints rather than assumed to land entirely on
# one, which both overstates isolated small disks and understates a job that
# genuinely touches all three.
preflight_space() {
    local out_dir="$1" multiplier="$2"; shift 2
    [[ "$FFX_SKIP_SPACE_CHECK" == true || "$DRY_RUN" == true ]] && return 0
    local total; total="$(sum_input_bytes "$@")"
    (( total > 0 )) || return 0
    local per_dir
    if [[ "$multiplier" == 1 ]]; then
        per_dir=$(awk -v t="$total" -v f="$FFX_SPACE_SAFETY_FACTOR" 'BEGIN{printf "%.0f",t*f}')
        register_space_requirement "$out_dir" "$per_dir"
    else
        per_dir=$(awk -v t="$total" -v m="$multiplier" -v f="$FFX_SPACE_SAFETY_FACTOR" 'BEGIN{printf "%.0f",(t*m*f)/3}')
        local mnt_run mnt_cache
        mnt_run="$(fs_mountpoint "$FFX_RUN_DIR")"
        mnt_cache="$(fs_mountpoint "$FFX_CACHE_DIR")"
        if [[ -n "$mnt_run" && "$mnt_run" == "$mnt_cache" ]]; then
            register_space_requirement "$FFX_CACHE_DIR" "$per_dir"
        else
            register_space_requirement "$FFX_RUN_DIR" "$per_dir"
            register_space_requirement "$FFX_CACHE_DIR" "$per_dir"
        fi
        register_space_requirement "$out_dir" "$per_dir"
    fi
    verify_space_requirements
}

preflight_space_resumable() {
    local out_dir="$1" all_bytes="${2:-0}" uncached_bytes="${3:-0}"
    [[ "$FFX_SKIP_SPACE_CHECK" == true || "$DRY_RUN" == true ]] && return 0
    (( all_bytes > 0 )) || return 0
    local out_req uncached_req
    out_req=$(awk -v t="$all_bytes" -v f="$FFX_SPACE_SAFETY_FACTOR" 'BEGIN{printf "%.0f",t*f}')
    register_space_requirement "$out_dir" "$out_req"
    if (( uncached_bytes > 0 )); then
        uncached_req=$(awk -v t="$uncached_bytes" -v f="$FFX_SPACE_SAFETY_FACTOR" 'BEGIN{printf "%.0f",t*f}')
        local mnt_run mnt_cache
        mnt_run="$(fs_mountpoint "$FFX_RUN_DIR")"
        mnt_cache="$(fs_mountpoint "$FFX_CACHE_DIR")"
        if [[ -n "$mnt_run" && "$mnt_run" == "$mnt_cache" ]]; then
            register_space_requirement "$FFX_CACHE_DIR" "$uncached_req"
        else
            register_space_requirement "$FFX_RUN_DIR" "$uncached_req"
            register_space_requirement "$FFX_CACHE_DIR" "$uncached_req"
        fi
    fi
    verify_space_requirements
}

ffprobe() {
    local binary
    binary=$(type -P ffprobe) || { warn "ffprobe executable is unavailable"; return 127; }
    timeout --kill-after=5 "${FFX_PROBE_TIMEOUT:-30}" "$binary" "$@"
}

# =============================================================================
# PROBE HELPERS
# =============================================================================
probe_wh() {
    local _w=0 _h=0
    IFS=' ' read -r _w _h < <(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=width,height \
            -of default=nw=1:nk=1 "$1" 2>/dev/null | xargs
    ) || true
    [[ "$_w" =~ ^[0-9]+$ ]] || _w=$CANVAS_W
    [[ "$_h" =~ ^[0-9]+$ && "$_h" -gt 0 ]] || _h=$CANVAS_H
    printf '%d %d\n' "$_w" "$_h"
}

probe_duration() {
    ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null || echo "60"
}

get_fps() {
    local s
    s=$(ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate -of default=nw=1:nk=1 "$1" 2>/dev/null || true)
    if [[ -z "$s" || "$s" == 0/0 ]]; then
        s=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=nw=1:nk=1 "$1" 2>/dev/null || true)
    fi
    awk -v s="$s" -v fallback="$ADV_FPS" 'BEGIN {split(s,a,"/"); if(a[1]+0>0 && (a[2]=="" || a[2]+0>0)) printf "%.6f",a[1]/(a[2]==""?1:a[2]); else printf "%s",fallback}'
}

is_interlaced() {
    local o
    o="$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=field_order \
        -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null || echo progressive)"
    case "$o" in tt|bb|tb|bt|bt_tb|bt_bt|tb_tb|tb_bt) return 0 ;; *) return 1 ;; esac
}

get_deinterlace_filter() { is_interlaced "$1" && echo "yadif=deint=interlaced" || echo "null"; }

# probe_video_params FILE: prints "codec width height pix_fmt avg_frame_rate
# profile" on one line, fields in that FIXED order. Parsed from ffprobe's
# key=value output BY KEY, never by position: ffprobe emits fields in its own
# internal order (codec, width, height, pix_fmt, frame rate), not the order
# they were requested in, so the previous positional parse silently shifted
# every field. Spaces inside the profile name ("High 4:4:4 Predictive") become
# underscores so the line stays whitespace-separable.
probe_video_params() {
    local k v codec="" w="" h="" pix="" fps="" prof=""
    while IFS='=' read -r k v; do
        case "$k" in
            codec_name)     codec="$v" ;;
            width)          w="$v" ;;
            height)         h="$v" ;;
            pix_fmt)        pix="$v" ;;
            avg_frame_rate) fps="$v" ;;
            profile)        prof="${v// /_}" ;;
        esac
    done < <(ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,profile,width,height,pix_fmt,avg_frame_rate \
        -of default=nw=1 "$1" 2>/dev/null)
    printf '%s %s %s %s %s %s\n' "${codec:-unknown}" "${w:-0}" "${h:-0}" \
        "${pix:-unknown}" "${fps:-0/1}" "${prof:-unknown}"
}

# probe_audio_params FILE: prints "codec sample_rate channels" for the first
# audio stream, or "none 0 0" when the file has no audio. Same by-key parse.
probe_audio_params() {
    local k v codec="" rate="" ch=""
    while IFS='=' read -r k v; do
        case "$k" in
            codec_name)  codec="$v" ;;
            sample_rate) rate="$v" ;;
            channels)    ch="$v" ;;
        esac
    done < <(ffprobe -v error -select_streams a:0 \
        -show_entries stream=codec_name,sample_rate,channels \
        -of default=nw=1 "$1" 2>/dev/null)
    printf '%s %s %s\n' "${codec:-none}" "${rate:-0}" "${ch:-0}"
}

# codec_family ENCODER_OR_CODEC: maps an ffmpeg ENCODER name (libx264,
# hevc_nvenc, ...) to the CODEC name ffprobe reports (h264, hevc, ...). The
# normalise path compared ffprobe's codec_name ("h264") against ADV_CODEC
# ("libx264"), which can never be equal, so no input was ever judged
# conformant.
codec_family() {
    case "$1" in
        libx264|h264|h264_*)                     printf 'h264' ;;
        libx265|hevc|hevc_*)                     printf 'hevc' ;;
        libvpx-vp9|vp9|vp9_*)                    printf 'vp9'  ;;
        libvpx|vp8)                              printf 'vp8'  ;;
        libaom-av1|libsvtav1|librav1e|av1|av1_*) printf 'av1'  ;;
        *)                                       printf '%s' "${1#lib}" ;;
    esac
}

# fps_equals A B: true when two frame rates ("30000/1001", "25/1", "29.97")
# agree within 0.01 fps.
fps_equals() {
    awk -v a="$1" -v b="$2" '
        function v(s,  p) { split(s, p, "/"); return (p[2] + 0 > 0) ? p[1] / p[2] : p[1] + 0 }
        BEGIN { d = v(a) - v(b); exit !(d < 0.01 && d > -0.01) }'
}

# =============================================================================
# MOOV ATOM
#
# NOTE (audit finding, not a regression — flagged per protocol but not silently
# "fixed" without naming it explicitly): check_moov_atom() only confirms ffprobe
# can read a duration field; it does NOT confirm the file's actual duration
# matches what was expected. Combined with run_ffmpeg's SIGTERM-on-timeout
# behavior, a truncated file could finalize a valid-but-short moov atom and
# pass this check. run_ffmpeg's --ffx-output cleanup closes the path that
# produced those truncated files in the first place, which is the correct
# fix point — re-deriving expected-vs-actual duration here would duplicate
# that fix at the wrong layer and add LBYL surface area for marginal benefit.
# Left unchanged; documenting the reasoning so it isn't re-litigated as an
# oversight.
# =============================================================================
check_moov_atom() {
    ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$1" >/dev/null 2>&1
}

# faststart_flags_for OUTPUT: prints "-movflags" "+faststart" (one per line)
# when OUTPUT's extension is an ISO-BMFF container, nothing otherwise. The
# flag is a MUXER option of the mov/mp4 family only: passing it to a
# matroska/webm/avi muxer makes ffmpeg abort with "Unrecognized option".
# Faststart relocates the moov atom (the index) in front of mdat, which is
# what lets a browser start playback and seek before the whole file has
# downloaded (see 4ndr0666 encoding guide, "Index at the end of the file").
faststart_flags_for() {
    case "${1##*.}" in
        mp4|MP4|m4v|M4V|mov|MOV|m4a|M4A|3gp|3g2|f4v) printf '%s\n' "-movflags" "+faststart" ;;
    esac
}

# mp4_moov_first FILE: true iff FILE's top-level atom walk reaches 'moov'
# before 'mdat'. Reads only the 16-byte header of each top-level atom
# (ftyp, free/skip/wide, then moov or mdat), so cost is constant regardless of
# file size. Handles the 64-bit "largesize" form (size field == 1).
mp4_moov_first() {
    local f="$1" off=0 i hdr size
    for (( i=0; i<64; i++ )); do
        hdr="$(dd if="$f" bs=1 skip="$off" count=16 2>/dev/null | od -An -v -tx1 | tr -d ' \n')" || true
        (( ${#hdr} >= 16 )) || return 1
        case "${hdr:8:8}" in
            6d6f6f76) return 0 ;;   # 'moov'
            6d646174) return 1 ;;   # 'mdat' first -> index is at the end
        esac
        size=$(( 16#${hdr:0:8} ))
        if (( size == 1 )); then
            (( ${#hdr} >= 32 )) || return 1
            size=$(( 16#${hdr:16:16} ))
        fi
        (( size >= 8 )) || return 1
        off=$(( off + size ))
    done
    return 1
}

# sibling_tmp FILE: prints a hidden temp path in FILE's OWN directory that
# keeps FILE's extension (so ffmpeg selects the right muxer) and registers it
# with cleanup_all(). Same-directory means the final `mv -f` is an atomic
# rename on one filesystem: a failed or interrupted replace can never leave a
# truncated file under the real name. (The previous auto_clean built the temp
# in $FFX_RUN_DIR, so `mv` across filesystems was a non-atomic copy-then-unlink
# that, on ENOSPC, overwrote the good output with a partial copy.)
sibling_tmp() {
    local file="$1" ext="${1##*.}" t
    t=$(umask 077; mktemp -p "$(dirname -- "$file")" --suffix=".$ext" '.ffx.XXXXXXXX') || return 1
    register_cleanup always "$t"
    printf '%s' "$t"
}

# ensure_faststart FILE: post-condition + repair. For ISO-BMFF outputs,
# guarantees the moov atom is in front of mdat, remuxing (-c copy, every
# video/audio stream kept) only when it is not. Idempotent; a file already
# in faststart layout is never rewritten. Non-ISO-BMFF containers and
# --dry-run are no-ops. Returns 1 if the layout could not be established.
ensure_faststart() {
    local file="$1"
    [[ "$DRY_RUN" == true ]] && return 0
    [[ -n "$(faststart_flags_for "$file")" ]] || return 0
    [[ -s "$file" ]] || return 1
    mp4_moov_first "$file" && return 0
    verbose_log "faststart: moov is not first in '$(basename "$file")'; remuxing."
    local tmpf; tmpf="$(sibling_tmp "$file")"
    if run_ffmpeg --ffx-output "$tmpf" -y -i "$file" -map 0 -c copy \
            -movflags +faststart "$tmpf" \
        && mp4_moov_first "$tmpf" \
        && mv -f -- "$tmpf" "$file"; then
        return 0
    fi
    rm -f -- "$tmpf" 2>/dev/null || true
    return 1
}

moov_fallback() {
    local in="$1" out="$2"
    local -a aopts; mapfile -t aopts < <(get_audio_opts_array)
    verbose_log "moov_fallback: re-encoding '$(basename "$in")'"
    local -a enc
    if [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]]; then
        enc=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "$ADV_PRESET")
    else
        enc=("-c:v" "$ADV_CODEC" "-crf" "${ADV_CRF:-18}" "-preset" "$ADV_PRESET")
    fi
    run_ffmpeg --ffx-output "$out" -y -i "$in" "${enc[@]}" "${aopts[@]}" -movflags +faststart "$out" \
        || die "moov_fallback failed for '$(basename "$in")'"
}

# =============================================================================
# DTS CORRECTION
# =============================================================================
# check_dts_for_file FILE: true when video DTS never decreases. Only NUMERIC
# values are compared: ffprobe reports the final (decoder-flush) frame's
# pkt_dts_time as the literal "N/A", which the previous awk coerced to 0 and
# therefore flagged as a decrease on virtually every file — sending healthy
# inputs through a needless DTS remux and making merge's stream-copy fast
# path unreachable.
check_dts_for_file() {
    ffprobe -v error -select_streams v \
        -show_entries frame=pkt_dts_time \
        -of csv=p=0 "$1" 2>/dev/null |
    awk '$1 ~ /^-?[0-9]/ { v = $1 + 0; if (seen && v < p) exit 1; p = v; seen = 1 }'
}

fix_dts() {
    local file="$1" tmpf
    tmpf="$(mktemp_ffx .mp4)"
    local -a aopts; mapfile -t aopts < <(get_audio_opts_array)
    if ! run_ffmpeg --ffx-output "$tmpf" -y -fflags +genpts -i "$file" \
            -c:v copy "${aopts[@]}" -movflags +faststart "$tmpf"; then
        verbose_log "DTS remux failed; lossless re-encode for '$(basename "$file")'"
        run_ffmpeg --ffx-output "$tmpf" -y -fflags +genpts -i "$file" \
            -c:v "$ADV_CODEC" -qp 0 -preset ultrafast \
            "${aopts[@]}" "$tmpf" || return 1
    fi
    printf '%s' "$tmpf"
}

ensure_dts_correct() {
    local file="$1"
    [[ "$DRY_RUN" != true ]] || { printf '%s' "$file"; return 0; }
    is_image "$file" && { printf '%s' "$file"; return 0; }
    [[ -f "$file" ]] || die "ensure_dts_correct: '$file' not found."
    if ! check_dts_for_file "$file"; then
        verbose_log "DTS issues detected in '$(basename "$file")'. Fixing..."
        local fixed
        capture_value fixed fix_dts "$file" || return 1
        [[ -s "$fixed" ]] || die "DTS fix produced empty output for '$(basename "$file")'."
        printf '%s' "$fixed"
    else
        printf '%s' "$file"
    fi
}

# =============================================================================
# METADATA
# =============================================================================
# auto_clean FILE: strips container metadata in place (stream copy).
# CHANGED unit. Superset of the old contract (metadata stripped, original kept
# on any failure) with three defects closed: (1) the remux dropped
# -movflags +faststart, so a faststart merge came out of auto_clean with its
# moov atom back at the END of the file; (2) the temp was always named .mp4
# whatever FILE's container was, so a .mkv/.mov output became an MP4 body
# under a foreign extension; (3) the temp lived in $FFX_RUN_DIR, making the
# final mv a non-atomic cross-filesystem copy (see sibling_tmp). Streams are
# mapped explicitly (video + audio) so audio is never silently dropped.
auto_clean() {
    [[ "$DRY_RUN" != true ]] || return 0
    local file="$1"
    [[ -z "$file" || ! -f "$file" ]] && return 0
    local -a fs; mapfile -t fs < <(faststart_flags_for "$file")
    local tmpf; tmpf="$(sibling_tmp "$file")"
    if run_ffmpeg --ffx-output "$tmpf" -y -i "$file" -map 0 \
            -map_metadata -1 -c copy "${fs[@]}" "$tmpf" \
        && mv -f -- "$tmpf" "$file"; then
        verbose_log "Metadata stripped: '$(basename "$file")'"
    else
        rm -f -- "$tmpf" 2>/dev/null || true
        verbose_log "Metadata strip skipped — kept original '$(basename "$file")'."
    fi
}

# =============================================================================
# BATCH CHECKPOINT MANIFEST (NEW unit — orchestrator class)
#
# This is the mechanism that makes large merge/composite jobs resumable instead
# of all-or-nothing. It is intentionally a flat, dumb key/value store on disk —
# not a database, not JSON requiring jq for the hot path — because the only
# operations needed are "has this exact input+settings combination already
# produced a temp file that's still valid" and "record that it now has."
#
# Architectural Gate 4.3 (base+patch, not copy-and-accumulate): satisfied by
# construction — the checkpoint never copies prior state; it only ever points
# at the ALREADY-EXISTING successful temp output for an input, and the only
# "reset" operation is checkpoint_clear(), which returns to a known-pristine
# baseline (no checkpoint at all) rather than trying to partially undo one.
# =============================================================================

# checkpoint_key(): derives a stable, collision-resistant identifier for one
# (input file + relevant encode settings) pair, so a checkpoint from a PRIOR
# run with different settings is correctly treated as stale and never
# silently reused across incompatible settings. Accepts an optional explicit
# target-geometry override (used by cmd_merge, whose actual per-file encode
# target is the batch-computed max_w x max_h, NOT the ADV_RES default) so the
# key reflects what was actually encoded rather than an unrelated config value.
checkpoint_key() {
    local input="$1" geometry_override="${2:-$ADV_RES}"
    {
        if [[ -f "$input" ]]; then
            absolute_path "$input"
            stat -c '%s:%Y' -- "$input" 2>/dev/null || stat -f '%z:%m' -- "$input" 2>/dev/null || printf '0:0\n'
        else
            printf '%s\n' "$input"
        fi
        printf '%s\0' "$ADV_CODEC" "$ADV_PIX_FMT" "$geometry_override" "${SPECIFIC_FPS:-$ADV_FPS}" "$ADV_CRF" "$ADV_PRESET" "$ADV_BR" "$ADV_QUALITY_MODE" "$ADV_MULTIPASS" "$REMOVE_AUDIO" "$FFX_AUDIO_RATE" "$PTS_FACTOR" "$INTERPOLATE" "norm4"
    } | sha256sum | awk '{print $1}'
}

checkpoint_key_legacy() {
    local input="$1" geometry_override="${2:-$ADV_RES}" norm_tag="${3:-norm4}"
    {
        if [[ -f "$input" ]]; then
            absolute_path "$input"
            sha256sum -- "$input"
        else
            printf '%s\n' "$input"
        fi
        if [[ "$norm_tag" == "norm3" ]]; then
            printf '%s\0' "$ADV_CODEC" "$ADV_PIX_FMT" "$geometry_override" "${SPECIFIC_FPS:-$ADV_FPS}" "$ADV_CRF" "$ADV_PRESET" "$ADV_BR" "$ADV_QUALITY_MODE" "$ADV_MULTIPASS" "$REMOVE_AUDIO" "$FFX_AUDIO_RATE" "norm3"
        else
            printf '%s\0' "$ADV_CODEC" "$ADV_PIX_FMT" "$geometry_override" "${SPECIFIC_FPS:-$ADV_FPS}" "$ADV_CRF" "$ADV_PRESET" "$ADV_BR" "$ADV_QUALITY_MODE" "$ADV_MULTIPASS" "$REMOVE_AUDIO" "$FFX_AUDIO_RATE" "$PTS_FACTOR" "$INTERPOLATE" "norm4"
        fi
    } | sha256sum | awk '{print $1}'
}

probe_cache_key() {
    local input="$1"
    {
        absolute_path "$input"
        stat -c '%s:%Y' -- "$input" 2>/dev/null || stat -f '%z:%m' -- "$input" 2>/dev/null || printf '0:0\n'
        printf 'probe_v1\0'
    } | sha256sum | awk '{print $1}'
}

probe_file_cached() {
    local f="$1"
    _P_VC="unknown"; _P_VW="0"; _P_VH="0"; _P_VPIX="unknown"; _P_VFPS="0/1"; _P_VPROF="unknown"
    _P_AC="none"; _P_AR="0"; _P_ACH="0"; _P_HAS_AUD="false"
    _P_DTS_OK="true"; _P_MOOV_OK="true"; _P_CSIG="none"

    if is_image "$f"; then
        _P_VC="image"
        return 0
    fi

    local pkey="" pfile=""
    if [[ "$DRY_RUN" != true && -d "${FFX_PROBE_CACHE_DIR:-}" ]]; then
        pkey="$(probe_cache_key "$f")"
        pfile="$FFX_PROBE_CACHE_DIR/${pkey}.probe"
        if [[ -s "$pfile" ]]; then
            local k v
            while IFS='=' read -r k v; do
                case "$k" in
                    VC)      _P_VC="$v" ;;
                    VW)      _P_VW="$v" ;;
                    VH)      _P_VH="$v" ;;
                    VPIX)    _P_VPIX="$v" ;;
                    VFPS)    _P_VFPS="$v" ;;
                    VPROF)   _P_VPROF="$v" ;;
                    AC)      _P_AC="$v" ;;
                    AR)      _P_AR="$v" ;;
                    ACH)     _P_ACH="$v" ;;
                    HAS_AUD) _P_HAS_AUD="$v" ;;
                    DTS_OK)  _P_DTS_OK="$v" ;;
                    MOOV_OK) _P_MOOV_OK="$v" ;;
                    CSIG)    _P_CSIG="$v" ;;
                esac
            done < "$pfile"
            if [[ -n "$_P_VC" && "$_P_VC" != "unknown" ]]; then
                return 0
            fi
        fi
    fi

    IFS=' ' read -r _P_VC _P_VW _P_VH _P_VPIX _P_VFPS _P_VPROF < <(probe_video_params "$f") || true
    _P_VC="${_P_VC:-unknown}"; _P_VW="${_P_VW:-0}"; _P_VH="${_P_VH:-0}"
    _P_VPIX="${_P_VPIX:-unknown}"; _P_VFPS="${_P_VFPS:-0/1}"; _P_VPROF="${_P_VPROF:-unknown}"

    IFS=' ' read -r _P_AC _P_AR _P_ACH < <(probe_audio_params "$f") || true
    _P_AC="${_P_AC:-none}"; _P_AR="${_P_AR:-0}"; _P_ACH="${_P_ACH:-0}"
    if [[ "$_P_AC" != "none" ]] || has_audio "$f"; then _P_HAS_AUD="true"; else _P_HAS_AUD="false"; fi

    if check_moov_atom "$f"; then _P_MOOV_OK="true"; else _P_MOOV_OK="false"; fi
    if check_dts_for_file "$f"; then _P_DTS_OK="true"; else _P_DTS_OK="false"; fi
    _P_CSIG="$(concat_signature "$f" 2>/dev/null || echo "none")"

    if [[ -n "$pfile" && "$DRY_RUN" != true ]]; then
        local tmp_pf
        if tmp_pf="$(mktemp -p "$FFX_PROBE_CACHE_DIR" .probe.XXXXXXXX 2>/dev/null)"; then
            register_cleanup always "$tmp_pf"
            printf 'VC=%s\nVW=%s\nVH=%s\nVPIX=%s\nVFPS=%s\nVPROF=%s\nAC=%s\nAR=%s\nACH=%s\nHAS_AUD=%s\nDTS_OK=%s\nMOOV_OK=%s\nCSIG=%s\n'                 "$_P_VC" "$_P_VW" "$_P_VH" "$_P_VPIX" "$_P_VFPS" "$_P_VPROF"                 "$_P_AC" "$_P_AR" "$_P_ACH" "$_P_HAS_AUD" "$_P_DTS_OK" "$_P_MOOV_OK" "$_P_CSIG" > "$tmp_pf"
            mv -f -- "$tmp_pf" "$pfile" 2>/dev/null || rm -f -- "$tmp_pf" 2>/dev/null || true
        fi
    fi
}

canonical_job_sig() {
    local target="$1"; shift
    local extra="$1"; shift
    local -a abs_files=()
    local f
    for f in "$@"; do
        abs_files+=("$(absolute_path "$f")")
    done
    local abs_target; abs_target="$(absolute_path "$target")"
    if [[ -n "$extra" ]]; then
        printf '%s|%s|%s' "${abs_files[*]}" "$extra" "$abs_target"
    else
        printf '%s|%s' "${abs_files[*]}" "$abs_target"
    fi
}

checkpoint_job_dir() {
    local job_sig="$1" legacy_sig="${2:-}"
    local job_hash; job_hash="$(sha256sum <<< "$job_sig" | awk '{print $1}')"
    local canon_dir="$FFX_CHECKPOINT_DIR/$job_hash"
    if [[ -d "$canon_dir" || -z "$legacy_sig" || "$legacy_sig" == "$job_sig" ]]; then
        printf '%s' "$canon_dir"
        return 0
    fi
    local leg_hash; leg_hash="$(sha256sum <<< "$legacy_sig" | awk '{print $1}')"
    local leg_dir="$FFX_CHECKPOINT_DIR/$leg_hash"
    if [[ -d "$leg_dir" ]]; then
        verbose_log "checkpoint: detected legacy job directory ($leg_hash); resuming in place."
        printf '%s' "$leg_dir"
        return 0
    fi
    printf '%s' "$canon_dir"
}

checkpoint_lock() {
    [[ "$DRY_RUN" != true ]] || return 0
    local job_dir="$1"
    mkdir -p -- "$(dirname -- "$job_dir")" || return 1
    exec {FFX_JOB_LOCK_FD}>"$job_dir.lock" || return 1
    flock -w 30 "$FFX_JOB_LOCK_FD" || die "Another invocation owns this checkpoint job"
}

checkpoint_get() {
    local job_dir="$1" input="$2" geometry_override="${3:-}"
    local key; key="$(checkpoint_key "$input" "$geometry_override")"
    local marker="$job_dir/$key"
    local recorded_path=""
    if [[ -f "$marker" ]]; then
        recorded_path="$(<"$marker")"
        [[ -s "$recorded_path" ]] || recorded_path="$job_dir/${key}.artifact.mp4"
        if [[ -s "$recorded_path" ]] && check_moov_atom "$recorded_path"; then
            printf '%s' "$recorded_path"
            return 0
        fi
    elif [[ -s "$job_dir/${key}.artifact.mp4" ]] && check_moov_atom "$job_dir/${key}.artifact.mp4"; then
        printf '%s' "$job_dir/${key}.artifact.mp4"
        return 0
    fi
    if [[ -d "${FFX_SEGMENT_CACHE_DIR:-}" ]]; then
        local shared_path="$FFX_SEGMENT_CACHE_DIR/${key}.artifact.mp4"
        if [[ -s "$shared_path" ]] && check_moov_atom "$shared_path"; then
            checkpoint_set "$job_dir" "$input" "$shared_path" "$geometry_override" 2>/dev/null || true
            printf '%s' "$shared_path"
            return 0
        fi
    fi
    if [[ -f "$input" ]] && { { [[ -d "$job_dir" ]] && compgen -G "$job_dir/*.artifact.mp4" >/dev/null 2>&1; } || { [[ -d "${FFX_SEGMENT_CACHE_DIR:-}" ]] && compgen -G "$FFX_SEGMENT_CACHE_DIR/*.artifact.mp4" >/dev/null 2>&1; }; }; then
        local norm_tag leg_key leg_marker leg_shared
        for norm_tag in norm4 norm3; do
            leg_key="$(checkpoint_key_legacy "$input" "$geometry_override" "$norm_tag")"
            leg_marker="$job_dir/$leg_key"
            if [[ -f "$leg_marker" ]]; then
                recorded_path="$(<"$leg_marker")"
                [[ -s "$recorded_path" ]] || recorded_path="$job_dir/${leg_key}.artifact.mp4"
                if [[ -s "$recorded_path" ]] && check_moov_atom "$recorded_path"; then
                    checkpoint_set "$job_dir" "$input" "$recorded_path" "$geometry_override" 2>/dev/null || true
                    printf '%s' "$recorded_path"
                    return 0
                fi
            elif [[ -s "$job_dir/${leg_key}.artifact.mp4" ]] && check_moov_atom "$job_dir/${leg_key}.artifact.mp4"; then
                recorded_path="$job_dir/${leg_key}.artifact.mp4"
                checkpoint_set "$job_dir" "$input" "$recorded_path" "$geometry_override" 2>/dev/null || true
                printf '%s' "$recorded_path"
                return 0
            fi
            if [[ -d "${FFX_SEGMENT_CACHE_DIR:-}" ]]; then
                leg_shared="$FFX_SEGMENT_CACHE_DIR/${leg_key}.artifact.mp4"
                if [[ -s "$leg_shared" ]] && check_moov_atom "$leg_shared"; then
                    checkpoint_set "$job_dir" "$input" "$leg_shared" "$geometry_override" 2>/dev/null || true
                    ln -f -- "$leg_shared" "$FFX_SEGMENT_CACHE_DIR/${key}.artifact.mp4" 2>/dev/null || true
                    printf '%s' "$leg_shared"
                    return 0
                fi
            fi
        done
    fi
    return 1
}

checkpoint_store_artifact() {
    [[ "$DRY_RUN" != true ]] || { printf '%s' "$3"; return 0; }
    local job_dir="$1" input="$2" transient_path="$3" geometry_override="${4:-}"
    mkdir -p "$job_dir" "${FFX_SEGMENT_CACHE_DIR:-$job_dir}"
    local key; key="$(checkpoint_key "$input" "$geometry_override")"
    local persistent_path="$job_dir/${key}.artifact.mp4"
    local tmp_publish; tmp_publish=$(mktemp -p "$job_dir" .artifact.XXXXXXXX) || return 1
    register_cleanup always "$tmp_publish"
    if ! mv -f -- "$transient_path" "$tmp_publish" 2>/dev/null; then
        cp -- "$transient_path" "$tmp_publish" || { rm -f -- "$tmp_publish"; return 1; }
        rm -f -- "$transient_path" 2>/dev/null || true
    fi
    mv -f -- "$tmp_publish" "$persistent_path" || { rm -f -- "$tmp_publish"; return 1; }
    if [[ -d "${FFX_SEGMENT_CACHE_DIR:-}" ]]; then
        ln -f -- "$persistent_path" "$FFX_SEGMENT_CACHE_DIR/${key}.artifact.mp4" 2>/dev/null || true
    fi
    printf '%s' "$persistent_path"
}

checkpoint_set() {
    [[ "$DRY_RUN" != true ]] || return 0
    local job_dir="$1" input="$2" produced_path="$3" geometry_override="${4:-}"
    mkdir -p "$job_dir"
    local key; key="$(checkpoint_key "$input" "$geometry_override")"
    local marker="$job_dir/$key"
    local tmp_marker; tmp_marker=$(mktemp -p "$job_dir" .marker.XXXXXXXX) || return 1
    register_cleanup always "$tmp_marker"
    printf '%s' "$produced_path" > "$tmp_marker"
    mv -f -- "$tmp_marker" "$marker"
}

checkpoint_clear() {
    [[ "$DRY_RUN" != true ]] || return 0
    local job_dir="$1"
    if [[ -d "$job_dir" && -d "${FFX_SEGMENT_CACHE_DIR:-}" ]]; then
        local art base
        for art in "$job_dir"/*.artifact.mp4; do
            [[ -e "$art" ]] || continue
            base="$(basename -- "$art")"
            rm -f -- "$FFX_SEGMENT_CACHE_DIR/$base" 2>/dev/null || true
        done
    fi
    rm -rf -- "$job_dir" "$job_dir.lock" 2>/dev/null || true
}

job_manifest_save() {
    [[ "$DRY_RUN" != true ]] || return 0
    local job_dir="$1" cmd_name="$2" out_target="$3" total_count="$4" completed_count="$5"
    shift 5
    local -a job_files=("$@")
    mkdir -p -- "$job_dir" || return 0
    local tmp_meta; tmp_meta=$(mktemp -p "$job_dir" .meta.XXXXXXXX) || return 0
    register_cleanup always "$tmp_meta"
    local now; now="$(date +%s)"
    local created="$now"
    if [[ -f "$job_dir/job.meta" ]]; then
        local prev_c
        prev_c="$(awk -F= '$1=="CREATED_AT"{print $2}' "$job_dir/job.meta" 2>/dev/null || true)"
        [[ "$prev_c" =~ ^[0-9]+$ ]] && created="$prev_c"
    fi
    {
        printf 'JOB_ID=%s\n' "$(basename -- "$job_dir")"
        printf 'JOB_CMD=%s\n' "$cmd_name"
        printf 'CREATED_AT=%s\n' "$created"
        printf 'UPDATED_AT=%s\n' "$now"
        printf 'CWD=%s\n' "$(pwd -P)"
        printf 'OUTPUT_TARGET=%s\n' "$(absolute_path "$out_target")"
        printf 'OUTPUT_DIR=%s\n' "$(absolute_path "$OUTPUT_DIR")"
        printf 'TOTAL_COUNT=%d\n' "$total_count"
        printf 'COMPLETED_COUNT=%d\n' "$completed_count"
        printf 'ADV_CONTAINER=%s\n' "$ADV_CONTAINER"
        printf 'ADV_RES=%s\n' "$ADV_RES"
        printf 'EXPLICIT_RES=%s\n' "${EXPLICIT_RES:-false}"
        printf 'ADV_FPS=%s\n' "$ADV_FPS"
        printf 'SPECIFIC_FPS=%s\n' "${SPECIFIC_FPS:-}"
        printf 'PTS_FACTOR=%s\n' "${PTS_FACTOR:-}"
        printf 'INTERPOLATE=%s\n' "${INTERPOLATE:-false}"
        printf 'ADV_CODEC=%s\n' "$ADV_CODEC"
        printf 'ADV_PIX_FMT=%s\n' "$ADV_PIX_FMT"
        printf 'ADV_CRF=%s\n' "$ADV_CRF"
        printf 'ADV_BR=%s\n' "$ADV_BR"
        printf 'ADV_PRESET=%s\n' "$ADV_PRESET"
        printf 'ADV_QUALITY_MODE=%s\n' "$ADV_QUALITY_MODE"
        printf 'ADV_MULTIPASS=%s\n' "$ADV_MULTIPASS"
        printf 'REMOVE_AUDIO=%s\n' "$REMOVE_AUDIO"
        printf 'FFX_AUDIO_RATE=%s\n' "$FFX_AUDIO_RATE"
        printf 'LAYOUT_MODE=%s\n' "$LAYOUT_MODE"
        printf 'COMPOSITE_LAYOUT=%s\n' "${COMPOSITE_LAYOUT:-}"
        printf 'COMPOSITE_AUDIO=%s\n' "${COMPOSITE_AUDIO:-mix}"
        printf 'BATCH_SIZE=%s\n' "$BATCH_SIZE"
    } > "$tmp_meta"
    mv -f -- "$tmp_meta" "$job_dir/job.meta" 2>/dev/null || rm -f -- "$tmp_meta"

    if [[ ! -s "$job_dir/job.files" ]]; then
        local tmp_files; tmp_files=$(mktemp -p "$job_dir" .files.XXXXXXXX) || return 0
        register_cleanup always "$tmp_files"
        local jf
        for jf in "${job_files[@]}"; do
            printf '%s\0' "$(absolute_path "$jf")"
        done > "$tmp_files"
        mv -f -- "$tmp_files" "$job_dir/job.files" 2>/dev/null || rm -f -- "$tmp_files"
    fi
}

_discover_resumable_jobs() {
    [[ -d "$FFX_CHECKPOINT_DIR" ]] || return 0
    local d meta
    local -a raw_rows=()
    for d in "$FFX_CHECKPOINT_DIR"/*; do
        [[ -d "$d" ]] || continue
        local base; base="$(basename -- "$d")"
        [[ "$base" == _* ]] && continue
        meta="$d/job.meta"
        if [[ -f "$meta" ]]; then
            local jid="" jcmd="" upd="0" tot="0" comp="0" out="" cwd=""
            local k v
            while IFS='=' read -r k v; do
                case "$k" in
                    JOB_ID)          jid="$v" ;;
                    JOB_CMD)         jcmd="$v" ;;
                    UPDATED_AT)      upd="$v" ;;
                    TOTAL_COUNT)     tot="$v" ;;
                    COMPLETED_COUNT) comp="$v" ;;
                    OUTPUT_TARGET)   out="$v" ;;
                    CWD)             cwd="$v" ;;
                esac
            done < "$meta"
            local actual_arts=0
            local a
            for a in "$d"/*.artifact.mp4; do
                [[ -e "$a" ]] && (( actual_arts++ )) || true
            done
            (( actual_arts > comp )) && comp=$actual_arts
            raw_rows+=("${upd:-0}"$'\t'"${jid:-$base}"$'\t'"${jcmd:-merge}"$'\t'"${comp}/${tot}"$'\t'"${out:-unknown}"$'\t'"${cwd:-unknown}"$'\t'"$d")
        else
            local actual_arts=0 mtime="0"
            local a
            for a in "$d"/*.artifact.mp4; do
                [[ -e "$a" ]] && (( actual_arts++ )) || true
            done
            (( actual_arts > 0 )) || continue
            mtime="$(stat -c '%Y' -- "$d" 2>/dev/null || echo 0)"
            raw_rows+=("${mtime}"$'\t'"${base}"$'\t'"legacy-job"$'\t'"${actual_arts}/?"$'\t'"(legacy checkpoint — run with original files or ffx merge <files>)"$'\t'"unknown"$'\t'"$d")
        fi
    done
    (( ${#raw_rows[@]} > 0 )) || return 0
    printf '%s\n' "${raw_rows[@]}" | sort -rn -k1,1
}

_recover_legacy_checkpoint() {
    local job_dir="$1"
    local jid; jid="$(basename -- "$job_dir")"
    local -a segs=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && segs+=("${line#* }")
    done < <(
        for a in "$job_dir"/*.artifact.mp4; do
            [[ -s "$a" ]] || continue
            printf '%s %s
' "$(stat -c '%Y' -- "$a" 2>/dev/null || echo 0)" "$a"
        done | sort -n
    )
    (( ${#segs[@]} > 0 )) || die "Legacy checkpoint '${jid:0:12}' contains no valid .artifact.mp4 segments."

    local seg_w=1920 seg_h=1080 seg_fps="$ADV_FPS"
    IFS=' ' read -r seg_w seg_h < <(probe_wh "${segs[0]}") || true
    (( seg_w > 0 && seg_h > 0 )) || { seg_w=1920; seg_h=1080; }
    seg_fps="$(get_fps "${segs[0]}")"
    local seg_geom="${seg_w}x${seg_h}"

    local mode="concat-now"
    if tui_available; then
        local -a opts=(
            "concat-now   -- Concatenate the ${#segs[@]} completed segments in encode order right now"
            "append-more  -- Keep the ${#segs[@]} completed segments, pick remaining file(s) in fzf to append, then concat"
            "scan-dir     -- Match files in $(pwd) against this checkpoint to rebuild job.files & resume"
        )
        local picked
        picked="$(printf '%s
' "${opts[@]}" | fzf --prompt="Legacy checkpoint (${#segs[@]} segments @ ${seg_geom})> " --height='~45%' --reverse --header="Job ${jid:0:12} has no job.files manifest from v8.5.0. Choose recovery mode:" 2>/dev/null)" || picked=""
        [[ -n "$picked" ]] || die "Legacy checkpoint recovery cancelled."
        mode="${picked%% *}"
    fi

    local out="${GLOBAL_OUTPUT_FILE:-}"
    if [[ -z "$out" ]]; then
        out="$(get_default_filename "output" "merged" "$ADV_CONTAINER")"
    else
        out="$(ensure_unique_output "$out")"
    fi

    if [[ "$mode" == "scan-dir" ]]; then
        say "Scanning $(pwd) for source files matching ${#segs[@]} cached segments (${seg_geom})..."
        local -a cand_files=() matched_pairs=()
        mapfile -t cand_files < <(apply_bulk_glob "$(pwd)")
        (( ${#cand_files[@]} > 0 )) || die "No media files found in $(pwd) to match against checkpoint."
        local cf k_fast k_leg3 k_leg4 match_art="" art_mtime
        for cf in "${cand_files[@]}"; do
            match_art=""
            k_fast="$(checkpoint_key "$cf" "$seg_geom")"
            if [[ -s "$job_dir/${k_fast}.artifact.mp4" ]]; then
                match_art="$job_dir/${k_fast}.artifact.mp4"
            else
                k_leg3="$(checkpoint_key_legacy "$cf" "$seg_geom" "norm3")"
                if [[ -s "$job_dir/${k_leg3}.artifact.mp4" ]]; then
                    match_art="$job_dir/${k_leg3}.artifact.mp4"
                else
                    k_leg4="$(checkpoint_key_legacy "$cf" "$seg_geom" "norm4")"
                    [[ -s "$job_dir/${k_leg4}.artifact.mp4" ]] && match_art="$job_dir/${k_leg4}.artifact.mp4"
                fi
            fi
            if [[ -n "$match_art" ]]; then
                art_mtime="$(stat -c '%Y' -- "$match_art" 2>/dev/null || echo 0)"
                matched_pairs+=("${art_mtime}"$'	'"$(absolute_path "$cf")")
            fi
        done
        (( ${#matched_pairs[@]} > 0 )) || die "No files in $(pwd) matched the segments in ${jid:0:12}. Use 'concat-now' or 'append-more' instead."
        local -a ordered_files=()
        while IFS=$'	' read -r _ mfile; do
            [[ -n "$mfile" ]] && ordered_files+=("$mfile")
        done < <(printf '%s
' "${matched_pairs[@]}" | sort -n -k1,1)
        say "Matched ${#ordered_files[@]}/${#segs[@]} cached segment(s) in $(pwd)."
        if tui_available; then
            local ans=""
            read -r -p "Pick additional unencoded files from $(pwd) to append after these ${#ordered_files[@]} files? (y/N): " ans || true
            if [[ "${ans,,}" =~ ^y ]]; then
                local -a extra_files=()
                mapfile -t extra_files < <(tui_pick_many "Pick remaining files to append")
                ordered_files+=("${extra_files[@]}")
            fi
        fi
        job_manifest_save "$job_dir" "merge" "$out" "${#ordered_files[@]}" "${#ordered_files[@]}" "${ordered_files[@]}"
        OVERWRITE_OUTPUT=true
        cmd_merge -o "$out" -- "${ordered_files[@]}"
        return $?
    fi

    local -a final_segs=("${segs[@]}")
    if [[ "$mode" == "append-more" ]]; then
        local -a extra_inputs=()
        mapfile -t extra_inputs < <(tui_pick_many "Pick remaining unencoded file(s) to append after the ${#segs[@]} cached segments")
        local ef
        for ef in "${extra_inputs[@]}"; do
            [[ -f "$ef" ]] || continue
            local tmp_seg; tmp_seg="$(mktemp_ffx .mp4)"
            local has_aud="false"
            has_audio "$ef" && has_aud="true"
            say "Normalizing appended file: $(basename -- "$ef") (${seg_geom} @ ${seg_fps}fps)..."
            if is_image "$ef"; then
                merge_image_input "$ef" "$tmp_seg" "$seg_w" "$seg_h" "$seg_fps" || die "Failed to normalize image: $ef"
            else
                merge_encode_input "$ef" "$tmp_seg" "$seg_w" "$seg_h" "$seg_fps" "$has_aud" false false || die "Failed to normalize video: $ef"
            fi
            local persisted; persisted="$(checkpoint_store_artifact "$job_dir" "$ef" "$tmp_seg" "$seg_geom")"
            checkpoint_set "$job_dir" "$ef" "$persisted" "$seg_geom"
            final_segs+=("$persisted")
        done
    fi

    say "Concatenating ${#final_segs[@]} normalized segment(s) from checkpoint ${jid:0:12} -> $out"
    local concat_list; concat_list="$(mktemp_ffx .txt)"
    local s
    for s in "${final_segs[@]}"; do
        concat_add "$concat_list" "$s"
    done
    local final_to; final_to="$(compute_batch_timeout "${#final_segs[@]}")"
    local -a final_fs; mapfile -t final_fs < <(faststart_flags_for "$out")
    run_ffmpeg --ffx-timeout "$final_to" --ffx-output "$out"         -y -avoid_negative_ts make_zero         -f concat -safe 0 -i "$concat_list" -c copy "${final_fs[@]}" "$out"         || die "merge: legacy checkpoint concat failed -> $out" "$out"
    finalize_merge_output "$out"
    say "Merged [${#final_segs[@]} segments]: $out"
    return 0
}

_execute_resumed_job() {
    local job_dir="$1"
    local meta="$job_dir/job.meta"
    local files_list="$job_dir/job.files"
    if [[ ! -f "$meta" || ! -f "$files_list" ]]; then
        _recover_legacy_checkpoint "$job_dir"
        return $?
    fi

    local cli_timeout="$FFX_TIMEOUT"
    local cli_timeout_pf="$FFX_TIMEOUT_PER_FILE"
    local cli_verbose="$VERBOSE_MODE"
    local cli_out="$GLOBAL_OUTPUT_FILE"

    local jcmd="merge" out_target=""
    local k v
    while IFS='=' read -r k v; do
        case "$k" in
            JOB_CMD)          jcmd="$v" ;;
            OUTPUT_TARGET)    out_target="$v" ;;
            OUTPUT_DIR)       OUTPUT_DIR="$v" ;;
            ADV_CONTAINER)    ADV_CONTAINER="$v" ;;
            ADV_RES)          ADV_RES="$v" ;;
            EXPLICIT_RES)     EXPLICIT_RES="$v" ;;
            ADV_FPS)          ADV_FPS="$v" ;;
            SPECIFIC_FPS)     SPECIFIC_FPS="$v" ;;
            PTS_FACTOR)       PTS_FACTOR="$v" ;;
            INTERPOLATE)      INTERPOLATE="$v" ;;
            ADV_CODEC)        ADV_CODEC="$v" ;;
            ADV_PIX_FMT)      ADV_PIX_FMT="$v" ;;
            ADV_CRF)          ADV_CRF="$v" ;;
            ADV_BR)           ADV_BR="$v" ;;
            ADV_PRESET)       ADV_PRESET="$v" ;;
            ADV_QUALITY_MODE) ADV_QUALITY_MODE="$v" ;;
            ADV_MULTIPASS)    ADV_MULTIPASS="$v" ;;
            REMOVE_AUDIO)     REMOVE_AUDIO="$v" ;;
            FFX_AUDIO_RATE)   FFX_AUDIO_RATE="$v" ;;
            LAYOUT_MODE)      LAYOUT_MODE="$v" ;;
            COMPOSITE_LAYOUT) COMPOSITE_LAYOUT="$v" ;;
            COMPOSITE_AUDIO)  COMPOSITE_AUDIO="$v" ;;
            BATCH_SIZE)       BATCH_SIZE="$v" ;;
        esac
    done < "$meta"

    FFX_TIMEOUT="$cli_timeout"
    FFX_TIMEOUT_PER_FILE="$cli_timeout_pf"
    [[ "$cli_verbose" == true ]] && VERBOSE_MODE=true
    [[ -n "$cli_out" ]] && out_target="$cli_out"

    local -a saved_files=()
    local f
    while IFS= read -r -d '' f; do
        saved_files+=("$f")
    done < "$files_list"

    (( ${#saved_files[@]} > 0 )) || die "Saved job manifest has no input files."
    say "Resuming ${jcmd} job ($(basename -- "$job_dir" | cut -c1-12)) with ${#saved_files[@]} file(s) -> $out_target"

    local saved_adv="$ADVANCED_MODE"
    ADVANCED_MODE=false
    OVERWRITE_OUTPUT=true
    local rc=0
    case "$jcmd" in
        composite) cmd_composite -o "$out_target" -- "${saved_files[@]}" || rc=$? ;;
        *)         cmd_merge     -o "$out_target" -- "${saved_files[@]}" || rc=$? ;;
    esac
    ADVANCED_MODE="$saved_adv"
    return "$rc"
}

cmd_resume() {
    local action="auto" target_id=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--list|list)     action="list"; shift ;;
            --latest|latest)    action="latest"; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; GLOBAL_OUTPUT_FILE="$2"; shift 2 ;;
            -*)                 die "Unknown resume option: $1" ;;
            *)                  action="pick_id"; target_id="$1"; shift ;;
        esac
    done

    local -a rows=()
    mapfile -t rows < <(_discover_resumable_jobs)
    if (( ${#rows[@]} == 0 )); then
        say "No incomplete or resumable batch jobs found in $FFX_CHECKPOINT_DIR."
        return 0
    fi

    if [[ "$action" == "list" ]]; then
        printf '%b# === Resumable FFX Jobs (%d) ===%b\n' "${CYAN}${BOLD}" "${#rows[@]}" "${RESET}"
        local idx=1 row upd jid jcmd prog out cwd jdir ts_human
        for row in "${rows[@]}"; do
            IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "$row"
            ts_human="$(date -d "@$upd" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '%s' "$upd")"
            printf '  [%d] %b%s%b  cmd=%-9s progress=%-7s updated=%s\n      target: %s\n'                 "$idx" "${CYAN}" "${jid:0:12}" "${RESET}" "$jcmd" "$prog" "$ts_human" "$out"
            (( idx++ )) || true
        done
        return 0
    fi

    if [[ "$action" == "pick_id" ]]; then
        local idx=1 row upd jid jcmd prog out cwd jdir
        for row in "${rows[@]}"; do
            IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "$row"
            if [[ "$target_id" == "$idx" || "$jid" == "$target_id"* ]]; then
                _execute_resumed_job "$jdir"
                return $?
            fi
            (( idx++ )) || true
        done
        die "resume: no resumable job matching '$target_id'. Run 'ffx resume --list' to inspect available jobs."
    fi

    if [[ "$action" == "latest" || ${#rows[@]} -eq 1 ]]; then
        local upd jid jcmd prog out cwd jdir
        IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "${rows[0]}"
        _execute_resumed_job "$jdir"
        return $?
    fi

    if tui_available; then
        local -a display_lines=()
        local idx=1 row upd jid jcmd prog out cwd jdir ts_human
        for row in "${rows[@]}"; do
            IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "$row"
            ts_human="$(date -d "@$upd" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$upd")"
            display_lines+=("${idx} | ${jid:0:12} | ${jcmd} (${prog}) | ${ts_human} | ${out}")
            (( idx++ )) || true
        done
        local picked
        picked="$(printf '%s\n' "${display_lines[@]}" | fzf --prompt='Resume job> ' --height='~50%' --reverse --header='Select an interrupted job to resume (most recent first)' 2>/dev/null)" || picked=""
        [[ -n "$picked" ]] || die "No job selected to resume."
        local picked_idx="${picked%% |*}"
        IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "${rows[$((picked_idx-1))]}"
        _execute_resumed_job "$jdir"
        return $?
    else
        local upd jid jcmd prog out cwd jdir
        IFS=$'\t' read -r upd jid jcmd prog out cwd jdir <<< "${rows[0]}"
        warn "Multiple resumable jobs found; automatically selecting the most recent (${jid:0:12}). Use 'ffx resume --list' or 'ffx resume <index>' to pick another."
        _execute_resumed_job "$jdir"
        return $?
    fi
}
# =============================================================================
# SELF-AUDIT ENGINE
