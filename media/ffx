#!/usr/bin/env bash
# Author: 4ndr0666
# v8.8.0 — Unified GUP Superset (v8.5.0 + v8.6.0 Ease-of-Use/Resume + v8.7.0 Beta/FFXD).
# Audit release: transactional outputs, CPU-verified media paths, zero-arg smart
# `ffx resume` with persisted job manifests, content-addressed segment cache,
# fast stat-based checkpoint keys with legacy sha256 fallback, cached ffprobe/DTS
# results, atomic zero-copy mv, uncached-aware preflight_space, CLI --tmp-dir /
# --cache-dir / --overwrite flags, native FFmpeg/ffprobe, carve, and config authority.
# Paradigm: Bash transaction coordinator; FFmpeg workers run in private session storage.
if [[ "${BASH_SOURCE[0]}" != "$0" && "${FFX_SOURCE_LOADED:-}" == 8.8.0 ]] && declare -F main >/dev/null; then
    return 0
fi
FFX_SOURCE_LOADED=8.8.0
set -euo pipefail
IFS=$'\n\t'
#                        === FFX === #
#
# shellcheck disable=SC2207,SC2034,SC2155,SC2317
# Descripttion: Ffmpeg cli wrapper
# Install path: /opt/ffx
# Approved feature manifest: A(v5) + B(beta/v6) + selective C(v7) superset.
# v8.4.0 (WO-01): merge output now always has the moov atom FIRST (+faststart on
# the fast concat, the final concat, auto_clean and a post-condition remux via
# ensure_faststart) and audio is never silently lost: every segment is
# normalised to one audio layout (FFX_AUDIO_RATE, default 48000 Hz stereo aac;
# silent track synthesised for audio-less inputs and images) before concat,
# and finalize_merge_output asserts an audio stream is present unless -an.
# Also fixed: probe parsing under IFS=$'\n\t', codec-name vs codec-family
# compare, check_dts_for_file N/A false positive, name-reservation hang and
# leaked 0-byte outputs, die() used before definition, paths.conf loader for
# FFX_SCRATCH_DIR/FFX_CACHE_DIR, -o <dir>, --audio-rate, faststart on clean/
# cleanmeta/fix/looperang/composite, debug_log wiring. Public library contracts
# (detect_max_res, check_container_first, log_verbose, log_error, show_help,
# build_ffmpeg_options) are exported for sourced callers (`source ffx`).
# v8.1.0: fixes the single-static-timeout-kills-the-whole-batch defect in
# run_ffmpeg, adds checkpointed/resumable batch concat for merge and
# composite, and makes die() able to scrub a partially-written destination file.
# v8.1.1: GUP synthesis pass over v8.1.0 against the v8.0.0 checkpoint
# baseline. Fixes a regression carried over verbatim from v8.0.0: the
# anullsrc audio-injection input was declared after output options in
# cmd_merge's re-encode branch, so ffmpeg rejected every audio-less source
# outright (verified live, not just read). Restores three guarantees v8.1.0
# silently dropped from the v8.0.0 checkpoint design: checkpoint_key() keys
# on absolute path + size + mtime again (v8.1.0 keyed on raw path + settings
# only, so a same-path content change resumed stale); checkpoint_get()
# re-validates the moov atom on every cache read, not just at write time;
# checkpoint_store_artifact()/checkpoint_set() publish atomically
# (temp+rename) instead of a direct cp/write, so a kill mid-publish can't
# leave a truncated file mistaken for a valid checkpoint. Also restores
# v8.0.0's single-pass fault tolerance in cmd_merge (one bad file is warned
# and skipped, not a hard die()) while keeping v8.1.0's cross-invocation
# checkpoint resumability — the two are complementary, not exclusive:
# checkpoint_clear() is now scoped to fire only after a fully successful
# pass, so a partially-failed batch keeps its cache for a cheap retry
# instead of wiping it on every partial success as v8.1.0 effectively would
# have once a skip-instead-of-die path existed.
# v8.2.0: adds an fzf-driven TUI (run_tui()). Running `ffx` with zero
# arguments in an interactive terminal now opens a menu covering every
# command, file selection (single/multi, video+image, with an ffprobe
# preview pane), and an options screen for the same ADV_* settings
# advanced_prompt() already exposes — the TUI populates those variables and
# hands off to the exact same main_dispatch() every CLI invocation uses, so
# there is no parallel implementation of any command to keep in sync. Purely
# additive: fzf missing, or stdin/stdout not a terminal (piped/scripted
# invocation), falls through to the original display_usage() zero-arg
# behavior unchanged.
# v8.2.2: fixes the actual root cause of "every input times out at exactly
# FFX_TIMEOUT with zero ffmpeg output," which v8.2.1's message fix correctly
# diagnosed as NOT being about which timeout flag applies but did not itself
# resolve. Confirmed live via `ps -eo stat`: the ffmpeg child process sits in
# STAT=TN (stopped by a job-control signal, niced) for the entire timeout
# window, not running, not blocked on I/O, not doing anything — a real
# encode of the same file outside this script's pipeline completes in under
# 2 seconds. Root cause: ffmpeg tries to configure the controlling terminal
# for interactive keypress handling (q to quit, etc: "Press [q] to stop, [?]
# for help") by touching termios state on its inherited stdin. When invoked
# as `timeout ... ffmpeg ... | tee logfile` from inside a shell function
# (run_ffmpeg's VERBOSE_MODE branch, and the non-verbose branch redirects
# stdout/stderr but never touches stdin either), ffmpeg's process group can
# end up backgrounded relative to the terminal even though the whole
# invocation looks foregrounded from the caller's perspective. The kernel's
# response to a backgrounded process touching terminal state is SIGTTOU,
# whose default disposition is to STOP the process — not kill it, not error
# it, just freeze it — until something sends SIGCONT, which nothing in this
# script ever does. `timeout` itself stays alive the whole time (correctly
# waiting on a child that will never move again) and only fires at the full
# budget, which is exactly the reported symptom: a flat, silent 300s wall on
# every single input regardless of file size or complexity, with zero
# ffmpeg output despite VERBOSE_MODE piping it live via tee. Fix: `-nostdin`
# on every ffmpeg invocation in run_ffmpeg's base command array — ffmpeg's
# own documented flag for exactly this situation ("useful when ffmpeg is in
# the background process group"), verified accepted and functional against
# the actual ffmpeg build in use. This could not be reproduced in a
# non-interactive sandbox (no controlling terminal to trigger SIGTTOU
# against), which is why v8.2.1's message fix was validated live but this
# fix could only be diagnosed from the user's live `ps` output and applied
# from the mechanism, not independently reproduced end-to-end here.
# v8.2.1: fixes a misleading run_ffmpeg() timeout message. On a timeout,
# every call site printed the identical "Use --timeout/--timeout-per-file to
# extend" regardless of which knob actually governed that call. Per-input
# normalize calls in cmd_merge/cmd_process/etc never pass --ffx-timeout, so
# they are governed solely by FFX_TIMEOUT (--timeout); FFX_TIMEOUT_PER_FILE
# (--timeout-per-file) only ever affects calls that DO pass --ffx-timeout
# (compute_batch_timeout call sites: fast-path/final concat in cmd_merge,
# final concat in cmd_composite, composite_batch). Verified live with a
# stubbed slow ffmpeg: setting FFX_TIMEOUT_PER_FILE=999 had zero effect on a
# no-override call that still timed out at the plain FFX_TIMEOUT ceiling —
# the old message was actively misleading for the single most common
# large-batch-merge failure mode (every per-file normalize timing out), since
# it pointed users at a flag that cannot affect that call. run_ffmpeg's
# actual behavior (dual-knob timeout, retry, --ffx-output cleanup) is
# otherwise unchanged; only the diagnostic text is corrected to name the
# flag that actually governs the call that failed.

# =============================================================================
# COLORS & LOGGING
# =============================================================================
if command -v tput >/dev/null 2>&1 && [[ -t 1 ]]; then
    CYAN="$(tput setaf 6 2>/dev/null || true)"
    GREEN="$(tput setaf 2 2>/dev/null || true)"
    BOLD="$(tput bold 2>/dev/null || true)"
    RED="$(tput setaf 1 2>/dev/null || true)"
    YELLOW="$(tput setaf 3 2>/dev/null || true)"
    RESET="$(tput sgr0 2>/dev/null || true)"
else
    CYAN="" GREEN="" BOLD="" RED="" YELLOW="" RESET=""
fi

say()         { printf '%b[OK] %s%b\n'       "${GREEN}${BOLD}" "$1" "${RESET}";      }
warn()        { printf '%b[!!] %s%b\n'       "${YELLOW}"        "$1" "${RESET}" >&2; }
verbose_log() { [[ "${VERBOSE_MODE:-false}" == true ]] && printf '[INFO] %s\n' "$1" >&2 || true; }
debug_log()   { [[ "${FFX_DEBUG:-0}"        == "1"  ]] && printf '[DEBUG] %s\n' "$1" >&2 || true; }

# die(): CHANGED unit (Golden-Unit §3 — superset, not a behavior break).
# Old contract: print red error to stderr, exit 1. Callers relied entirely on
# the EXIT trap (cleanup_all) to remove $FFX_RUN_DIR; nothing ever scrubbed a
# partially-written FINAL output path (e.g. a destination file mid-mv when a
# later pipeline stage in the same batch died).
# New contract: same message + exit behavior, PLUS an optional second argument
# naming a destination-path file to unlink before exiting, so a half-written
# user-visible output never survives a hard failure under its real filename.
# This satisfies Architectural Gate 4.4 (every allocated resource — including
# a not-yet-complete destination file — gets unconditional cleanup), not just
# resources inside the ephemeral run directory.
die() {
    local msg="$1" partial_output="${2:-}"
    printf '%b[XX] Error: %s%b\n' "${RED}" "$msg" "${RESET}" >&2
    if [[ -n "$partial_output" && -e "$partial_output" ]]; then
        rm -f -- "$partial_output" 2>/dev/null || true
        warn "Removed incomplete output: $partial_output"
    fi
    exit 1
}

# =============================================================================
# XDG & SESSION DIRECTORIES
#
# CHANGED unit (Golden-Unit §3 — superset, not a behavior break on any
# invocation that didn't already hit the bug this closes).
#
# OLD DIGEST: FFX_CACHE_DIR and the base directory for FFX_RUN_DIR were each
# either a fixed XDG-derived path or, in one field-edited revision, both
# hardcoded onto a path whose last component was literally "tmp". Neither
# form gave an operator any way to point ffx at a different filesystem
# without editing this file, and the hardcoded form put persistent
# checkpoint state (read back by the SAME still-running job, potentially
# long after it was written) on a path pattern that external reapers
# (systemd-tmpfiles, tmpwatch, an ad-hoc cron `find -mtime +N -delete`) are
# conventionally pointed at — producing exactly the reported symptom: a
# batch completes, but a handful of "file does not exist" errors surface
# for checkpoint artifacts a sweep caught mid-run. Root-caused from the
# architecture; could not be forced to reproduce live (no external reaper
# exists in this sandbox to trigger against).
#
# NEW DIGEST: both directories are independently configurable via ordinary
# environment variables (FFX_SCRATCH_DIR, FFX_CACHE_DIR), read with bash's
# own `:=` default-assignment so an operator's existing exported value is
# never overridden, only defaulted. Defaults remain the standard,
# universally-correct XDG locations — this script ships with no assumption
# about any specific disk layout (e.g. a secondary mount); an operator who
# wants scratch/cache state on a different filesystem (more free space, a
# faster disk, one NOT subject to a tmp-reaping policy) sets these two
# variables — in the environment, or once in $XDG_CONFIG_HOME/ffx/paths.conf
# (see _load_paths_conf below) — rather than
# editing this file. Both directory creations now check their own exit
# status instead of assuming mkdir/mktemp succeeded, so a misconfigured or
# unwritable override fails immediately with a clear message, before any
# ffmpeg work starts, instead of surfacing as a confusing mid-batch I/O
# error.
#
# Architectural Gate 4.6 (EAFP over LBYL): mkdir/mktemp are still attempted
# directly and only checked for failure after the fact — no pre-existence
# probing was added.
# =============================================================================
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_RUNTIME_DIR:=${TMPDIR:-/tmp}}"
if [[ -z "${TEMP:-}" ]]; then
    if [[ -d "/Nas/tmp" && -w "/Nas/tmp" ]]; then
        TEMP="/Nas/tmp"
    else
        TEMP="${TMPDIR:-/tmp}"
    fi
fi

FFX_CONFIG_DIR="$XDG_CONFIG_HOME/ffx"
FFX_LOG_DIR="$XDG_DATA_HOME/ffx"
FFX_DEFAULTS="$FFX_CONFIG_DIR/defaults"

FFX_PATHS_CONF="$FFX_CONFIG_DIR/paths.conf"
_load_paths_conf() {
    local key value
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ -z "$key" || "$key" == \#* ]] && continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        value="${value%\"}"; value="${value#\"}"; value="${value%\'}"; value="${value#\'}"
        value="${value/#\~/$HOME}"
        case "$key" in
            FFX_TMP_DIR)
                if [[ -n "$value" && -z "${FFX_TMP_DIR:-}" ]]; then FFX_TMP_DIR="$value"; fi
                if [[ -n "$value" && -z "${FFX_SCRATCH_DIR:-}" ]]; then FFX_SCRATCH_DIR="$value"; fi ;;
            FFX_SCRATCH_DIR|FFX_CACHE_DIR|FFX_SKIP_SPACE_CHECK|FFX_SPACE_SAFETY_FACTOR)
                if [[ -n "$value" && -z "${!key:-}" ]]; then printf -v "$key" '%s' "$value"; fi ;;
        esac
    done 2>/dev/null < "$FFX_PATHS_CONF" || true
}
_load_paths_conf

if [[ -n "${FFX_TMP_DIR:-}" && -z "${FFX_SCRATCH_DIR:-}" ]]; then
    FFX_SCRATCH_DIR="$FFX_TMP_DIR"
fi

if [[ -d "/Nas/tmp" && -w "/Nas/tmp" ]]; then
    : "${FFX_CACHE_DIR:=/Nas/tmp}"
    : "${FFX_SCRATCH_DIR:=/Nas/tmp}"
else
    : "${FFX_CACHE_DIR:=$XDG_CACHE_HOME/ffx}"
    : "${FFX_SCRATCH_DIR:=${TEMP:-$XDG_RUNTIME_DIR}}"
fi

FFX_RUN_DIR=""
LOG_FILE="$FFX_LOG_DIR/ffx.log"
FFX_CHECKPOINT_DIR="$FFX_CACHE_DIR/checkpoints"
FFX_SEGMENT_CACHE_DIR="$FFX_CHECKPOINT_DIR/_segments"
FFX_PROBE_CACHE_DIR="$FFX_CHECKPOINT_DIR/_probes"

init_session() {
    if [[ -n "${FFX_TMP_DIR:-}" ]]; then
        FFX_SCRATCH_DIR="$FFX_TMP_DIR"
    fi
    FFX_CHECKPOINT_DIR="$FFX_CACHE_DIR/checkpoints"
    FFX_SEGMENT_CACHE_DIR="$FFX_CHECKPOINT_DIR/_segments"
    FFX_PROBE_CACHE_DIR="$FFX_CHECKPOINT_DIR/_probes"
    mkdir -p -- "$FFX_SCRATCH_DIR" 2>/dev/null || {
        if [[ "$FFX_SCRATCH_DIR" == "/Nas/tmp" ]]; then
            warn "Scratch directory '/Nas/tmp' unavailable; falling back to '${TMPDIR:-/tmp}'."
            FFX_SCRATCH_DIR="${TMPDIR:-/tmp}"
            mkdir -p -- "$FFX_SCRATCH_DIR" || die "Cannot create scratch directory: $FFX_SCRATCH_DIR"
        else
            die "Cannot create scratch directory: $FFX_SCRATCH_DIR (use --tmp-dir <dir> or set FFX_TMP_DIR to choose a writable path)"
        fi
    }
    FFX_RUN_DIR=$(umask 077; mktemp -d -p "$FFX_SCRATCH_DIR" ffx.XXXXXXXX) || die "Cannot create private session in $FFX_SCRATCH_DIR"
    trap cleanup_all EXIT
    FFX_WORKER_PID=""
    FFX_LOG_PID=""
    FFX_CAPTURE_PID=""
    trap 'terminate_session 130' INT
    trap 'terminate_session 143' TERM
    trap 'terminate_session 129' HUP
    if [[ "$DRY_RUN" == true ]]; then
        FFX_CHECKPOINT_DIR="$FFX_RUN_DIR/checkpoints"
        FFX_SEGMENT_CACHE_DIR="$FFX_CHECKPOINT_DIR/_segments"
        FFX_PROBE_CACHE_DIR="$FFX_CHECKPOINT_DIR/_probes"
        LOG_FILE="$FFX_RUN_DIR/ffx.log"
    else
        mkdir -p -- "$FFX_CONFIG_DIR" "$FFX_LOG_DIR" "$FFX_CACHE_DIR" "$FFX_CHECKPOINT_DIR" "$FFX_SEGMENT_CACHE_DIR" "$FFX_PROBE_CACHE_DIR" || die "Cannot initialize FFX directories"
        exec {FFX_CACHE_LOCK_FD}>"$FFX_CACHE_DIR/.ffx.lock" || die "Cannot open cache lease"
        flock -s -w 30 "$FFX_CACHE_LOCK_FD" || die "Cannot acquire cache lease"
    fi
}

# =============================================================================
# CLEANUP & TRAP
# =============================================================================
# register_cleanup MODE PATH: records a path OUTSIDE $FFX_RUN_DIR that
# cleanup_all() must reclaim on every exit (normal, die(), INT/TERM/HUP).
# File-backed (not an in-memory array) because get_default_filename() and
# ensure_unique_output() are invoked inside $(...) subshells, where an array
# append would be lost. MODE:
#   empty  — remove PATH only if it is still zero bytes (a reserved-but-never-
#            written output name; a completed output is never touched)
#   always — remove PATH unconditionally (a sibling temp file that was never
#            renamed into place)
register_cleanup() {
    [[ -d "${FFX_RUN_DIR:-}" ]] || return 0
    printf '%s\0%s\0' "$1" "$2" >> "$FFX_RUN_DIR/cleanup.list" 2>/dev/null || true
}

cleanup_all() {
    local mode path
    if [[ -f "${FFX_RUN_DIR:-}/cleanup.list" ]]; then
        while IFS= read -r -d '' mode && IFS= read -r -d '' path; do
            case "$mode" in
                always) rm -f -- "$path" 2>/dev/null || true ;;
                empty)  if [[ -e "$path" && ! -s "$path" ]]; then rm -f -- "$path" 2>/dev/null || true; fi ;;
            esac
        done < "$FFX_RUN_DIR/cleanup.list"
    fi
    if [[ -d "${FFX_RUN_DIR:-}" ]]; then rm -rf -- "$FFX_RUN_DIR"; fi
    return 0
}

terminate_session() {
    local status="$1"
    trap - INT TERM HUP
    if [[ -n "${FFX_CAPTURE_PID:-}" ]]; then
        pkill -TERM -P "$FFX_CAPTURE_PID" 2>/dev/null || true
        kill -TERM "$FFX_CAPTURE_PID" 2>/dev/null || true
        wait "$FFX_CAPTURE_PID" 2>/dev/null || true
    fi
    if [[ -n "${FFX_WORKER_PID:-}" ]]; then
        pkill -TERM -P "$FFX_WORKER_PID" 2>/dev/null || true
        kill -TERM -- "-$FFX_WORKER_PID" 2>/dev/null || kill -TERM "$FFX_WORKER_PID" 2>/dev/null || true
        wait "$FFX_WORKER_PID" 2>/dev/null || true
    fi
    if [[ -n "${FFX_LOG_PID:-}" ]]; then
        kill "$FFX_LOG_PID" 2>/dev/null || true
        wait "$FFX_LOG_PID" 2>/dev/null || true
    fi
    exit "$status"
}

# Interruptible replacement for command substitutions that execute media workers.
capture_value() {
    local destination="$1" capture_file capture_status=0
    shift
    capture_file=$(mktemp_ffx .capture) || return 1
    (
        FFX_CAPTURE_PID=""
        trap 'terminate_session 130' INT
        trap 'terminate_session 143' TERM
        trap 'terminate_session 129' HUP
        "$@"
    ) > "$capture_file" <&0 &
    FFX_CAPTURE_PID=$!
    wait "$FFX_CAPTURE_PID" || capture_status=$?
    FFX_CAPTURE_PID=""
    ((capture_status==0)) || return "$capture_status"
    printf -v "$destination" '%s' "$(<"$capture_file")"
}

mktemp_ffx() { mktemp -p "$FFX_RUN_DIR" --suffix="${1:-.tmp}"; }

# =============================================================================
# CANVAS CONSTANTS  (16:9 master — per user spec)
# =============================================================================
readonly CANVAS_W=1920
readonly CANVAS_H=1080
readonly IMAGE_DURATION=5

# =============================================================================
# DEFAULTS & CONFIGURATION
# =============================================================================
is_nonneg_int() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

default_config() {
    ADVANCED_MODE=false
    VERBOSE_MODE=false
    DRY_RUN=false
    BULK_MODE=false
    REMOVE_AUDIO=false
    COMPOSITE_MODE=false
    MAX_1080=false
    INTERPOLATE=false
    GLOBAL_OUTPUT_FILE=""
    LAYOUT_MODE="fixed"

    OUTPUT_DIR="$(pwd)"
    SPECIFIC_FPS=""
    PTS_FACTOR=""
    BATCH_SIZE=0

    # FFX_TIMEOUT is now explicitly documented as the PER-OPERATION budget for
    # a single ffmpeg invocation acting on ONE input file (process/filter/slowmo/
    # looperang/etc). It is no longer applied unscaled to operations whose cost
    # scales with input count (bulk merge/composite concat) — see
    # compute_batch_timeout() and FFX_TIMEOUT_PER_FILE below.
    FFX_TIMEOUT="${FFX_TIMEOUT:-300}"

    # FFX_TIMEOUT_PER_FILE: per-input budget used to SCALE the timeout for any
    # operation whose total ffmpeg work grows with the number of files being
    # concatenated/composited. A 50-file merge gets 50x this value as its ceiling
    # instead of inheriting the single-file FFX_TIMEOUT and guaranteeing failure.
    FFX_TIMEOUT_PER_FILE="${FFX_TIMEOUT_PER_FILE:-60}"

    # FFX_RETRY: number of automatic retries on a transient (non-timeout) ffmpeg
    # failure before run_ffmpeg gives up and returns 1. EAFP: attempt the real
    # operation, and on failure, retry the operation itself rather than trying to
    # pre-validate every condition that could have caused it.
    FFX_RETRY="${FFX_RETRY:-1}"

    # FFX_AUDIO_RATE: the single sample rate every merged segment's audio is
    # normalised to. The concat demuxer (-f concat -c copy) cannot reconcile
    # segments whose AAC sample rate/channel count differ: it applies the first
    # segment's parameters to all of them, so later segments play at the wrong
    # speed/pitch or are dropped (verified live: 44.1k + 48k segments produced
    # 14.2s of audio against 13.0s of video). Override only if the whole
    # library is known to share another rate.
    FFX_AUDIO_RATE="${FFX_AUDIO_RATE:-48000}"

    ADV_CONTAINER="mp4"
    ADV_RES="${CANVAS_W}x${CANVAS_H}"
    ADV_FPS="60"
    ADV_CODEC="libx264"
    ADV_PIX_FMT="yuv420p"
    ADV_CRF="18"
    ADV_BR="10M"
    ADV_PRESET="medium"
    ADV_MULTIPASS="false"
    ADV_QUALITY_MODE="crf"
    FIX_REFERENCE=""
    FORCE_CFR=false
    CACHE_YES=false
    COMPOSITE_LAYOUT=""
    COMPOSITE_AUDIO=mix
    EXPLICIT_RES=false
    OVERWRITE_OUTPUT=false
    RESUME_MODE=false
}
default_config
REMAINING_ARGS=()


# =============================================================================
# PERSISTENT CONFIG
# =============================================================================
print_defaults() {
    printf '%s\n' \
        "ADV_CONTAINER=$ADV_CONTAINER"       \
        "ADV_RES=$ADV_RES"                   \
        "ADV_FPS=$ADV_FPS"                   \
        "ADV_CODEC=$ADV_CODEC"               \
        "ADV_PIX_FMT=$ADV_PIX_FMT"          \
        "ADV_CRF=$ADV_CRF"                   \
        "ADV_BR=$ADV_BR"                     \
        "ADV_PRESET=$ADV_PRESET"             \
        "ADV_MULTIPASS=$ADV_MULTIPASS"       \
        "ADV_QUALITY_MODE=$ADV_QUALITY_MODE" \
        "LAYOUT_MODE=$LAYOUT_MODE"
}

save_defaults() {
    (
    [[ "$DRY_RUN" != true ]] || return 0
    validate_settings
    local key
    for key in ADV_CONTAINER ADV_RES ADV_FPS ADV_CODEC ADV_PIX_FMT ADV_CRF ADV_BR ADV_PRESET ADV_MULTIPASS ADV_QUALITY_MODE LAYOUT_MODE; do
        [[ "${!key}" != *$'\n'* && "${!key}" != *$'\r'* ]] || die "Multiline default: $key"
    done
    mkdir -p -- "$FFX_CONFIG_DIR" || return 1
    local tmp; tmp=$(mktemp -p "$FFX_CONFIG_DIR" .defaults.XXXXXXXX) || return 1
    trap 'rm -f -- "$tmp"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    print_defaults > "$tmp" && sync -f "$tmp" && mv -f -- "$tmp" "$FFX_DEFAULTS" && sync -f "$FFX_CONFIG_DIR"
    )
}

cmd_config() {
    case "${1:-show}" in
        show) (($# <= 1)) || die "config show takes no operands"; print_defaults ;;
        save) (($# == 1)) || die "config save takes no operands"
            if [[ "$DRY_RUN" == true ]]; then printf '[DRY-RUN] save defaults to %q\n' "$FFX_DEFAULTS" >&2
            else save_defaults || die "Cannot save defaults"; fi ;;
        *) die "config requires show or save" ;;
    esac
}

load_defaults() {
    if [[ ! -f "$FFX_DEFAULTS" && -f "$FFX_CONFIG_DIR/defaults.json" ]]; then
        # The Python revision stored JSON. Read data, never evaluate it as shell.
        command_exists python3 || die "Reading legacy defaults.json requires Python 3"
        local converted
        converted=$(python3 - "$FFX_CONFIG_DIR/defaults.json" <<'PYCONFIG'
import json,sys
with open(sys.argv[1], encoding='utf-8') as stream:
    data=json.load(stream)
if not isinstance(data,dict): raise ValueError('FFX defaults must be an object')
for key,value in data.items():
    if key.startswith('adv_') or key == 'layout_mode':
        if not isinstance(value,(str,int,float,bool)): raise ValueError('Invalid default: '+key)
        value=str(value).lower() if isinstance(value,bool) else str(value)
        if '\n' in value or '\r' in value: raise ValueError('Multiline defaults are invalid')
        print(key.upper()+'='+value)
PYCONFIG
        ) || die "Cannot read legacy defaults.json"
        local key value
        while IFS='=' read -r key value; do
            case "$key" in ADV_CONTAINER|ADV_RES|ADV_FPS|ADV_CODEC|ADV_PIX_FMT|ADV_CRF|ADV_BR|ADV_PRESET|ADV_MULTIPASS|ADV_QUALITY_MODE|LAYOUT_MODE)
                printf -v "$key" '%s' "$value" ;;
            esac
        done <<< "$converted"
        return 0
    fi
    [[ -f "$FFX_DEFAULTS" ]] || return 0
    local key value
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        case "$key" in ADV_CONTAINER|ADV_RES|ADV_FPS|ADV_CODEC|ADV_PIX_FMT|ADV_CRF|ADV_BR|ADV_PRESET|ADV_MULTIPASS|ADV_QUALITY_MODE|LAYOUT_MODE)
            [[ -z "$value" ]] || printf -v "$key" '%s' "$value" ;;
        esac
    done < "$FFX_DEFAULTS"
    return 0
}

# =============================================================================
# DEPENDENCY MANAGEMENT
# =============================================================================
command_exists() { command -v "$1" >/dev/null 2>&1; }

_try_install() {
    local pkg="$1"
    if command_exists pacman;  then sudo pacman -S --noconfirm --needed "$pkg" 2>/dev/null && return 0; fi
    if command_exists apt-get; then sudo apt-get install -y "$pkg" 2>/dev/null && return 0; fi
    if command_exists dnf;     then sudo dnf install -y "$pkg" 2>/dev/null && return 0; fi
    if command_exists zypper;  then sudo zypper install -y "$pkg" 2>/dev/null && return 0; fi
    if command_exists brew;    then brew install "$pkg" 2>/dev/null && return 0; fi
    return 1
}

check_deps() {
    local dep missing=""
    for dep in ffmpeg ffprobe awk timeout sha256sum flock; do
        type -P "$dep" >/dev/null 2>&1 || missing+=" $dep"
    done
    if [[ -n "$missing" ]]; then
        if [[ "${FFX_AUTO_INSTALL:-false}" == true && "$DRY_RUN" != true ]]; then
            local -a packages=(); IFS=' ' read -r -a packages <<< "$missing"
            for dep in "${packages[@]}"; do
                case "$dep" in ffprobe) _try_install ffmpeg ;; timeout|sha256sum) _try_install coreutils ;; awk) _try_install gawk ;; *) _try_install "$dep" ;; esac || true
            done
        fi
        for dep in ffmpeg ffprobe awk timeout sha256sum flock; do
            type -P "$dep" >/dev/null 2>&1 || die "Required command unavailable: $dep. Install dependencies, or explicitly enable FFX_AUTO_INSTALL=true."
        done
    fi
}

# =============================================================================
# PATH & SIZE UTILITIES
# =============================================================================
absolute_path() {
    readlink -f "$1" 2>/dev/null \
        || realpath "$1" 2>/dev/null \
        || ( cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")" )
}

bytes_to_human() {
    awk -v b="${1:-0}" 'BEGIN{
        split("B KiB MiB GiB",u); i=1
        while(b>=1024 && i<4){b/=1024; i++}
        printf "%.2f %s\n", b, u[i]
    }'
}

# _reserve_unique DIR BASE EXT FIRST: NEW shared core of get_default_filename()
# and ensure_unique_output(). Atomically reserves the first free name in the
# sequence FIRST, DIR/BASE_1.EXT, DIR/BASE_2.EXT, ... and prints it.
#
# Closes two defects in the loops it replaces. (1) NON-TERMINATION: when the
# create itself was refused (missing directory, read-only filesystem, no
# permission, disk full) the old `while ! ( set -C; : > "$candidate" )` loop
# treated every refusal as "name taken" and counted upward forever, hanging
# the run on e.g. `-o /no/such/dir/out.mp4`. A failed reservation is a NAME
# collision only if something already exists at that path; otherwise no
# later name can succeed and the call dies with the real cause. (2) LEAK: a
# reserved-but-never-written name (run interrupted, ffmpeg failed before
# writing) was left behind as a 0-byte file; it is now registered with
# cleanup_all() in `empty` mode, which only ever removes it while it is still
# zero bytes. The output directory is created on demand (EAFP: mkdir -p).
_reserve_unique() {
    local dir="$1" base="$2" ext="$3" candidate="$4" n=1
    local suffix=""
    [[ -n "$ext" ]] && suffix=".${ext}"
    mkdir -p -- "$dir" 2>/dev/null || die "Cannot create output directory '$dir'."
    # Atomic reservation: noclobber (set -C) is scoped to the subshell only,
    # so it never leaks into unrelated redirects (e.g. run_ffmpeg's log
    # truncation). Two overlapping ffx invocations cannot both win one name.
    while ! ( set -C; : > "$candidate" ) 2>/dev/null; do
        if [[ ! -e "$candidate" && ! -L "$candidate" ]]; then
            die "Cannot create output file '$candidate' (directory not writable, read-only, or filesystem full)."
        fi
        candidate="${dir}/${base}_${n}${suffix}"
        (( n++ )) || true
    done
    register_cleanup empty "$candidate"
    printf '%s' "$candidate"
}

get_default_filename() {
    local base="${1:-out}" suffix="${2:-tmp}" ext="${3:-mp4}"
    local candidate="${OUTPUT_DIR}/${base}_${suffix}.${ext}" n=1

    if [[ "$DRY_RUN" == true ]]; then
        # Dry-run never writes anything, so there is nothing to atomically
        # reserve against; a plain existence check is correct here and
        # avoids leaving stray 0-byte files behind from a run that
        # explicitly promised not to touch the filesystem.
        while [[ -e "$candidate" ]]; do
            candidate="${OUTPUT_DIR}/${base}_${suffix}_${n}.${ext}"
            (( n++ )) || true
        done
        printf '%s' "$candidate"
        return 0
    fi

    # Atomically reserve the name via noclobber redirection in a subshell
    # (set -C is scoped to the subshell only, so it never leaks out and
    # affects unrelated redirects elsewhere in the script, e.g. run_ffmpeg's
    # log-file truncation). This closes the check-then-act race in the old
    # `while [[ -e "$candidate" ]]` scan: two overlapping ffx invocations
    # (or anything else creating a file at the scanned path in the window
    # between the check and the later ffmpeg write, which used to be the
    # only actual consumer of this path) could previously compute the
    # identical "next free" name and one would silently clobber the
    # other's output. Reserving the file the instant it's confirmed free
    # means the name belongs to this call from that moment on: any
    # concurrent caller's scan will see it already exists and move on to
    # the next candidate instead of colliding with it.
    if [[ -f "$candidate" && ! -s "$candidate" ]]; then
        rm -f -- "$candidate" 2>/dev/null || true
    fi
    _reserve_unique "$OUTPUT_DIR" "${base}_${suffix}" "$ext" "$candidate"
}

# ensure_unique_output(): the explicit-path counterpart to
# get_default_filename(). Every command previously applied the ascending
# _1, _2, ... non-overwrite guarantee ONLY when -o/--output was omitted;
# an explicitly-named destination went straight into ffmpeg's own -y flag,
# i.e. always overwrote silently regardless of what was already there. That
# was an inconsistent guarantee -- "never overwrites" only held sometimes --
# not a deliberate exception for explicit paths. This applies the identical
# atomic-reservation scheme to an explicit path: if it's free, it's reserved
# and returned unchanged (the common case); if something already exists
# there, ascending _N suffixes are inserted before the extension (mirroring
# get_default_filename()'s naming convention) until a free, reserved name is
# found. Same dry-run carve-out as get_default_filename(), for the same
# reason: dry-run must never touch the filesystem.
ensure_unique_output() {
    local requested="$1"
    [[ -z "$requested" ]] && { printf '%s' "$requested"; return 0; }

    local dir base ext fname
    dir="$(dirname -- "$requested")"
    fname="$(basename -- "$requested")"
    if [[ "$fname" == *.* && "$fname" != .* ]]; then
        base="${fname%.*}"
        ext="${fname##*.}"
    else
        base="$fname"
        ext=""
    fi

    local candidate="$requested" n=1

    if [[ "${OVERWRITE_OUTPUT:-false}" == true ]]; then
        if [[ "$DRY_RUN" != true ]]; then
            mkdir -p -- "$dir" 2>/dev/null || die "Cannot create output directory '$dir'."
            if [[ ! -e "$candidate" ]]; then
                : > "$candidate" 2>/dev/null || die "Cannot create output file '$candidate'."
                register_cleanup empty "$candidate"
            fi
        fi
        printf '%s' "$candidate"
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        while [[ -e "$candidate" && -s "$candidate" ]]; do
            if [[ -n "$ext" ]]; then
                candidate="${dir}/${base}_${n}.${ext}"
            else
                candidate="${dir}/${base}_${n}"
            fi
            (( n++ )) || true
        done
        printf '%s' "$candidate"
        return 0
    fi

    if [[ -f "$candidate" && ! -s "$candidate" ]]; then
        rm -f -- "$candidate" 2>/dev/null || true
    fi

    _reserve_unique "$dir" "$base" "$ext" "$candidate"
}

fzf_pick() {
    command_exists fzf || die "fzf is not installed. Install it for interactive file selection."
    local -a sel
    mapfile -t sel < <(fzf --multi)
    (( ${#sel[@]} > 0 )) || die "No selection made."
    printf '%s\n' "${sel[@]}"
}

apply_bulk_glob() {
    local dir="$1"
    find "$dir" -maxdepth 1 -type f \( \
        -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.mov' \
        -o -iname '*.avi' -o -iname '*.webm' -o -iname '*.gif' \
        -o -iname '*.ts'  -o -iname '*.m4v' \) -print
}

shuffle_files() {
    local -n _sf="$1"
    if command_exists shuf && [[ -z "${FFX_RANDOM_SEED:-}" ]]; then
        mapfile -t _sf < <(printf '%s\n' "${_sf[@]}" | shuf)
    else
        local i j tmp n="${#_sf[@]}"
        for (( i=n-1; i>0; i-- )); do
            j=$(( RANDOM % (i+1) ))
            tmp="${_sf[$i]}"; _sf[$i]="${_sf[$j]}"; _sf[$j]="$tmp"
        done
    fi
}

is_image() {
    local ext="${1##*.}"
    case "${ext,,}" in
        jpg|jpeg|png|bmp|gif|webp|tif|tiff) return 0 ;;
        *) return 1 ;;
    esac
}

has_audio() {
    ffprobe -v error -select_streams a -show_entries stream=index \
        -of csv=p=0 "$1" 2>/dev/null | grep -q .
}

