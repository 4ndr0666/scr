FFX_VERSION="8.8.0"
FFX_SEGMENT_LINES="${FFX_SEGMENT_LINES:-500}"
FFX_MANIFEST_DIR="$FFX_CACHE_DIR/manifests"

hash_file() { sha256sum "$1" | awk '{print $1}'; }

generate_manifest() {
    local src="$1" ts overall tmpdir
    command_exists sha256sum || die "sha256sum required for manifest generation."
    command_exists split    || die "split required for manifest generation."
    [[ "$FFX_SEGMENT_LINES" =~ ^[1-9][0-9]{0,5}$ ]] || die "FFX_SEGMENT_LINES must be a positive bounded integer"
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    overall="$(hash_file "$src")"
    tmpdir="$(mktemp -d -p "$FFX_RUN_DIR" ffx_manifest.XXXXXX)"
    split -l "$FFX_SEGMENT_LINES" "$src" "$tmpdir/seg_"
    printf '{\n'
    printf '  "version": "%s",\n'        "$FFX_VERSION"
    printf '  "timestamp": "%s",\n'      "$ts"
    printf '  "overall_sha256": "%s",\n' "$overall"
    printf '  "segment_kind": "legacy_line_transport_only",\n'
    printf '  "segments": {\n'
    local first=true idx=0
    for seg in "$tmpdir"/seg_*; do
        local h; h="$(hash_file "$seg")"
        [[ "$first" == true ]] || printf ',\n'
        first=false
        printf '    "%d": "%s"' "$idx" "$h"
        idx=$(( idx + 1 ))
    done
    printf '\n  }\n}\n'
    rm -rf "$tmpdir"
}

save_manifest() {
    command_exists jq || die "jq is required for manifest JSON validation"
    [[ "$DRY_RUN" != true ]] || { printf '[DRY-RUN] manifest save\n'; return 0; }
    mkdir -p "$FFX_MANIFEST_DIR"
    local out="$FFX_MANIFEST_DIR/${FFX_VERSION}.json" tmp
    tmp=$(mktemp -p "$FFX_MANIFEST_DIR" .manifest.XXXXXXXX) || return 1
    register_cleanup always "$tmp"
    generate_manifest "${BASH_SOURCE[0]}" > "$tmp" || return 1
    jq -e '.overall_sha256 and .segments' "$tmp" >/dev/null || return 1
    if [[ -f "$out" ]] && diff -q <(jq -S 'del(.timestamp)' "$out") <(jq -S 'del(.timestamp)' "$tmp") >/dev/null; then
        say "Manifest unchanged: $out"
        return 0
    fi
    mv -f -- "$tmp" "$out"
    say "Manifest saved: $out"
}

verify_superset() {
    command_exists jq || die "jq is required for manifest JSON validation"
    local canon="$FFX_MANIFEST_DIR/${FFX_VERSION}.json" tmp
    [[ -f "$canon" ]] || die "No canonical manifest; run 'ffx manifest save' explicitly"
    tmp=$(mktemp_ffx .json)
    generate_manifest "${BASH_SOURCE[0]}" > "$tmp" || return 1
    jq -e '.overall_sha256 and .segments' "$canon" >/dev/null || die "Invalid canonical manifest JSON"
    diff -q <(jq -S 'del(.timestamp)' "$canon") <(jq -S 'del(.timestamp)' "$tmp") >/dev/null || die "INTEGRITY FAILURE: source bytes or segment policy differ from the saved manifest"
    say "Byte integrity verified: ${FFX_VERSION} (not semantic or production certification)"
}

cmd_manifest() {
    local action="${1:-show}"
    case "$action" in
        save)   save_manifest ;;
        verify) verify_superset ;;
        show)   generate_manifest "${BASH_SOURCE[0]}" ;;
        *)      die "manifest: unknown action '$action'. Use: save | verify | show" ;;
    esac
}

# =============================================================================
# ADVANCED INTERACTIVE PROMPT
# =============================================================================
advanced_prompt() {
    [[ "$ADVANCED_MODE" != true ]] && return 0
    printf '%b* Advanced Mode%b -- press Enter to keep current value.\n' "${CYAN}${BOLD}" "${RESET}"
    local inp

    read -r -p "Container [mp4/mkv/mov] (${ADV_CONTAINER}): " inp
    [[ -n "$inp" ]] && ADV_CONTAINER="$inp"

    read -r -p "Resolution e.g. 1920x1080 (${ADV_RES}): " inp
    if [[ -n "$inp" ]]; then
        [[ "$inp" =~ ^[0-9]+x[0-9]+$ ]] && ADV_RES="$inp" \
            || warn "Invalid resolution; keeping ${ADV_RES}."
    fi

    read -r -p "Frame rate [24/30/60/120] (${ADV_FPS}): " inp
    if [[ -n "$inp" ]]; then
        [[ "$inp" =~ ^[0-9]+(\.[0-9]+)?$ ]] && ADV_FPS="$inp" \
            || warn "Invalid FPS; keeping ${ADV_FPS}."
    fi

    read -r -p "Codec [libx264/libx265] (${ADV_CODEC}): " inp
    [[ -n "$inp" ]] && ADV_CODEC="$inp"

    read -r -p "Pixel format [yuv420p/yuv422p] (${ADV_PIX_FMT}): " inp
    [[ -n "$inp" ]] && ADV_PIX_FMT="$inp"

    read -r -p "Encoder preset [ultrafast/fast/medium/slow] (${ADV_PRESET}): " inp
    [[ -n "$inp" ]] && ADV_PRESET="$inp"

    read -r -p "Layout mode [fixed/random] (${LAYOUT_MODE}): " inp
    if [[ -n "$inp" ]]; then
        case "${inp,,}" in
            fixed|random) LAYOUT_MODE="${inp,,}" ;;
            *) warn "Invalid layout mode; keeping ${LAYOUT_MODE}." ;;
        esac
    fi

    read -r -p "Quality mode [crf/qp0] (${ADV_QUALITY_MODE}): " inp
    if [[ -n "$inp" ]]; then
        case "${inp,,}" in
            crf) ADV_QUALITY_MODE="crf" ;;
            qp0) ADV_QUALITY_MODE="qp0" ;;
            *)   warn "Invalid quality mode; keeping ${ADV_QUALITY_MODE}." ;;
        esac
    fi

    if [[ "$ADV_QUALITY_MODE" == "crf" ]]; then
        read -r -p "CRF 0-51 — 18=near-lossless, 23=default (${ADV_CRF}): " inp
        if [[ -n "$inp" ]]; then
            [[ "$inp" =~ ^[0-9]+$ ]] && (( inp >= 0 && inp <= 51 )) \
                && ADV_CRF="$inp" || warn "CRF must be 0-51; keeping ${ADV_CRF}."
        fi
        read -r -p "Bitrate e.g. 10M (${ADV_BR}): " inp
        if [[ -n "$inp" ]]; then
            [[ "$inp" =~ ^[0-9]+[kKmMgG]?$ ]] && ADV_BR="$inp" \
                || warn "Invalid bitrate; keeping ${ADV_BR}."
        fi
        read -r -p "Multi-pass? (y/N): " inp
        [[ "${inp,,}" =~ ^y ]] && ADV_MULTIPASS="true" || ADV_MULTIPASS="false"
    else
        ADV_CRF="18"; ADV_BR="10M"; ADV_MULTIPASS="false"
        say "Lossless mode (qp=0): CRF/bitrate/multipass ignored."
    fi

    validate_settings
    save_defaults
    printf '%b[config]%b container=%s res=%s fps=%s codec=%s pix=%s preset=%s layout=%s quality=%s crf=%s\n' \
        "${CYAN}" "${RESET}" \
        "$ADV_CONTAINER" "$ADV_RES" "$ADV_FPS" \
        "$ADV_CODEC" "$ADV_PIX_FMT" "$ADV_PRESET" \
        "$LAYOUT_MODE" "$ADV_QUALITY_MODE" "$ADV_CRF"
}
# =============================================================================
# MODULE 1A: FIXED COMPOSITE ENGINE  (v5 deterministic layout)
# Canvas: 1920x1080. Layouts: 1=fullscreen, 2=lossless hstack,
# 3=1top+2bot, 4=2x2 grid. >4 inputs auto-batched by caller.
# =============================================================================
_cell_vf() {
    local cw="$1" ch="$2"
    printf 'scale=%d:%d:flags=lanczos:force_original_aspect_ratio=decrease,pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1' \
        "$cw" "$ch" "$cw" "$ch"
}

build_composite() {
    local output="$1"; shift
    local -a files=("$@")
    local n="${#files[@]}"

    (( n >= 1 )) || die "build_composite: no input files."
    (( n <= 4  )) || die "build_composite: max 4 inputs per frame (got ${n})."
    verbose_log "build_composite: ${n} input(s) -> $(basename "$output")"

    local cw1=$CANVAS_W          ch1=$CANVAS_H
    local cw3t=$CANVAS_W          ch3t=$(( CANVAS_H / 2 ))
    local cw3b=$(( CANVAS_W / 2 )) ch3b=$(( CANVAS_H / 2 ))
    local cw4=$(( CANVAS_W / 2 )) ch4=$(( CANVAS_H / 2 ))

    local -a ff_in=()
    local f; for f in "${files[@]}"; do ff_in+=("-i" "$f"); done

    local fc
    case "$n" in
    1) fc="[0:v]$(_cell_vf "$cw1" "$ch1")[v]" ;;
    2)
        local cp_out; capture_value cp_out composite_pair_lossless "${files[0]}" "${files[1]}" || return 1
        [[ "$DRY_RUN" == true ]] || mv -- "$cp_out" "$output"
        verbose_log "build_composite: 2-input via composite_pair_lossless."
        return 0
        ;;
    3) fc="[0:v]$(_cell_vf "$cw3t" "$ch3t")[s0];[1:v]$(_cell_vf "$cw3b" "$ch3b")[s1];[2:v]$(_cell_vf "$cw3b" "$ch3b")[s2];[s1][s2]hstack=inputs=2[bot];[s0][bot]vstack=inputs=2[v]" ;;
    4) fc="[0:v]$(_cell_vf "$cw4" "$ch4")[s0];[1:v]$(_cell_vf "$cw4" "$ch4")[s1];[2:v]$(_cell_vf "$cw4" "$ch4")[s2];[3:v]$(_cell_vf "$cw4" "$ch4")[s3];[s0][s1]hstack=inputs=2[top];[s2][s3]hstack=inputs=2[bot];[top][bot]vstack=inputs=2[v]" ;;
    esac
    if [[ "$COMPOSITE_LAYOUT" == vertical3 && "$n" == 3 ]]; then
        fc="[0:v]$(_cell_vf "$CANVAS_W" "$((CANVAS_H/3))")[s0];[1:v]$(_cell_vf "$CANVAS_W" "$((CANVAS_H/3))")[s1];[2:v]$(_cell_vf "$CANVAS_W" "$((CANVAS_H/3))")[s2];[s0][s1][s2]vstack=inputs=3[v]"
    fi

    local -a enc
    if [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]]; then
        enc=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "$ADV_PRESET")
    else
        enc=("-c:v" "$ADV_CODEC" "-crf" "${ADV_CRF:-18}" "-preset" "$ADV_PRESET")
    fi

    local -a aopts=(-an)
    if [[ "$REMOVE_AUDIO" != true ]]; then
        local ai audio_fc=""
        for ((ai=0; ai<n; ai++)); do audio_fc+="[${ai}:a:0]"; done
        if [[ "$COMPOSITE_AUDIO" == merge ]]; then
            fc+=";${audio_fc}amerge=inputs=${n}[aout]"
            aopts=(-map '[aout]' -c:a aac -ar "$FFX_AUDIO_RATE")
        else
            fc+=";${audio_fc}amix=inputs=${n}:duration=longest:normalize=1[aout]"
            aopts=(-map "[aout]" -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
        fi
    fi

    run_ffmpeg --ffx-output "$output" -y \
        "${ff_in[@]}" \
        -filter_complex "$fc" \
        -map "[v]" "${aopts[@]}" \
        "${enc[@]}" \
        -pix_fmt "$ADV_PIX_FMT" -r "${SPECIFIC_FPS:-$ADV_FPS}" -video_track_timescale 90000 \
        -movflags +faststart \
        "$output" \
        || die "build_composite(${n}): ffmpeg failed." "$output"

    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || die "Composite output is unreadable; no input-dropping fallback is permitted." "$output"
    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || die "build_composite: moov atom missing in '$(basename "$output")'"
    verbose_log "build_composite: complete -> $(basename "$output")"
}

composite_pair_lossless() {
    local file1="$1" file2="$2"
    local out; out="$(mktemp_ffx .mp4)"

    local h1=0 h2=0 w1=0 w2=0
    IFS=' ' read -r w1 h1 < <(probe_wh "$file1")
    IFS=' ' read -r w2 h2 < <(probe_wh "$file2")

    h1="${h1:-0}"; h2="${h2:-0}"
    [[ "$h1" =~ ^[0-9]+$ ]] || h1=0
    [[ "$h2" =~ ^[0-9]+$ ]] || h2=0
    local mh=$(( h1 > h2 ? h1 : h2 ))
    (( mh > 0 )) || mh=$CANVAS_H
    verbose_log "composite_pair_lossless: canvas height=${mh}"

    local fc
    fc="[0:v]scale=-2:${mh}:flags=lanczos,setsar=1[v0];"
    fc+="[1:v]scale=-2:${mh}:flags=lanczos,setsar=1[v1];"
    fc+="[v0][v1]hstack=inputs=2[vout]"

    local -a args=("-y" "-i" "$file1" "-i" "$file2")
    local audio_streams=0 audio_fc=""

    if [[ "$REMOVE_AUDIO" == false ]]; then
        if ffprobe -v error -select_streams a -show_entries stream=index \
                -of csv=p=0 "$file1" 2>/dev/null | grep -q .; then
            audio_fc+="[0:a]"; (( audio_streams++ )) || true
        fi
        if ffprobe -v error -select_streams a -show_entries stream=index \
                -of csv=p=0 "$file2" 2>/dev/null | grep -q .; then
            audio_fc+="[1:a]"; (( audio_streams++ )) || true
        fi
    fi

    if (( audio_streams > 0 )); then
        if [[ "$COMPOSITE_AUDIO" == merge ]]; then
            fc+=";${audio_fc}amerge=inputs=${audio_streams}[aout]"
            args+=(-filter_complex "$fc" -map '[vout]' -map '[aout]' -c:a aac -ar "$FFX_AUDIO_RATE")
        else
            fc+=";${audio_fc}amix=inputs=${audio_streams}:duration=longest:normalize=1[aout]"
            args+=("-filter_complex" "$fc" "-map" "[vout]" "-map" "[aout]" "-c:a" "aac" "-ar" "$FFX_AUDIO_RATE" "-ac" "2")
        fi
    else
        args+=("-filter_complex" "$fc" "-map" "[vout]" "-an")
    fi

    args+=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "$ADV_PRESET" "-r" "${SPECIFIC_FPS:-$ADV_FPS}" "-video_track_timescale" "90000" "-movflags" "+faststart" "$out")
    run_ffmpeg --ffx-output "$out" "${args[@]}" || die "composite_pair_lossless: ffmpeg failed." "$out"
    printf '%s' "$out"
}

# =============================================================================
# MODULE 1B: RANDOM COMPOSITE ENGINE  (AR fitness layout selection)
# =============================================================================
cell_vf() {
    local cw="$1" ch="$2" fps="${SPECIFIC_FPS:-$ADV_FPS}"
    is_nonneg_int "$cw" && is_nonneg_int "$ch" && ((cw>0 && ch>0)) && is_positive_rate "$fps" || return 1
    printf 'fps=%s,setpts=PTS-STARTPTS,scale=%d:%d:flags=lanczos:force_original_aspect_ratio=decrease,pad=%d:%d:-1:-1:color=black,setsar=1' \
        "$fps" "$cw" "$ch" "$cw" "$ch"
}

ar_score() {
    awk -v vw="$1" -v vh="$2" -v cw="$3" -v ch="$4" '
        BEGIN {
            if (vw<=0||vh<=0||cw<=0||ch<=0) { print 0; exit }
            r = (vw/vh) / (cw/ch)
            if (r<1) r=1/r
            printf "%d", int(100/r)
        }'
}

readonly _AWK_SORT_BY_AR='
    { idx[NR]=$1; ar[NR]=$2/$3; n=NR }
    END {
        for (i=2;i<=n;i++) {
            ki=idx[i]; ka=ar[i]; j=i-1
            while(j>=1&&ar[j]>ka){idx[j+1]=idx[j];ar[j+1]=ar[j];j--}
            idx[j+1]=ki; ar[j+1]=ka
        }
        for(k=1;k<=n;k++) printf "%d ",idx[k]
    }'

declare -a L_IDS=() L_SLOTS=() L_FC=()

L_IDS+=("fullscreen");   L_SLOTS+=("1920:1080");
L_FC+=('[0:v]CELL0[v]')

L_IDS+=("hstack");       L_SLOTS+=("960:1080 960:1080");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[s0][s1]hstack=inputs=2[v]')
L_IDS+=("vstack");       L_SLOTS+=("1920:540 1920:540");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[s0][s1]vstack=inputs=2[v]')

L_IDS+=("top1_bot2");    L_SLOTS+=("1920:540 960:540 960:540");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[s1][s2]hstack=inputs=2[bot];[s0][bot]vstack=inputs=2[v]')
L_IDS+=("top2_bot1");    L_SLOTS+=("960:540 960:540 1920:540");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[s0][s1]hstack=inputs=2[top];[top][s2]vstack=inputs=2[v]')
L_IDS+=("left1_right2"); L_SLOTS+=("960:1080 960:540 960:540");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[s1][s2]vstack=inputs=2[right];[s0][right]hstack=inputs=2[v]')
L_IDS+=("left2_right1"); L_SLOTS+=("960:540 960:540 960:1080");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[s0][s1]vstack=inputs=2[left];[left][s2]hstack=inputs=2[v]')

L_IDS+=("grid2x2");      L_SLOTS+=("960:540 960:540 960:540 960:540");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[3:v]CELL3[s3];[s0][s1]hstack=inputs=2[top];[s2][s3]hstack=inputs=2[bot];[top][bot]vstack=inputs=2[v]')
L_IDS+=("row4");         L_SLOTS+=("480:1080 480:1080 480:1080 480:1080");
L_FC+=('[0:v]CELL0[s0];[1:v]CELL1[s1];[2:v]CELL2[s2];[3:v]CELL3[s3];[s0][s1][s2][s3]hstack=inputs=4[v]')

_LAST_SCORE=0
# _eval_layout(): CHANGED unit (Golden-Unit §3 — bug fix, pre-existing,
# disclosed per protocol; out of original audit scope but found via
# regression testing of the units this audit DID touch).
#
# OLD DIGEST: Builds `slots`, `fi_arr`, `si_arr` via unquoted-expansion word
# splitting — `( ${L_SLOTS[$cidx]} )`, `( $f_order )`, `( $s_order )` — which
# requires the shell's IFS to include a space. This script sets
# `IFS=$'\n\t'` globally at the top of the file (intentional hardening
# against accidental splitting elsewhere), which silently removes space from
# IFS. The practical effect: every one of these three array constructions
# collapses its space-delimited source string into a SINGLE array element
# instead of N elements, so `${#slots[@]}` is always 1 regardless of how many
# slots a layout actually has. This breaks _eval_layout for every layout
# except those whose L_SLOTS entry happens to have exactly one slot.
#
# NEW DIGEST: Same inputs, same scoring algorithm, same outputs (order file,
# _LAST_SCORE) — only the array-construction mechanism changes, from
# IFS-dependent unquoted expansion to explicit `IFS=' ' read -r -a`, which
# splits on space regardless of the shell's ambient IFS setting. Superset:
# every case that worked before (single-slot layouts) still works
# identically; every case that was silently broken before (multi-slot
# layouts) now works correctly.
_eval_layout() {
    local cidx="$1"
    local -n _ev_files="$2"
    local -n _ev_whs="$3"
    local -a slots; IFS=' ' read -r -a slots <<< "${L_SLOTS[$cidx]}"

    ((${#slots[@]} == ${#_ev_files[@]} && ${#_ev_files[@]} == ${#_ev_whs[@]})) || {
        warn "Layout slots must match input and dimension counts"; return 1;
    }

    local f_awk_in="" fidx
    for fidx in "${!_ev_whs[@]}"; do f_awk_in+="${fidx} ${_ev_whs[$fidx]}"$'\n'; done
    local f_order; f_order=$(printf '%s' "$f_awk_in" | awk "$_AWK_SORT_BY_AR") || true

    local s_awk_in="" si sw sh
    for si in "${!slots[@]}"; do
        IFS=':' read -r sw sh <<< "${slots[$si]}"
        s_awk_in+="${si} ${sw} ${sh}"$'\n'
    done
    local s_order; s_order=$(printf '%s' "$s_awk_in" | awk "$_AWK_SORT_BY_AR") || true

    local -a fi_arr; IFS=' ' read -r -a fi_arr <<< "$f_order"
    local -a si_arr; IFS=' ' read -r -a si_arr <<< "$s_order"
    local -a assignment=()
    local total_score=0 fw fh k
    for k in "${!fi_arr[@]}"; do
        fi="${fi_arr[$k]}"
        si="${si_arr[$k]}"
        assignment[$si]=$fi
        IFS=' ' read -r fw fh <<< "${_ev_whs[$fi]}"
        IFS=':' read -r sw sh <<< "${slots[$si]}"
        local sc; sc=$(ar_score "$fw" "$fh" "$sw" "$sh")
        (( total_score += sc )) || true
    done

    _LAST_SCORE=$total_score
    local order_file="$FFX_RUN_DIR/order_${cidx}"; : > "$order_file"
    local n="${#_ev_files[@]}"
    for si in $(seq 0 $(( n-1 ))); do
        printf '%s\n' "${_ev_files[${assignment[$si]}]}" >> "$order_file"
    done
}

_BEST_LAYOUT_IDX=0
declare -a _BEST_FILE_ORDER=()

# select_layout(): CHANGED unit (Golden-Unit §3 — same bug class and same
# fix pattern as _eval_layout above). OLD DIGEST: built `slots` via the same
# IFS-broken unquoted expansion, so `${#slots[@]}` was always 1, meaning
# `cands` (layouts whose slot count equals the input file count) was empty
# for every n > 1 — the only n for which this branch ever populated `cands`
# was n=1 (fullscreen has exactly one slot, and a 1-element unquoted
# expansion accidentally has length 1 even when split incorrectly). This is
# exactly the failure observed empirically: `top_cands` ends up empty,
# `RANDOM % ${#top_cands[@]}` divides by zero, and the command crashes for
# every multi-file random-layout composite batch. NEW DIGEST: same
# candidate-selection and scoring logic, `slots` built via explicit
# `IFS=' ' read -r -a` so its element count is correct regardless of ambient
# IFS. Superset: n=1 still works identically; n=2,3,4 now work instead of
# crashing.
select_layout() {
    local -a _sl_files=("$@")
    local n="${#_sl_files[@]}"
    local -a _sl_whs=()
    for f in "${_sl_files[@]}"; do _sl_whs+=("$(probe_wh "$f")"); done

    local -a cands=() i
    for i in "${!L_IDS[@]}"; do
        local slots; IFS=' ' read -r -a slots <<< "${L_SLOTS[$i]}"
        (( ${#slots[@]} == n )) && cands+=("$i")
    done

    (( ${#cands[@]} > 0 )) || die "select_layout: no layout supports ${n} input(s). Supported counts: 1-4."

    local best_score=-1 cidx
    local -a top_cands=()
    for cidx in "${cands[@]}"; do
        _eval_layout "$cidx" _sl_files _sl_whs
        if (( _LAST_SCORE > best_score )); then
            best_score=$_LAST_SCORE; top_cands=("$cidx")
        elif (( _LAST_SCORE == best_score )); then
            top_cands+=("$cidx")
        fi
    done

    local pick=$(( RANDOM % ${#top_cands[@]} ))
    _BEST_LAYOUT_IDX="${top_cands[$pick]}"

    local last_cand="${cands[-1]}"
    [[ "$_BEST_LAYOUT_IDX" != "$last_cand" ]] && _eval_layout "$_BEST_LAYOUT_IDX" _sl_files _sl_whs

    _BEST_FILE_ORDER=()
    while IFS= read -r line; do _BEST_FILE_ORDER+=("$line"); done < "$FFX_RUN_DIR/order_${_BEST_LAYOUT_IDX}"
}

# build_fc(): CHANGED unit (Golden-Unit §3 — same bug class and fix pattern).
# OLD DIGEST: built `slots` via the same IFS-broken unquoted expansion;
# for any layout with more than one slot, `${slots[$i]}` for i>=1 would be
# unset/empty, producing a malformed or incomplete filter_complex string.
# Combined with select_layout never reaching this function for n>1 (it died
# first), this was unreachable-but-still-broken dead code along the same
# fault line. NEW DIGEST: same filter-complex template substitution, `slots`
# built via explicit `IFS=' ' read -r -a`. Superset.
build_fc() {
    local cidx="$1"; shift
    local -a files=("$@")
    local fc="${L_FC[$cidx]}"
    local -a slots; IFS=' ' read -r -a slots <<< "${L_SLOTS[$cidx]}"
    local i sw sh cvf
    for i in "${!files[@]}"; do
        IFS=':' read -r sw sh <<< "${slots[$i]}"
        cvf="$(cell_vf "$sw" "$sh")"
        fc="${fc//CELL${i}/$cvf}"
    done
    printf '%s' "$fc"
}

# composite_batch(): UNCHANGED logic; run_ffmpeg call site updated to pass
# --ffx-output (so a timeout/failure mid-batch-encode cleans up its own part
# file) and --ffx-timeout via compute_batch_timeout scaled to this batch's
# input count (n is always <=4 here by construction, so this mostly keeps
# parity with the single-file default, but stays correct if MAX batch size
# is ever raised).
composite_batch() {
    local batch_num="$1"; shift
    [[ -z "${FFX_RANDOM_SEED:-}" ]] || RANDOM=$((10#$FFX_RANDOM_SEED+batch_num))
    local -a files=("$@")
    local n="${#files[@]}"
    local part_file; part_file="$FFX_RUN_DIR/part_$(printf '%04d' "$batch_num").mp4"

    select_layout "${files[@]}"
    local cidx="$_BEST_LAYOUT_IDX"
    local -a ordered=("${_BEST_FILE_ORDER[@]}")

    verbose_log "Batch ${batch_num}: layout=${L_IDS[$cidx]} inputs=${n}"

    local dur_mode=$(( RANDOM % 2 ))
    local -a ff_inputs=() dur_flags=()

    if (( dur_mode == 0 )); then
        verbose_log "duration: trim-to-shortest"
        for f in "${ordered[@]}"; do ff_inputs+=(-i "$f"); done
        local min_dur="" d
        for f in "${ordered[@]}"; do
            d="$(probe_duration "$f")"
            min_dur=$(awk -v a="$min_dur" -v b="$d" 'BEGIN{printf "%.6f",(a=="" || b+0<a+0)?b:a}')
        done
        dur_flags=(-t "$min_dur")
    else
        verbose_log "duration: loop-to-longest"
        local max_dur="0" d
        for f in "${ordered[@]}"; do
            d="$(probe_duration "$f")"
            max_dur="$(awk -v a="$max_dur" -v b="$d" 'BEGIN{printf "%.6f",(a+0>b+0)?a:b}')"
        done
        for f in "${ordered[@]}"; do ff_inputs+=(-stream_loop -1 -i "$f"); done
        dur_flags=(-t "$max_dur")
    fi

    local fc; fc="$(build_fc "$cidx" "${ordered[@]}")"

    if [[ "$REMOVE_AUDIO" == false ]]; then
        local a_in=""
        for (( i=0; i<n; i++ )); do a_in+="[${i}:a]"; done
        if [[ "$COMPOSITE_AUDIO" == merge ]]; then
            fc+=";${a_in}amerge=inputs=${n}[aout]"
        else
            fc+=";${a_in}amix=inputs=${n}:duration=longest[aout]"
        fi
    fi

    local -a enc
    if [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]]; then
        enc=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "$ADV_PRESET")
    else
        enc=("-c:v" "$ADV_CODEC" "-crf" "${ADV_CRF:-18}" "-preset" "$ADV_PRESET")
    fi

    local -a audio_args=()
    if [[ "$REMOVE_AUDIO" == false ]]; then
        audio_args=("-map" "[aout]" "-c:a" "aac" "-b:a" "192k" "-ar" "$FFX_AUDIO_RATE")
        [[ "$COMPOSITE_AUDIO" == merge ]] || audio_args+=(-ac 2)
    fi

    local fps="${SPECIFIC_FPS:-$ADV_FPS}"
    local batch_to; batch_to="$(compute_batch_timeout "$n")"
    run_ffmpeg --ffx-timeout "$batch_to" --ffx-output "$part_file" -y \
        "${ff_inputs[@]}" \
        -filter_complex "$fc" \
        -map "[v]" \
        "${audio_args[@]}" \
        "${enc[@]}" \
        -pix_fmt "$ADV_PIX_FMT" \
        -r "$fps" \
        -max_muxing_queue_size 1024 -video_track_timescale 90000 \
        -movflags +faststart \
        "${dur_flags[@]}" \
        "$part_file" || die "composite_batch: ffmpeg failed." "$part_file"

    printf '%s' "$part_file"
}
# =============================================================================
# CMD: COMPOSITE
#
# cmd_composite(): CHANGED unit (Golden-Unit §3 — superset of prior contract).
#
# OLD DIGEST: Splits corrected inputs into batches of up to 4, calls
# build_composite/composite_batch for each, collecting PART_FILES; on ANY
# batch's ffmpeg failure, die() exits the whole process, discarding every
# already-produced part file via the EXIT trap (cleanup_all wipes
# $FFX_RUN_DIR). Re-running after such a failure reprocesses every batch from
# scratch, including the ones that already succeeded. The final assembly step
# (single ffmpeg concat over all parts when >1 batch) ran under the same flat
# FFX_TIMEOUT as every other call, with no scaling for total batch count.
#
# NEW DIGEST: Same batching, same layout selection, same output contract.
# Adds: (1) each batch's output is checkpointed via checkpoint_set() keyed to
# its exact input file list + current encode settings, so a re-run of the
# same composite job skips any batch whose checkpoint still points at a valid
# part file and only (re)processes the batches that actually failed or were
# never reached; (2) the final concat step's timeout is computed via
# compute_batch_timeout() scaled to total batch count instead of inheriting
# the single-file default; (3) on a hard failure mid-job, the checkpoint job
# directory is left intact (not cleared) specifically so the next invocation
# can resume — checkpoint_clear() is only ever called after a fully successful
# run, per Architectural Gate 4.3 (known-pristine baseline is "no checkpoint,"
# never a partially-undone one).
#
# Superset: every input that produced a valid part file under the old logic
# still does under the new logic; nothing that previously succeeded can now
# fail, and the failure path is strictly better (resumable instead of total
# loss).
# =============================================================================
prepare_composite_input() {
    local PTS_FACTOR="" INTERPOLATE=false
    local f="$1" out w h ac ar ch duration
    if is_image "$f"; then
        IFS=' ' read -r w h < <(probe_wh "$f")
        w=$(( (w+1)/2*2 )); h=$(( (h+1)/2*2 ))
        out=$(mktemp_ffx .mp4)
        merge_image_input "$f" "$out" "$w" "$h" "${SPECIFIC_FPS:-$ADV_FPS}" || return 1
    else
        # Audio preparation must not introduce a lossy video generation or
        # reduce a lossless pair's source bit depth/chroma. Matroska carries
        # the original elementary video stream until the layout filter.
        out=$(mktemp_ffx .mkv)
        IFS=' ' read -r ac ar ch < <(probe_audio_params "$f")
        local -a inputs=() audio=(-an)
        if [[ "$REMOVE_AUDIO" != true ]]; then
            if [[ "$ac" == none ]]; then
                duration=$(probe_duration "$f")
                inputs=(-f lavfi -i "anullsrc=r=$FFX_AUDIO_RATE:cl=stereo")
                audio=(-map 1:a:0 -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2 -t "$duration")
            else
                audio=(-map 0:a:0 -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
            fi
        fi
        run_ffmpeg --ffx-output "$out" -y -fflags +genpts -i "$f" "${inputs[@]}" -map 0:v:0 -c:v copy "${audio[@]}" "$out" || return 1
    fi
    printf '%s' "$out"
}

cmd_composite() {
    advanced_prompt
    local output_base="composite"
    local output="${GLOBAL_OUTPUT_FILE:-}"
    local -a input_files=()
    local no_resume=false resume_requested="${RESUME_MODE:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; input_files+=("$@"); break ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output_base="${2%.*}"; output="$2"; shift 2 ;;
            -B|--batch-size)    [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; [[ "$2" =~ ^[0-9]{1,9}$ ]] || die "Batch size must be a bounded non-negative integer"; BATCH_SIZE="$((10#$2))"; shift 2 ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -r|--resume)        resume_requested=true; shift ;;
            --no-resume)        no_resume=true; shift ;;
            -y|--overwrite)     OVERWRITE_OUTPUT=true; shift ;;
            --layout|--audio-mode) [[ $# -ge 2 ]] || die "Missing $1 operand"; set_composite_option "$1" "$2"; shift 2 ;;
            -*) die "Unknown composite option: $1" ;;
            *)                  input_files+=("$1"); shift ;;
        esac
    done

    if (( ${#input_files[@]} == 0 )) && [[ "$resume_requested" == true ]]; then
        cmd_resume ${output:+-o "$output"}
        return $?
    fi
    (( ${#input_files[@]} == 0 )) && mapfile -t input_files < <(fzf_pick)
    for f in "${input_files[@]}"; do [[ -f "$f" ]] || die "File not found: $f"; done

    local checkpoint_target="${output:-$OUTPUT_DIR/composite_composite.$ADV_CONTAINER}"
    local -a corrected=("${input_files[@]}")

    local legacy_job_sig="${input_files[*]}|${LAYOUT_MODE}|${COMPOSITE_LAYOUT}|${COMPOSITE_AUDIO}|audio-v2|${checkpoint_target}"
    local job_sig; job_sig="$(canonical_job_sig "$checkpoint_target" "${LAYOUT_MODE}|${COMPOSITE_LAYOUT}|${COMPOSITE_AUDIO}|audio-v2" "${input_files[@]}")"
    local job_dir; job_dir="$(checkpoint_job_dir "$job_sig" "$legacy_job_sig")"
    checkpoint_lock "$job_dir"
    [[ "$no_resume" == true ]] && checkpoint_clear "$job_dir"

    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$output_base" "composite" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    preflight_space "$(dirname -- "$output")" 3 "${corrected[@]}"
    job_manifest_save "$job_dir" "composite" "$checkpoint_target" "${#corrected[@]}" 0 "${corrected[@]}"
    if [[ "$LAYOUT_MODE" == random ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            FFX_RANDOM_SEED=1
        else
            mkdir -p -- "$job_dir"
            if [[ ! -s "$job_dir/random-seed" ]]; then printf '%s\n' "$RANDOM" > "$job_dir/random-seed"; fi
            read -r FFX_RANDOM_SEED < "$job_dir/random-seed"
            [[ "$FFX_RANDOM_SEED" =~ ^[0-9]{1,5}$ ]] || die "Invalid saved random layout seed"
        fi
        RANDOM=$((10#$FFX_RANDOM_SEED))
        shuffle_files corrected
    fi

    local total="${#corrected[@]}" idx=0 bnum=1
    local channels=2 capacity=4
    ((BATCH_SIZE <= 0 || BATCH_SIZE > 4)) || capacity=$BATCH_SIZE
    ((total >= capacity)) || capacity=$total
    [[ "$COMPOSITE_AUDIO" != merge ]] || channels=$((capacity*2))
    local -a PART_FILES=()
    local resumed_count=0 fresh_count=0

    while (( idx < total )); do
        local remaining=$(( total - idx ))
        local max_n=$(( remaining < 4 ? remaining : 4 ))
        local n

        if [[ "$LAYOUT_MODE" == "random" ]]; then
            if (( BATCH_SIZE > 0 && BATCH_SIZE <= 4 )); then
                n=$(( remaining < BATCH_SIZE ? remaining : BATCH_SIZE ))
            else
                n=$(( (RANDOM % max_n) + 1 ))
            fi
        else
            if (( BATCH_SIZE > 0 && BATCH_SIZE <= 4 )); then
                n=$(( remaining < BATCH_SIZE ? remaining : BATCH_SIZE ))
            else
                n=$(( max_n ))
            fi
        fi

        local -a batch=()
        for (( j=0; j<n; j++, idx++ )); do batch+=("${corrected[$idx]}"); done

        # checkpoint_key is computed over the batch's own joined file list, plus
        # CRF/codec/pix_fmt/quality-mode (all of which composite's encode path
        # actually uses) — so a batch is only resumed if both its input set and
        # those settings match what produced the checkpointed part file. Note:
        # the key also folds in ADV_RES even though composite's layout engine
        # never reads it (composite targets CANVAS_W/CANVAS_H and per-layout
        # slot sizes); this can cause an unnecessary cache miss if ADV_RES
        # changes between runs with no other change, but never an incorrect
        # resume — composite simply reprocesses fresh in that case.
        local batch_sig
        batch_sig=$(for f in "${batch[@]}"; do checkpoint_key "$f" "$CANVAS_W:$CANVAS_H"; done; printf '%s\n' "$bnum" "$n" "$LAYOUT_MODE")
        local resumed_part=""
        if resumed_part="$(checkpoint_get "$job_dir" "$batch_sig" 2>/dev/null)"; then
            verbose_log "composite: batch ${bnum} resumed from checkpoint -> $(basename "$resumed_part")"
            PART_FILES+=("$resumed_part")
            (( resumed_count++ )) || true
        else
            local -a prepared=()
            local normalized
            for f in "${batch[@]}"; do
                capture_value normalized prepare_composite_input "$f" || die "Cannot prepare composite input: $f"
                prepared+=("$normalized")
            done
            local part_file
            if [[ "$LAYOUT_MODE" == "random" ]]; then
                capture_value part_file composite_batch "$bnum" "${prepared[@]}"
            else
                part_file="$FFX_RUN_DIR/part_$(printf '%04d' "$bnum").mp4"
                build_composite "$part_file" "${prepared[@]}"
            fi
            if ((total>4 || (BATCH_SIZE>0 && total>BATCH_SIZE))) || [[ "$COMPOSITE_AUDIO" == merge && "$LAYOUT_MODE" == random ]]; then
                local consistent; consistent=$(mktemp_ffx .mp4)
                local part_has=false
                has_audio "$part_file" && part_has=true
                PTS_FACTOR="" INTERPOLATE=false merge_encode_input "$part_file" "$consistent" "$CANVAS_W" "$CANVAS_H" "${SPECIFIC_FPS:-$ADV_FPS}" "$part_has" false false "$channels" || die "Cannot normalize composite batch"
                part_file=$consistent
            fi
            local persisted; persisted="$(checkpoint_store_artifact "$job_dir" "$batch_sig" "$part_file")"
            checkpoint_set "$job_dir" "$batch_sig" "$persisted"
            PART_FILES+=("$persisted")
            (( fresh_count++ )) || true
        fi
        job_manifest_save "$job_dir" "composite" "$checkpoint_target" "$total" "$idx" "${corrected[@]}"
        (( bnum++ )) || true
    done

    (( resumed_count > 0 )) && verbose_log "composite: ${resumed_count} batch(es) resumed from prior run, ${fresh_count} processed fresh."

    if [[ "$DRY_RUN" == true ]]; then
        say "[DRY-RUN] Composite: $output"
        return 0
    fi
    if (( ${#PART_FILES[@]} == 1 )); then
        local publish; publish=$(sibling_tmp "$output")
        cp -- "${PART_FILES[0]}" "$publish" && mv -f -- "$publish" "$output" || die "Cannot publish composite" "$output"
    else
        local cl="$FFX_RUN_DIR/concat.txt"
        : > "$cl"
        for pf in "${PART_FILES[@]}"; do concat_add "$cl" "$pf"; done
        local concat_to; concat_to="$(compute_batch_timeout "${#PART_FILES[@]}")"
        run_ffmpeg --ffx-timeout "$concat_to" --ffx-output "$output" \
            -y -f concat -safe 0 -i "$cl" -c copy -movflags +faststart "$output" \
            || die "composite concat failed." "$output"
    fi

    apply_timing "$output" "${#PART_FILES[@]}" || die "Composite timing failed" "$output"
    # Only clear the checkpoint job on a FULLY successful run — this is the
    # "known-pristine baseline" reset point per Architectural Gate 4.3. A
    # failure anywhere above this line leaves the job dir intact for resume.
    checkpoint_clear "$job_dir"

    auto_clean "$output"
    say "Matrix Composited: $output"
}
# =============================================================================
# CMD: MERGE
#
# cmd_merge(): CHANGED unit (Golden-Unit §3 — superset of prior contract).
#
# OLD DIGEST: Probes all inputs; if uniform, does a single ffmpeg concat call
# under FFX_TIMEOUT (flat, unscaled — this IS the exact mechanism behind the
# reported "large batch -> timeout kills the whole process" failure: a concat
# of 50 files takes proportionally longer to probe/mux than a concat of 5, but
# was bound by the identical timeout ceiling). If non-uniform, normalizes each
# input sequentially via its own run_ffmpeg call (also flat FFX_TIMEOUT each),
# collecting temp files into `preprocessed`; ANY single input's failure dies
# the whole command, discarding every already-normalized temp file for the
# inputs processed before it. Final concat (after normalize) also ran under
# the flat timeout.
#
# NEW DIGEST: Same uniformity detection, same fast-path/normalize-path split,
# same per-input non-conformance logic (DTS/moov/codec/pix_fmt/resolution/audio
# checks all unchanged). Adds: (1) fast-path and final concat timeouts are now
# computed via compute_batch_timeout() scaled to input count, so the exact
# failure mode reported — many files, single static timeout, total job
# failure — is structurally closed; (2) the normalize path checkpoints each
# input's successfully-produced temp file, keyed to that input + current
# encode settings, so a failure on file 30-of-50 no longer discards the 29
# already-normalized temp files — re-running the same merge command resumes
# from file 30; (3) the checkpoint job is only cleared after the FINAL concat
# succeeds (Architectural Gate 4.3 — pristine baseline only on full success).
#
# IMPORTANT — v8.2.1 addendum, not a behavior change: the per-input normalize
# run_ffmpeg calls below never pass --ffx-timeout, so they are governed
# solely by FFX_TIMEOUT (--timeout), never by FFX_TIMEOUT_PER_FILE
# (--timeout-per-file). This was always true; run_ffmpeg's message just used
# to claim otherwise (see v8.2.1 changelog entry, top of file). If every
# input in a batch times out here, --timeout is the only knob that helps —
# --timeout-per-file only affects the fast-path/final-concat calls further
# down, which scale with file COUNT, not per-file encode TIME.
#
# Superset: every file set that concatenated successfully under the old logic
# still does; every failure path is now resumable rather than total-loss, and
# the previously-unscaled timeout that caused outright failure on large
# batches no longer applies.

# merge_encode_input FILE OUT W H FPS HAS_AUDIO AUDIO_OK VIDEO_COPY
# NEW unit (extracted from cmd_merge's inline normalise branches so the
# primary pass and the moov re-try run the IDENTICAL command; the old
# moov_fallback re-encoded at the input's own geometry/fps with `-c:a copy`,
# producing a segment that could not be concatenated with its siblings).
# Produces one segment in the common target format:
#   video  W x H @ FPS, ADV_PIX_FMT (or stream-copied when VIDEO_COPY=true)
#   audio  first track only, AAC, FFX_AUDIO_RATE Hz, stereo — copied untouched
#          when AUDIO_OK=true, re-encoded when false, a silent track of the
#          same format synthesised when the input has none. Audio is NEVER
#          dropped unless -an/--remove-audio was given for this invocation.
# Only the first audio track is kept so every segment has the same stream
# layout, which the concat demuxer requires.
merge_encode_input() {
    local f="$1" tmp="$2" w="$3" h="$4" tf="$5" has_aud="$6" aud_ok="$7" vcopy="$8"
    local channels="${9:-2}" audio_filter=""
    local -a vargs=() extra_inputs=() acmd=() enc=()
    if [[ "$vcopy" == true ]]; then
        vargs=("-map" "0:v:0" "-c:v" "copy")
    else
        local scale_vf="scale=${w}:${h}:flags=lanczos:force_original_aspect_ratio=decrease,pad=${w}:${h}:-1:-1:color=black,setsar=1"
        local deint; deint="$(get_deinterlace_filter "$f")"
        local full_vf="$scale_vf"
        if [[ "$deint" != "null" ]]; then full_vf="${deint},${scale_vf}"; fi
        [[ -z "$PTS_FACTOR" ]] || full_vf+=",setpts=${PTS_FACTOR}*(PTS-STARTPTS)"
        [[ "$INTERPOLATE" != true ]] || full_vf+=",$(interpolation_filter "$f" "${PTS_FACTOR:-1}" "$tf")"
        if [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]]; then
            enc=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "ultrafast")
        else
            enc=("-c:v" "$ADV_CODEC" "-crf" "${ADV_CRF:-18}" "-preset" "ultrafast")
        fi
        vargs=("-vf" "$full_vf" "-r" "$tf" "${enc[@]}" "-pix_fmt" "$ADV_PIX_FMT" "-map" "0:v:0")
    fi
    if [[ "$REMOVE_AUDIO" == true ]]; then
        acmd=("-an")
    elif [[ "$has_aud" != true ]]; then
        # anullsrc is a second INPUT: it must be declared before any output
        # option (-vf/-map/...) or ffmpeg applies those options to it.
        extra_inputs=("-f" "lavfi" "-i" "anullsrc=r=${FFX_AUDIO_RATE}:cl=${channels}c")
        acmd=("-map" "1:a:0" "-c:a" "aac" "-ar" "$FFX_AUDIO_RATE" "-ac" "$channels" "-shortest")
    elif [[ "$aud_ok" == true ]]; then
        acmd=("-map" "0:a:0" "-c:a" "copy")
    else
        acmd=("-map" "0:a:0" "-c:a" "aac" "-b:a" "128k" "-ar" "$FFX_AUDIO_RATE" "-ac" "$channels")
        if ((channels>2)); then
            # A shorter final batch keeps its occupied channel slots; remaining
            # slots are silence. Automatic rematrixing would mix those channels.
            local source_channels channel
            source_channels=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of default=nw=1:nk=1 "$f") || return 1
            [[ "$source_channels" =~ ^[1-8]$ ]] && ((source_channels<=channels)) || return 1
            audio_filter="pan=${channels}c"
            for ((channel=0; channel<channels; channel++)); do
                if ((channel<source_channels)); then audio_filter+="|c${channel}=c${channel}"
                else audio_filter+="|c${channel}=0*c0"; fi
            done
        fi
    fi
    if [[ -n "$PTS_FACTOR" && "$REMOVE_AUDIO" != true && "$has_aud" == true ]]; then
        audio_filter="${audio_filter:+$audio_filter,}$(tempo_filter "$PTS_FACTOR")"
        acmd=(-map 0:a:0 -c:a aac -ar "$FFX_AUDIO_RATE" -ac "$channels")
    fi
    [[ -z "$audio_filter" ]] || acmd+=(-af "$audio_filter")
    run_ffmpeg --ffx-output "$tmp" -y -fflags +genpts -i "$f" "${extra_inputs[@]}" \
        "${vargs[@]}" "${acmd[@]}" -video_track_timescale 90000 -movflags +faststart "$tmp"
}

# merge_image_input FILE OUT W H FPS: NEW unit (extracted, see above). A still
# image becomes an IMAGE_DURATION-second segment in the common target format,
# with a silent AAC track at FFX_AUDIO_RATE so it concatenates with real
# audio segments (or no track at all under -an).
merge_image_input() {
    local f="$1" tmp="$2" w="$3" h="$4" tf="$5"
    local duration="$IMAGE_DURATION"
    [[ -z "$PTS_FACTOR" ]] || duration=$(awk -v d="$IMAGE_DURATION" -v f="$PTS_FACTOR" 'BEGIN{print d*f}')
    local scale_vf="scale=${w}:${h}:force_original_aspect_ratio=decrease,pad=${w}:${h}:-1:-1:color=black,setsar=1,fps=${tf},format=${ADV_PIX_FMT}"
    local -a ain=() aout=("-an")
    local -a enc=(-c:v "$ADV_CODEC" -crf "${ADV_CRF:-18}" -preset ultrafast)
    [[ "$ADV_QUALITY_MODE" != qp0 ]] || enc=(-c:v "$ADV_CODEC" -qp 0 -preset ultrafast)
    if [[ "$REMOVE_AUDIO" != true ]]; then
        ain=("-f" "lavfi" "-i" "anullsrc=r=${FFX_AUDIO_RATE}:cl=stereo")
        aout=("-c:a" "aac" "-ar" "$FFX_AUDIO_RATE" "-ac" "2" "-shortest")
    fi
    run_ffmpeg --ffx-output "$tmp" -y -loop 1 -t "$duration" -i "$f" \
        "${ain[@]}" -vf "$scale_vf" \
        "${enc[@]}" \
        "${aout[@]}" -t "$duration" -video_track_timescale 90000 -movflags +faststart "$tmp"
}

# finalize_merge_output FILE: the single exit gate for every merge result.
# Strips metadata (auto_clean, faststart-preserving), then asserts the two
# properties the encoding guide makes non-negotiable and the merge path must
# never violate: the moov atom is in front of mdat, and the audio survived.
# Dies (removing the bad output) rather than hand the operator a file that
# only LOOKS merged.
finalize_merge_output() {
    local out="$1"
    auto_clean "$out"
    [[ "$DRY_RUN" == true ]] && return 0
    ensure_faststart "$out" \
        || die "merge: could not place the moov atom in front of mdat -> $out" "$out"
    if [[ "$REMOVE_AUDIO" != true ]]; then
        has_audio "$out" || die "merge: merged output has no audio stream -> $out" "$out"
    fi
}

# =============================================================================
concat_add() {
    local list="$1" file path
    path=$(absolute_path "$2") || return 1
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || die "concat filenames cannot contain line breaks"
    file=${path//\'/\'\\\'\'}
    printf "file '%s'\n" "$file" >> "$list"
}

concat_signature() {
    ffprobe -v error -show_data -show_entries stream=codec_type,codec_name,profile,level,width,height,pix_fmt,sample_aspect_ratio,time_base,r_frame_rate,avg_frame_rate,sample_rate,channels,channel_layout,extradata -of compact "$1" | sha256sum | awk '{print $1}'
}

cmd_merge() {
    advanced_prompt
    local -a files=()
    local output="${GLOBAL_OUTPUT_FILE:-}"
    local no_resume=false resume_requested="${RESUME_MODE:-false}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; files+=("$@"); break ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            -C|--composite)     COMPOSITE_MODE=true; shift ;;
            -B|--batch-size)    [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; [[ "$2" =~ ^[0-9]{1,9}$ ]] || die "Batch size must be a bounded non-negative integer"; BATCH_SIZE="$((10#$2))"; shift 2 ;;
            -s|--fps|-f)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; is_positive_rate "$2" || die "Frame rate must be positive"; SPECIFIC_FPS="$2"; shift 2 ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -r|--resume)        resume_requested=true; shift ;;
            --no-resume)        no_resume=true; shift ;;
            -y|--overwrite)     OVERWRITE_OUTPUT=true; shift ;;
            -*) die "Unknown merge option: $1" ;;
            *)                  files+=("$1"); shift ;;
        esac
    done

    if [[ "$COMPOSITE_MODE" == true ]]; then
        local -a composite_output_args=()
        [[ -z "$output" ]] || composite_output_args+=(-o "$output")
        [[ "$no_resume" != true ]] || composite_output_args+=(--no-resume)
        [[ "$resume_requested" != true ]] || composite_output_args+=(--resume)
        (( BATCH_SIZE <= 0 )) || composite_output_args+=(-B "$BATCH_SIZE")
        cmd_composite "${composite_output_args[@]}" -- "${files[@]}"
        return $?
    fi

    if (( ${#files[@]} < 1 )); then
        if [[ "$resume_requested" == true ]]; then
            cmd_resume ${output:+-o "$output"}
            return $?
        elif [[ "$BULK_MODE" == true ]]; then
            mapfile -t files < <(apply_bulk_glob "${OUTPUT_DIR:-$(pwd)}")
            (( ${#files[@]} >= 1 )) || die "merge --bulk: no video files found in '${OUTPUT_DIR:-$(pwd)}'."
        else
            mapfile -t files < <(fzf_pick)
        fi
    fi
    (( ${#files[@]} >= 1 )) || die "'merge' requires at least 1 file."

    local f
    for f in "${files[@]}"; do [[ -f "$f" ]] || die "File not found: $f"; done

    local checkpoint_target="${output:-$OUTPUT_DIR/output_merged.$ADV_CONTAINER}"
    local legacy_job_sig="${files[*]}|${checkpoint_target}"
    local job_sig; job_sig="$(canonical_job_sig "$checkpoint_target" "" "${files[@]}")"
    local job_dir; job_dir="$(checkpoint_job_dir "$job_sig" "$legacy_job_sig")"

    if [[ -z "$output" ]]; then
        output="$(get_default_filename "output" "merged" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    # ── PROBE PHASE (Cached per file path + size + mtime) ────────────────────
    local -a v_codec=() v_res=() v_fps=() v_pix=() v_prof=()
    local -a a_codec=() a_rate=() a_ch=() has_audio_arr=()
    local -a dts_ok=() moov_ok=() csig_arr=()

    for f in "${files[@]}"; do
        probe_file_cached "$f"
        v_codec+=("$_P_VC")
        v_res+=("${_P_VW}x${_P_VH}")
        v_fps+=("$_P_VFPS")
        v_pix+=("$_P_VPIX")
        v_prof+=("$_P_VPROF")
        a_codec+=("$_P_AC")
        a_rate+=("$_P_AR")
        a_ch+=("$_P_ACH")
        has_audio_arr+=("$_P_HAS_AUD")
        dts_ok+=("$_P_DTS_OK")
        moov_ok+=("$_P_MOOV_OK")
        csig_arr+=("$_P_CSIG")
    done

    # ── UNIFORMITY CHECK ─────────────────────────────────────────────────────
    local target_vc="${v_codec[0]}"
    local target_res="${v_res[0]}"
    local target_fps="${v_fps[0]}"
    local target_pix="${v_pix[0]}"

    local max_w=0 max_h=0 i
    for (( i=0; i<${#files[@]}; i++ )); do
        local ww="${v_res[$i]%x*}" hh="${v_res[$i]#*x}"
        [[ "$ww" =~ ^[0-9]+$ ]] || ww=0
        [[ "$hh" =~ ^[0-9]+$ ]] || hh=0
        (( ww > max_w )) && max_w=$ww
        (( hh > max_h )) && max_h=$hh
    done
    (( max_w > 0 )) || max_w=$CANVAS_W
    (( max_h > 0 )) || max_h=$CANVAS_H
    (( max_w % 2 != 0 )) && (( max_w++ )) || true
    (( max_h % 2 != 0 )) && (( max_h++ )) || true

    local target_family; target_family="$(codec_family "$ADV_CODEC")"
    local uniform=true
    [[ -z "$PTS_FACTOR" && "$INTERPOLATE" != true ]] || uniform=false
    local target_signature="${csig_arr[0]}"
    [[ -n "$target_signature" && "$target_signature" != "none" ]] || uniform=false
    [[ "$target_vc" == "$target_family" && "$target_pix" == "$ADV_PIX_FMT" ]] || uniform=false
    [[ -z "$SPECIFIC_FPS" ]] || fps_equals "$target_fps" "$SPECIFIC_FPS" || uniform=false
    if [[ "${EXPLICIT_RES:-false}" == true ]]; then
        max_w=${ADV_RES%x*}; max_h=${ADV_RES#*x}
        [[ "$target_res" == "$ADV_RES" ]] || uniform=false
    fi
    for (( i=0; i<${#files[@]}; i++ )); do
        [[ "${csig_arr[$i]}" == "$target_signature" ]] || { uniform=false; break; }
        [[ "${v_codec[$i]}" != "image" ]]          || { uniform=false; break; }
        [[ "${has_audio_arr[$i]}" == "true" ]]     || { uniform=false; break; }
        [[ "${v_codec[$i]}" == "$target_vc" ]]     || { uniform=false; break; }
        [[ "${v_res[$i]}"   == "$target_res" ]]    || { uniform=false; break; }
        [[ "${v_fps[$i]}"   == "$target_fps" ]]    || { uniform=false; break; }
        [[ "${v_pix[$i]}"   == "$target_pix" ]]    || { uniform=false; break; }
        [[ "${v_prof[$i]}"  == "${v_prof[0]}" ]]   || { uniform=false; break; }
        [[ "${a_codec[$i]}" == "${a_codec[0]}" ]]  || { uniform=false; break; }
        [[ "${a_rate[$i]}"  == "${a_rate[0]}" ]]   || { uniform=false; break; }
        [[ "${a_ch[$i]}"    == "${a_ch[0]}" ]]     || { uniform=false; break; }
        [[ "${dts_ok[$i]}"  == "true" ]]           || { uniform=false; break; }
        [[ "${moov_ok[$i]}" == "true" ]]           || { uniform=false; break; }
    done

    # ── FAST PATH ─────────────────────────────────────────────────────────────
    if [[ "$uniform" == true && "$REMOVE_AUDIO" != true ]]; then
        preflight_space "$(dirname -- "$output")" 1 "${files[@]}"
        verbose_log "merge: fast path — all ${#files[@]} inputs conformant; skipping re-encode."
        local concat_list; concat_list="$(mktemp_ffx .txt)"
        for f in "${files[@]}"; do
            concat_add "$concat_list" "$f"
        done
        local fast_to; fast_to="$(compute_batch_timeout "${#files[@]}")"
        local -a out_fs; mapfile -t out_fs < <(faststart_flags_for "$output")
        run_ffmpeg --ffx-timeout "$fast_to" --ffx-output "$output" \
            -y -avoid_negative_ts make_zero \
            -f concat -safe 0 -i "$concat_list" -c copy "${out_fs[@]}" "$output" \
            || die "merge: fast-path concat failed -> $output" "$output"
        finalize_merge_output "$output"
        say "Merged [fast]: $output"
        return
    fi

    verbose_log "merge: normalise path — target ${max_w}x${max_h} @ ${ADV_FPS}fps (uniform=${uniform})"

    checkpoint_lock "$job_dir"
    [[ "$no_resume" == true ]] && checkpoint_clear "$job_dir"

    # ── PRE-SCAN CHECKPOINTS & RESUME-AWARE SPACE PREFLIGHT ──────────────────
    local -a cached_paths=() uncached_files=()
    local pre_resumed=0
    for (( i=0; i<${#files[@]}; i++ )); do
        f="${files[$i]}"
        local cpath=""
        if [[ "$no_resume" != true ]] && cpath="$(checkpoint_get "$job_dir" "$f" "${max_w}x${max_h}" 2>/dev/null)"; then
            cached_paths[$i]="$cpath"
            (( pre_resumed++ )) || true
        else
            cached_paths[$i]=""
            uncached_files+=("$f")
        fi
    done

    local all_bytes uncached_bytes=0
    all_bytes="$(sum_input_bytes "${files[@]}")"
    if (( ${#uncached_files[@]} > 0 )); then
        uncached_bytes="$(sum_input_bytes "${uncached_files[@]}")"
    fi
    preflight_space_resumable "$(dirname -- "$output")" "$all_bytes" "$uncached_bytes"
    job_manifest_save "$job_dir" "merge" "$checkpoint_target" "${#files[@]}" "$pre_resumed" "${files[@]}"

    # ── NORMALISE PATH ────────────────────────────────────────────────────────
    local -a preprocessed=() failed_files=()
    local tf="${SPECIFIC_FPS:-$ADV_FPS}"
    local resumed_count=0 fresh_count=0

    for (( i=0; i<${#files[@]}; i++ )); do
        f="${files[$i]}"

        local resumed_tmp="${cached_paths[$i]:-}"
        if [[ -z "$resumed_tmp" && "$no_resume" != true ]]; then
            resumed_tmp="$(checkpoint_get "$job_dir" "$f" "${max_w}x${max_h}" 2>/dev/null || true)"
        fi
        if [[ -n "$resumed_tmp" ]]; then
            verbose_log "merge: input $(basename "$f") resumed from checkpoint."
            preprocessed+=("$resumed_tmp")
            (( resumed_count++ )) || true
            continue
        fi

        local tmp; tmp="$(mktemp_ffx .mp4)"
        local step_ok=true
        local aud_ok=false vcopy=false

        if is_image "$f"; then
            verbose_log "merge: normalizing image $f"
            merge_image_input "$f" "$tmp" "$max_w" "$max_h" "$tf" || step_ok=false
        else
            # Audio is already in the common format only when it is AAC at the
            # target rate in stereo; anything else is re-encoded to it.
            if [[ "${has_audio_arr[$i]}" == "true" && "${a_codec[$i]}" == "aac" \
                  && "${a_rate[$i]}" == "$FFX_AUDIO_RATE" && "${a_ch[$i]}" == "2" ]]; then
                aud_ok=true
            fi
            # Video is stream-copied only when it already IS the target:
            # same codec family/pixel format/geometry/fps, clean DTS and moov,
            # and (for H.264) the profile libx264 emits for yuv420p, so the
            # copied SPS agrees with its re-encoded siblings in the same file.
            if [[ "${dts_ok[$i]}" == "true" && "${moov_ok[$i]}" == "true" \
                  && "${v_codec[$i]}" == "$target_family" \
                  && "${v_pix[$i]}" == "$ADV_PIX_FMT" \
                  && "${v_res[$i]}" == "${max_w}x${max_h}" ]] \
               && fps_equals "${v_fps[$i]}" "$tf" \
               && { [[ "$target_family" != "h264" ]] || [[ "${v_prof[$i]}" == "High" ]]; }; then
                vcopy=true
            fi
            [[ -z "$PTS_FACTOR" && "$INTERPOLATE" != true ]] || vcopy=false
            verbose_log "merge: input $(basename "$f") video=$([[ "$vcopy" == true ]] && echo copy || echo re-encode) audio=$([[ "$aud_ok" == true ]] && echo copy || echo normalise)"
            merge_encode_input "$f" "$tmp" "$max_w" "$max_h" "$tf" \
                "${has_audio_arr[$i]}" "$aud_ok" "$vcopy" || step_ok=false
        fi

        # A segment whose index cannot be read is re-made through the FULL
        # normalise encode (same geometry/fps/audio as its siblings), never
        # through a generic re-encode that would break concatenation.
        if [[ "$step_ok" == true && "$DRY_RUN" != true ]] && ! check_moov_atom "$tmp"; then
            if is_image "$f"; then
                merge_image_input "$f" "$tmp" "$max_w" "$max_h" "$tf" || step_ok=false
            else
                merge_encode_input "$f" "$tmp" "$max_w" "$max_h" "$tf" \
                    "${has_audio_arr[$i]}" false false || step_ok=false
            fi
            check_moov_atom "$tmp" || step_ok=false
        fi

        # Post-condition: a normalised segment must carry audio (unless -an),
        # or the final concat would silently lose that segment's sound.
        if [[ "$step_ok" == true && "$REMOVE_AUDIO" != true && "$DRY_RUN" != true ]]; then
            has_audio "$tmp" || { warn "merge: normalised segment for '$(basename "$f")' has no audio."; step_ok=false; }
        fi

        if [[ "$step_ok" != true ]]; then
            warn "merge: failed to normalize '$(basename "$f")' — skipping (rerun to retry; completed files stay cached)."
            failed_files+=("$f")
            continue
        fi

        local persisted; persisted="$(checkpoint_store_artifact "$job_dir" "$f" "$tmp" "${max_w}x${max_h}")"
        checkpoint_set "$job_dir" "$f" "$persisted" "${max_w}x${max_h}"
        preprocessed+=("$persisted")
        (( fresh_count++ )) || true
        job_manifest_save "$job_dir" "merge" "$checkpoint_target" "${#files[@]}" "${#preprocessed[@]}" "${files[@]}"
    done

    (( resumed_count > 0 )) && verbose_log "merge: ${resumed_count} input(s) resumed from prior run, ${fresh_count} processed fresh."
    (( ${#preprocessed[@]} >= 1 )) || die "merge: every input failed normalization; nothing to concatenate."

    # ── CONCAT ───────────────────────────────────────────────────────────────
    local concat_list; concat_list="$(mktemp_ffx .txt)"
    for f in "${preprocessed[@]}"; do
        concat_add "$concat_list" "$f"
    done
    local final_to; final_to="$(compute_batch_timeout "${#preprocessed[@]}")"
    local -a final_fs; mapfile -t final_fs < <(faststart_flags_for "$output")
    local -a final_codecs=(-c copy)
    if [[ -n "$SPECIFIC_FPS" ]]; then
        # AAC padding changes concat packet offsets. Re-time decoded video at
        # the explicit requested cadence; qp0 avoids another lossy generation.
        final_codecs=(-c:v "$ADV_CODEC" -qp 0 -preset ultrafast -pix_fmt "$ADV_PIX_FMT" -r "$SPECIFIC_FPS" -fps_mode cfr -c:a copy)
    fi
    run_ffmpeg --ffx-timeout "$final_to" --ffx-output "$output" \
        -y -avoid_negative_ts make_zero \
        -f concat -safe 0 -i "$concat_list" "${final_codecs[@]}" "${final_fs[@]}" "$output" \
        || die "merge: concat failed -> $output" "$output"

    finalize_merge_output "$output"

    if (( ${#failed_files[@]} > 0 )); then
        # Deliberately skip checkpoint_clear here: the job is NOT fully done,
        # so its cache must survive for the good files to resume for free on
        # the next attempt at the remaining/fixed file(s).
        warn "merge: completed with ${#failed_files[@]} skipped file(s):"
        for f in "${failed_files[@]}"; do warn "  - $f"; done
        say "Merged [partial]: $output"
        return 1
    fi

    # Pristine-baseline reset only after a fully successful pass —
    # Architectural Gate 4.3. Any earlier or partial failure leaves the
    # checkpoint intact.
    checkpoint_clear "$job_dir"
    say "Merged: $output"
}
# =============================================================================
# CMD: PROBE
# =============================================================================
cmd_probe() {
    advanced_prompt
    local input="" mode=summary
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) mode=full; shift ;;
            --json) mode=json; shift ;;
            --) shift; (($# == 1)) || die "probe requires one input"; input="$1"; break ;;
            -*) die "Unknown probe option: $1" ;;
            *) [[ -z "$input" ]] || die "probe accepts one input"; input="$1"; shift ;;
        esac
    done

    if [[ -z "$input" ]]; then
        local -a _s; mapfile -t _s < <(fzf_pick); input="${_s[0]}"
    fi
    [[ -f "$input" ]] || die "File not found: $input"

    case "$mode" in
        full) cmd_ffprobe -v error -show_streams -show_format "$input"; return ;;
        json) cmd_ffprobe -v error -show_streams -show_format -of json "$input"; return ;;
    esac

    local sz=0 res fps dur fmt
    sz="$(stat -c '%s' "$input" 2>/dev/null || stat -f '%z' "$input" 2>/dev/null || echo 0)"
    res="$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=width,height -of csv=p=0:s=x "$input" 2>/dev/null || echo unknown)"
    fps="$(get_fps "$input")"
    dur="$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null || echo 0)"
    fmt="$(ffprobe -v error -show_entries format=format_name \
        -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null || echo unknown)"

    printf '%b# === FFX Probe ===%b\n'  "${CYAN}${BOLD}" "${RESET}"
    printf '%bFile:%b       %s\n'       "${CYAN}" "${RESET}" "$input"
    printf '%bSize:%b       %s\n'       "${CYAN}" "${RESET}" "$(bytes_to_human "$sz")"
    printf '%bFormat:%b     %s\n'       "${CYAN}" "${RESET}" "$fmt"
    printf '%bResolution:%b %s\n'       "${CYAN}" "${RESET}" "$res"
    printf '%bFPS:%b        %s\n'       "${CYAN}" "${RESET}" "$fps"
    printf '%bDuration:%b   %ss\n'      "${CYAN}" "${RESET}" "$dur"

    if [[ "$res" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        local h="${BASH_REMATCH[2]}"
        if (( h > 1080 )) && [[ -t 0 && -t 1 ]]; then
            local ans
            read -r -p "Resolution ($res) exceeds 1080p. Process now? (y/N): " ans
            [[ "${ans,,}" =~ ^y ]] && cmd_process "$input"
        fi
    fi
}

# =============================================================================
# CMD: PROCESS
# =============================================================================
cmd_process() {
    advanced_prompt
    local input="" output="${GLOBAL_OUTPUT_FILE:-}" forced_fps=""
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; args+=("$@"); break ;;
            -P|-m|--max-1080|--max1080) MAX_1080=true; shift ;;
            -an|-n|--remove-audio|--noaudio) REMOVE_AUDIO=true; shift ;;
            --speed) [[ $# -ge 2 ]] || die "Missing playback speed"; PTS_FACTOR=$(speed_to_pts "$2") || die "Playback speed must be finite and positive"; shift 2 ;;
            -p|--pts) [[ $# -ge 2 ]] || die "Missing PTS factor"; is_positive_number "$2" || die "PTS factor must be positive"; PTS_FACTOR="$2"; shift 2 ;;
            -i|--interpolate) INTERPOLATE=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            -f|--fps)           [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; is_positive_rate "$2" || die "Frame rate must be positive"; forced_fps="$2"; shift 2 ;;
            -*) die "Unknown process option: $1" ;;
            *)                  args+=("$1"); shift ;;
        esac
    done

    input="${args[0]:-}"
    if [[ "$BULK_MODE" == true ]]; then
        (( ${#args[@]} > 0 )) || mapfile -t args < <(apply_bulk_glob "$OUTPUT_DIR")
        (( ${#args[@]} > 0 )) || die "No bulk process inputs"
        [[ -z "$output" || ${#args[@]} == 1 ]] || die "A single output cannot name multiple bulk results"
        local failed=0 file
        local -a bulk_output_args=()
        [[ -z "$output" ]] || bulk_output_args=(-o "$output")
        BULK_MODE=false
        for file in "${args[@]}"; do
            # A subshell isolates per-file failures while the parent retains cleanup ownership.
            ( init_session; cmd_process "$file" "${bulk_output_args[@]}" ) || failed=1
        done
        return "$failed"
    fi
    (( ${#args[@]} <= 2 )) || die "process accepts input and optional output; use --bulk for multiple inputs"
    [[ -z "$output" ]] && output="${args[1]:-}"
    [[ -z "$input" ]] && die "'process' requires an input file."
    [[ -s "$input" ]] || die "Input zero-length or missing: $input"

    local bare; bare="$(basename "${input%.*}")"
    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$bare" "processed" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi
    [[ -n "$forced_fps" ]] && ADV_FPS="$forced_fps"
    [[ -n "$SPECIFIC_FPS" ]] && ADV_FPS="$SPECIFIC_FPS"

    local fixed; capture_value fixed ensure_dts_correct "$input" || die "DTS fix failed: $input"

    if [[ "$MAX_1080" == true ]]; then
        local w h
        IFS=' ' read -r w h < <(probe_wh "$fixed")
        ADV_RES=$(awk -v w="$w" -v h="$h" 'BEGIN{r=1; if(w>1920)r=1920/w; if(h*r>1080)r=1080/h; printf "%dx%d",int(w*r/2)*2,int(h*r/2)*2}')
    fi

    local -a aopts; mapfile -t aopts < <(get_audio_opts_array)
    local deint; deint="$(get_deinterlace_filter "$fixed")"

    # PRE-EXISTING BUG FIX (found via regression testing, disclosed per
    # protocol; out of original audit scope but adjacent to units already
    # touched): ADV_RES is stored in "WxH" form (e.g. "1920x1080"). ffmpeg's
    # `scale` filter accepts that form directly, but `pad` does not — pad
    # requires colon-separated `width:height:x:y` arguments. The original
    # line built `pad=${ADV_RES}:-1:-1`, which ffmpeg parses as a single
    # malformed width expression ("1920x1080") and rejects outright,
    # failing 'process' for every invocation that reaches this code path
    # (i.e. every non-qp0, non-multipass CRF encode — the default mode).
    # Fix: split ADV_RES into its width/height components once, and use
    # those for the pad clause, mirroring the already-correct pattern in
    # cmd_merge's scale_vf construction (which uses max_w:max_h directly).
    local res_w res_h
    IFS='x' read -r res_w res_h <<< "$ADV_RES"
    local scale_f="scale=${ADV_RES}:flags=lanczos:force_original_aspect_ratio=decrease,pad=${res_w}:${res_h}:-1:-1:color=black,setsar=1"
    local full_vf; [[ "$deint" != "null" ]] && full_vf="${deint},${scale_f}" || full_vf="$scale_f"
    if [[ -n "$PTS_FACTOR" ]]; then
        full_vf+=",setpts=${PTS_FACTOR}*(PTS-STARTPTS)"
        if [[ "$REMOVE_AUDIO" != true ]] && has_audio "$fixed"; then
            aopts=(-af "$(tempo_filter "$PTS_FACTOR")" -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
        fi
    fi
    if [[ "$INTERPOLATE" == true ]]; then full_vf+=",$(interpolation_filter "$fixed" "${PTS_FACTOR:-1}" "$ADV_FPS")"; fi

    if [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]]; then
        run_ffmpeg --ffx-output "$output" -y -i "$fixed" -vf "$full_vf" -r "$ADV_FPS" \
            -c:v "$ADV_CODEC" -qp 0 -preset "$ADV_PRESET" \
            "${aopts[@]}" -pix_fmt "$ADV_PIX_FMT" -movflags +faststart "$output" \
            || die "process (qp0) failed." "$output"
    elif [[ "$ADV_MULTIPASS" == "true" ]]; then
        run_ffmpeg -y -i "$fixed" -vf "$full_vf" -r "$ADV_FPS" \
            -c:v "$ADV_CODEC" -b:v "$ADV_BR" -preset "$ADV_PRESET" -pix_fmt "$ADV_PIX_FMT" -passlogfile "$FFX_RUN_DIR/pass" -pass 1 -an \
            -f mp4 /dev/null || die "process: pass 1 failed."
        run_ffmpeg --ffx-output "$output" -y -i "$fixed" -vf "$full_vf" -r "$ADV_FPS" \
            -c:v "$ADV_CODEC" -b:v "$ADV_BR" -preset "$ADV_PRESET" -passlogfile "$FFX_RUN_DIR/pass" -pass 2 \
            "${aopts[@]}" -pix_fmt "$ADV_PIX_FMT" -movflags +faststart "$output" \
            || die "process: pass 2 failed." "$output"
    else
        run_ffmpeg --ffx-output "$output" -y -i "$fixed" -vf "$full_vf" -r "$ADV_FPS" \
            -c:v "$ADV_CODEC" -crf "${ADV_CRF:-18}" -preset "$ADV_PRESET" \
            "${aopts[@]}" -pix_fmt "$ADV_PIX_FMT" -movflags +faststart "$output" \
            || die "process (CRF) failed." "$output"
    fi

    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || moov_fallback "$fixed" "$output"
    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || die "moov atom missing: $output"
    auto_clean "$output"
    say "Processed: $output"
}

# =============================================================================
# CMD: LOOPERANG
# =============================================================================
cmd_looperang() {
    advanced_prompt
    local input="" output="${GLOBAL_OUTPUT_FILE:-}"; local -a args=()
    while (($#)); do
        case "$1" in
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose) VERBOSE_MODE=true; shift ;;
            -o|--output) [[ $# -ge 2 ]] || die "Missing output"; output="$2"; shift 2 ;;
            --) shift; args+=("$@"); break ;;
            -*) die "Unknown looperang option: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    input="${args[0]:-}"; output="${output:-${args[1]:-}}"
    [[ -f "$input" ]] || die "looperang requires a readable input file"
    [[ -n "$output" ]] && output=$(ensure_unique_output "$output") || output=$(get_default_filename "$(basename "${input%.*}")" looperang "$ADV_CONTAINER")
    local fc='[0:v:0]split=2[f][r];[r]reverse[rv];[f][rv]concat=n=2:v=1:a=0[v]'
    local -a audio=(-an)
    if [[ "$REMOVE_AUDIO" != true ]] && has_audio "$input"; then
        fc+=';[0:a:0]asplit=2[af][ar];[ar]areverse[ra];[af][ra]concat=n=2:v=0:a=1[a]'
        audio=(-map '[a]' -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
    fi
    local video_map='[v]'
    if [[ -n "$PTS_FACTOR" || "$INTERPOLATE" == true ]]; then
        local timing="setpts=${PTS_FACTOR:-1}*(PTS-STARTPTS)"
        [[ "$INTERPOLATE" != true ]] || timing+=",$(interpolation_filter "$input" "${PTS_FACTOR:-1}" "${SPECIFIC_FPS:-$ADV_FPS}" 2)"
        fc+=";[v]${timing}[timedv]"; video_map='[timedv]'
        if [[ -n "$PTS_FACTOR" && "${audio[0]}" == -map ]]; then
            fc+=";[a]$(tempo_filter "$PTS_FACTOR")[timeda]"
            audio=(-map '[timeda]' -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
        fi
    fi
    local fps="${SPECIFIC_FPS:-$(get_fps "$input")}"
    run_ffmpeg --ffx-output "$output" -y -i "$input" -filter_complex "$fc" -map "$video_map" "${audio[@]}" -r "$fps" \
        -c:v "$ADV_CODEC" -qp 0 -preset ultrafast "$output" || die "looperang failed" "$output"
    auto_clean "$output"
    say "Looperang: $output"
}

# =============================================================================
# CMD: SLOWMO
# =============================================================================
cmd_slowmo() {
    advanced_prompt
    local input="" output="${GLOBAL_OUTPUT_FILE:-}" factor=""
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; args+=("$@"); break ;;
            -i|--interpolate)   INTERPOLATE=true; shift ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            --speed) [[ $# -ge 2 ]] || die "Missing playback speed"; factor=$(speed_to_pts "$2") || die "Playback speed must be finite and positive"; shift 2 ;;
            -p|--pts)           [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; is_positive_number "$2" || die "PTS factor must be positive"; factor="$2"; shift 2 ;;
            -f|--fps)           [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; is_positive_rate "$2" || die "Frame rate must be positive"; SPECIFIC_FPS="$2"; shift 2 ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            -*) die "Unknown slowmo option: $1" ;;
            *)                  args+=("$1"); shift ;;
        esac
    done

    input="${args[0]:-}"
    [[ -z "$output" ]] && output="${args[1]:-}"
    [[ -z "$factor" ]] && factor="${PTS_FACTOR:-${args[2]:-2}}"
    is_positive_number "$factor" || die "PTS factor must be positive"

    [[ -z "$input" ]] && die "slowmo requires an input file."
    [[ -f "$input" ]] || die "File not found: $input"

    local bare; bare="$(basename "${input%.*}")"
    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$bare" "slowmo" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    local fps="${SPECIFIC_FPS:-$ADV_FPS}"
    local vf="setpts=${factor}*(PTS-STARTPTS)"

    if [[ "$INTERPOLATE" == true ]]; then
        [[ -z "$SPECIFIC_FPS" ]] && fps="120" \
            && verbose_log "No -f set; defaulting interpolation to 120 FPS."
        vf="${vf},$(interpolation_filter "$input" "$factor" "$fps")"
    fi

    is_positive_number "$factor" || die "slowmo factor must be positive"
    local -a ffa=("-y" "-i" "$input")
    if [[ "$REMOVE_AUDIO" == false ]] && has_audio "$input"; then
        local af
        af=$(tempo_filter "$factor")
        ffa+=("-filter_complex" "[0:v]${vf}[v];[0:a]${af}[a]" "-map" "[v]" "-map" "[a]" -c:a aac -ar "$FFX_AUDIO_RATE" -ac 2)
    else
        ffa+=("-vf" "$vf" "-an")
    fi

    ffa+=("-r" "$fps" "-c:v" "$ADV_CODEC")
    [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]] \
        && ffa+=("-qp" "0") || ffa+=("-crf" "${ADV_CRF:-18}")
    ffa+=("-preset" "$ADV_PRESET" "-pix_fmt" "$ADV_PIX_FMT" "$output")

    run_ffmpeg --ffx-output "$output" "${ffa[@]}" || die "slowmo failed." "$output"
    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || moov_fallback "$input" "$output"
    auto_clean "$output"
    say "Slow motion: $output"
}

# =============================================================================
# CMD: FIX
# =============================================================================
cmd_fix() {
    advanced_prompt
    [[ -z "$SPECIFIC_FPS" ]] || FORCE_CFR=true
    local input="" output="${GLOBAL_OUTPUT_FILE:-}"
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; args+=("$@"); break ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            --reference) [[ $# -ge 2 ]] || die "Missing reference"; FIX_REFERENCE="$2"; shift 2 ;;
            --cfr) FORCE_CFR=true; shift ;;
            -*) die "Unknown fix option: $1" ;;
            *)                  args+=("$1"); shift ;;
        esac
    done

    input="${args[0]:-}"
    [[ -z "$output" ]] && output="${args[1]:-}"
    [[ -z "$input" ]] && die "fix requires an input file."
    [[ -f "$input" ]] || die "File not found: $input"

    local bare; bare="$(basename "${input%.*}")"
    if [[ "$FORCE_CFR" == true ]]; then
        local working="$input"
        if [[ -n "$FIX_REFERENCE" ]]; then
            capture_value working recover_container "$input" "$FIX_REFERENCE" || die "Container recovery failed; source retained"
        fi
        SPECIFIC_FPS="${SPECIFIC_FPS:-$ADV_FPS}"
        output="${output:-$OUTPUT_DIR/${bare}_fixed.$ADV_CONTAINER}"
        cmd_process "$working" -o "$output"
        return
    fi
    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$bare" "fixed" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    if [[ "$DRY_RUN" == true && "$FORCE_CFR" != true && -z "$FIX_REFERENCE" ]]; then
        run_ffmpeg -y -i "$input" -c copy "$output"
        return 0
    fi
    local working="$input" fixed
    if [[ -n "$FIX_REFERENCE" ]]; then
        capture_value working recover_container "$input" "$FIX_REFERENCE" || die "Container recovery failed; source retained"
    fi
    capture_value fixed ensure_dts_correct "$working" || die "fix: DTS correction failed."
    local -a audio fs
    mapfile -t audio < <(get_audio_opts_array)
    mapfile -t fs < <(faststart_flags_for "$output")
    run_ffmpeg --ffx-output "$output" -y -i "$fixed" -map 0 -c copy "${audio[@]}" "${fs[@]}" "$output" || die "fix: remux failed" "$output"
    ensure_faststart "$output" || die "fix: cannot establish faststart" "$output"
    say "Fixed: $output"
}

