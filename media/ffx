# =============================================================================
# CMD: CLIP
# =============================================================================
timestamp_seconds() {
    [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ || "$1" =~ ^[0-9]+:[0-5][0-9]:[0-5][0-9]([.][0-9]+)?$ ]] || return 1
    awk -v t="$1" 'BEGIN{n=split(t,a,":"); if(n==1) print t+0; else printf "%.6f",a[1]*3600+a[2]*60+a[3]}'
}

cmd_clip() {
    local input="" output="${GLOBAL_OUTPUT_FILE:-}"
    local -a args=(); local st="" et=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --start|-ss) [[ $# -ge 2 ]] || die "Missing clip start"; st="$2"; shift 2 ;;
            --end|-to) [[ $# -ge 2 ]] || die "Missing clip end"; et="$2"; shift 2 ;;
            --) shift; args+=("$@"); break ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            -*) die "Unknown clip option: $1" ;;
            *)                  args+=("$1"); shift ;;
        esac
    done

    input="${args[0]:-}"
    if ((${#args[@]} >= 3)); then
        ((${#args[@]} <= 4)) || die "clip accepts INPUT START END [OUTPUT]"
        [[ -z "$st$et" ]] || die "Do not mix positional and flagged clip times"
        st="${args[1]}"; et="${args[2]}"
        [[ -z "$output" ]] && output="${args[3]:-}"
    else
        [[ -z "$output" ]] && output="${args[1]:-}"
    fi

    if [[ -z "$input" ]]; then
        local -a _s; mapfile -t _s < <(fzf_pick); input="${_s[0]}"
    fi
    [[ -f "$input" ]] || die "File not found: $input"
    local bare; bare="$(basename "${input%.*}")"
    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$bare" "clip" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    local dur
    dur="$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null || echo 0)"
    printf 'Total duration: %ss\n' "$dur"

    [[ -n "$st" ]] || read -r -p "Start time (HH:MM:SS or seconds): " st || die "clip requires --start or interactive input"
    [[ -n "$et" ]] || read -r -p "End time   (HH:MM:SS or seconds): " et || die "clip requires --end or interactive input"
    local seconds_start seconds_end
    seconds_start=$(timestamp_seconds "$st") || die "Invalid clip start"
    seconds_end=$(timestamp_seconds "$et") || die "Invalid clip end"
    awk -v a="$seconds_start" -v b="$seconds_end" 'BEGIN{exit !(b>a)}' || die "Clip end must follow start"
    [[ -z "$st" || -z "$et" ]] && die "clip: start and end times are required."

    local -a aopts; mapfile -t aopts < <(get_audio_opts_array)
    run_ffmpeg --ffx-output "$output" -y -ss "$st" -to "$et" -i "$input" -c copy "${aopts[@]}" "$output" \
        || die "clip failed. If stream copy errors, process the source first." "$output"
    say "Clip: $output"
}

# =============================================================================
# CMD: FILTER
# =============================================================================
cmd_filter() {
    advanced_prompt
    local input="" output="" preset="enhance" custom_filter=""
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; args+=("$@"); break ;;
            --preset|-P)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; preset="$2"; shift 2 ;;
            --filter|-F)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; custom_filter="$2"; shift 2 ;;
            -o|--output)        [[ $# -ge 2 && -n "$2" ]] || die "Option '$1' requires an argument."; output="$2"; shift 2 ;;
            -an|--remove-audio) REMOVE_AUDIO=true; shift ;;
            -v|--verbose)       VERBOSE_MODE=true; shift ;;
            -*) die "Unknown filter option: $1" ;;
            *)                  args+=("$1"); shift ;;
        esac
    done

    input="${args[0]:-}"
    [[ -z "$output" ]] && output="${args[1]:-${GLOBAL_OUTPUT_FILE:-}}"

    if [[ -z "$input" ]]; then
        local -a _s; mapfile -t _s < <(fzf_pick); input="${_s[0]}"
    fi
    [[ -f "$input" ]] || die "File not found: $input"
    local bare; bare="$(basename "${input%.*}")"
    if [[ -z "$output" ]]; then
        output="$(get_default_filename "$bare" "filtered" "$ADV_CONTAINER")"
    else
        output="$(ensure_unique_output "$output")"
    fi

    local vfilter
    if [[ -n "$custom_filter" ]]; then
        vfilter="$custom_filter"
    else
        case "$preset" in
        enhance)       vfilter="eq=brightness=0.1:contrast=1.2:saturation=1.2" ;;
        skintone)      vfilter="eq=brightness=0.15:contrast=1.3:saturation=0.9,colorbalance=rs=-0.1:gs=0.05:bs=0.05" ;;
        denoise)       vfilter="hqdn3d=2:1:2:3" ;;
        cross_process) vfilter="curves=preset=cross_process" ;;
        hdr2sdr)       vfilter="zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable,zscale=t=bt709:m=bt709:r=tv,format=yuv420p" ;;
        smooth)        vfilter="minterpolate=fps=60,tblend=all_mode=average,framestep=2" ;;
        whitecal)      vfilter="colorbalance=rs=-0.05:gs=0.05:bs=0.10" ;;
        *)             die "Unknown filter preset: '$preset'. Valid: enhance skintone denoise cross_process hdr2sdr smooth whitecal" ;;
        esac
    fi

    verbose_log "filter preset='$preset' vfilter='$vfilter'"

    local fixed; capture_value fixed ensure_dts_correct "$input" || die "DTS fix failed: $input"
    local deint; deint="$(get_deinterlace_filter "$fixed")"
    local full_vf
    [[ "$deint" != "null" ]] && full_vf="${deint},${vfilter}" || full_vf="$vfilter"

    local -a aopts; mapfile -t aopts < <(get_audio_opts_array)
    local -a enc
    [[ "${ADV_QUALITY_MODE:-crf}" == "qp0" ]] \
        && enc=("-c:v" "$ADV_CODEC" "-qp" "0" "-preset" "$ADV_PRESET") \
        || enc=("-c:v" "$ADV_CODEC" "-crf" "${ADV_CRF:-18}" "-preset" "$ADV_PRESET")

    local -a filter_rate_args=()
    [[ -z "$SPECIFIC_FPS" ]] || filter_rate_args=(-r "$SPECIFIC_FPS")
    run_ffmpeg --ffx-output "$output" -y -i "$fixed" \
        -vf "$full_vf" \
        "${enc[@]}" "${aopts[@]}" \
        "${filter_rate_args[@]}" -pix_fmt "$ADV_PIX_FMT" -movflags +faststart "$output" \
        || die "filter: ffmpeg failed." "$output"

    [[ "$DRY_RUN" == true ]] || check_moov_atom "$output" || moov_fallback "$fixed" "$output"
    auto_clean "$output"
    say "Filtered [${preset}]: $output"
}

# =============================================================================
# CMD: CACHE-CLEAN
#
# CHANGED: now also offers to clear stale resume checkpoints, since
# FFX_CHECKPOINT_DIR lives under FFX_CACHE_DIR and the user's existing mental
# model of "cache-clean wipes FFX's scratch state" should cover it without
# introducing a second, separate command to learn.
# =============================================================================
cmd_cache_clean() {
    local include_legacy=false yes="$CACHE_YES" ans=n
    while (($#)); do
        case "$1" in
            --yes) yes=true ;;
            --include-legacy) include_legacy=true ;;
            *) die "Unknown cache-clean option: $1" ;;
        esac
        shift
    done
    if [[ "$DRY_RUN" == true ]]; then
        printf '[DRY-RUN] cache-clean %q\n' "$FFX_CACHE_DIR"
        [[ "$include_legacy" != true ]] || printf '[DRY-RUN] remove %q %q\n' "$XDG_CACHE_HOME/ffxd" "$XDG_RUNTIME_DIR/ffxd"
        return 0
    fi
    printf 'Remove managed FFX checkpoints/manifests in: %s\n' "$FFX_CACHE_DIR"
    [[ "$include_legacy" != true ]] || printf 'Also remove old namespaces: %s and %s\n' "$XDG_CACHE_HOME/ffxd" "$XDG_RUNTIME_DIR/ffxd"
    if [[ "$yes" == true ]]; then ans=y
    else read -r -p "Are you sure? (y/N): " ans || true; fi
    if [[ "${ans,,}" =~ ^y ]]; then
        flock -x -n "$FFX_CACHE_LOCK_FD" || die "Cache is in use by another invocation; nothing removed"
        rm -rf -- "$FFX_CHECKPOINT_DIR" "$FFX_MANIFEST_DIR"
        mkdir -p -- "$FFX_CHECKPOINT_DIR"
        if [[ "$include_legacy" == true ]]; then
            rm -rf -- "$XDG_CACHE_HOME/ffxd" "$XDG_RUNTIME_DIR/ffxd" || die "Cannot clear old cache namespaces"
        fi
        say "Cache cleaned (managed checkpoints and manifests; unrelated files retained)."
    else
        printf 'Aborted.\n'
    fi
}
# =============================================================================
# TUI — fzf-driven front end
#
# NEW (v8.2.0): running `ffx` with zero arguments and an interactive terminal
# now launches an fzf menu instead of immediately printing usage and exiting.
# This is purely additive: every existing CLI invocation (`ffx merge ...`,
# `ffx -A process foo.mp4`, etc.) is completely unaffected, since the TUI
# only ever engages on the exact zero-argument path that previously called
# display_usage() unconditionally — and it still falls through to that same
# display_usage() if fzf isn't installed or stdin/stdout aren't a terminal
# (piped/scripted invocation), so `ffx` with no args in a non-interactive
# context (CI, `ffx | cat`, etc.) behaves exactly as before.
#
# The TUI does not duplicate any command's actual logic — it only gathers
# the same inputs a CLI invocation would (files, encode options, per-command
# extras) and then calls the exact same main_dispatch() every CLI path uses.
# There is no second code path to keep in sync with cmd_merge/cmd_process/etc.
# =============================================================================
tui_available() { command_exists fzf && [[ -t 0 && -t 1 ]]; }

# tui_discover_files(): candidate list for fzf file pickers. Deliberately
# broader than apply_bulk_glob() (which is maxdepth-1 and video-only, tuned
# for --bulk's directory-glob semantics) — the TUI also needs images, since
# merge/composite accept them, and a little directory depth so a typical
# project layout (./clips/*.mp4, ./stills/*.png) is browsable without cd'ing.
tui_discover_files() {
    find "$(pwd)" -maxdepth 3 -type f \( \
        -iname '*.mp4' -o -iname '*.mkv'  -o -iname '*.mov' -o -iname '*.avi' \
        -o -iname '*.webm' -o -iname '*.gif' -o -iname '*.ts' -o -iname '*.m4v' \
        -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.bmp' \
        -o -iname '*.webp' -o -iname '*.tif' -o -iname '*.tiff' \) 2>/dev/null | sort
}

tui_pick_one() {
    local prompt="$1"
    tui_discover_files | fzf --prompt="${prompt}> " --height='~60%' --reverse \
        --preview 'timeout --kill-after=5 30 ffprobe -hide_banner -i {} 2>&1 | sed -n "1,20p"' \
        --header='Enter to select, Esc to cancel' 2>/dev/null
}

tui_pick_many() {
    local prompt="$1"
    tui_discover_files | fzf --multi --prompt="${prompt}> " --height='~60%' --reverse \
        --preview 'timeout --kill-after=5 30 ffprobe -hide_banner -i {} 2>&1 | sed -n "1,20p"' \
        --header='Tab to multi-select, Enter to confirm, Esc to cancel' 2>/dev/null
}

# _tui_pick(): single-select menu helper for scalar settings (resolution,
# codec, etc). Always offers "Keep current" and "Custom..." alongside the
# supplied presets, so every setting is reachable even if the caller's
# preset list doesn't cover it — never a dead end back to the CLI.
_tui_pick() {
    local prompt="$1" current="$2"; shift 2
    local -a opts=("$@" "Keep current (${current})" "Custom...")
    local choice
    choice="$(printf '%s\n' "${opts[@]}" \
        | fzf --prompt="${prompt}> " --height='~50%' --reverse --header="Current: ${current}" 2>/dev/null)" || choice=""
    case "$choice" in
        ""|"Keep current"*) printf '%s' "$current" ;;
        "Custom...")
            local custom
            read -r -p "${prompt} (custom value): " custom
            printf '%s' "${custom:-$current}"
            ;;
        *) printf '%s' "$choice" ;;
    esac
}

# tui_options_screen(): the fzf equivalent of advanced_prompt()'s read-based
# flow, walking the same ADV_* variables advanced_prompt() does and calling
# the same save_defaults() at the end so choices persist identically either
# way. Callers dispatch with ADVANCED_MODE left at its current value; since
# this function has already populated ADV_*, a subsequent advanced_prompt()
# call inside the dispatched cmd_* (gated on ADVANCED_MODE) would just
# re-prompt for values already chosen, so run_tui() dispatches with
# ADVANCED_MODE forced false for the duration of the call (restored after).
tui_options_screen() {
    local include_layout="${1:-false}"
    say "Configure encode options (Enter re-selects the current value)."
    ADV_CONTAINER="$(_tui_pick "Container"      "$ADV_CONTAINER"   "mp4" "mkv" "mov")"
    ADV_RES="$(_tui_pick       "Resolution"     "$ADV_RES"         "1920x1080" "1280x720" "3840x2160" "854x480")"
    ADV_FPS="$(_tui_pick       "Frame rate"     "$ADV_FPS"         "24" "30" "60" "120")"
    ADV_CODEC="$(_tui_pick     "Codec"          "$ADV_CODEC"       "libx264" "libx265")"
    ADV_PIX_FMT="$(_tui_pick   "Pixel format"   "$ADV_PIX_FMT"     "yuv420p" "yuv422p" "yuv444p")"
    ADV_PRESET="$(_tui_pick    "Encoder preset" "$ADV_PRESET"      "ultrafast" "fast" "medium" "slow")"
    ADV_QUALITY_MODE="$(_tui_pick "Quality mode" "$ADV_QUALITY_MODE" "crf" "qp0")"
    if [[ "$ADV_QUALITY_MODE" == "crf" ]]; then
        ADV_CRF="$(_tui_pick "CRF (0-51, 18=near-lossless, 23=default)" "$ADV_CRF" "18" "20" "23" "28")"
        ADV_BR="$(_tui_pick "Video bitrate" "$ADV_BR" "2M" "6M" "10M")"
        local multipass; multipass="$(_tui_pick "Two-pass bitrate encode" "$ADV_MULTIPASS" true false)"
        ADV_MULTIPASS=$multipass
    else
        ADV_CRF="18"; ADV_BR="10M"; ADV_MULTIPASS="false"
    fi
    if [[ "$include_layout" == true ]]; then
        LAYOUT_MODE="$(_tui_pick "Composite layout" "$LAYOUT_MODE" "fixed" "random")"
    fi
    local ra_current ra_choice
    ra_current="$([[ "$REMOVE_AUDIO" == true ]] && printf 'yes' || printf 'no')"
    ra_choice="$(_tui_pick "Remove audio" "$ra_current" "yes" "no")"
    [[ "$ra_choice" == "yes" ]] && REMOVE_AUDIO=true || REMOVE_AUDIO=false
    validate_settings
    save_defaults
}

run_tui() {
    local -a menu=(
        "web          -- Browser-compatible MP4 from encoding guide"
        "capabilities -- Inspect installed FFmpeg capabilities"
        "probe        -- Inspect a file's stream info"
        "process      -- Re-encode/scale a file"
        "resume       -- Resume an interrupted merge/composite job"
        "merge        -- Concatenate multiple files"
        "composite    -- Multi-file layout composite"
        "looperang    -- Forward+reverse palindrome"
        "slowmo       -- Slow motion"
        "filter       -- Colour/enhancement filter preset"
        "fix          -- Repair DTS/timestamp issues"
        "clean        -- Strip metadata"
        "clean-fast   -- Strip metadata (stream-copy only)"
        "clip         -- Trim by start/end time"
        "manifest     -- Self-audit SHA-256 manifest"
        "cache-clean  -- Remove FFX cache/checkpoints"
        "help         -- Full usage text"
        "quit         -- Exit"
    )
    local choice cmd
    choice="$(printf '%s\n' "${menu[@]}" \
        | fzf --prompt='ffx> ' --height='~70%' --reverse --header='Select an operation (Esc to quit)' 2>/dev/null)" || choice=""
    [[ -z "$choice" ]] && { say "No selection — exiting."; exit 0; }
    cmd="${choice%% *}"

    local -a dispatch_args=()
    local f

    case "$cmd" in
        web) f="$(tui_pick_one "Web input")"; [[ -n "$f" ]] || die "No file selected"; dispatch_args=(web "$f") ;;
        capabilities) dispatch_args=(capabilities filters) ;;
        probe)
            f="$(tui_pick_one "File to probe")"
            [[ -z "$f" ]] && die "No file selected."
            dispatch_args=(probe "$f")
            ;;
        process)
            f="$(tui_pick_one "Input file")"
            [[ -z "$f" ]] && die "No file selected."
            tui_options_screen false
            local mchoice; mchoice="$(_tui_pick "Clamp to 1080p" "$([[ "$MAX_1080" == true ]] && echo yes || echo no)" "yes" "no")"
            [[ "$mchoice" == "yes" ]] && MAX_1080=true || MAX_1080=false
            dispatch_args=(process "$f")
            ;;
        merge)
            local -a files; mapfile -t files < <(tui_pick_many "Files to merge")
            (( ${#files[@]} >= 1 )) || die "No files selected."
            tui_options_screen false
            local cchoice; cchoice="$(_tui_pick "Composite mode" "no" "yes" "no")"
            dispatch_args=(merge "${files[@]}")
            [[ "$cchoice" == "yes" ]] && dispatch_args+=(-C)
            ;;
        composite)
            local -a files; mapfile -t files < <(tui_pick_many "Files to composite")
            (( ${#files[@]} >= 1 )) || die "No files selected."
            tui_options_screen true
            dispatch_args=(composite "${files[@]}")
            ;;
        looperang)
            f="$(tui_pick_one "Input file")"
            [[ -z "$f" ]] && die "No file selected."
            dispatch_args=(looperang "$f")
            ;;
        slowmo)
            f="$(tui_pick_one "Input file")"
            [[ -z "$f" ]] && die "No file selected."
            local factor; read -r -p "Slow-motion factor (e.g. 2 = half speed) [2]: " factor
            local ichoice; ichoice="$(_tui_pick "Motion interpolation" "no" "yes" "no")"
            [[ "$ichoice" == "yes" ]] && INTERPOLATE=true || INTERPOLATE=false
            dispatch_args=(slowmo "$f" -p "${factor:-2}")
            ;;
        filter)
            f="$(tui_pick_one "Input file")"
            [[ -z "$f" ]] && die "No file selected."
            local preset
            preset="$(printf '%s\n' enhance skintone denoise cross_process hdr2sdr smooth whitecal \
                | fzf --prompt='Filter preset> ' --height='~40%' --reverse 2>/dev/null)"
            dispatch_args=(filter "$f" --preset "${preset:-enhance}")
            ;;
        fix)        f="$(tui_pick_one "Input file")"; [[ -z "$f" ]] && die "No file selected."; dispatch_args=(fix "$f") ;;
        clean)      f="$(tui_pick_one "Input file")"; [[ -z "$f" ]] && die "No file selected."; dispatch_args=(clean "$f") ;;
        clean-fast) f="$(tui_pick_one "Input file")"; [[ -z "$f" ]] && die "No file selected."; dispatch_args=(clean-fast "$f") ;;
        clip)       f="$(tui_pick_one "Input file")"; [[ -z "$f" ]] && die "No file selected."; dispatch_args=(clip "$f") ;;
        manifest)
            local sub
            sub="$(printf '%s\n' save verify show | fzf --prompt='manifest> ' --height='~30%' --reverse 2>/dev/null)"
            dispatch_args=(manifest "${sub:-show}")
            ;;
        resume)      dispatch_args=(resume) ;;
        cache-clean) dispatch_args=(cache-clean) ;;
        help)        display_usage ;;
        quit)        exit 0 ;;
        *)           die "Unknown TUI selection: '$cmd'" ;;
    esac

    local saved_advanced_mode="$ADVANCED_MODE"
    ADVANCED_MODE=false
    main_dispatch "${dispatch_args[@]}"
    local rc=$?
    ADVANCED_MODE="$saved_advanced_mode"
    return "$rc"
}
