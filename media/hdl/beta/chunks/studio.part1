<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>4NDR0666 // 3LECTRIC-GLASS HDL STUDIO</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=JetBrains+Mono:wght@400;700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
<style>
:root{--base:rgb(10,19,26);--g1:rgba(10,19,26,.72);--g2:rgba(10,19,26,.65);--g3:rgba(10,19,26,.55);
--gH:rgba(10,19,26,.95);--cyan:#00E5FF;--cyan2:#67E8F9;--alert:#ff0055;--white:#fff;
--line:rgba(0,229,255,.2);--line2:rgba(0,229,255,.3);--line3:rgba(0,229,255,.4);
--t:150ms ease-in-out;--mono:"JetBrains Mono",monospace;--disp:"Orbitron",sans-serif;}
*{box-sizing:border-box;background:none;margin:0;padding:0;font-family:var(--mono);
transition:color var(--t),background-color var(--t),border-color var(--t),box-shadow var(--t),opacity var(--t);}
html,body{height:100%;}
body{background:#050A0F;color:var(--cyan);overflow:hidden;}
body::before{content:"";position:fixed;inset:0;z-index:-1;background:
radial-gradient(600px 400px at 12% 88%,rgba(0,229,255,.10),transparent 70%),
radial-gradient(700px 500px at 88% 12%,rgba(0,229,255,.07),transparent 70%),
radial-gradient(rgba(0,229,255,.05) 1px,transparent 1px);background-size:auto,auto,28px 28px;}

/* ═══ GLYPH — canonical component. No filters. ═══ */
.gring1{animation:gspinA 36s linear infinite;transform-origin:64px 64px;}
.gring2{animation:gspinB 24s linear infinite;transform-origin:64px 64px;}
.ghex{animation:gspinA 120s linear infinite;transform-origin:64px 64px;}
.gpsi{animation:gpulse 2.6s ease-in-out infinite;}
@keyframes gspinA{to{transform:rotate(360deg);}}
@keyframes gspinB{to{transform:rotate(-360deg);}}
@keyframes gpulse{0%,100%{opacity:.55;}50%{opacity:1;}}

/* ═══ WINDOW — master values ═══ */
#app{position:fixed;inset:14px;display:flex;flex-direction:column;background:var(--g1);
backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);
border:1px solid var(--line);border-radius:6px;box-shadow:0 0 40px rgba(0,229,255,.15);}
#hdr{display:flex;align-items:center;gap:14px;padding:10px 16px;background:var(--gH);
border-bottom:2px solid var(--cyan);flex:0 0 auto;}
#hdr .t{font-family:var(--disp);font-weight:700;font-size:14pt;color:var(--cyan2);letter-spacing:2px;line-height:1;}
#hdr .s{font-size:9pt;color:rgba(0,229,255,.7);letter-spacing:1px;margin-top:2px;}
#hdr .spacer{flex:1;}
#status{flex:0 0 auto;display:flex;align-items:center;gap:10px;padding:6px 16px;background:var(--gH);
border-top:1px solid var(--line);font-size:8pt;color:rgba(0,229,255,.7);}
#status .spacer{flex:1;}

#body{flex:1;display:grid;grid-template-columns:260px 1fr 360px;grid-template-areas:"ctl ed out";
min-height:0;padding:8px;gap:8px;}
#ctl{grid-area:ctl;}#ed{grid-area:ed;}#out{grid-area:out;}
@media(max-width:1150px){#body{grid-template-columns:240px 1fr;grid-template-areas:"ctl ed" "out out";grid-template-rows:auto 1fr 240px;}}
@media(max-width:760px){#app{position:static;margin:0;}#body{grid-template-columns:1fr;grid-template-areas:"ctl" "ed" "out";}body{overflow:auto;}}
.pane{overflow:auto;}

/* ═══ GLASS PANEL ═══ */
.gpanel{background:var(--g3);border:1px solid var(--line2);border-radius:4px;padding:10px;}
.ctlbox{display:flex;flex-direction:column;gap:6px;}
.ltitle{font-family:var(--disp);font-weight:700;font-size:11pt;color:var(--cyan2);}
.lfield{font-size:8pt;color:rgba(0,229,255,.7);letter-spacing:.5px;margin-top:6px;}
.lgroup{font-weight:700;color:var(--cyan2);margin:8px 0 2px;}
.lval{color:var(--cyan2);word-break:break-word;}
.lbadge{color:var(--alert);font-weight:700;font-size:8pt;}
.hr{border:none;border-top:1px solid var(--line);margin:8px 0;}

/* ═══ BUTTONS — spec §4.4 verbatim ═══ */
button{background:rgba(10,19,26,.65);border:1px solid var(--line3);border-radius:0;color:var(--cyan);
font-weight:700;font-size:9pt;padding:10px 20px;cursor:pointer;letter-spacing:1px;}
button:hover{background:rgba(0,229,255,.2);border-color:var(--cyan);color:var(--cyan2);
box-shadow:0 0 20px rgba(0,229,255,.5);}
button:active{background:rgba(0,229,255,.3);color:var(--white);}
button.on,button.active{background:rgba(0,229,255,.3);border-color:var(--cyan);color:var(--white);
box-shadow:0 0 12px rgba(0,229,255,.4);}
button.destructive{border-color:var(--alert);color:var(--alert);}
button.destructive:hover{background:rgba(255,0,85,.3);border-color:var(--alert);box-shadow:0 0 25px var(--alert);color:var(--white);}
button.mini{padding:2px 8px;font-size:8pt;}
.moderail{display:grid;grid-template-columns:1fr 1fr;gap:4px;}
.moderail button{padding:8px 4px;font-size:8pt;}
.seg{display:inline-flex;gap:2px;flex-wrap:wrap;}
.seg button{padding:4px 8px;font-size:8pt;}
.modbtn{padding:4px 10px;font-size:8pt;}

/* ═══ FIELDS ═══ */
input[type=text],input[type=number],textarea{width:100%;background:var(--g3);
border:1px solid var(--line3);border-radius:0;color:var(--cyan);caret-color:var(--cyan);
padding:6px 8px;font-size:9pt;outline:none;font-family:var(--mono);}
input:focus,textarea:focus{border-color:var(--cyan);box-shadow:0 0 12px rgba(0,229,255,.35);}
textarea{resize:vertical;min-height:34px;}
input[type=number]{-moz-appearance:textfield;}
::-webkit-inner-spin-button{display:none;}
.combo{position:relative;}
.combo input,.combo textarea{padding-right:26px;}
.cbtn{position:absolute;right:1px;top:1px;bottom:1px;border:none;border-radius:0;
background:transparent;padding:0 7px;color:rgba(0,229,255,.7);font-size:9pt;
letter-spacing:0;font-weight:400;box-shadow:none;}
.cbtn:hover{background:rgba(0,229,255,.14);border:none;color:var(--cyan);box-shadow:none;}

/* ═══ MANIFEST POPOVER — §4.7 values, fixed/floating ═══ */
#dd-pop{position:fixed;z-index:400;background:var(--g2);
backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
border:1px solid var(--line2);border-radius:4px;
box-shadow:0 0 20px rgba(0,229,255,.15);min-width:300px;max-width:480px;}
.ddhead{padding:4px 8px;font-size:8pt;color:rgba(0,229,255,.55);letter-spacing:1px;
border-bottom:1px solid rgba(0,229,255,.18);text-transform:uppercase;}
.ddnote{padding:4px 8px;font-size:8pt;color:var(--alert);border-bottom:1px solid rgba(255,0,85,.25);}
.ddlist{max-height:300px;overflow-y:auto;}
.dditem{padding:5px 8px;cursor:pointer;border-bottom:1px solid rgba(0,229,255,.08);}
.dditem:hover{background:rgba(0,229,255,.2);}
.dditem:hover .dk,.dditem:hover .ddd{color:var(--white);}
.dditem.cur{border-left:2px solid var(--cyan2);background:rgba(0,229,255,.08);}
.dditem.hide{display:none;}
.dk{color:var(--cyan);font-size:9pt;font-weight:700;}
.ddd{color:rgba(0,229,255,.55);font-size:8pt;display:block;}

/* ═══ SWITCH §4.6 ═══ */
.gswitch{position:relative;width:44px;height:24px;flex:0 0 auto;cursor:pointer;background:#050A0F;
border:1px solid var(--cyan);border-radius:0;}
.gswitch .knob{position:absolute;top:2px;left:2px;width:18px;height:18px;background:var(--cyan);
box-shadow:0 0 12px rgba(0,229,255,.8);transition:left var(--t);}
.gswitch.on{background:rgba(0,229,255,.2);}
.gswitch.on .knob{left:22px;}

/* ═══ CHIPS ═══ */
.chips{display:flex;flex-wrap:wrap;gap:4px;align-items:center;}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line3);
background:rgba(10,19,26,.65);padding:2px 6px;font-size:8pt;color:var(--cyan2);}
.chip .x{cursor:pointer;color:var(--alert);font-weight:700;}
.chip .x:hover{text-shadow:0 0 8px var(--alert);}
.chiprow{display:flex;gap:4px;margin-top:4px;align-items:stretch;}
.chiprow .combo{flex:1;}

/* ═══ SECTIONS ═══ */
#sections{display:flex;flex-direction:column;gap:8px;}
details.section{background:var(--g3);border:1px solid var(--line2);border-radius:4px;}
details.section>summary{list-style:none;cursor:pointer;padding:10px 12px;font-family:var(--disp);
font-weight:700;font-size:11pt;color:var(--cyan2);display:flex;align-items:center;gap:10px;user-select:none;}
details.section>summary::-webkit-details-marker{display:none;}
details.section>summary .arr{font-family:var(--mono);color:var(--cyan);transition:transform var(--t);}
details.section[open]>summary .arr{transform:rotate(90deg);}
details.section[open]>summary{border-bottom:1px solid var(--line2);}
.sbtns{margin-left:auto;display:flex;gap:4px;}
.secbody{padding:10px 14px;}
.pcard{border:1px solid var(--line2);border-radius:4px;background:rgba(10,19,26,.55);
padding:8px;margin-bottom:8px;}
.pcard .phead{display:flex;gap:6px;align-items:center;margin-bottom:6px;}
.pcard .phead .combo,.pcard .phead input{flex:1;}

/* ═══ OUTPUT ═══ */
#out .gpanel{height:100%;display:flex;flex-direction:column;gap:8px;}
#outpre{flex:1;overflow:auto;white-space:pre;font-size:8pt;line-height:1.5;color:var(--cyan2);}
#outpre.wrap{white-space:pre-wrap;word-break:break-word;}
.j-key{color:var(--cyan);} .j-str{color:var(--cyan2);} .j-num{color:var(--white);} .j-dim{color:#0f6d7a;}
.outhead{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.outhead .spacer{flex:1;}

/* ═══ TOAST ═══ */
#toast{position:fixed;top:28px;left:50%;transform:translateX(-50%) translateY(-16px);opacity:0;
pointer-events:none;background:var(--g2);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
border:1px solid var(--line2);border-radius:4px;padding:10px 20px;color:var(--white);
font-weight:700;font-size:9pt;letter-spacing:1px;box-shadow:0 0 20px rgba(0,229,255,.15);
transition:opacity var(--t),transform var(--t);z-index:500;}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
#toast.error{border-color:var(--alert);color:var(--alert);box-shadow:0 0 25px var(--alert);}

/* ═══ WIZARD ═══ */
#wiz{position:fixed;inset:0;background:rgba(5,10,15,.7);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);
display:none;align-items:center;justify-content:center;z-index:90;}
#wiz.open{display:flex;}
.wpanel{width:min(680px,92vw);max-height:86vh;display:flex;flex-direction:column;gap:10px;
background:var(--g2);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
border:1px solid var(--line3);border-radius:4px;box-shadow:0 0 40px rgba(0,229,255,.25);padding:16px;}
.wtitle{font-family:var(--disp);font-weight:700;font-size:12pt;color:var(--cyan2);letter-spacing:1px;}
.wprog{font-size:8pt;color:rgba(0,229,255,.7);}
.wbar{height:3px;background:rgba(0,229,255,.12);}
.wbar div{height:100%;background:var(--cyan);box-shadow:0 0 8px var(--cyan);transition:width var(--t);}
.wsec{font-size:9pt;font-weight:700;color:var(--cyan2);}
.wpath{font-size:8pt;color:rgba(0,229,255,.55);word-break:break-all;}
#wmount{overflow:auto;max-height:48vh;padding:4px 0;}
.wbtns{display:flex;gap:6px;flex-wrap:wrap;}
.wbtns .spacer{flex:1;}
.modrow{display:flex;align-items:center;gap:6px;padding:7px 8px;border:1px solid var(--line2);
background:rgba(10,19,26,.55);border-radius:4px;margin-bottom:6px;flex-wrap:wrap;}
.modrow .mtitle{flex:1;font-size:9pt;font-weight:700;color:var(--cyan2);min-width:150px;}
.modrow.mstatic .mtitle{color:rgba(0,229,255,.5);}

/* ═══ SCROLLBARS §4.8 ═══ */
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:rgba(0,0,0,.4);}
::-webkit-scrollbar-thumb{background:var(--cyan);border-radius:0;}
::-webkit-scrollbar-thumb:hover{background:var(--cyan2);}
*{scrollbar-width:thin;scrollbar-color:var(--cyan) rgba(0,0,0,.4);}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="glyph" viewBox="0 0 128 128" fill="none" stroke="#00E5FF"
 stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <path class="gring1" d="M 64,12 A 52,52 0 1 1 63.9,12 Z" stroke-dasharray="21.78 21.78" stroke-width="2"/>
  <path class="gring2" d="M 64,20 A 44,44 0 1 1 63.9,20 Z" stroke-dasharray="10 10" stroke-width="1.5" opacity="0.7"/>
  <path class="ghex" d="M64 30 L91.3 47 L91.3 81 L64 98 L36.7 81 L36.7 47 Z"/>
  <text class="gpsi" x="64" y="67" text-anchor="middle" dominant-baseline="middle"
   fill="#00E5FF" stroke="none" font-size="56" font-weight="700"
   font-family="'Cinzel Decorative',serif">Ψ</text>
</symbol>
</defs></svg>

<div id="app">
  <header id="hdr">
    <svg width="26" height="26"><use href="#glyph"/></svg>
    <div><div class="t">4NDR0666</div>
    <div class="s">3LECTRIC-GLASS // HDL PROMPT ENGINE // OVERRIDE LEVEL 800</div></div>
    <div class="spacer"></div>
    <button id="btn-export">EXPORT</button>
    <button id="btn-purge" class="destructive">PURGE ✖</button>
  </header>
  <div id="body">
    <aside id="ctl" class="pane"><div class="gpanel ctlbox">
      <svg width="52" height="52" style="margin:0 auto;display:block"><use href="#glyph"/></svg>
      <div class="ltitle" style="text-align:center">4NDR0TOOLS</div>
      <div class="lfield" style="text-align:center;margin:0">MODE SELECTION</div>
      <div class="moderail">
        <button id="m-default">DEFAULT</button>
        <button id="m-stock">STOCK</button>
        <button id="m-hybrid">HYBRID</button>
        <button id="m-random">RANDOM</button>
      </div>
      <div class="lfield" style="margin-top:6px;line-height:1.7">
        DEFAULT — walk every field from defaults<br>
        STOCK — parse default HDL prompt only<br>
        HYBRID — module select: skip / walk / ⚡rnd<br>
        RANDOM — instant randomized schema
      </div>
      <hr class="hr">
      <div class="lfield">SEED (0 = RND)</div>
      <div style="display:flex;gap:4px;align-items:stretch;">
        <input type="number" id="seed" min="0" max="999999" value="0" style="flex:1">
        <button class="mini" id="btn-rnd">RND</button>
      </div>
      <div class="lfield">PANELS</div>
      <input type="number" id="panels" min="1" max="9" value="6">
      <button id="btn-gen">GENERATE (RANDOM)</button>
      <hr class="hr">
      <div class="lfield">OUTPUT MODE</div>
      <div style="display:flex;align-items:center;gap:8px">
        <span class="lfield" style="margin:0">JSON</span>
        <div class="gswitch" id="modesw"><div class="knob"></div></div>
        <span class="lfield" style="margin:0">FLAT</span>
      </div>
    </div></aside>
    <main id="ed" class="pane"><div id="sections"></div></main>
    <aside id="out" class="pane"><div class="gpanel">
      <div class="outhead"><span class="ltitle">LIVE OUTPUT</span><div class="spacer"></div>
        <button class="mini" id="btn-copyjson">COPY JSON</button>
        <button class="mini" id="btn-copyflat">COPY FLAT</button></div>
      <pre id="outpre"></pre>
    </div></aside>
  </div>
  <footer id="status">
    <svg width="20" height="20"><use href="#glyph"/></svg>
    <span id="statustext">ENGINE: BROWSER-NATIVE // MODULE REGISTRY ACTIVE</span>
    <div class="spacer"></div><span id="statmode"></span>
  </footer>
</div>

<div id="toast"></div>

<div id="wiz"><div class="wpanel">
  <div class="wtitle" id="wtitle">WALK</div>
  <div class="wprog" id="wprog"></div>
  <div class="wbar"><div id="wfill"></div></div>
  <div class="wsec" id="wsec"></div>
  <div class="wpath" id="wpath"></div>
  <div id="wmount"></div>
  <div class="wbtns" id="wfieldbtns">
    <button id="wkeep">ACCEPT →</button>
    <button id="wrest">KEEP ALL REMAINING</button>
    <div class="spacer"></div>
    <button id="wabort" class="destructive">ABORT</button>
  </div>
  <div class="wbtns" id="wmodbtns" style="display:none;">
    <button id="wbegin">BEGIN WALK →</button>
    <button id="wwalkall">WALK ALL</button>
    <button id="wrndall">⚡RND ALL</button>
    <button id="wskipall">SKIP ALL</button>
    <div class="spacer"></div>
    <button id="wabort2" class="destructive">ABORT</button>
  </div>
</div></div>

<script>
"use strict";
/* ═══════════════════════════════════════════════════════════════════════════
   MANIFEST REGISTRY — verbatim port of promptlib.py (full-length descriptions).
   REGISTRY ⇄ SOURCE PARITY: canonical across all manifests, including the
   Vintage / Character Lenses block. No authored data remains.
   ═══════════════════════════════════════════════════════════════════════ */
const M = {
  "views": {
    "EXTREME CLOSE-UP (ECU/XCU)": "Fills frame with single feature \u2014 eye, mouth, hand",
    "CLOSE-UP (CU)": "Head and shoulders only, tight on face",
    "MEDIUM CLOSE-UP (MCU)": "Chest and above \u2014 classic portrait framing",
    "MEDIUM SHOT (MS)": "Waist and above \u2014 standard conversational",
    "FULL SHOT (FS)": "Head to toe \u2014 full body in frame",
    "WIDE SHOT (WS/LS)": "Subject dwarfed by environment \u2014 context dominant",
    "EXTREME WIDE SHOT (EWS/XLS)": "Maximum environment \u2014 subject near invisible",
    "BIRDS EYE (BE)": "True overhead, 90\u00b0 looking directly down",
    "AERIAL OBLIQUE (AO)": "45\u201370\u00b0 downward from height \u2014 dramatic spatial context",
    "WORM EYE LOW ANGLE (WELA)": "Camera at ground level looking steeply upward",
    "LOW ANGLE DUTCH (LAD)": "Below subject, canted frame \u2014 power + disorientation",
    "HIGH ANGLE STANDARD (HAS)": "Above subject looking down at 20\u201345\u00b0",
    "SIDE CLOSE-UP (SCU)": "Lateral profile, chest level, slight downward tilt",
    "THREE_QUARTER DRAMATIC HIGH ANGLE (TQDH)": "45\u00b0 rotated, elevated 8ft, looking down",
    "FRONT FISH EYE (FE)": "Ultra-wide rectilinear distortion, full front",
    "FRONT EXTREME CLOSE-UP MACRO (ECUM/XCUM)": "100mm macro, full rib cage, f/2.8, razor sharp",
    "OVER_SHOULDER (OS)": "Camera behind and above one shoulder, sees face",
    "DUTCH_ANGLE_45 (DA45)": "Frame canted 45\u00b0 clockwise \u2014 tension, instability",
    "TRACKING_LATERAL (TL)": "Camera moves parallel to subject mid-motion",
    "REACTION SHOT (RS)": "Tight on face catching emotional response",
    "INSERT MACRO DETAIL (IMD)": "Object or body-part detail \u2014 hands, lips, fabric",
    "SPLIT DIOPTER (SD)": "Two focal planes sharp simultaneously",
    "RACK_FOCUS_PULL (RFP)": "Foreground sharp \u2192 background sharp, soft middle",
    "COWBOY SHOT (CS)": "Mid-thigh to head \u2014 American Western framing",
    "TWO SHOT (2S)": "Two subjects in same frame, balanced composition",
    "POINT OF VIEW (POV)": "Camera occupies subject's optical perspective",
    "EXTREME MACRO DETAIL (XMD)": "Sub-millimetre magnification \u2014 pore, thread, droplet",
    "REVERSE ANGLE (RA)": "180\u00b0 cut from prior angle \u2014 facing same axis",
    "HANDHELD UNSTABLE (HU)": "Deliberate camera shake \u2014 urgency, documentary feel",
    "SURVEILLANCE HIGH STATIC (SHS)": "Fixed high-corner security-cam aesthetic, wide",
    "SNORKEL UNDERWATER (SUW)": "Below waterline looking up \u2014 distorted refraction",
    "PERISCOPE LOW FLOOR (PLF)": "Camera at floor plane looking along surface",
    "SILHOUETTE CONTRE-JOUR (SCJ)": "Subject fully backlit, detail lost to pure shadow form",
    "PROFILE STRICT (PS)": "Pure 90\u00b0 lateral \u2014 zero facial front, full depth",
    "NAPE OF NECK (NON)": "Tight on back of neck, base of skull, hair fall",
    "HAND DETAIL MACRO (HDM)": "Hands only \u2014 knuckles, veins, tension, grip detail"
  },
  "kinematic": {
    "structural_alignment": {
      "anatomic_neutral": "0.0,0.0,0.0",
      "supine_flat": "0.0,-1.0,0.0",
      "supine_head_elevated": "0.0,-0.9,0.1",
      "supine_legs_elevated": "0.0,-0.9,-0.1",
      "prone_flat": "0.0,1.0,0.0",
      "prone_head_turned_left": "-0.1,1.0,0.0",
      "prone_head_turned_right": "0.1,1.0,0.0",
      "fetal_position_left": "-0.5,-0.5,0.0",
      "fetal_position_right": "0.5,-0.5,0.0",
      "lateral_recumbent_left": "-1.0,0.0,0.0",
      "lateral_recumbent_right": "1.0,0.0,0.0",
      "spinal_extension_mild": "0.0,0.1,0.0",
      "spinal_extension_maximum": "0.0,0.4,0.0",
      "spinal_flexion_forward": "0.0,-0.3,0.1",
      "spinal_flexion_deep": "0.0,-0.6,0.3",
      "lateral_tilt_left": "-0.2,0.0,0.0",
      "lateral_tilt_right": "0.2,0.0,0.0",
      "axial_rotation_left": "0.0,0.0,-0.3",
