const LEVEL_KEYS=new Set(["PHOTON_TRANSMISSION_RATIO","MEAN_FREE_PATH_SCATTERING","BACKLIT_SUBSURFACE_GLOW","FRESNEL_REFLECTION_COEFFICIENT","SPECULAR_HIGHLIGHT_LOBE","LAMBERTIAN_DIFFUSE_REFLECTANCE","MICRO_FIBER_DRAPE_PHYSICS","LOW_TENSILE_STRUCTURAL_DEFORMITY","GRAVITY_WEIGHTED_FOLDS","SUB_MICRON_WEAVE_DENSITY","SURFACE_ADHESION_COEFFICIENT"]);
function poolForCtl(path){
  const key=path[path.length-1];
  if(path.includes("!EXEC_COMPOSITION_MATRIX")){
    if(key==="LAYOUT_PRESET")return"layouts";
    if(key==="PANELS")return"counts";
    return"poses";
  }
  return POOL_OF_KEY[key]||null;
}

