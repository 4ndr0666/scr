  dofFg:M.dofFg, dofMg:M.dofMg, dofBg:M.dofBg,
  textStr:M.textStr, textFont:M.textFont, textPlace:M.textPlace
};
function poolEntries(name){
  const p=POOLS[name]; if(!p) return [];
  return Array.isArray(p)?p.map(k=>({k,d:null})):Object.entries(p).map(([k,d])=>({k,d}));
}
const MACRO_VIEWS=new Set(["FRONT EXTREME CLOSE-UP (ECU/XCU)","FRONT EXTREME CLOSE-UP MACRO(ECUM/XCUM)","FRONT EXTREME CLOSE-UP MACRO (ECUM/XCUM)","INSERT MACRO DETAIL (IMD)","EXTREME MACRO DETAIL (XMD)","HAND DETAIL MACRO (HDM)"]);
const LIST_VIEWS=new Set(["SIDE CLOSE-UP (SCU)","THREE_QUARTER DRAMATIC HIGH ANGLE (TQDH)"]);

const POOL_OF_KEY={
LOCATION_SETTING:"location",GLASS_SURFACE_METRICS:"glass",PARTICULATE_SCATTERING:"meteo",WIND_VECTOR_FORCE:"meteo",
FOREGROUND:"dofFg",MIDGROUND:"dofMg",BACKGROUND:"dofBg",
LAYOUT_PRESET:"layouts",PANELS:"counts",
SKIN_TOPOGRAPHY_LOGIC:"topo",SURFACE_MICRO_ELEMENTS:"skinMicro",REFLECTANCE_MAP:"skinRef",EXPRESSION:"skinExp",HAIR:"skinHair",
