function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function makeRng(seed){const rng=mulberry32(seed==null?(Math.random()*1e9)|0:seed);
const r=a=>a[Math.floor(rng()*a.length)];
const rl=(a,lo,hi)=>{const k=lo+Math.floor(rng()*(Math.min(hi,a.length)-lo+1));const c=a.slice(),o=[];while(o.length<k)o.push(c.splice(Math.floor(rng()*c.length),1)[0]);return o;};
return{rng,r,rl};}
const clone=o=>JSON.parse(JSON.stringify(o));

