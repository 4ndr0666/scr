    "$schema": {
      "const": "./hdl-v8.schema.json"
    },
    "!INIT_MEM_LOCK": {
      "$ref": "#/$defs/memoryLock"
    },
    "!INIT_ATMOSPHERICS": {
      "$ref": "#/$defs/atmospherics"
    }
  },
  "required": [
    "!INIT_MEM_LOCK",
    "!INIT_ATMOSPHERICS"
  ],
  "additionalProperties": false,
  "$defs": {
