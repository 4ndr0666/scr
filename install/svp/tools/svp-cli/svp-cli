#!/usr/bin/env bash
# === Ψ SVP-CLI // APPLE TV SVPLAYER CONTROLLER & TELEMETRY SUITE === (c) 2026 - 4ndr0666
# Standalone CLI controller for Apple TV (AppleTV5,3) SVPlayer REST API (/r/*),
# Hardware-Tuned mpv.conf management, Nerd Settings snapshot/restore, Browser DevTools JS
# snippet generator, systemd auto-heal watchdog, and seamless delegation to standalone M3 & mkplaylist.
set -euo pipefail

VERSION="3.2.0"

# -----------------------------------------------------------------------------
# Global State & XDG Base Directories
# -----------------------------------------------------------------------------
SVP_HOST="${SVP_HOST:-http://192.168.1.211}"
SVP_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/svp"
M3_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/m3u8/m3u8.conf"
M3_CONFIG_DIR="${M3_CONFIG_FILE%/*}"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/logs"
TMP_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/m3u8dl"
TMP_DIR="${TMP_BASE}/$$"
SAVE_DIR="${SVP_STREAM_DIR:-$HOME/streamdir}"
NERD_SNAPSHOT="${SVP_CONFIG_DIR}/nerd-settings.json"
MPV_SNAPSHOT="${SVP_CONFIG_DIR}/mpv.conf"
JS_SNIPPET_FILE="${SVP_CONFIG_DIR}/svp-nerd-injector.js"
CADDY_PORT="${SVP_CADDY_PORT:-3000}"

THREAD_COUNT=8
RETRY_COUNT=5
SAVE_NAME=""
PROXY_URL=""
TARGET_URL=""
BIN_M3U8=""

# M3 fallback switches
AUTO_SELECT=1
SKIP_MERGE=0
DEL_AFTER_DONE=1
USE_FFMPEG_CONCAT=0
LIVE_REAL_TIME_MERGE=0
LIVE_PERFORM_AS_VOD=0

PRESET_URL_1="https://example.com/master.m3u8"
PRESET_LABEL_1="Preset Stream 1"
PRESET_URL_2="https://example.com/live.m3u8"
PRESET_LABEL_2="Preset Stream 2"

# -----------------------------------------------------------------------------
# Output & Validation Helpers (#15FFFF Theme)
# -----------------------------------------------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
	C_RED=$'\033[1;31m'
	C_GRN=$'\033[1;32m'
	C_CYN=$'\033[38;2;21;255;255m'
	C_YLW=$'\033[1;33m'
	C_RST=$'\033[0m'
else
	C_RED='' C_GRN='' C_CYN='' C_YLW='' C_RST=''
fi

info() { printf '%s[Ψ] %s%s\n' "$C_CYN" "$*" "$C_RST"; }
ok()   { printf '%s[+] %s%s\n' "$C_GRN" "$*" "$C_RST"; }
warn() { printf '%s[*] %s%s\n' "$C_YLW" "$*" "$C_RST" >&2; }
err()  { printf '%s[!] %s%s\n' "$C_RED" "$*" "$C_RST" >&2; }
die()  { err "$*"; exit 1; }

is_uint() {
	case ${1:-} in '' | *[!0-9]* | 0*) return 1 ;; *) return 0 ;; esac
}

ensure_dir() {
	mkdir -p -- "$1" 2>/dev/null || die "Cannot create directory: $1"
	[[ -w "$1" ]] || die "Directory not writable: $1"
}

cleanup() {
	[[ -d "$TMP_DIR" ]] && rm -rf -- "$TMP_DIR" || true
}
trap cleanup EXIT INT TERM

ensure_dir "$SVP_CONFIG_DIR"
ensure_dir "$M3_CONFIG_DIR"
ensure_dir "$LOG_DIR"

detect_lan_ip() {
	if command -v ip >/dev/null 2>&1; then
		ip -o -4 addr show up scope global 2>/dev/null | \
			awk '$2 !~ /^(lo|tun|tap|wg|docker|br-|veth|virbr)/ && $4 !~ /\/32$/ {split($4,a,"/"); print a[1]; exit}'
	fi
}

resolve_m3_script() {
	local self_dir
	self_dir="$(cd -- "$(dirname -- "$0")" && pwd -P)"
	if [[ -x "${self_dir}/M3" ]]; then
		printf '%s\n' "${self_dir}/M3"
		return 0
	elif command -v M3 >/dev/null 2>&1; then
		command -v M3
		return 0
	fi
	return 1
}

# -----------------------------------------------------------------------------
# M3 Dependency & Configuration Management (Preserved & Delegated to Standalone M3)
# -----------------------------------------------------------------------------
check_m3_deps() {
	for bin in N_m3u8DL-RE n-m3u8dl-re N-m3u8DL-RE n-m3u8dl-re-git N-m3u8dl-RE-git; do
		if command -v "$bin" >/dev/null 2>&1; then
			BIN_M3U8="$bin"
			break
		fi
	done
	[[ -n "$BIN_M3U8" ]] || die "Missing N_m3u8DL-RE in PATH."
	command -v ffmpeg >/dev/null 2>&1 || die "Missing ffmpeg in PATH."
}

load_m3_config() {
	[[ -f "$M3_CONFIG_FILE" ]] || return 0
	while IFS='=' read -r key val || [[ -n "$key" ]]; do
		case "$key" in '' | \#*) continue ;; esac
		val="${val#\"}"
		val="${val%\"}"
		case "$key" in
			THREAD_COUNT) is_uint "$val" && THREAD_COUNT="$val" ;;
			RETRY_COUNT)  is_uint "$val" && RETRY_COUNT="$val" ;;
			SAVE_DIR)     [[ -n "$val" ]] && SAVE_DIR="$val" ;;
			TMP_BASE)     [[ -n "$val" ]] && TMP_BASE="$val" && TMP_DIR="${TMP_BASE}/$$" ;;
			PROXY_URL)    PROXY_URL="$val" ;;
			SVP_HOST)     [[ -n "$val" ]] && SVP_HOST="$val" ;;
		esac
	done <"$M3_CONFIG_FILE"
}

save_m3_config() {
	local m3_bin=""
	if m3_bin="$(resolve_m3_script)"; then
		SVP_HOST="$SVP_HOST" "$m3_bin" --create-config
		return 0
	fi
	ensure_dir "$M3_CONFIG_DIR"
	cat <<EOF >"$M3_CONFIG_FILE"
# Ψ-4ndr0666 SVP & N_m3u8DL-RE Orchestrator Configuration
SVP_HOST="$SVP_HOST"
THREAD_COUNT="$THREAD_COUNT"
RETRY_COUNT="$RETRY_COUNT"
SAVE_DIR="$SAVE_DIR"
TMP_BASE="$TMP_BASE"
PROXY_URL="$PROXY_URL"
EOF
	ok "Configuration locked at $M3_CONFIG_FILE"
}

# -----------------------------------------------------------------------------
# Optimal AppleTV5,3 mpv.conf Emitter
# -----------------------------------------------------------------------------
