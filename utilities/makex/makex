# Scores the first SNIFF_LINES lines of a shebang-less text chunk. Sets TEXT_KIND to
# "shell" (strong evidence of a runnable shell script) or, as an advisory only,
# "python" | "perl" | "ruby" | "node"; empty when nothing is conclusive.
scan_text() {
    local chunk="$1" line n=0
    local s_fi=0 s_done=0 s_esac=0 s_set=0 s_if=0 s_func=0 s_pos=0 s_exp=0 s_echo=0 s_exit=0
    local p_main=0 p_imp=0 p_def=0 pl_use=0 rb_req=0 rb_end=0 js_req=0 js_out=0
    TEXT_KIND=""

    while IFS= read -r line; do
        if (( ++n > SNIFF_LINES )); then
            break
        fi
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        [[ "$line" =~ $RE_SH_FI ]]    && s_fi=1
        [[ "$line" =~ $RE_SH_DONE ]]  && s_done=1
        [[ "$line" =~ $RE_SH_ESAC ]]  && s_esac=1
        [[ "$line" =~ $RE_SH_SET ]]   && s_set=1
        [[ "$line" =~ $RE_SH_IF ]]    && s_if=1
        [[ "$line" =~ $RE_SH_FUNC ]]  && s_func=1
        [[ "$line" =~ $RE_SH_POS ]]   && s_pos=1
        [[ "$line" =~ $RE_SH_EXP ]]   && s_exp=1
        [[ "$line" =~ $RE_SH_ECHO ]]  && s_echo=1
        [[ "$line" =~ $RE_SH_EXIT ]]  && s_exit=1
        [[ "$line" =~ $RE_PY_MAIN ]]  && p_main=1
        [[ "$line" =~ $RE_PY_IMP ]]   && p_imp=1
        [[ "$line" =~ $RE_PY_DEF ]]   && p_def=1
        [[ "$line" =~ $RE_PL_USE ]]   && pl_use=1
        [[ "$line" =~ $RE_RB_REQ ]]   && rb_req=1
        [[ "$line" =~ $RE_RB_END ]]   && rb_end=1
        [[ "$line" =~ $RE_JS_REQ ]]   && js_req=1
        [[ "$line" =~ $RE_JS_OUT ]]   && js_out=1
    done <<<"$chunk"

    local closers=$(( s_fi + s_done + s_esac + s_set + s_if ))
    local total=$(( closers + s_func + s_pos + s_exp + s_echo + s_exit ))
    if (( p_main + p_imp + p_def == 0 && closers >= 1 && total >= 3 )); then
        TEXT_KIND="shell"
    elif (( p_main || (p_imp && p_def) )); then
        TEXT_KIND="python"
    elif (( pl_use )); then
        TEXT_KIND="perl"
    elif (( rb_req && rb_end )); then
        TEXT_KIND="ruby"
    elif (( js_req && js_out )); then
        TEXT_KIND="node"
    fi
    return 0
}

# Layered, content-first classification. Sets CLASS to one of:
#   script - will be (or should stay) runnable: any shebang, .sh, or strong shell content
#   data   - non-executable by nature: data extension/name, known non-exec magic bytes,
#            or an interpreted-language source file that has no shebang
#   native - compiled executable (ELF, Mach-O, PE): never touched
#   other  - inconclusive: never touched
# Sets ADVISORY to a language name when a shebang-less file looks like a non-shell script.
CLASS="other"
ADVISORY=""
TEXT_KIND=""
classify() {
    local target="$1"
    local LC_ALL=C
    local name lname ext="" chunk="" rc=0 has_nul=0 first

    CLASS="other"
    ADVISORY=""
    name="${target##*/}"
    lname="${name,,}"

    # 1. Name and extension: unconditional non-executable types.
    if [[ " $DATA_NAMES " == *" $lname "* ]]; then
        CLASS="data"
        return 0
    fi
    case "$lname" in
        .*rc|.profile|.bash_*|.zsh*|.env|.env.*|.git*|.editorconfig)
            CLASS="data"
            return 0
            ;;
    esac
    if [[ "$lname" == *.* ]]; then
        ext="${lname##*.}"
        if [[ "$ext" != *[[:space:]]* && " $DATA_EXTS " == *" $ext "* ]]; then
            CLASS="data"
            return 0
        fi
    fi

    # 2. Content sniff: one bounded builtin read. read -d '' stops at the first NUL,
    # so (status 0 and short chunk) means a NUL arrived early, i.e. a binary file.
    IFS= read -r -d '' -n "$SNIFF_BYTES" chunk 2>/dev/null <"$target" || rc=$?
    if [[ "$rc" -eq 0 && ${#chunk} -lt "$SNIFF_BYTES" ]]; then
        has_nul=1
    fi

    # 3. Shebang: any interpreter makes the file a script.
    if [[ "$chunk" == '#!'* ]]; then
        first="${chunk%%$'\n'*}"
        if [[ "$first" =~ $SHEBANG_PATTERN ]]; then
            CLASS="script"
            return 0
        fi
    fi

    # 4. Native executables are never touched.
    case "$chunk" in
        $'\x7f'ELF*|$'\xcf\xfa\xed\xfe'*|$'\xce\xfa\xed\xfe'*|$'\xfe\xed\xfa\xce'*|$'\xfe\xed\xfa\xcf'*|$'\xca\xfe\xba\xbe'*)
            CLASS="native"
            return 0
            ;;
        MZ*)
            if [[ "$has_nul" -eq 1 ]]; then
                CLASS="native"
                return 0
            fi
            ;;
    esac

    # 5. A .sh name is a strong hint (original behavior), but content can overrule it:
    # binary data or clearly non-shell source (Python/Perl/Ruby/Node) is not a shell script.
    if [[ "$ext" == "sh" ]]; then
        if [[ "$has_nul" -eq 1 ]]; then
            return 0
        fi
        scan_text "$chunk"
        if [[ -n "$TEXT_KIND" && "$TEXT_KIND" != "shell" ]]; then
            ADVISORY="$TEXT_KIND"
            return 0
        fi
        CLASS="script"
        return 0
    fi

    # 6. Known non-executable formats by magic bytes (works with no/wrong extension).
    case "$chunk" in
        $'\x89PNG'*|$'\xff\xd8\xff'*|GIF87a*|GIF89a*|'%PDF-'*|$'PK\x03\x04'*|$'\x1f\x8b'*|$'\xfd7zXZ'*|$'7z\xbc\xaf'*|$'\x28\xb5\x2f\xfd'*|'SQLite format 3'*)
            CLASS="data"
            return 0
            ;;
        BZh*|RIFF*|OggS*|fLaC*|ID3*|wOFF*|wOF2*|Rar!*)
            if [[ "$has_nul" -eq 1 ]]; then
                CLASS="data"
                return 0
            fi
            ;;
    esac

    # 7. Interpreted-language sources without a shebang cannot be exec'd meaningfully.
    if [[ -n "$ext" && "$ext" != *[[:space:]]* && " $SCRIPTY_EXTS " == *" $ext "* ]]; then
        CLASS="data"
        return 0
    fi

    # 8. Unknown binary: leave alone. Unknown text: sniff for shell-script content.
    if [[ "$has_nul" -eq 1 ]]; then
        return 0
    fi
    scan_text "$chunk"
    if [[ "$TEXT_KIND" == "shell" ]]; then
        CLASS="script"
    else
        ADVISORY="$TEXT_KIND"
    fi
    return 0
}

check_is_script() {
    classify "$1"
    [[ "$CLASS" == "script" ]] || return 1
    return 0
}

check_is_data() {
    classify "$1"
    [[ "$CLASS" == "data" ]] || return 1
    return 0
}

# Unprivileged chmod first; escalate through sudo only when the kernel refuses.
try_chmod() {
    local chmod_op="$1"
    shift
    local err=""
    if err="$(chmod -- "$chmod_op" "$@" 2>&1)"; then
        return 0
    fi
    if [[ "$EUID" -ne 0 && "$HAVE_SUDO" -eq 1 ]]; then
        if err="$(sudo chmod -- "$chmod_op" "$@" 2>&1)"; then
            return 0
        fi
    fi
    LAST_CHMOD_ERR="$err"
    return 1
}

report_scan_errors() {
    local phase="$1"
    [[ -s "$SCAN_ERR" ]] || return 0
    local n first
    n="$(wc -l <"$SCAN_ERR")"
    first="$(head -n 1 "$SCAN_ERR")"
    sanitize "$first"
    log_warn "Phase $phase scan incomplete: $((n + 0)) unreadable path(s). First: ${SAFE_DISPLAY}"
    (( scan_warnings += n )) || true
    : >"$SCAN_ERR"
}

flush_batch() {
    local chmod_op="$1"
    local phase="$2"
    shift 2
    local -a files=("$@")
    local verb f ok_count=0 bad_count=0

    [[ ${#files[@]} -eq 0 ]] && return 0

    if [[ "$phase" == "1" ]]; then
        verb="$SCRIPT_PAST_TENSE_VERB"
    else
        verb="$NON_SCRIPT_PAST_TENSE_VERB"
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        for f in "${files[@]}"; do
            if [[ "$QUIET" -eq 0 ]]; then
                sanitize "$f"
                log_ok "[DRY-RUN] Would apply chmod $chmod_op to '${CYAN}${SAFE_DISPLAY}${RESET}'."
            fi
        done
        ok_count=${#files[@]}
    elif try_chmod "$chmod_op" "${files[@]}"; then
        for f in "${files[@]}"; do
            if [[ "$QUIET" -eq 0 ]]; then
                sanitize "$f"
                log_ok "$verb '${CYAN}${SAFE_DISPLAY}${RESET}'."
            fi
        done
        ok_count=${#files[@]}
    else
        # Batch refused: isolate per file so one vanished/forbidden path cannot
        # mask (or be blamed for) the rest of the batch. chmod is idempotent.
        for f in "${files[@]}"; do
            sanitize "$f"
            if try_chmod "$chmod_op" "$f"; then
                if [[ "$QUIET" -eq 0 ]]; then
                    log_ok "$verb '${CYAN}${SAFE_DISPLAY}${RESET}'."
                fi
                (( ok_count += 1 )) || true
            else
                log_err "chmod $chmod_op failed on '${SAFE_DISPLAY}' (phase $phase): ${LAST_CHMOD_ERR}"
                (( bad_count += 1 )) || true
            fi
        done
    fi

    if [[ "$phase" == "1" ]]; then
        (( files_changed_phase1 += ok_count )) || true
    else
        (( files_changed_phase2 += ok_count )) || true
    fi
    (( total_failures += bad_count )) || true
}

report_advisories() {
    [[ "$advisory_total" -gt 0 ]] || return 0
    local entry lang path shown=0
    log_warn "$advisory_total shebang-less file(s) look like scripts; chmod +x cannot make them runnable (add a shebang line):"
    if [[ "$QUIET" -eq 0 ]]; then
        for entry in "${ADVISORIES[@]}"; do
            if (( shown >= ADVISORY_SHOW_LIMIT )); then
                break
            fi
            lang="${entry%%|*}"
            path="${entry#*|}"
            sanitize "$path"
            log_warn "  [${lang}] '${SAFE_DISPLAY}'"
            (( shown += 1 )) || true
        done
        if (( advisory_total > shown )); then
            log_warn "  ... and $(( advisory_total - shown )) more"
        fi
    fi
    return 0
}

# ==============================================================================
# PHASE 1: SCRIPT DETECTION (content-aware)
# ==============================================================================
log_op "PHASE 1: Engaging $SCRIPT_ACTION_VERB script directives..."

# Find-level pre-filter derived from the same lists classify() uses; classify()
# remains the authority, this only avoids reading files that cannot be scripts.
declare -a find_exclusion_args=()
declare -a _data_words=()
read -r -a _data_words <<<"$DATA_EXTS"
for pattern in "${_data_words[@]}"; do
    find_exclusion_args+=("!" "-iname" "*.${pattern}")
done
read -r -a _data_words <<<"$DATA_NAMES"
for pattern in "${_data_words[@]}"; do
    find_exclusion_args+=("!" "-iname" "$pattern")
done

declare -a target_batch=()

if [[ "$REVERSE_MODE" -eq 0 ]]; then
    RECORD_ADVISORIES=1
fi

while IFS= read -r -d '' file; do
    if check_is_script "$file"; then
        target_batch+=("$file")
        if [[ ${#target_batch[@]} -ge $BATCH_LIMIT ]]; then
            flush_batch "$SCRIPT_CHMOD_OP" "1" "${target_batch[@]}"
            target_batch=()
        fi
    elif [[ "$RECORD_ADVISORIES" -eq 1 && -n "$ADVISORY" ]]; then
        (( advisory_total += 1 )) || true
        if (( ${#ADVISORIES[@]} < ADVISORY_SHOW_LIMIT )); then
            ADVISORIES+=("${ADVISORY}|${file}")
        fi
    fi
done < <(
    find -H "${TARGETS[@]}" \
        "${prune_args[@]}" \
        "(" -type f \
            "${find_exclusion_args[@]}" \
            "${SCRIPT_PERM_CHECK_ARGS[@]}" \
        ")" -print0 2>>"$SCAN_ERR"
)
RECORD_ADVISORIES=0

if [[ ${#target_batch[@]} -gt 0 ]]; then
    flush_batch "$SCRIPT_CHMOD_OP" "1" "${target_batch[@]}"
fi
target_batch=()
report_scan_errors "1"

echo -e "${CYAN}------------------------------------------------------------${RESET}"

# ==============================================================================
# PHASE 2: NON-SCRIPT HARDENING (same in both modes: never grants exec)
# ==============================================================================
log_op "PHASE 2: Engaging $NON_SCRIPT_ACTION_VERB non-script directives..."

while IFS= read -r -d '' file; do
    if check_is_data "$file"; then
        target_batch+=("$file")
        if [[ ${#target_batch[@]} -ge $BATCH_LIMIT ]]; then
            flush_batch "$NON_SCRIPT_CHMOD_OP" "2" "${target_batch[@]}"
            target_batch=()
        fi
    fi
done < <(
    find -H "${TARGETS[@]}" \
        "${prune_args[@]}" \
        "(" -type f \
            "${NON_SCRIPT_PERM_CHECK_ARGS[@]}" \
        ")" -print0 2>>"$SCAN_ERR"
)

if [[ ${#target_batch[@]} -gt 0 ]]; then
    flush_batch "$NON_SCRIPT_CHMOD_OP" "2" "${target_batch[@]}"
fi
report_scan_errors "2"

echo -e "${CYAN}------------------------------------------------------------${RESET}"

# ==============================================================================
# TELEMETRY SUMMARY
# ==============================================================================
total_changed=$(( files_changed_phase1 + files_changed_phase2 ))
count_note=""
if [[ "$DRY_RUN" -eq 1 ]]; then
    count_note=" (planned, dry-run)"
fi

report_advisories

if [[ "$total_failures" -gt 0 ]]; then
    log_err "EXECUTION CONCLUDED WITH CRITICAL FAULTS: $total_failures file(s) unmodified."
    log_warn "Phase 1 Matrix Alterations: $files_changed_phase1"
    log_warn "Phase 2 Matrix Alterations: $files_changed_phase2"
    if [[ "$scan_warnings" -gt 0 ]]; then
        log_warn "Unreadable paths skipped during scan: $scan_warnings"
    fi
    exit 1
else
    echo -e "\n      ${CYAN}─── [ SYSTEM READY : MATRIX SECURED ] ───${RESET}\n"
    log_op "Phase 1 Executable Alterations  : ${files_changed_phase1}${count_note}"
    log_op "Phase 2 Non-Executable Alterations: ${files_changed_phase2}${count_note}"
    log_op "Total Files Modified            : ${total_changed}${count_note}"
    if [[ "$scan_warnings" -gt 0 ]]; then
        log_warn "Unreadable paths skipped during scan: $scan_warnings"
    fi
    exit 0
fi
