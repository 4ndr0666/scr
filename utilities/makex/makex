# Any shebang is a script: the kernel will exec it through the named interpreter.
SHEBANG_PATTERN='^#![[:space:]]*/[^[:space:]]+'

# Extensions that are non-executable by nature (documents, markup, data, media,
# archives, fonts, keys, compiled-language sources). An extension in this list wins
# over content, matching the original safe-pattern behavior.
DATA_EXTS="md markdown mdx txt text rst adoc org tex rtf doc docx odt ppt pptx odp xls xlsx ods pdf epub mobi djvu log
json jsonl ndjson yml yaml toml ini cfg conf xml csv tsv html htm xhtml css scss sass less svg
jpg jpeg png gif bmp tiff tif webp ico heic heif avif psd xcf
mp3 flac wav ogg oga opus m4a aac wma aiff mid midi
mp4 m4v mkv webm avi mov wmv flv mpg mpeg 3gp m2ts vob srt ass vtt
zip tar gz tgz bz2 xz zst 7z rar iso dmg cab deb rpm jar war whl
ttf otf woff woff2 eot sqlite sqlite3 db mdb sql pem crt cer key pub csr gpg asc sig
lock bak orig rej swp tmp patch diff map c h cc cpp cxx hpp hh rs go java kt swift cs"

# Exact (case-insensitive) file names that are never executable.
DATA_NAMES="readme license licence copying authors contributors changelog changes news notice todo makefile dockerfile"

# Interpreted-language extensions: executable only when a shebang makes them
# runnable. Without a shebang the exec bit is meaningless (the kernel returns ENOEXEC
# and the shell would feed Python/JS/etc. source to sh), so they count as non-executable.
SCRIPTY_EXTS="py pyw pl pm rb js mjs cjs ts tsx jsx php lua awk tcl r jl fish bash zsh ksh csh tcsh dash ash groovy ex exs"

# Collapse the multi-line lists above into single-space-separated words so the
# " $LIST " == *" $word "* membership tests below are exact.
DATA_EXTS="${DATA_EXTS//$'\n'/ }"
DATA_NAMES="${DATA_NAMES//$'\n'/ }"
SCRIPTY_EXTS="${SCRIPTY_EXTS//$'\n'/ }"

# Text-heuristic signatures (shebang-less files only).
RE_SH_FI='^[[:space:]]*fi[[:space:]]*(;|$)'
RE_SH_DONE='^[[:space:]]*done[[:space:]]*($|[<|;])'
RE_SH_ESAC='^[[:space:]]*esac[[:space:]]*($|;)'
RE_SH_SET='^[[:space:]]*set[[:space:]]+-[A-Za-z]*[euxo]'
RE_SH_IF='^[[:space:]]*(if|elif|while|until)[[:space:]]+(\[|test[[:space:]])'
RE_SH_FUNC='^[[:space:]]*(function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\))'
RE_SH_POS='\$([0-9]|[@#?*]|\{[0-9@#])'
RE_SH_EXP='^[[:space:]]*(export|local|readonly)[[:space:]]+[A-Za-z_]'
RE_SH_ECHO='^[[:space:]]*(echo|printf)[[:space:]]'
RE_SH_EXIT='^[[:space:]]*exit([[:space:]]+[0-9$]|[[:space:]]*$)'
RE_PY_MAIN='^if[[:space:]]+__name__[[:space:]]*=='
RE_PY_IMP='^(import|from)[[:space:]]+[A-Za-z_.]+'
RE_PY_DEF='^def[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\('
RE_PL_USE='^use[[:space:]]+(strict|warnings)'
RE_RB_REQ='^require[[:space:]]+['"'"'"]'
RE_RB_END='^end[[:space:]]*$'
RE_JS_REQ='require\([[:space:]]*['"'"'"]'
RE_JS_OUT='(console\.log|module\.exports|process\.argv)'

