#!/usr/bin/env bash
# Author: 4ndr0666
# Re-Architected by: Ψ-4ndr0666 (Superset Batch Optimization)
# Version: 2.2.0
# Paradigm: Strict Bash Utility — find(1) -print0 stream orchestrator; batched chmod
#           with EAFP privilege escalation and per-file failure isolation; zero
#           dependencies beyond bash/findutils/coreutils (sudo only on EPERM fallback).
# shellcheck disable=SC2016
set -euo pipefail

# ==============================================================================
# 4NDR0SCRIPT UI LIBRARY
# ==============================================================================
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    CYAN='\033[38;5;51m'
    GLOW='\033[1;36m'
    RED='\033[38;5;196m'
    ORANGE='\033[38;5;208m'
    RESET='\033[0m'
else
    CYAN=''
    GLOW=''
    RED=''
    ORANGE=''
    RESET=''
fi
FRAME_TOP="┌────────────────────────────────────────────────────────────┐"
FRAME_BTM="└────────────────────────────────────────────────────────────┘"

log_header() {
    echo -e "${CYAN}${FRAME_TOP}${RESET}"
    echo -e "${CYAN}│${RESET}       ${GLOW}💀 Ψ • - ⦑ ${1:-MAKEX : PERMISSION MATRIX} ⦒ - • Ψ 💀${RESET}        ${CYAN}│${RESET}"
    echo -e "${CYAN}${FRAME_BTM}${RESET}"
}
log_op()   { echo -e " ${CYAN}Ψ${RESET} [${GLOW}SYSTEM${RESET}] :: $1"; }
log_ok()   { echo -e " ${CYAN}Ψ${RESET} [${GLOW}ACTIVE${RESET}] :: $1"; }
log_warn() { echo -e " ${CYAN}!${RESET} [${ORANGE}CAUTION${RESET}] :: $1"; }
log_err()  { echo -e " ${RED}✘${RESET} [${RED}FATAL${RESET}]  :: $1" >&2; }

log_banner() {
    local banner
    banner="███╗   ███╗ █████╗ ██╗  ██╗███████╗██╗  ██╗\n"
    banner+="████╗ ████║██╔══██╗██║ ██╔╝██╔════╝╚██╗██╔╝\n"
    banner+="██╔████╔██║███████║█████╔╝ ██████╗   ╚███╔╝\n"
    banner+="██║╚██╔╝██║██╔══██║██╔═██╗ ██╔══╝   ██╔██╗\n"
    banner+="██║ ╚═╝ ██║██║  ██║██║  ██╗███████╗██╔╝ ██╗\n"
    banner+="╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚╝╚══════╝╚═╝  ╚═╝"
    echo -e "${CYAN}${banner}${RESET}\n"
}

# ==============================================================================
# CONFIGURATION ENGINE
# ==============================================================================
MAKEX_VERSION="2.2.0"
DEFAULT_DIR="."
BATCH_LIMIT=1000

# Matches: #!/bin/sh  #!/usr/bin/bash  #!/usr/bin/env bash  #!/usr/bin/env -S bash -e
#          #!/usr/bin/env VAR=1 zsh   — and rejects #!/bin/shellfoo, #!/usr/bin/env python3
SHEBANG_PATTERN='^#![[:space:]]*/([^[:space:]]*/)?(env[[:space:]]+(-[^[:space:]]+[[:space:]]+|[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*)?(bash|sh|zsh|dash|ksh|ash)([[:space:]]|$)'

SAFE_NOEXEC_PATTERNS=(
    "*.md" "*.MD" "*.markdown"
    "*.txt" "*.TXT"
    "*.pdf" "*.PDF"
    "*.jpg" "*.jpeg" "*.png" "*.gif" "*.svg"
    "*.json" "*.yml" "*.yaml"
    "*.csv" "*.html" "*.css" "*.rst"
    "README" "README.md" "README.MD"
    "*.webp" "*.ico" "*.toml" "*.xml" "*.ini" "*.log"
)

# ==============================================================================
# ARGUMENT PARSING
# ==============================================================================
REVERSE_MODE=0
HIDDEN_MODE=0
DRY_RUN=0
QUIET=0
TARGETS=()

usage() {
    log_header "MAKEX : HELP"
    echo -e " Usage: makex [-r] [--hidden] [-n] [-q] [-h|--help] [--] [DIR...]\n"
    echo -e "  -r        : Reverse Mode — strip exec from scripts, add to non-scripts"
    echo -e "  --hidden  : Include hidden files/directories (default: skip dotfiles)"
    echo -e "  -rh|-hr   : Shorthand for -r --hidden"
    echo -e "  -n|--dry-run : Report planned changes; modify nothing"
    echo -e "  -q|--quiet   : Suppress per-file success lines (errors and summary remain)"
    echo -e "  -V|--version : Print version"
    echo -e "  -h|--help : Show this help message"
    echo -e "  --        : End of options (allows directories starting with '-')"
    echo -e "  [DIR...]  : Target director(y|ies) (default: .)\n"
    exit 0
}

END_OF_OPTS=0
for arg in "$@"; do
    if [[ "$END_OF_OPTS" -eq 1 ]]; then
        TARGETS+=("$arg")
        continue
    fi
    case "$arg" in
        --)             END_OF_OPTS=1 ;;
        -h|--help)      usage ;;
        -V|--version)   echo "makex ${MAKEX_VERSION}"; exit 0 ;;
        --hidden)       HIDDEN_MODE=1 ;;
        -r)             REVERSE_MODE=1 ;;
        -rh|-hr)        REVERSE_MODE=1; HIDDEN_MODE=1 ;;
        -n|--dry-run)   DRY_RUN=1 ;;
        -q|--quiet)     QUIET=1 ;;
        -*)             log_err "Unknown flag: '$arg'. Use -h for help."; exit 1 ;;
        *)              TARGETS+=("$arg") ;;
    esac
done

if [[ ${#TARGETS[@]} -eq 0 ]]; then
    TARGETS=("$DEFAULT_DIR")
fi

# Display sanitizer: neutralizes backslashes (echo -e) and control bytes (terminal
# escape injection) in untrusted path text. Result lands in SAFE_DISPLAY (no fork).
SAFE_DISPLAY=""
sanitize() {
    local s="${1//\\/\\\\}"
    SAFE_DISPLAY="${s//[[:cntrl:]]/?}"
}

DIR_DISPLAY=""
for i in "${!TARGETS[@]}"; do
    if [[ ! -d "${TARGETS[$i]}" ]]; then
        sanitize "${TARGETS[$i]}"
        log_err "Directory parameter '${SAFE_DISPLAY}' does not map to a valid filesystem entity."
        exit 1
    fi
    # A leading '-' would be parsed as an option by find/chmod.
    if [[ "${TARGETS[$i]}" == -* ]]; then
        TARGETS[i]="./${TARGETS[$i]}"
    fi
    sanitize "${TARGETS[$i]}"
    if [[ -z "$DIR_DISPLAY" ]]; then
        DIR_DISPLAY="$SAFE_DISPLAY"
    else
        DIR_DISPLAY+="', '${SAFE_DISPLAY}"
    fi
done

# ==============================================================================
# EPHEMERAL SCAN-ERROR SINK (guaranteed reclamation)
# ==============================================================================
SCAN_ERR_TMP=""
SCAN_ERR="/dev/null"
# shellcheck disable=SC2329  # invoked indirectly via trap
cleanup() {
    if [[ -n "$SCAN_ERR_TMP" ]]; then
        rm -f -- "$SCAN_ERR_TMP"
    fi
    return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if SCAN_ERR_TMP="$(mktemp 2>/dev/null)"; then
    SCAN_ERR="$SCAN_ERR_TMP"
else
    SCAN_ERR_TMP=""
fi

# ==============================================================================
# PRIVILEGE MODEL (EAFP: unprivileged chmod first, sudo only on failure)
# ==============================================================================
HAVE_SUDO=0
if command -v sudo >/dev/null 2>&1; then
    HAVE_SUDO=1
fi
LAST_CHMOD_ERR=""

# ==============================================================================
# MODE CALIBRATION
# ==============================================================================
declare MODE_NAME
declare SCRIPT_CHMOD_OP SCRIPT_ACTION_VERB SCRIPT_PAST_TENSE_VERB
declare NON_SCRIPT_CHMOD_OP NON_SCRIPT_ACTION_VERB NON_SCRIPT_PAST_TENSE_VERB
declare -a SCRIPT_PERM_CHECK_ARGS NON_SCRIPT_PERM_CHECK_ARGS

if [[ "$REVERSE_MODE" -eq 1 ]]; then
    MODE_NAME="Reverse"
    SCRIPT_PERM_CHECK_ARGS=("-perm" "/u=x")
    SCRIPT_CHMOD_OP="u-x"
    SCRIPT_ACTION_VERB="non-executable"
    SCRIPT_PAST_TENSE_VERB="Removed executable bit from"
    NON_SCRIPT_PERM_CHECK_ARGS=("!" "-perm" "-u=x")
    NON_SCRIPT_CHMOD_OP="u+x"
    NON_SCRIPT_ACTION_VERB="executable"
    NON_SCRIPT_PAST_TENSE_VERB="Injected executable bit to"
else
    MODE_NAME="Default"
    SCRIPT_PERM_CHECK_ARGS=("!" "-perm" "-u=x")
    SCRIPT_CHMOD_OP="u+x"
    SCRIPT_ACTION_VERB="executable"
    SCRIPT_PAST_TENSE_VERB="Injected executable bit to"
    NON_SCRIPT_PERM_CHECK_ARGS=("-perm" "/a=x")
    NON_SCRIPT_CHMOD_OP="a-x"
    NON_SCRIPT_ACTION_VERB="non-executable"
    NON_SCRIPT_PAST_TENSE_VERB="Removed executable bit from"
fi

# ==============================================================================
# PRUNE ARGS
# ==============================================================================
declare -a prune_args=()
if [[ "$HIDDEN_MODE" -eq 0 ]]; then
    prune_args=("-mindepth" "1" "(" "-name" ".*" "-prune" ")" "-o")
else
    prune_args=("(" "-path" "*/.git" "-prune" ")" "-o")
fi

# ==============================================================================
# TELEMETRY
# ==============================================================================
files_changed_phase1=0
files_changed_phase2=0
total_failures=0
scan_warnings=0

# ==============================================================================
# UI BOOTSTRAP
# ==============================================================================
if [[ -t 1 ]]; then
    clear 2>/dev/null || true
fi
log_banner
log_header "MAKEX PERMISSION MATRIX"
log_op "Mode -> Tactical Profile: [$MODE_NAME] | Hidden Processing: [$HIDDEN_MODE]"
log_op "Target Directory -> '$DIR_DISPLAY'"
if [[ "$DRY_RUN" -eq 1 ]]; then
    log_warn "DRY-RUN engaged: no permission bits will be modified."
fi
if [[ "$EUID" -ne 0 && "$HAVE_SUDO" -eq 0 ]]; then
    log_warn "sudo is not available: operating with current-user privileges only; files owned by other users will fail."
fi

# ==============================================================================
# HELPERS
# ==============================================================================

check_is_script() {
    local target="$1"
    [[ "${target##*/}" == *.sh ]] && return 0

    # Fork-free, NUL-safe, bounded (256 byte) first-line read. The stderr redirect is
    # ordered first so an unreadable file is silenced at the failure site (EAFP).
    local first_line=""
    LC_ALL=C IFS= read -r -n 256 first_line 2>/dev/null <"$target" || true
    [[ "$first_line" =~ $SHEBANG_PATTERN ]] && return 0
    return 1
}

# Unprivileged chmod first; escalate through sudo only when the kernel refuses.
try_chmod() {
    local chmod_op="$1"
    shift
    local err=""
    if err="$(chmod -- "$chmod_op" "$@" 2>&1)"; then
        return 0
    fi
    if [[ "$EUID" -ne 0 && "$HAVE_SUDO" -eq 1 ]]; then
        if err="$(sudo chmod -- "$chmod_op" "$@" 2>&1)"; then
            return 0
        fi
    fi
    LAST_CHMOD_ERR="$err"
    return 1
}

report_scan_errors() {
    local phase="$1"
    [[ -s "$SCAN_ERR" ]] || return 0
    local n first
    n="$(wc -l <"$SCAN_ERR")"
    first="$(head -n 1 "$SCAN_ERR")"
    sanitize "$first"
    log_warn "Phase $phase scan incomplete: $((n + 0)) unreadable path(s). First: ${SAFE_DISPLAY}"
    (( scan_warnings += n )) || true
    : >"$SCAN_ERR"
}

flush_batch() {
    local chmod_op="$1"
    local phase="$2"
    shift 2
    local -a files=("$@")
    local verb f ok_count=0 bad_count=0

    [[ ${#files[@]} -eq 0 ]] && return 0

    if [[ "$phase" == "1" ]]; then
        verb="$SCRIPT_PAST_TENSE_VERB"
    else
        verb="$NON_SCRIPT_PAST_TENSE_VERB"
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        for f in "${files[@]}"; do
            if [[ "$QUIET" -eq 0 ]]; then
                sanitize "$f"
                log_ok "[DRY-RUN] Would apply chmod $chmod_op to '${CYAN}${SAFE_DISPLAY}${RESET}'."
            fi
        done
        ok_count=${#files[@]}
    elif try_chmod "$chmod_op" "${files[@]}"; then
        for f in "${files[@]}"; do
            if [[ "$QUIET" -eq 0 ]]; then
                sanitize "$f"
                log_ok "$verb '${CYAN}${SAFE_DISPLAY}${RESET}'."
            fi
        done
        ok_count=${#files[@]}
    else
        # Batch refused: isolate per file so one vanished/forbidden path cannot
        # mask (or be blamed for) the rest of the batch. chmod is idempotent.
        for f in "${files[@]}"; do
            sanitize "$f"
            if try_chmod "$chmod_op" "$f"; then
                if [[ "$QUIET" -eq 0 ]]; then
                    log_ok "$verb '${CYAN}${SAFE_DISPLAY}${RESET}'."
                fi
                (( ok_count += 1 )) || true
            else
                log_err "chmod $chmod_op failed on '${SAFE_DISPLAY}' (phase $phase): ${LAST_CHMOD_ERR}"
                (( bad_count += 1 )) || true
            fi
        done
    fi

    if [[ "$phase" == "1" ]]; then
        (( files_changed_phase1 += ok_count )) || true
    else
        (( files_changed_phase2 += ok_count )) || true
    fi
    (( total_failures += bad_count )) || true
}

# ==============================================================================
# PHASE 1: NATIVE SCRIPT HEURISTICS
# ==============================================================================
log_op "PHASE 1: Engaging $SCRIPT_ACTION_VERB script directives..."

declare -a find_exclusion_args=()
for pattern in "${SAFE_NOEXEC_PATTERNS[@]}"; do
    find_exclusion_args+=("!" "-iname" "$pattern")
done

declare -a target_batch=()

while IFS= read -r -d '' file; do
    if check_is_script "$file"; then
        target_batch+=("$file")
        if [[ ${#target_batch[@]} -ge $BATCH_LIMIT ]]; then
            flush_batch "$SCRIPT_CHMOD_OP" "1" "${target_batch[@]}"
            target_batch=()
        fi
    fi
done < <(
    find -H "${TARGETS[@]}" \
        "${prune_args[@]}" \
        "(" -type f \
            "${find_exclusion_args[@]}" \
            "${SCRIPT_PERM_CHECK_ARGS[@]}" \
        ")" -print0 2>>"$SCAN_ERR"
)

if [[ ${#target_batch[@]} -gt 0 ]]; then
    flush_batch "$SCRIPT_CHMOD_OP" "1" "${target_batch[@]}"
fi
target_batch=()
report_scan_errors "1"

echo -e "${CYAN}------------------------------------------------------------${RESET}"

# ==============================================================================
# PHASE 2: NON-SCRIPT HARDENING
# ==============================================================================
log_op "PHASE 2: Engaging $NON_SCRIPT_ACTION_VERB non-script directives..."

declare -a find_non_exec_args=()
if [[ ${#SAFE_NOEXEC_PATTERNS[@]} -gt 0 ]]; then
    find_non_exec_args+=("(")
    find_non_exec_args+=("-iname" "${SAFE_NOEXEC_PATTERNS[0]}")
    for (( i=1; i<${#SAFE_NOEXEC_PATTERNS[@]}; i++ )); do
        find_non_exec_args+=("-o" "-iname" "${SAFE_NOEXEC_PATTERNS[$i]}")
    done
    find_non_exec_args+=(")")
fi

while IFS= read -r -d '' file; do
    target_batch+=("$file")
    if [[ ${#target_batch[@]} -ge $BATCH_LIMIT ]]; then
        flush_batch "$NON_SCRIPT_CHMOD_OP" "2" "${target_batch[@]}"
        target_batch=()
    fi
done < <(
    find -H "${TARGETS[@]}" \
        "${prune_args[@]}" \
        "(" -type f \
            "${NON_SCRIPT_PERM_CHECK_ARGS[@]}" \
            "${find_non_exec_args[@]}" \
        ")" -print0 2>>"$SCAN_ERR"
)

if [[ ${#target_batch[@]} -gt 0 ]]; then
    flush_batch "$NON_SCRIPT_CHMOD_OP" "2" "${target_batch[@]}"
fi
report_scan_errors "2"

echo -e "${CYAN}------------------------------------------------------------${RESET}"

# ==============================================================================
# TELEMETRY SUMMARY
# ==============================================================================
total_changed=$(( files_changed_phase1 + files_changed_phase2 ))
count_note=""
if [[ "$DRY_RUN" -eq 1 ]]; then
    count_note=" (planned, dry-run)"
fi

if [[ "$total_failures" -gt 0 ]]; then
    log_err "EXECUTION CONCLUDED WITH CRITICAL FAULTS: $total_failures file(s) unmodified."
    log_warn "Phase 1 Matrix Alterations: $files_changed_phase1"
    log_warn "Phase 2 Matrix Alterations: $files_changed_phase2"
    if [[ "$scan_warnings" -gt 0 ]]; then
        log_warn "Unreadable paths skipped during scan: $scan_warnings"
    fi
    exit 1
else
    echo -e "\n      ${CYAN}─── [ SYSTEM READY : MATRIX SECURED ] ───${RESET}\n"
    log_op "Phase 1 Executable Alterations  : ${files_changed_phase1}${count_note}"
    log_op "Phase 2 Non-Executable Alterations: ${files_changed_phase2}${count_note}"
    log_op "Total Files Modified            : ${total_changed}${count_note}"
    if [[ "$scan_warnings" -gt 0 ]]; then
        log_warn "Unreadable paths skipped during scan: $scan_warnings"
    fi
    exit 0
fi
