#!/usr/bin/env bash
# Paradigm: POSIX shell utility — idempotent host cache maintenance.
set -euo pipefail

_PRUNE_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
export PKG_PATH="$_PRUNE_DIR"
# shellcheck source=./common.sh
source "$PKG_PATH/common.sh"

cleanup() {
    echo "[+] Prune cleanup trap triggered. Exiting gracefully."
}
trap 'cleanup' EXIT INT TERM

echo "========================================================"
echo "Starting APEX-Compliant Non-Destructive System Prune"
echo "========================================================"

prune_failed=0

run_prune() {
    local name="$1"
    shift
    echo " -> Pruning $name..."
    if run_bounded 300 "$name" "$@" >/dev/null 2>&1; then
        return 0
    else
        local rc=$?
        echo "[ERROR] Pruning $name failed with rc=$rc" >&2
        return "$rc"
    fi
}

record_prune() {
    if "$@"; then
        return 0
    else
        local rc=$?
        prune_failed=1
        return "$rc"
    fi
}

# 1. NODE / JS PRUNE
echo "[+] Pruning JS/Node artifacts..."
record_prune run_prune "Yarn cache" yarn cache clean --all || true
record_prune run_prune "NPM cache" npm cache clean --force || true
if ! rm -rf "${HOME}/.cache/yarn"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.yarn/cache"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.npm/_cacache" 2>/dev/null; then prune_failed=1; fi

# 2. CARGO / RUST PRUNE
echo "[+] Pruning Cargo (Rust) caches..."
chmod -R u+w "${HOME}/.cargo/registry/cache" 2>/dev/null || true
chmod -R u+w "${HOME}/.cargo/registry/src" 2>/dev/null || true
chmod -R u+w "${HOME}/.cargo/git" 2>/dev/null || true
if ! rm -rf "${HOME}/.cargo/registry/cache"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.cargo/registry/src"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.cargo/git/db"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.cargo/git/checkouts"; then prune_failed=1; fi

# 3. RUBY (GEM & BUNDLER) PRUNE
echo "[+] Pruning Ruby, Bundler, and Gem caches..."
record_prune run_prune "Ruby Gems" gem cleanup -q || true
record_prune run_prune "Bundler" bundle clean --force || true
if ! rm -rf "${HOME}/.bundle/cache"; then prune_failed=1; fi
if ! rm -rf "${HOME}/.rbenv/cache" 2>/dev/null; then prune_failed=1; fi
if ! rm -rf "${HOME}/.rvm/archives" 2>/dev/null; then prune_failed=1; fi
if ! rm -rf "${HOME}/.rvm/src" 2>/dev/null; then prune_failed=1; fi

# 4. GO (GOLANG) PRUNE
echo "[+] Pruning Go module and build caches..."
record_prune run_prune "Go caches" go clean -cache -testcache -fuzzcache -modcache || true
GOPATH_DIR="${GOPATH:-$HOME/go}"
chmod -R u+w "${GOPATH_DIR}/pkg/mod" 2>/dev/null || true
if ! rm -rf "${GOPATH_DIR}/pkg/mod" 2>/dev/null; then prune_failed=1; fi
if ! rm -rf "${HOME}/.cache/go-build" 2>/dev/null; then prune_failed=1; fi

# 5. DOCKER / PODMAN PRUNE
echo "[+] Pruning Container artifacts..."
record_prune run_prune "Docker system" docker system prune -f || true
record_prune run_prune "Docker builder" docker builder prune -f || true
record_prune run_prune "Podman system" podman system prune -f || true

# 6. PYTHON (PIP, POETRY, CONDA) PRUNE
echo "[+] Pruning Python caches..."
record_prune run_prune "Pip cache" pip cache purge || true
record_prune run_prune "Pip3 cache" pip3 cache purge || true
record_prune run_prune "Poetry cache" poetry cache clear --all pypi -n || true
record_prune run_prune "Conda cache" conda clean --all -y || true
if ! rm -rf "${HOME}/.cache/pip"; then prune_failed=1; fi
if ! find "${HOME}" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; then prune_failed=1; fi

if (( prune_failed != 0 )); then
    echo "[ERROR] One or more prune operations failed." >&2
    exit 1
fi

echo "========================================================"
echo "Unified system prune completed successfully."
echo "========================================================"
