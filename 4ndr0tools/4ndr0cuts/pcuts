#
# High-density terminal reference & interactive fzf picker for pacman and the
# Arch Linux package management ecosystem (pacman-contrib, pacutils, expac,
# devtools, lsof, fzf). Embeds the full 4ndr0666 colors.sh 256-color banner
# engine in a single zero-dependency executable.

set -uo pipefail
IFS=$'\n\t'

VERSION="4.0.0"

# ===================================================================================
# --- // EMBEDDED COLORS.SH PALETTE & BANNER ENGINE // ---
# ===================================================================================

setup_colors() {
    local mode="${1:-auto}"
    if [[ "$mode" == "never" ]] || { [[ "$mode" == "auto" ]] && { [[ ! -t 1 ]] || [[ "${TERM:-dumb}" == "dumb" ]] || [[ -n "${NO_COLOR:-}" ]]; }; }; then
        reset="" bold="" dim=""
        white="" black="" grey="" red="" green="" blue="" cyan="" yellow="" orange="" magenta="" purple=""
        bg_black="" bg_grey="" bg_charcoal="" bg_red="" bg_green="" bg_lime="" bg_aquamarine=""
        bg_olive="" bg_blue="" bg_sky="" bg_cyan="" bg_aqua="" bg_goldenrod="" bg_yellow=""
        bg_coral="" bg_orange="" bg_pink="" bg_lavender="" bg_magenta="" bg_purple="" bg_white=""
    else
        reset=$'\e[0m'
        bold=$'\e[1m'
        dim=$'\e[2m'

        # Foreground text colors
        white=$'\e[97m'
        black=$'\e[38;5;232m'
        grey=$'\e[38;5;246m'
        red=$'\e[91m'
        green=$'\e[92m'
        blue=$'\e[94m'
        cyan=$'\e[96m'
        yellow=$'\e[93m'
        orange=$'\e[38;5;208m'
        magenta=$'\e[95m'
        purple=$'\e[38;5;141m'

        # Background banner colors (256-color palette from colors.sh)
        bg_black=$'\e[40m'
        bg_grey=$'\e[48;5;240m'
        bg_charcoal=$'\e[48;5;237m'
        bg_red=$'\e[48;5;1m'
        bg_green=$'\e[48;5;22m'
        bg_lime=$'\e[48;5;40m'
        bg_aquamarine=$'\e[48;5;120m'
        bg_olive=$'\e[48;5;58m'
        bg_blue=$'\e[44m'
        bg_sky=$'\e[48;5;25m'
        bg_cyan=$'\e[46m'
        bg_aqua=$'\e[48;5;87m'
        bg_goldenrod=$'\e[48;5;220m'
        bg_yellow=$'\e[48;5;226m'
        bg_coral=$'\e[48;5;208m'
        bg_orange=$'\e[48;5;202m'
        bg_pink=$'\e[48;5;207m'
        bg_lavender=$'\e[48;5;141m'
        bg_magenta=$'\e[48;5;90m'
        bg_purple=$'\e[48;5;53m'
        bg_white=$'\e[107m'
    fi

    # Shortcuts
    r=$reset
    b=$bold
    blk=$black
    gry=$grey
    grn=$green
    blu=$blue
    yel=$yellow
    org=$orange
    mag=$magenta
    pur=$purple
    cyn=$cyan
    wht=$white

    bgblk=$bg_black
    bggry=$bg_grey
    bgchr=$bg_charcoal
    bgred=$bg_red
    bggrn=$bg_green
    bglim=$bg_lime
    bgaqm=$bg_aquamarine
    bgolv=$bg_olive
    bgblu=$bg_blue
    bgsky=$bg_sky
    bgcyn=$bg_cyan
    bgaqa=$bg_aqua
    bggdr=$bg_goldenrod
    bgyel=$bg_yellow
    bgcrl=$bg_coral
    bgorg=$bg_orange
    bgpnk=$bg_pink
    bglav=$bg_lavender
    bgmag=$bg_magenta
    bgpur=$bg_purple
    bgwht=$bg_white
}

term_width() {
    local cols="${COLUMNS:-}"
    if [[ ! "$cols" =~ ^[0-9]+$ ]]; then
        cols=$(tput cols 2>/dev/null) || cols=100
    fi
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=100
    (( cols < 40 )) && cols=40
    printf '%s' "$cols"
}

heading() {
    if [[ -z "${1:-}" || -z "${2:-}" ]]; then
        printf 'Usage: heading <color> "Heading Text"\n' >&2
        return 1
    fi

    local weight=""
    [[ -n "${3:-}" ]] && weight="$bold"

    local color="${1,,}"
    local hding="$2"
    local hdlen=${#hding}
    local twidt
    twidt=$(term_width)

    if (( twidt <= hdlen )); then
        twidt=$(( hdlen + 2 ))
    fi

    local l=$(( twidt - hdlen ))
    local d=$(( l / 2 ))
    local padding=""
    printf -v padding '%*s' "$d" ''

    local padextra=""
    local totlenth=$(( ${#padding} * 2 + hdlen ))
    if (( twidt != totlenth )); then
        padextra=" "
    fi

    # Plain-mode fallback when colors are disabled
    if [[ -z "$reset" ]]; then
        local rule=""
        printf -v rule '%*s' "$twidt" ''
        rule="${rule// /=}"
        printf '\n%s\n%s%s\n%s\n\n' "$rule" "$padding" "$hding" "$rule"
        return 0
    fi

    if [[ "$color" == "rnd" || "$color" == "rand" || "$color" == "random" ]]; then
        local colors=("gry" "chr" "red" "grn" "lim" "aqm" "olv" "blu" "sky" "cyn" "aqa" "gdr" "yel" "crl" "org" "pnk" "lav" "mag" "pur")
        color="${colors[$RANDOM % ${#colors[@]}]}"
    fi

    case "$color" in
        grey|gry)           color="${bggry}${white}" ;;
        charcoal|chr)       color="${bgchr}${white}" ;;
        red)                color="${bgred}${white}" ;;
        green|grn)          color="${bggrn}${white}" ;;
        lime|lim)           color="${bglim}${black}" ;;
        aquamarine|aqm)     color="${bgaqm}${black}" ;;
        olive|olv)          color="${bgolv}${white}" ;;
        blue|blu)           color="${bgblu}${white}" ;;
        sky)                color="${bgsky}${white}" ;;
        cyan|cyn)           color="${bgcyn}${black}" ;;
        aqua|agua|aqa)      color="${bgaqa}${black}" ;;
        goldenrod|gdr)      color="${bggdr}${black}" ;;
        yellow|yel)         color="${bgyel}${black}" ;;
        coral|crl)          color="${bgcrl}${black}" ;;
        orange|org)         color="${bgorg}${white}" ;;
        pink|pnk)           color="${bgpnk}${black}" ;;
        lavender|lav)       color="${bglav}${black}" ;;
        magenta|mag)        color="${bgmag}${white}" ;;
        purple|pur)         color="${bgpur}${white}" ;;
        *)                  color="${bggrn}${white}" ;;
    esac

    printf '\n%b%s%b%s%s%s%b\n\n' "$color" "$padding" "$weight" "$hding" "$padding" "$padextra" "$reset"
}

bheading() {
    heading "$1" "$2" "bold"
}

# ===================================================================================
# --- // COMMAND CATALOG (SINGLE SOURCE OF TRUTH) // ---
# ===================================================================================
# Format per row: "category \t command \t description \t tip"
# Categories & short flags:
#   sync     (-s, --sync)      : Sync, Install & Upgrade
#   search   (-r, --remote)    : Search Remote Packages & Repos
#   query    (-q, --query)     : Search Installed / Local Packages
#   files    (-f, --files)     : Search Files & Package Ownership
#   remove   (-x, --remove)    : Remove Packages & Orphan Cleanup
#   cache    (-c, --cache)     : Cache Management, Logs & Downgrading
#   verify   (-v, --verify)    : Integrity Audit, .pacnew & Dependency Trees
#   tricks   (-t, --tricks)    : Power-User One-Liners & Pacman Tips
#   recovery (-e, --emergency) : Broken System, Keyring & Lock Recovery

PCUTS_TABLE=(
    # --- 1. SYNC, INSTALL & UPGRADE (-s / --sync) ---
    $'sync\tpacman -Syu\tSync databases and upgrade all installed packages\tAlways upgrade with -Syu; installing after a bare -Sy causes partial upgrades.'
    $'sync\tpacman -S package-name\tInstall a package from repositories\tMultiple packages or package groups can be space-separated.'
    $'sync\tpacman -S --needed package-name\tInstall a package only if not already up-to-date\tSkips reinstalling packages that are already at the latest version.'
    $'sync\tpacman -Syu --needed package-name\tUpgrade system and install a package in one transaction\tSafest way to install new software on a rolling-release system.'
    $'sync\tpacman -S --asdeps package-name\tInstall a package marked as a dependency (e.g. optional dep)\tAllows pacman -Qtdq to clean it up automatically if its parent is removed.'
    $'sync\tpacman -S extra/package-name\tInstall a package from a specific repository\tUseful when testing/multilib/custom repos provide duplicate package names.'
    $'sync\tpacman -S --needed - < pkglist.txt\tInstall all packages listed in a text file\tPair with pacman -Qqen > pkglist.txt to clone native packages across machines.'
    $'sync\tpacman -U /path/to/package.pkg.tar.zst\tInstall a local or downloaded package archive\tAlso accepts http:// or https:// URLs directly.'
    $'sync\tpacman -U --asdeps /path/to/package.pkg.tar.zst\tInstall a local package archive marked as a dependency\tPrevents manually built dependency packages from polluting pacman -Qe.'
    $'sync\tpacman -Sw package-name\tDownload package archive to cache without installing\tArchives land in /var/cache/pacman/pkg/ for offline or later use.'
    $'sync\tpacman -Sy\tSync and refresh remote package databases only\tDo NOT follow with pacman -S <pkg> without -u (partial upgrade hazard).'
    $'sync\tpacman -Syyu\tForce refresh all package databases and full upgrade\tUseful when switching mirrors or recovering from a corrupted sync db.'

    # --- 2. SEARCH REMOTE PACKAGES & REPOS (-r / --remote) ---
    $'search\tpacman -Ss keyword\tSearch remote package names and descriptions\tAccepts extended regular expressions (ERE) by default.'
    $'search\tpacman -Ss \'^keyword\'\tSearch remote packages whose name begins with keyword\tAnchoring with ^ filters out noisy matches in descriptions.'
    $'search\tpacman -Si package-name\tShow detailed metadata for a remote package\tDisplays version, repo, dependencies, optional deps, and download/install size.'
    $'search\tpacman -Sii package-name\tShow extended remote info including reverse dependencies\tReveals "Required By" and "Optional For" across the entire sync database.'
    $'search\tpacman -Sl repo-name\tList all packages in a repository (e.g. core, extra, multilib)\tMarks already-installed packages with [installed] at the end of the line.'
    $'search\tpacman -Sg\tList all package groups across enabled repositories\tPass a group name (pacman -Sg base-devel) to list group members.'
    $'search\tpacman-conf --repo-list\tList all currently enabled repositories in order\tOrder in pacman.conf determines repository precedence.'
    $'search\tpactree -s package-name\tShow full dependency tree of a remote package\tFrom pacman-contrib; queries sync DB even if the package is not installed.'

    # --- 3. SEARCH LOCAL / INSTALLED PACKAGES (-q / --query) ---
    $'query\tpacman -Q\tList all installed packages with versions\tAdd -q (pacman -Qq) to output package names only for scripting.'
    $'query\tpacman -Qs keyword\tSearch installed package names and descriptions\tSupports regexes; use pacman -Qs \'^lib\' to find installed libraries.'
    $'query\tpacman -Qi package-name\tShow detailed metadata for an installed package\tShows install date, install reason, size, required-by, and optional deps.'
    $'query\tpacman -Qii package-name\tShow installed package info plus modified backup files\tLists tracked config files and whether they are MODIFIED or UNMODIFIED.'
    $'query\tpacman -Qe\tList explicitly installed packages\tPackages you intentionally installed (not pulled in automatically as deps).'
    $'query\tpacman -Qent\tList explicit native packages not required by any other pkg\tTrue top-level "leaf" packages from official repos.'
    $'query\tpacman -Qn\tList all native packages (found in enabled sync repos)\tExcludes AUR and locally built packages.'
    $'query\tpacman -Qm\tList all foreign (AUR / local / dropped) packages with versions\tIncludes anything not present in currently configured sync databases.'
    $'query\tpacman -Qmq\tList all foreign (AUR) package names only\tPipe into an AUR helper or review list to audit non-repo software.'
    $'query\tpacman -Qu\tList out-of-date packages as of the last database sync\tReflects cached sync DB state; use checkupdates for a live safe check.'
    $'query\tcheckupdates\tSafely check for pending upgrades without root or -Sy\tFrom pacman-contrib; syncs to a temporary DB so your system DB stays untouched.'
    $'query\tpacman -Qdt\tList unneeded orphaned dependencies\tPackages installed as dependencies that no installed package requires anymore.'
    $'query\tpacman -Qdtt\tList orphans including packages kept only as optional deps\tSingle -t hides optional deps; -tt includes them.'
    $'query\tpacman -Qq | grep -Ee \'-(bzr|cvs|darcs|git|hg|svn)$\'\tList all installed VCS / development (-git) packages\tHelpful for auditing AUR -git packages that need manual rebuilds.'
    $'query\tpacman -Qqe > pkglist.txt\tExport all explicitly installed packages to a file\tUse pacman -Qqen > pkglist.txt for official repo packages only.'
    $'query\tpacman -Qq | fzf --preview \'pacman -Qil {}\' --layout=reverse --bind \'enter:execute(pacman -Qil {} | less)\'\tInteractive fzf browser over all installed packages\tPress Enter on any package to inspect its full info and file list in less.'

    # --- 4. SEARCH FILES & PACKAGE OWNERSHIP (-f / --files) ---
    $'files\tpacman -Qo /path/to/file\tShow which installed package owns a local file\tAlso accepts a command name in PATH (e.g. pacman -Qo $(which mpv)).'
    $'files\tpacman -Ql package-name\tList all files installed by a local package\tCombine with grep (pacman -Ql pkg | grep /usr/bin/) to see its binaries.'
    $'files\tpacman -Qql package-name\tList files owned by a local package (paths only)\tQuiet output without the package-name prefix—ideal for piping to xargs/stat.'
    $'files\tpacman -Fy\tRefresh the remote files database (required before -F)\tSeparate from -Sy; updates file lists for uninstalled repository packages.'
    $'files\tpacman -F filename\tFind which remote package provides a filename or path\tReplaces pkgfile; pass a bare binary name (e.g. pacman -F mkfs.fat) or path.'
    $'files\tpacman -Fx \'usr/bin/.*ctl$\'\tSearch remote package file paths using a regular expression\tMatches against full root-relative paths in the sync files database.'
    $'files\tpacman -Fl package-name\tList all files inside a remote (uninstalled) package\tInspect a package\'s contents before deciding to install it.'
    $'files\tpacman -Qlp /path/to/package.pkg.tar.zst\tList all files inside a local .pkg.tar.zst archive\tUse -Qip on the same file to inspect its PKGINFO metadata before installing.'

    # --- 5. REMOVE, ORPHANS & INSTALL REASONS (-x / --remove) ---
    $'remove\tpacman -R package-name\tRemove a single package, leaving all its dependencies\tSafest minimal removal; refuses if another package depends on it.'
    $'remove\tpacman -Rs package-name\tRemove package and its unused dependencies (recommended)\tLeaves configuration backup files (.pacsave) in place.'
    $'remove\tpacman -Rns package-name\tRemove package, unused dependencies, and its config backups\t-n prevents saving .pacsave config backups in /etc.'
    $'remove\tpacman -Rsu package-name\tRemove package, unused deps, and unneeded optional dependents\t-u (--unneeded) avoids breaking packages while cleaning loose ends.'
    $'remove\tpacman -Rc package-name\tCascade remove package and ALL packages that depend on it\tDANGER: -c means cascade (NOT config!). Always preview with -Rcp first.'
    $'remove\tpacman -Rdd package-name\tForce remove a package ignoring all dependency checks\tUse ONLY when replacing a blocking provider package manually.'
    $'remove\tpacman -Qtdq | sudo pacman -Rns -\tRemove all orphaned packages and their configs in one shot\tExits cleanly if no orphans exist; review the target list before confirming.'
    $'remove\tpacman -Qqd | pacman -Rsu --print -\tDetect circular or isolated dependency subgraphs\tPrints dependency groups that only depend on each other.'
    $'remove\tpacman -D --asexplicit package-name\tMark an installed package as explicitly installed\tProtects a dependency from being removed by pacman -Rs or orphan cleanup.'
    $'remove\tpacman -D --asdeps package-name\tMark an installed package as a dependency\tMakes a formerly explicit package eligible for automatic orphan removal.'

    # --- 6. CACHE, LOGS & DOWNGRADE (-c / --cache) ---
    $'cache\tpaccache -d -k 2\tDry-run cache cleanup keeping the last 2 versions per pkg\tFrom pacman-contrib; shows how much disk space would be reclaimed.'
    $'cache\tsudo paccache -r -k 2\tPrune package cache keeping 2 versions for easy rollback\tRecommended over pacman -Sc so you can still downgrade broken upgrades.'
    $'cache\tsudo paccache -rk1 && sudo paccache -ruk0\tKeep 1 version of installed pkgs and 0 of uninstalled pkgs\tReclaims maximum disk space while still keeping the current archive.'
    $'cache\tpacman -Sc\tRemove cached packages that are not currently installed\tBuilt-in pacman cache cleaner; removes all rollback versions of installed pkgs.'
    $'cache\tpacman -Scc\tWipe the ENTIRE package cache (/var/cache/pacman/pkg/)\tUse only when critically low on disk space; eliminates local rollback.'
    $'cache\tsudo pacman -U /var/cache/pacman/pkg/pkg-oldver.pkg.tar.zst\tDowngrade a package from your local pacman cache\tTab-complete inside /var/cache/pacman/pkg/ to pick the previous version.'
    $'cache\tsudo pacman -U https://archive.archlinux.org/packages/p/pkg/pkg-ver.pkg.tar.zst\tDowngrade a package directly from the Arch Linux Archive\tWorks even if you cleared your local /var/cache/pacman/pkg/ directory.'
    $'cache\tgrep -E \'\\[(ALPM)\\] (installed|upgraded|removed)\' /var/log/pacman.log | tail -n 30\tShow the last 30 install, upgrade, and removal events\tReads /var/log/pacman.log directly to see what changed in recent updates.'

    # --- 7. VERIFY, AUDIT, CONFIGS & DEPS (-v / --verify) ---
    $'verify\tpacman -Dk\tVerify internal consistency of the local pacman database\tAdd -Dkk to check sync databases for missing or conflicting dependencies.'
    $'verify\tpacman -Qk\tVerify that all files owned by installed packages exist\tQuick presence check across every installed package on the system.'
    $'verify\tpacman -Qkk package-name\tPerform thorough file-attribute verification on a package\tChecks permissions, file sizes, modification times, and symlink targets.'
    $'verify\tpaccheck --md5sum --quiet\tShow all installed package files with modified checksums\tFrom pacutils; use --sha256sum for cryptographic content verification.'
    $'verify\tpacreport --unowned-files\tGenerate a system report including unowned files in /etc & /usr\tFrom pacutils; run with sudo for complete filesystem visibility.'
    $'verify\tsudo DIFFPROG=\'nvim -d\' pacdiff\tFind and interactively merge .pacnew and .pacsave files\tFrom pacman-contrib; View, Merge, Skip, or Overwrite updated /etc configs.'
    $'verify\tpactree -c package-name\tDisplay colorized forward dependency tree of an installed pkg\tAdd -d 2 (pactree -cd2 pkg) to limit recursion depth to 2 levels.'
    $'verify\tpactree -r package-name\tDisplay reverse dependency tree ("why is this installed?")\tShows every installed package chain that requires the target package.'
    $'verify\tpacman -T \'package>=1.2.0\'\tTest whether versioned dependencies are satisfied locally\tPrints unsatisfied dependencies; exits 0 if satisfied, 127 if missing.'
    $'verify\tlsof +c 0 | grep -w DEL | awk \'1 { print $1 ": " $NF }\' | sort -u\tShow running processes still holding deleted shared libraries\tRun after pacman -Syu to see which daemons/apps need restarting.'

    # --- 8. POWER-USER ONE-LINERS & TIPS (-t / --tricks) ---
    $'tricks\texpac --timefmt=\'%Y-%m-%d %T\' \'%l\\t%n\' | sort | tail -n 20\tShow the 20 most recently installed or upgraded packages\tRequires expac; sorts by exact installation epoch timestamp.'
    $'tricks\texpac -H M \'%m\\t%n\' | sort -h | tail -n 20\tShow the 20 largest installed packages by disk size (MiB)\tHuman-readable MiB output sorted from smallest to largest.'
    $'tricks\texpac -S -H M \'%k\\t%n\' $(pacman -Qqu) | sort -sh\tShow download sizes of all pending package updates\tRun after checkupdates or -Sy to see which pending update is huge.'
    $'tricks\tpacman -Sp --print-format \'%r/%n %v (%s bytes)\' package-name\tPreview exact repo, version, and download size without root\tAlso accepts %l to print the exact mirror download URLs.'
    $'tricks\tpacman -Slq | fzf --multi --preview \'pacman -Si {1}\' | xargs -ro sudo pacman -S\tInteractive fzf package finder and multi-select installer\tUse Tab to mark multiple packages in fzf, Enter to install them with pacman.'
    $'tricks\tpacman -Qq | fzf --multi --preview \'pacman -Qi {1}\' | xargs -ro sudo pacman -Rns\tInteractive fzf multi-select package remover\tPreview local package details and remove selected items with -Rns.'
    $'tricks\tbsdtar -xvf package.pkg.tar.zst -C /tmp/extracted\tExtract a pacman package archive without installing it\tUseful for inspecting scripts, binaries, or recovering a single deleted file.'
    $'tricks\tbacman package-name\tReconstruct a .pkg.tar.zst archive from an installed package\tFrom pacman-contrib; repacks an installed package before you upgrade/remove it.'
    $'tricks\tsudo reflector --country US --latest 15 --protocol https --sort rate --save /etc/pacman.d/mirrorlist\tRank and save the 15 fastest HTTPS Arch mirrors\tRequires reflector; dramatically speeds up pacman ParallelDownloads.'

    # --- 9. EMERGENCY & BROKEN SYSTEM RECOVERY (-e / --emergency) ---
    $'recovery\tsudo rm -f /var/lib/pacman/db.lck\tRemove a stale pacman database lock file\tRun ONLY after verifying no pacman process is currently active (pgrep -a pacman).'
    $'recovery\tsudo pacman -Sy --needed archlinux-keyring && sudo pacman -Su\tFix "unknown trust" or invalid PGP signature errors on upgrade\tRefreshes the Arch master keyring before upgrading the rest of the system.'
    $'recovery\tsudo rm -rf /etc/pacman.d/gnupg && sudo pacman-key --init && sudo pacman-key --populate archlinux\tCompletely reset and rebuild a corrupted pacman GPG keyring\tNuclear fix when gpg keyrings in /etc/pacman.d/gnupg are damaged.'
    $'recovery\tsudo pacman -S --overwrite \'glob\' package-name\tInstall package overwriting conflicting untracked files\tReplace glob with the specific conflicting path (e.g. \'/usr/lib/python3.12/*\').'
    $'recovery\tsudo pacman -S --dbonly package-name\tRestore local pacman database entry without writing files\tFixes missing /var/lib/pacman/local/ metadata when files are already on disk.'
    $'recovery\tsudo pacman --sysroot /mnt -Syu\tUpgrade or repair an unbootable Arch installation from live ISO\tMount root at /mnt first; safer than arch-chroot when bash/glibc Inside /mnt is broken.'
    $'recovery\tpacman -Qqn | sudo pacman -S -\tReinstall every native repository package on the system\tRepairs widespread filesystem corruption or accidentally deleted /usr files.'
)

# ===================================================================================
# --- // CATEGORY METADATA & RENDERING // ---
# ===================================================================================

ALL_CATEGORIES=(sync search query files remove cache verify tricks recovery)

_category_color() {
    case "$1" in
        sync)     printf 'pur' ;;
        search)   printf 'grn' ;;
        query)    printf 'cyn' ;;
        files)    printf 'mag' ;;
        remove)   printf 'red' ;;
        cache)    printf 'gdr' ;;
        verify)   printf 'sky' ;;
        tricks)   printf 'aqm' ;;
        recovery) printf 'org' ;;
        *)        printf 'grn' ;;
    esac
}

_category_title() {
    case "$1" in
        sync)     printf 'SYNC, INSTALL & UPGRADE  (-s)' ;;
        search)   printf 'SEARCH REMOTE PACKAGES   (-r)' ;;
        query)    printf 'SEARCH LOCAL PACKAGES    (-q)' ;;
        files)    printf 'SEARCH FILES & OWNERS    (-f)' ;;
        remove)   printf 'REMOVE & ORPHAN CLEANUP  (-x)' ;;
        cache)    printf 'CACHE, LOGS & DOWNGRADE  (-c)' ;;
        verify)   printf 'VERIFY, AUDIT & DEPS     (-v)' ;;
        tricks)   printf 'POWER-USER ONE-LINERS    (-t)' ;;
        recovery) printf 'EMERGENCY & RECOVERY     (-e)' ;;
    esac
}

_row_matches_filter() {
    local filter="$1"
    local cmd="$2"
    local desc="$3"
    local tip="$4"
    [[ -z "$filter" ]] && return 0
    local haystack="${cmd} ${desc} ${tip}"
    [[ "${haystack,,}" == *"${filter,,}"* ]]
}

# Renders every matching row in category $1.
# Uses two-tier column alignment so normal-length commands align in a crisp vertical
# column while 90+ char pipelines never push short commands across the screen.
_print_category() {
    local category="$1"
    local filter="${2:-}"
    local detailed="${3:-0}"
    local row cat cmd desc tip
    local align_max=42
    local AlignCap=56
    local -a cmds=() descs=() tips=()

    for row in "${PCUTS_TABLE[@]}"; do
        IFS=$'\t' read -r cat cmd desc tip <<<"$row"
        [[ "$cat" == "$category" ]] || continue
        _row_matches_filter "$filter" "$cmd" "$desc" "$tip" || continue
        cmds+=("$cmd")
        descs+=("$desc")
        tips+=("${tip:-}")
        if (( ${#cmd} <= AlignCap && ${#cmd} > align_max )); then
            align_max=${#cmd}
        fi
    done

    (( ${#cmds[@]} == 0 )) && return 1

    bheading "$(_category_color "$category")" "$(_category_title "$category")"

    local idx pad pad_str cmd_len
    for idx in "${!cmds[@]}"; do
        cmd_len=${#cmds[$idx]}
        if (( cmd_len <= align_max )); then
            pad=$(( align_max - cmd_len + 3 ))
        else
            pad=2
        fi
        printf -v pad_str '%*s' "$pad" ''
        printf '  %b%s%b%s%b#%b %s\n' \
            "$grn" "${cmds[$idx]}" "$r" \
            "$pad_str" \
            "$cyn" "$r" "${descs[$idx]}"
        if (( detailed )) && [[ -n "${tips[$idx]}" ]]; then
            printf '      %b↳ Tip: %s%b\n' "$gry" "${tips[$idx]}" "$r"
        fi
    done
    return 0
}

