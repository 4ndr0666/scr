# ===================================================================================
# --- // INTERACTIVE FZF BROWSER (--browse) // ---
# ===================================================================================

browse() {
    local filter="${1:-}"
    shift || true
    local -a active_cats=("$@")

    if ! command -v fzf &>/dev/null; then
        printf '%bpcuts --browse requires fzf, which is not installed.%b\n' "$red" "$r" >&2
        printf 'Install it with: sudo pacman -S fzf\n' >&2
        return 1
    fi

    local row cat cmd desc tip tag
    local -a lines=()
    local cat_match

    for row in "${PCUTS_TABLE[@]}"; do
        IFS=$'\t' read -r cat cmd desc tip <<<"$row"
        cat_match=0
        for c in "${active_cats[@]}"; do
            [[ "$c" == "$cat" ]] && { cat_match=1; break; }
        done
        (( cat_match )) || continue
        _row_matches_filter "$filter" "$cmd" "$desc" "$tip" || continue
        tag=$(printf '[%-8s]' "${cat^^}")
        # Tab-separated fields:
        # 1: display line | 2: raw command | 3: category | 4: description | 5: tip
        lines+=("${cyn}${tag}${r} ${grn}${cmd}${r}  ${gry}# ${desc}${r}"$'\t'"${cmd}"$'\t'"${cat^^}"$'\t'"${desc}"$'\t'"${tip:-None}")
    done

    if (( ${#lines[@]} == 0 )); then
        printf '%bpcuts: no commands matched filter "%s".%b\n' "$red" "$filter" "$r" >&2
        return 1
    fi

    local selected status=0
    selected=$(
        printf '%s\n' "${lines[@]}" | FZF_DEFAULT_OPTS="" fzf \
            --ansi \
            --delimiter=$'\t' \
            --with-nth=1 \
            --no-multi \
            --height=85% \
            --layout=reverse \
            --border=rounded \
            --query="$filter" \
            --prompt='pcuts> ' \
            --header='Enter: print & copy command | Esc: cancel' \
            --preview=$'printf "\\033[1;95mCATEGORY:\\033[0m    %s\\n\\n\\033[1;92mCOMMAND:\\033[0m\\n  %s\\n\\n\\033[1;96mDESCRIPTION:\\033[0m\\n  %s\\n\\n\\033[1;93mPRO-TIP / NOTE:\\033[0m\\n  %s\\n" {3} {2} {4} {5}' \
            --preview-window='down:9:wrap:border-top' \
            --color='bg:#000000,bg+:#071a1a,fg:#e0e0e0,fg+:#15ffff,hl:#00d7ff,hl+:#15ffff,info:#15ffff,prompt:#15ffff,pointer:#15ffff,marker:#15ffff,header:#a855f7,border:#15ffff'
    ) || status=$?

    if (( status == 1 || status == 130 )) || [[ -z "$selected" ]]; then
        return 0
    fi
    if (( status != 0 )); then
        return "$status"
    fi

    local chosen_cmd
    IFS=$'\t' read -r _ chosen_cmd _ <<<"$selected"

    printf '%b%s%b\n' "$grn" "$chosen_cmd" "$r"

    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &>/dev/null; then
        printf '%s' "$chosen_cmd" | wl-copy
        printf '%b(copied to Wayland clipboard via wl-copy)%b\n' "$yel" "$r" >&2
    elif [[ -n "${DISPLAY:-}" ]] && command -v xclip &>/dev/null; then
        printf '%s' "$chosen_cmd" | xclip -selection clipboard
        printf '%b(copied to X11 clipboard via xclip)%b\n' "$yel" "$r" >&2
    elif [[ -n "${DISPLAY:-}" ]] && command -v xsel &>/dev/null; then
        printf '%s' "$chosen_cmd" | xsel --clipboard --input
        printf '%b(copied to X11 clipboard via xsel)%b\n' "$yel" "$r" >&2
    fi
}

# ===================================================================================
# --- // ARGUMENT PARSING & DISPATCH // ---
# ===================================================================================

main() {
    local color_mode="auto"
    local mode="show"
    local detailed=0
    local do_clear=0
    local filter=""
    local -a requested_cats=()
    local -A seen_cats=()

    add_cat() {
        local c="$1"
        if [[ -z "${seen_cats[$c]:-}" ]]; then
            requested_cats+=("$c")
            seen_cats["$c"]=1
        fi
    }

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                mode="help"
                shift
                ;;
            --version)
                printf 'pcuts %s\n' "$VERSION"
                return 0
                ;;
            -b|--browse)
                mode="browse"
                shift
                ;;
            -l|--list)
                mode="list"
                shift
                ;;
            -d|--detailed)
                detailed=1
                shift
                ;;
            -C|--clear)
                do_clear=1
                shift
                ;;
            --plain|--no-color)
                color_mode="never"
                shift
                ;;
            --color)
                if (( $# < 2 )); then
                    printf 'pcuts: --color requires an argument (auto, always, never)\n' >&2
                    return 1
                fi
                color_mode="$2"
                shift 2
                ;;
            --color=*)
                color_mode="${1#--color=}"
                shift
                ;;
            -g|--find|--grep)
                if (( $# < 2 )); then
                    printf 'pcuts: %s requires a search pattern\n' "$1" >&2
                    return 1
                fi
                filter="$2"
                shift 2
                ;;
            --sync)                add_cat sync; shift ;;
            --remote|--search)     add_cat search; shift ;;
            --query)               add_cat query; shift ;;
            --files)               add_cat files; shift ;;
            --remove)              add_cat remove; shift ;;
            --cache)               add_cat cache; shift ;;
            --verify|--audit)      add_cat verify; shift ;;
            --tricks|--tips)       add_cat tricks; shift ;;
            --emergency|--recovery) add_cat recovery; shift ;;
            --all)
                for c in "${ALL_CATEGORIES[@]}"; do add_cat "$c"; done
                shift
                ;;
            --)
                shift
                if (( $# > 0 )); then
                    filter="${filter:+$filter }$*"
                fi
                break
                ;;
            --*)
                setup_colors "$color_mode"
                printf '%bUnknown option: %s%b\n' "$red" "$1" "$r" >&2
                show_help >&2
                return 1
                ;;
            -*)
                local flags="${1#-}"
                if [[ -z "$flags" ]]; then
                    setup_colors "$color_mode"
                    printf '%bUnknown option: %s%b\n' "$red" "$1" "$r" >&2
                    return 1
                fi
                local i ch
                for (( i=0; i<${#flags}; i++ )); do
                    ch="${flags:$i:1}"
                    case "$ch" in
                        s|S) add_cat sync ;;
                        r|R) add_cat search ;;
                        q|Q) add_cat query ;;
                        f|F) add_cat files ;;
                        x|X) add_cat remove ;;
                        c)   add_cat cache ;;
                        v|V) add_cat verify ;;
                        t|T) add_cat tricks ;;
                        e|E) add_cat recovery ;;
                        a|A) for c in "${ALL_CATEGORIES[@]}"; do add_cat "$c"; done ;;
                        d|D) detailed=1 ;;
                        C)   do_clear=1 ;;
                        b|B) mode="browse" ;;
                        l|L) mode="list" ;;
                        h|H) mode="help" ;;
                        *)
                            setup_colors "$color_mode"
                            printf '%bUnknown short flag: -%s (in %s)%b\n' "$red" "$ch" "$1" "$r" >&2
                            show_help >&2
                            return 1
                            ;;
                    esac
                done
                shift
                ;;
            *)
                # Positional arguments act as a convenient live search filter
                filter="${filter:+$filter }$1"
                shift
                ;;
        esac
    done

    case "$color_mode" in
        auto|always|never) ;;
        *)
            printf 'pcuts: --color must be auto, always, or never (got: %s)\n' "$color_mode" >&2
            return 1
            ;;
    esac

    setup_colors "$color_mode"

    if [[ "$mode" == "help" ]]; then
        show_help
        return 0
    fi

    if (( ${#requested_cats[@]} == 0 )); then
        requested_cats=("${ALL_CATEGORIES[@]}")
    fi

    if [[ "$mode" == "browse" ]]; then
        browse "$filter" "${requested_cats[@]}"
        return $?
    fi

    if [[ "$mode" == "list" ]]; then
        local row cat cmd desc tip matched=0
        for c in "${requested_cats[@]}"; do
            for row in "${PCUTS_TABLE[@]}"; do
                IFS=$'\t' read -r cat cmd desc tip <<<"$row"
                [[ "$cat" == "$c" ]] || continue
                _row_matches_filter "$filter" "$cmd" "$desc" "$tip" || continue
                printf '%s\t%s\t%s\t%s\n' "$cat" "$cmd" "$desc" "${tip:-}"
                matched=1
            done
        done
        (( matched )) && return 0 || return 1
    fi

    if (( do_clear )) && [[ -t 1 ]]; then
        clear 2>/dev/null || true
    fi

    local any_printed=0
    for c in "${requested_cats[@]}"; do
        if _print_category "$c" "$filter" "$detailed"; then
            any_printed=1
        fi
    done

    if (( ! any_printed )); then
        printf '\n%bNo pacman commands matched filter "%s".%b\n\n' "$red" "$filter" "$r" >&2
        return 1
    fi

    printf '\n'
}

main "$@"