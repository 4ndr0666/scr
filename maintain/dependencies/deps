if [[ "${COLORS_ENABLED}" = true ]]; then
	OK="$(_t setaf 2)[OK]$(_t sgr0)"
	ERROR="$(_t setaf 1)[ERROR]$(_t sgr0)"
	NOTE="$(_t setaf 3)[NOTE]$(_t sgr0)"
