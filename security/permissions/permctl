#!/bin/sh
# ==============================================================================
# File:        permctl.sh (install as /usr/local/bin/permctl)
# Author:      4ndr0666
# Version:     8.0.0
# Paradigm:    Suckless Vectorized POSIX Shell Engine (#!/bin/sh, zero Bashisms)
# Architecture:
#   - Zero per-file shell loops: replaces O(N) shell fork-storms with O(1)-fork
#     vectorized `find ... -exec stat {} +` streams piped into single-pass `awk`
#     hash-join engines and batch-grouped `xargs` mutators.
#   - Multi-threaded Zstandard (`zstd -T0`) / `pigz` / `gzip` compressed Init
#     Index (`permctl.idx.zst`) + declarative rule-tree (`rules.conf`).
#   - Single-pass `awk` `FNR==1 ... nextfile` magic-byte (`#!` & `\177ELF`)
#     detector for home directory executable preservation.
#   - Live visual telemetry: determinate progress bars, background PID spinners,
#     and structured completion scorecards.
# ==============================================================================

set -eu
(set -o pipefail 2>/dev/null) && set -o pipefail || true

# ------------------------------------------------------------------------------
# 1. GLOBAL CONFIGURATION & ENVIRONMENT
# ------------------------------------------------------------------------------

PERMCTL_VERSION="8.0.0"
SCRIPT_NAME="$(basename "$0")"
readonly PERMCTL_VERSION SCRIPT_NAME

INVOKING_USER="${SUDO_USER:-${USER:-$(id -un 2>/dev/null || echo root)}}"
INVOKING_HOME="$HOME"
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && command -v getent >/dev/null 2>&1; then
	_sudo_h="$(getent passwd "$SUDO_USER" 2>/dev/null | awk -F: '{print $6}' || true)"
	[ -n "$_sudo_h" ] && [ -d "$_sudo_h" ] && INVOKING_HOME="$_sudo_h"
	unset _sudo_h
fi

ROOT_PREFIX="${PERMCTL_ROOT:-/}"
CONFIG_DIR="${PERMCTL_CONFIG_DIR:-/etc/permctl}"
CONFIG_FILE="${PERMCTL_CONFIG_FILE:-$CONFIG_DIR/permctl.conf}"
POLICY_FILE="${PERMCTL_POLICY_FILE:-$CONFIG_DIR/permissions_policy.tsv}"
INDEX_ZST_FILE="${PERMCTL_INDEX_FILE:-$CONFIG_DIR/permctl.idx.zst}"
YAML_POLICY_FILE="${PERMCTL_YAML_POLICY_FILE:-$CONFIG_DIR/permissions_policy.yaml}"
CUSTOM_PATHS_FILE="${PERMCTL_CUSTOM_PATHS_FILE:-/etc/custom_paths.txt}"
LOG_DIR="${PERMCTL_LOG_DIR:-${XDG_DATA_HOME:-$INVOKING_HOME/.local/share}/logs}"
LOG_FILE="${PERMCTL_LOG_FILE:-$LOG_DIR/permctl.log}"
ROLLBACK_STATE_FILE="${PERMCTL_ROLLBACK_FILE:-$LOG_DIR/permctl_rollback.tsv}"
BACKUP_BASE_DIR="${PERMCTL_BACKUP_DIR:-/var/backups/permctl}"
PACMAN_CACHE_DIR="${PERMCTL_PACMAN_CACHE:-/var/cache/pacman/pkg}"
LOG_MAX_BYTES=10485760

# Execution flags
DRY_RUN=0
RECURSIVE=0
SILENT=0
FORCE_YES=0
USE_FZF=1
INCLUDE_CACHE=0
AUTO_ESCALATE=1
EXPORT_YAML=0
LOG_READY=0
CLEANUP_RAN=0
ROLLBACK_RESET_DONE=0
IS_TTY=0
[ -t 1 ] && IS_TTY=1

# Parameters
TARGET_USER="$INVOKING_USER"
TARGET_GROUP="root"
TARGET_PATH="$PWD"
FILE_PATTERN="*"
CHMOD_MODE=""
DIR_MODE="0700"
FILE_MODE="0600"
SNAPSHOT_PREFIX=""
RESTORE_SOURCE=""
ACL_SPEC=""
GROUP_ACTION=""
REMAP_OLD_USER=""
REMAP_NEW_USER=""
FIX_STRATEGY="direct"          # direct | cache | reinstall | all-packages
POLICY_SOURCE="authoritative"  # authoritative | snapshot | live
SPECIAL_BITS=""
SUBCOMMAND=""
STD_SUBMODE="standard-all"
WORK_DIR=""

# ANSI / tput visual styling
if [ "$IS_TTY" -eq 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
	C_RED="$(tput setaf 1)"
	C_GRN="$(tput setaf 2)"
	C_YEL="$(tput setaf 3)"
	C_BLU="$(tput setaf 4)"
	C_MAG="$(tput setaf 5)"
	C_CYA="$(tput setaf 6)"
	C_BLD="$(tput bold)"
	C_DIM="$(tput dim 2>/dev/null || true)"
	C_RST="$(tput sgr0)"
else
	C_RED=""
	C_GRN=""
	C_YEL=""
	C_BLU=""
	C_MAG=""
	C_CYA=""
	C_BLD=""
	C_DIM=""
	C_RST=""
fi

TAG_OK="${C_GRN}[✓]${C_RST}"
TAG_ERR="${C_RED}[✗]${C_RST}"
TAG_WARN="${C_YEL}[!]${C_RST}"
TAG_INFO="${C_CYA}[i]${C_RST}"
TAG_ACT="${C_BLU}[»]${C_RST}"
TAG_DRY="${C_MAG}[~]${C_RST}"

# ------------------------------------------------------------------------------
# 2. VISUAL TELEMETRY ENGINE (PROGRESS BAR, SPINNER & SCORECARD)
# ------------------------------------------------------------------------------

# Render a live determinate progress bar on stderr (TTY-aware, silent-safe).
# Usage: ui_progress <current_step> <total_steps> <label>
ui_progress() {
	[ "$SILENT" -eq 1 ] && return 0
	_cur="$1"
	_tot="$2"
	_lbl="$3"
	[ "$_tot" -le 0 ] && _tot=1
	_pct=$((_cur * 100 / _tot))
	_w=28
	_fill=$((_cur * _w / _tot))
	_empty=$((_w - _fill))

	if [ "$IS_TTY" -eq 1 ]; then
		_bar_f="$(awk -v n="$_fill" 'BEGIN { for (i=0; i<n; i++) printf "█" }')"
		_bar_e="$(awk -v n="$_empty" 'BEGIN { for (i=0; i<n; i++) printf "░" }')"
		printf '\r\033[K%s[%s%s%s]%s %3d%% (%d/%d) %s' \
			"$C_CYA" "$C_GRN$_bar_f" "$C_DIM$_bar_e" "$C_CYA" "$C_RST" \
			"$_pct" "$_cur" "$_tot" "$_lbl" >&2
		if [ "$_cur" -ge "$_tot" ]; then
			printf '\n' >&2
		fi
		unset _bar_f _bar_e
	else
		printf '%s [%3d%%] (%d/%d) %s\n' "$TAG_INFO" "$_pct" "$_cur" "$_tot" "$_lbl" >&2
	fi
	unset _cur _tot _lbl _pct _w _fill _empty
}

# Run a command in the background with an animated spinner when attached to a TTY.
# Usage: run_with_spinner "Label" cmd arg1 arg2 ...
run_with_spinner() {
	_sp_lbl="$1"
	shift
	if [ "$SILENT" -eq 1 ] || [ "$IS_TTY" -eq 0 ]; then
		log_msg INFO "$_sp_lbl..."
		"$@"
		return $?
	fi

	"$@" &
	_sp_pid=$!
	_sp_i=0
	while kill -0 "$_sp_pid" 2>/dev/null; do
		_sp_i=$(( (_sp_i + 1) % 4 ))
		case "$_sp_i" in
		0) _gl="|" ;;
		1) _gl="/" ;;
		2) _gl="-" ;;
		3) _gl="\\" ;;
		esac
		printf '\r\033[K%s[%s]%s %s...' "$C_CYA" "$_gl" "$C_RST" "$_sp_lbl" >&2
		sleep 0.1 2>/dev/null || sleep 1
	done
	printf '\r\033[K' >&2
	_sp_rc=0
	wait "$_sp_pid" || _sp_rc=$?
	unset _sp_lbl _sp_pid _sp_i _gl
	return "$_sp_rc"
}

# Render a structured completion scorecard.
# Usage: ui_scorecard "Title" "Metric1: Value1" "Metric2: Value2" ...
ui_scorecard() {
	[ "$SILENT" -eq 1 ] && return 0
	_sc_title="$1"
	shift
	printf '\n%s┌──────────────────────────────────────────────────────────────┐%s\n' "$C_CYA" "$C_RST"
	printf '%s│%s %-60s %s│%s\n' "$C_CYA" "$C_BLD" "$_sc_title" "$C_CYA" "$C_RST"
	printf '%s├──────────────────────────────────────────────────────────────┤%s\n' "$C_CYA" "$C_RST"
	for _row in "$@"; do
		_k="${_row%%:*}"
		_v="${_row#*: }"
		printf '%s│%s  %-22s : %-34s %s│%s\n' "$C_CYA" "$C_RST" "$_k" "$_v" "$C_CYA" "$C_RST"
	done
	printf '%s└──────────────────────────────────────────────────────────────┘%s\n' "$C_CYA" "$C_RST"
	unset _sc_title _row _k _v
}

# ------------------------------------------------------------------------------
# 3. COMPRESSION STREAM ADAPTER (ZSTD -T0 / PIGZ / GZIP)
# ------------------------------------------------------------------------------

compress_stream() {
	if command -v zstd >/dev/null 2>&1; then
		zstd -q -T0 -3 -f
	elif command -v pigz >/dev/null 2>&1; then
		pigz -q -f
	else
		gzip -q -f
	fi
}

decompress_file() {
	_df="$1"
	case "$_df" in
	*.zst)
		if command -v zstd >/dev/null 2>&1; then
			zstd -dc "$_df"
		else
			die "'zstd' is required to decompress $_df" 1
		fi
		;;
	*.gz)
		if command -v pigz >/dev/null 2>&1; then
			pigz -dc "$_df"
		else
			gzip -dc "$_df"
		fi
		;;
	*)
		cat "$_df"
		;;
	esac
	unset _df
}

# ------------------------------------------------------------------------------
# 4. WORKSPACE, LOGGING, TRAPS & PERSISTENT ROLLBACK ENGINE
# ------------------------------------------------------------------------------

init_workspace() {
	WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/permctl.XXXXXX")"
}

init_logging() {
	mkdir -p "$LOG_DIR" 2>/dev/null || {
		LOG_DIR="${TMPDIR:-/tmp}"
		LOG_FILE="$LOG_DIR/permctl.log"
		ROLLBACK_STATE_FILE="$LOG_DIR/permctl_rollback.tsv"
	}
	if [ -f "$LOG_FILE" ]; then
		_sz="$(stat -c '%s' "$LOG_FILE" 2>/dev/null || echo 0)"
		if [ "$_sz" -ge "$LOG_MAX_BYTES" ]; then
			mv "$LOG_FILE" "${LOG_FILE}.$(date '+%Y%m%d%H%M%S').bak" 2>/dev/null || true
		fi
		unset _sz
	fi
	touch "$LOG_FILE" "$ROLLBACK_STATE_FILE" 2>/dev/null || true
	chmod 0600 "$LOG_FILE" "$ROLLBACK_STATE_FILE" 2>/dev/null || true
	if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
		chown "$SUDO_UID:$SUDO_GID" "$LOG_DIR" "$LOG_FILE" "$ROLLBACK_STATE_FILE" 2>/dev/null || true
	fi
	LOG_READY=1
}

log_msg() {
	_lvl="$1"
	_msg="$2"
	_ts="$(date '+%Y-%m-%d %H:%M:%S')"
	if [ "$LOG_READY" -eq 1 ] && [ -w "$LOG_FILE" ]; then
		printf '%s [%s] %s\n' "$_ts" "$_lvl" "$_msg" >>"$LOG_FILE"
	fi
	if [ "$SILENT" -eq 0 ]; then
		case "$_lvl" in
		OK) printf '%s %s\n' "$TAG_OK" "$_msg" ;;
		ERROR) printf '%s %s\n' "$TAG_ERR" "$_msg" >&2 ;;
		WARN) printf '%s %s\n' "$TAG_WARN" "$_msg" >&2 ;;
		ACTION) printf '%s %s\n' "$TAG_ACT" "$_msg" ;;
		DRY) printf '%s %s\n' "$TAG_DRY" "$_msg" ;;
		*) printf '%s %s\n' "$TAG_INFO" "$_msg" ;;
		esac
	fi
	unset _lvl _msg _ts
}

die() {
	log_msg ERROR "$1"
	exit "${2:-1}"
}

cleanup() {
	_rc=$?
	[ "$CLEANUP_RAN" -eq 1 ] && exit "$_rc"
	CLEANUP_RAN=1
	trap - EXIT INT TERM HUP
	if [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ]; then
		rm -rf "$WORK_DIR" 2>/dev/null || true
	fi
	exit "$_rc"
}
trap cleanup EXIT INT TERM HUP

run_cmd() {
	if [ "$DRY_RUN" -eq 1 ]; then
		log_msg DRY "Would execute: $*"
		return 0
	fi
	"$@"
}

confirm_action() {
	[ "$FORCE_YES" -eq 1 ] && return 0
	printf '%s [y/N]: ' "$1" >&2
	read -r _ans || return 1
	case "$_ans" in
	[Yy] | [Yy][Ee][Ss])
		unset _ans
		return 0
		;;
	*)
		unset _ans
		return 1
		;;
	esac
}

record_rollback_entry() {
	_rb_path="$1"
	if [ ! -e "$_rb_path" ] || [ -L "$_rb_path" ] || [ "$DRY_RUN" -eq 1 ]; then
		unset _rb_path
		return 0
	fi
	if [ "$ROLLBACK_RESET_DONE" -eq 0 ] && [ "${SUBCOMMAND:-menu}" != "menu" ]; then
		: >"$ROLLBACK_STATE_FILE" 2>/dev/null || true
		ROLLBACK_RESET_DONE=1
	fi
	if [ "$RECURSIVE" -eq 1 ] && [ -d "$_rb_path" ]; then
		find "$_rb_path" -maxdepth 3 ! -type l -exec stat -c '%a|%U|%G|%n' {} + >>"$ROLLBACK_STATE_FILE" 2>/dev/null || true
	else
		stat -c '%a|%U|%G|%n' "$_rb_path" >>"$ROLLBACK_STATE_FILE" 2>/dev/null || true
	fi
	unset _rb_path
}

rollback_session() {
	if [ ! -f "$ROLLBACK_STATE_FILE" ] || [ ! -s "$ROLLBACK_STATE_FILE" ]; then
		log_msg INFO "Rollback journal ($ROLLBACK_STATE_FILE) is empty; nothing to roll back."
		return 0
	fi
	log_msg ACTION "Rolling back recorded permission changes from $ROLLBACK_STATE_FILE..."
	awk '{ lines[NR] = $0 } END { for (i = NR; i >= 1; i--) print lines[i] }' "$ROLLBACK_STATE_FILE" |
		while IFS='|' read -r _m _u _g _p; do
			[ -z "$_p" ] && continue
			if [ -e "$_p" ] && [ ! -L "$_p" ]; then
				run_cmd chown "$_u:$_g" "$_p" 2>/dev/null || log_msg WARN "Rollback chown failed on $_p"
				run_cmd chmod "$_m" "$_p" 2>/dev/null || log_msg WARN "Rollback chmod failed on $_p"
				log_msg OK "Restored $_p -> $_u:$_g ($_m)"
			fi
		done
	[ "$DRY_RUN" -eq 0 ] && : >"$ROLLBACK_STATE_FILE"
	log_msg OK "Rollback complete."
}

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		if [ "$DRY_RUN" -eq 1 ]; then
			log_msg WARN "Running non-root (UID=$(id -u)) in --dry-run mode."
			return 0
		fi
		if [ "$AUTO_ESCALATE" -eq 1 ] && command -v sudo >/dev/null 2>&1; then
			log_msg INFO "Escalating privileges via sudo..."
			exec sudo "$0" "$@"
		fi
		die "Root privileges required. Re-run with sudo." 1
	fi
}

resolve_root_path() {
	_rel="$1"
	if [ "$ROOT_PREFIX" = "/" ]; then
		printf '%s\n' "$_rel"
	else
		printf '%s/%s\n' "${ROOT_PREFIX%/}" "${_rel#/}"
	fi
	unset _rel
}

# ------------------------------------------------------------------------------
# 5. VECTORIZED DELTA-ONLY BATCH EXECUTOR (ZERO PER-FILE SHELL FORKS)
#    Takes a target stream of `TYPE|MODE|OWNER|GROUP|PATH` and compares it against
#    a single vectorized `find ... -exec stat {} +` pass in `awk`, then applies
#    only the necessary `chown` and `chmod` mutations in grouped batches!
# ------------------------------------------------------------------------------

# Apply a target policy/snapshot stream (`TYPE|MODE|OWNER|GROUP|PATH` or `MODE|OWNER|GROUP|SYM|PATH`)
# using vectorized batch execution instead of spawning chmod/chown per line.
apply_vectorized_stream() {
	_stream_file="$1"
	_dest_root="${2:-$ROOT_PREFIX}"
	_old_u="${3:-$REMAP_OLD_USER}"
	_new_u="${4:-$REMAP_NEW_USER}"

	_chmod_plan="$WORK_DIR/chmod_plan.tsv"
	_chown_plan="$WORK_DIR/chown_plan.tsv"
	: >"$_chmod_plan"
	: >"$_chown_plan"

	# Normalize records into MODE|OWNER:GROUP|FULL_PATH and filter out paths that already match on disk
	# by probing existing paths in vectorized `stat` batches of 4,000 arguments!
	_norm_targets="$WORK_DIR/norm_targets.tsv"
	_target_paths="$WORK_DIR/target_paths.txt"

	awk -F'|' -v droot="$_dest_root" -v oldu="$_old_u" -v newu="$_new_u" '
	/^#/ || NF < 4 { next }
	{
		if ($1 == "D" || $1 == "F") {
			m = $2; u = $3; g = $4
			p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
		} else if (NF >= 5) {
			m = $1; u = $2; g = $3
			p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
		} else {
			m = $1; u = $2; g = $3
			p = substr($0, length($1)+length($2)+length($3)+4)
		}
		if (oldu != "" && u == oldu) u = newu
		if (oldu != "" && g == oldu) g = newu
		sub(/^0+/, "", m); if (m == "") m = "0"
		if (droot != "/" && index(p, droot) != 1) {
			sub(/^\//, "", p)
			full = droot "/" p
			gsub(/\/\//, "/", full)
		} else {
			full = p
		}
		# Layer 1 Kernel/Device Guard: NEVER touch /dev (except /dev/shm), /proc, /sys, or /run
		if (full ~ /^\/(proc|sys|run|dev)(\/|$)/ && full != "/dev/shm") next
		printf "%s|%s:%s|%s\n", m, u, g, full
	}' "$_stream_file" >"$_norm_targets"

	awk -F'|' '{ print substr($0, length($1)+length($2)+3) }' "$_norm_targets" >"$_target_paths"

	# Vectorized live-stat pass over the target paths (4,000 paths per stat invocation via xargs)
	# Includes %F (file type) so character/block devices, sockets, and FIFOs are strictly rejected!
	_live_stat="$WORK_DIR/live_stat.tsv"
	: >"$_live_stat"
	if [ -s "$_target_paths" ]; then
		tr '\n' '\0' <"$_target_paths" | xargs -0 -r stat -c '%F|%a|%U:%G|%n' >>"$_live_stat" 2>/dev/null || true
	fi

	# Single-pass awk hash-join: emit ONLY regular files and directories whose mode or owner:group differs!
	awk -F'|' -v chmod_out="$_chmod_plan" -v chown_out="$_chown_plan" '
	FILENAME == ARGV[1] {
		ftype = $1
		if (ftype !~ /^(regular file|regular empty file|directory)$/) next
		p = substr($0, length($1)+length($2)+length($3)+4)
		m = $2; sub(/^0+/, "", m); if (m == "") m = "0"
		live_m[p] = m
		live_ug[p] = $3
		next
	}
	{
		p = substr($0, length($1)+length($2)+3)
		if (!(p in live_m)) next
		exp_m = $1; sub(/^0+/, "", exp_m); if (exp_m == "") exp_m = "0"
		exp_ug = $2
		if (live_m[p] != exp_m) {
			printf "%s|%s\n", exp_m, p >> chmod_out
		}
		if (live_ug[p] != exp_ug) {
			printf "%s|%s\n", exp_ug, p >> chown_out
		}
	}' "$_live_stat" "$_norm_targets"

	_chmod_cnt="$(wc -l <"$_chmod_plan" | tr -d ' ')"
	_chown_cnt="$(wc -l <"$_chown_plan" | tr -d ' ')"

	# Execute grouped batch chown (1 xargs pipeline per distinct owner:group instead of 1 fork per file!)
	if [ "$_chown_cnt" -gt 0 ]; then
		cut -d'|' -f1 "$_chown_plan" | sort -u | while IFS= read -r _ug; do
			[ -z "$_ug" ] && continue
			if [ "$DRY_RUN" -eq 1 ]; then
				_c="$(awk -F'|' -v k="$_ug" '$1==k {n++} END {print n+0}' "$_chown_plan")"
				log_msg DRY "Would batch-chown $_c path(s) to $_ug"
			else
				awk -F'|' -v k="$_ug" '$1==k { printf "%s\0", substr($0, length($1)+2) }' "$_chown_plan" |
					xargs -0 -r chown "$_ug" 2>/dev/null || true
			fi
		done
	fi

	# Execute grouped batch chmod (1 xargs pipeline per distinct octal mode instead of 1 fork per file!)
	if [ "$_chmod_cnt" -gt 0 ]; then
		cut -d'|' -f1 "$_chmod_plan" | sort -u | while IFS= read -r _md; do
			[ -z "$_md" ] && continue
			if [ "$DRY_RUN" -eq 1 ]; then
				_c="$(awk -F'|' -v k="$_md" '$1==k {n++} END {print n+0}' "$_chmod_plan")"
				log_msg DRY "Would batch-chmod $_c path(s) to 0$_md"
			else
				awk -F'|' -v k="$_md" '$1==k { printf "%s\0", substr($0, length($1)+2) }' "$_chmod_plan" |
					xargs -0 -r chmod "$_md" 2>/dev/null || true
			fi
		done
	fi

	LAST_VECTOR_CHMOD="$_chmod_cnt"
	LAST_VECTOR_CHOWN="$_chown_cnt"
	unset _stream_file _dest_root _old_u _new_u _chmod_plan _chown_plan _norm_targets _target_paths _live_stat _ug _md _c
}

# ------------------------------------------------------------------------------
# 6. CONFIGURATION & DEPENDENCY ENGINE
# ------------------------------------------------------------------------------

load_config() {
	[ ! -f "$CONFIG_FILE" ] && return 0
	while IFS='=' read -r _k _v || [ -n "$_k" ]; do
		_k="$(printf '%s' "$_k" | sed 's/#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
		[ -z "$_k" ] && continue
		_v="$(printf '%s' "$_v" | sed "s/^[[:space:]]*//; s/[[:space:]]*$//; s/^'//; s/'$//; s/^\"//; s/\"$//")"
		case "$_k" in
		DEFAULT_USER) TARGET_USER="$_v" ;;
		DEFAULT_GROUP) TARGET_GROUP="$_v" ;;
		BACKUP_BASE_DIR) BACKUP_BASE_DIR="$_v" ;;
		POLICY_FILE) POLICY_FILE="$_v" ;;
		LOG_FILE) LOG_FILE="$_v" ;;
		esac
	done <"$CONFIG_FILE"
	unset _k _v
}

save_config() {
	run_cmd mkdir -p "$(dirname "$CONFIG_FILE")"
	if [ "$DRY_RUN" -eq 1 ]; then
		log_msg DRY "Would write configuration to $CONFIG_FILE"
		return 0
	fi
	cat >"$CONFIG_FILE" <<EOF
# permctl configuration — managed by $SCRIPT_NAME v$PERMCTL_VERSION
DEFAULT_USER=$TARGET_USER
DEFAULT_GROUP=$TARGET_GROUP
BACKUP_BASE_DIR=$BACKUP_BASE_DIR
POLICY_FILE=$POLICY_FILE
LOG_FILE=$LOG_FILE
EOF
	chmod 0600 "$CONFIG_FILE" 2>/dev/null || true
	log_msg OK "Configuration saved to $CONFIG_FILE"
}

check_dependencies() {
	_auto_install="${1:-0}"
	_missing=""
	for _cmd in find stat chmod chown awk sed grep sort comm tr cut head tail wc date mktemp xargs; do
		command -v "$_cmd" >/dev/null 2>&1 || _missing="$_missing $_cmd"
	done
	[ -n "$_missing" ] && die "Missing core POSIX utilities:$_missing" 1

	_opt_missing=""
	for _opt in getfacl setfacl getfattr setfattr lsattr chattr pacman zstd rsync fzf; do
		command -v "$_opt" >/dev/null 2>&1 || _opt_missing="$_opt_missing $_opt"
	done
	if [ -n "$_opt_missing" ] && [ "$_auto_install" -eq 1 ] && command -v pacman >/dev/null 2>&1; then
		log_msg INFO "Optional utilities not installed:$_opt_missing"
		if confirm_action "Install optional Arch packages (acl attr e2fsprogs zstd rsync fzf pacutils)?"; then
			run_cmd pacman -S --noconfirm --needed acl attr e2fsprogs zstd rsync fzf pacutils
		fi
	fi
	unset _auto_install _missing _cmd _opt_missing _opt
}

# ------------------------------------------------------------------------------
# 7. PATH INSPECTOR & DAILY-DRIVER OPERATIONS
# ------------------------------------------------------------------------------

inspect_path() {
	_target="${1:-$TARGET_PATH}"
	if [ ! -e "$_target" ] && [ ! -L "$_target" ]; then
		log_msg ERROR "Path does not exist: $_target"
		unset _target
		return 1
	fi
	_owner="$(stat -c '%U' "$_target" 2>/dev/null || echo unknown)"
	_group="$(stat -c '%G' "$_target" 2>/dev/null || echo unknown)"
	_uid="$(stat -c '%u' "$_target" 2>/dev/null || echo '?')"
	_gid="$(stat -c '%g' "$_target" 2>/dev/null || echo '?')"
	_octal="$(stat -c '%a' "$_target" 2>/dev/null || echo '???')"
	_sym="$(stat -c '%A' "$_target" 2>/dev/null || echo '??????????')"
	_type="$(stat -c '%F' "$_target" 2>/dev/null || echo 'unknown')"

	_special="none"
	case "$_octal" in
	[1-7][0-7][0-7][0-7])
		_lead="${_octal%[0-7][0-7][0-7]}"
		_sp_list=""
		[ "$((_lead & 4))" -ne 0 ] && _sp_list="${_sp_list}setuid "
		[ "$((_lead & 2))" -ne 0 ] && _sp_list="${_sp_list}setgid "
		[ "$((_lead & 1))" -ne 0 ] && _sp_list="${_sp_list}sticky "
		_special="${_sp_list% }"
		unset _lead _sp_list
		;;
	esac

	_attrs="n/a"
	if command -v lsattr >/dev/null 2>&1 && [ ! -L "$_target" ]; then
		_attrs="$(lsattr -d "$_target" 2>/dev/null | awk '{print $1}' || echo 'n/a')"
	fi

	printf '%s┌─ // PATH INSPECTOR // ───────────────────────────────────────┐%s\n' "$C_CYA" "$C_RST"
	printf '  %sPath:%s        %s (%s)\n' "$C_BLD" "$C_RST" "$_target" "$_type"
	printf '  %sOwner:Group:%s %s:%s (UID=%s, GID=%s)\n' "$C_BLD" "$C_RST" "$_owner" "$_group" "$_uid" "$_gid"
	printf '  %sPermissions:%s %s (%s) [Special: %s]\n' "$C_BLD" "$C_RST" "$_octal" "$_sym" "$_special"
	printf '  %sAttributes:%s  %s\n' "$C_BLD" "$C_RST" "$_attrs"
	if command -v getfacl >/dev/null 2>&1; then
		printf '  %sACLs:%s\n' "$C_BLD" "$C_RST"
		getfacl -p "$_target" 2>/dev/null | grep -E '^(user:|group:|mask:|other:|default:)' | sed 's/^/    /' || true
	fi
	printf '%s└──────────────────────────────────────────────────────────────┘%s\n' "$C_CYA" "$C_RST"
	unset _target _owner _group _uid _gid _octal _sym _type _special _attrs
}

apply_path_transform() {
	_mode_kind="$1"
	_target="${2:-$TARGET_PATH}"
	_pattern="${3:-$FILE_PATTERN}"
	[ ! -e "$_target" ] && die "Target path does not exist: $_target" 1

	record_rollback_entry "$_target"

	case "$_mode_kind" in
	own-it)
		log_msg ACTION "Applying own-it ($TARGET_USER:$TARGET_GROUP + ug+rwx, recursive=$RECURSIVE, pattern=$_pattern) on $_target"
		if [ "$RECURSIVE" -eq 1 ]; then
			if [ "$_pattern" = "*" ]; then
				run_cmd chown -R "$TARGET_USER:$TARGET_GROUP" "$_target"
				run_cmd chmod -R ug+rwx "$_target"
			else
				run_cmd find "$_target" -name "$_pattern" -exec chown "$TARGET_USER:$TARGET_GROUP" {} +
				run_cmd find "$_target" -name "$_pattern" -exec chmod ug+rwx {} +
			fi
		else
			run_cmd chown "$TARGET_USER:$TARGET_GROUP" "$_target"
			run_cmd chmod ug+rwx "$_target"
		fi
		log_msg OK "own-it completed on $_target"
		;;

	compaudit)
		log_msg ACTION "Applying compaudit lockdown ($TARGET_USER:$TARGET_GROUP + og-w, recursive=$RECURSIVE, pattern=$_pattern) on $_target"
		if [ "$RECURSIVE" -eq 1 ]; then
			if [ "$_pattern" = "*" ]; then
				run_cmd chown -R "$TARGET_USER:$TARGET_GROUP" "$_target"
				run_cmd chmod -R og-w "$_target"
			else
				run_cmd find "$_target" -name "$_pattern" -exec chown "$TARGET_USER:$TARGET_GROUP" {} +
				run_cmd find "$_target" -name "$_pattern" -exec chmod og-w {} +
			fi
		else
			run_cmd chown "$TARGET_USER:$TARGET_GROUP" "$_target"
			run_cmd chmod og-w "$_target"
		fi
		if command -v zsh >/dev/null 2>&1; then
			_zsh_insecure="$(zsh -c 'autoload -Uz compaudit && compaudit' 2>/dev/null || true)"
			if [ -z "$_zsh_insecure" ]; then
				log_msg OK "Zsh compaudit reports zero insecure directories."
			else
				log_msg WARN "Zsh compaudit flagged insecure paths:"
				printf '%s\n' "$_zsh_insecure" | sed 's/^/  /'
			fi
			unset _zsh_insecure
		fi
		log_msg OK "compaudit completed on $_target"
		;;

	standard-all)
		log_msg ACTION "Setting standard private permissions (dirs=$DIR_MODE, files=$FILE_MODE) on $_target"
		run_cmd find "$_target" -type d -exec chmod "$DIR_MODE" {} +
		run_cmd find "$_target" -type f -exec chmod "$FILE_MODE" {} +
		log_msg OK "Standard permissions (dirs=$DIR_MODE, files=$FILE_MODE) applied to $_target"
		;;

	standard-dirs)
		log_msg ACTION "Setting directory permissions ($DIR_MODE) on $_target"
		run_cmd find "$_target" -type d -exec chmod "$DIR_MODE" {} +
		log_msg OK "Directory permissions ($DIR_MODE) applied to $_target"
		;;

	standard-files)
		log_msg ACTION "Setting file permissions ($FILE_MODE) on $_target"
		run_cmd find "$_target" -type f -exec chmod "$FILE_MODE" {} +
		log_msg OK "File permissions ($FILE_MODE) applied to $_target"
		;;

	custom-chmod)
		[ -z "$CHMOD_MODE" ] && die "--chmod=MODE is required for custom-chmod operation." 1
		log_msg ACTION "Applying mode $CHMOD_MODE (recursive=$RECURSIVE, pattern=$_pattern) on $_target"
		if [ "$RECURSIVE" -eq 1 ] && [ -d "$_target" ]; then
			if [ "$_pattern" = "*" ]; then
				run_cmd chmod -R "$CHMOD_MODE" "$_target"
			else
				run_cmd find "$_target" -name "$_pattern" -exec chmod "$CHMOD_MODE" {} +
			fi
		elif [ -d "$_target" ] && [ "$_pattern" != "*" ]; then
			run_cmd find "$_target" -maxdepth 1 -name "$_pattern" -exec chmod "$CHMOD_MODE" {} +
		else
			run_cmd chmod "$CHMOD_MODE" "$_target"
		fi
		log_msg OK "Mode $CHMOD_MODE applied to $_target"
		;;

	change-owner)
		log_msg ACTION "Changing ownership to $TARGET_USER:$TARGET_GROUP (recursive=$RECURSIVE) on $_target"
		if [ "$RECURSIVE" -eq 1 ]; then
			run_cmd chown -R "$TARGET_USER:$TARGET_GROUP" "$_target"
		else
			run_cmd chown "$TARGET_USER:$TARGET_GROUP" "$_target"
		fi
		log_msg OK "Ownership updated on $_target"
		;;

	change-both)
		[ -z "$CHMOD_MODE" ] && CHMOD_MODE="0755"
		log_msg ACTION "Changing ownership ($TARGET_USER:$TARGET_GROUP) and mode ($CHMOD_MODE, recursive=$RECURSIVE) on $_target"
		if [ "$RECURSIVE" -eq 1 ]; then
			run_cmd chown -R "$TARGET_USER:$TARGET_GROUP" "$_target"
			run_cmd chmod -R "$CHMOD_MODE" "$_target"
		else
			run_cmd chown "$TARGET_USER:$TARGET_GROUP" "$_target"
			run_cmd chmod "$CHMOD_MODE" "$_target"
		fi
		log_msg OK "Ownership and permissions updated on $_target"
		;;
	esac
	unset _mode_kind _target _pattern
}

apply_special_bits() {
	_target="${1:-$TARGET_PATH}"
	_bits="${2:-$SPECIAL_BITS}"
	[ ! -e "$_target" ] && die "Path does not exist: $_target" 1
	record_rollback_entry "$_target"
	case "$_bits" in
	suid | u+s)
		[ ! -u "$_target" ] && run_cmd chmod u+s "$_target"
		log_msg OK "Verified setuid (u+s) on $_target"
		;;
	sgid | g+s)
		[ ! -g "$_target" ] && run_cmd chmod g+s "$_target"
		log_msg OK "Verified setgid (g+s) on $_target"
		;;
	sticky | +t)
		[ ! -k "$_target" ] && run_cmd chmod +t "$_target"
		log_msg OK "Verified sticky bit (+t) on $_target"
		;;
	all)
		[ ! -u "$_target" ] && run_cmd chmod u+s "$_target"
		[ ! -g "$_target" ] && run_cmd chmod g+s "$_target"
		[ ! -k "$_target" ] && run_cmd chmod +t "$_target"
		log_msg OK "Applied setuid, setgid, and sticky bits to $_target"
		;;
	*)
		die "Invalid special bit specification '$_bits' (expected: suid, sgid, sticky, or all)." 1
		;;
	esac
	unset _target _bits
}

# ------------------------------------------------------------------------------
# 8. VECTORIZED SNAPSHOT & MULTI-FORMAT RESTORE ENGINE
#    Uses `find ... -exec stat {} +`, `getfacl --skip-base`, and `zstd -T0`
#    plus vectorized delta-only restoration!
# ------------------------------------------------------------------------------

create_snapshot() {
	_target="${1:-$TARGET_PATH}"
	_prefix="${2:-$SNAPSHOT_PREFIX}"
	if [ -z "$_prefix" ]; then
		_ts="$(date '+%Y%m%d_%H%M%S')"
		_prefix="$BACKUP_BASE_DIR/snapshot_${_ts}"
		unset _ts
	fi
	[ ! -e "$_target" ] && die "Snapshot target does not exist: $_target" 1

	_snap_dir="$(dirname "$_prefix")"
	run_cmd mkdir -p "$_snap_dir"
	_t0="$(date +%s)"

	if [ "$DRY_RUN" -eq 1 ]; then
		log_msg DRY "Would create vectorized snapshot at ${_prefix}.*"
		unset _target _prefix _snap_dir _t0
		return 0
	fi

	ui_progress 1 4 "Capturing vectorized stat stream (${_prefix}.perms)..."
	find "$_target" -xdev \
		\( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path /tmp \
		-o -path /mnt -o -path /media -o -path /lost+found \
		-o -path '/var/cache' -o -path '/var/tmp' \
		-o -path '*/.cache' -o -path '*/.local/share/Trash' \) -prune -o \
		\( -type f -o -type d \) -exec stat -c '%a|%U|%G|%A|%n' {} + >"${_prefix}.perms" 2>/dev/null || true

	ui_progress 2 4 "Capturing non-trivial POSIX ACLs (--skip-base)..."
	if command -v getfacl >/dev/null 2>&1; then
		getfacl -R --skip-base --absolute-names --one-file-system "$_target" >"${_prefix}.acl" 2>/dev/null || true
	fi

	ui_progress 3 4 "Capturing extended attributes (xattrs)..."
	if command -v getfattr >/dev/null 2>&1; then
		getfattr -R -d -m - --absolute-names "$_target" >"${_prefix}.attrs" 2>/dev/null || true
	fi

	ui_progress 4 4 "Compressing Zstandard capsule & computing SHA-256 manifest..."
	if command -v zstd >/dev/null 2>&1; then
		zstd -q -T0 -3 -f -k "${_prefix}.perms" -o "${_prefix}.perms.zst" 2>/dev/null || true
	fi
	if command -v sha256sum >/dev/null 2>&1; then
		: >"${_prefix}.sha256"
		for _sf in "${_prefix}.perms" "${_prefix}.perms.zst" "${_prefix}.acl" "${_prefix}.attrs"; do
			[ -f "$_sf" ] && sha256sum "$_sf" >>"${_prefix}.sha256" 2>/dev/null || true
		done
		unset _sf
	fi

	_count="$(wc -l <"${_prefix}.perms" | tr -d ' ')"
	_elapsed=$(( $(date +%s) - _t0 ))
	log_msg OK "Snapshot complete ($_count entries in ${_elapsed}s -> ${_prefix}.*)"
	ui_scorecard "SNAPSHOT COMPLETED" \
		"Target Root: $_target" \
		"Entries Captured: $_count" \
		"Snapshot Prefix: $_prefix" \
		"Elapsed Time: ${_elapsed}s"
	unset _target _prefix _snap_dir _t0 _count _elapsed
}

restore_snapshot() {
	_src="${1:-$RESTORE_SOURCE}"
	_dest_root="${2:-$ROOT_PREFIX}"
	[ -z "$_src" ] && die "Snapshot source path or prefix is required for restore." 1

	_old_u="$REMAP_OLD_USER"
	_new_u="$REMAP_NEW_USER"
	_t0="$(date +%s)"
	_vec_input="$WORK_DIR/restore_vector.tsv"
	: >"$_vec_input"

	# Case A: Directory from acl_manager or permission_manager
	if [ -d "$_src" ]; then
		if [ -f "$_src/system_ownerships.txt" ]; then
			ui_progress 1 3 "Parsing acl_manager backup directory ($_src)..."
			if [ -f "$_src/system_perms.acl" ] && [ -s "$_src/system_perms.acl" ] && command -v setfacl >/dev/null 2>&1; then
				_acl_f="$_src/system_perms.acl"
				if [ -n "$_old_u" ] && [ -n "$_new_u" ] && [ "$DRY_RUN" -eq 0 ]; then
					_acl_f="$WORK_DIR/remapped.acl"
					sed "s/\\b${_old_u}\\b/${_new_u}/g" "$_src/system_perms.acl" >"$_acl_f"
				fi
				run_cmd setfacl --restore="$_acl_f" 2>/dev/null || true
				unset _acl_f
			fi
			awk '
			/^total/ || NF < 3 { next }
			$1 ~ /^[-dlcbps][rwxstST-]/ {
				m = $2; u = $3; g = $4
				p = ""
				for (i = 5; i <= NF; i++) p = p (i > 5 ? " " : "") $i
				printf "F|%s|%s|%s|%s\n", m, u, g, p
				next
			}
			{
				u = $1; g = $2
				p = ""
				for (i = 3; i <= NF; i++) p = p (i > 3 ? " " : "") $i
				printf "F|755|%s|%s|%s\n", u, g, p
			}' "$_src/system_ownerships.txt" >"$_vec_input"
			ui_progress 2 3 "Applying vectorized delta restoration..."
			apply_vectorized_stream "$_vec_input" "$_dest_root" "$_old_u" "$_new_u"
			ui_progress 3 3 "Restore complete."
			log_msg OK "Restored acl_manager backup from $_src"
			unset _src _dest_root _old_u _new_u _t0 _vec_input
			return 0
		fi

		_latest_csv="$(ls -1t "$_src"/ownerships_*.csv 2>/dev/null | head -n 1 || true)"
		_latest_acl="$(ls -1t "$_src"/permissions_acl_*.gz 2>/dev/null | head -n 1 || true)"
		if [ -n "$_latest_csv" ] && [ -f "$_latest_csv" ]; then
			ui_progress 1 3 "Parsing permission_manager CSV backup ($_latest_csv)..."
			if [ -n "$_latest_acl" ] && [ -f "$_latest_acl" ] && command -v setfacl >/dev/null 2>&1; then
				if [ "$DRY_RUN" -eq 0 ]; then
					decompress_file "$_latest_acl" | setfacl --restore=- 2>/dev/null || true
				else
					log_msg DRY "Would restore compressed ACLs from $_latest_acl"
				fi
			fi
			awk -F',' 'NF >= 4 { printf "F|%s|%s|%s|%s\n", $2, $3, $4, $1 }' "$_latest_csv" >"$_vec_input"
			ui_progress 2 3 "Applying vectorized delta restoration..."
			apply_vectorized_stream "$_vec_input" "$_dest_root" "$_old_u" "$_new_u"
			ui_progress 3 3 "Restore complete."
			log_msg OK "Restored permission_manager backup from $_src"
			unset _src _dest_root _old_u _new_u _t0 _vec_input _latest_csv _latest_acl
			return 0
		fi
	fi

	# Case B: File or prefix (.perms.zst, .perms, or raw snapshot file)
	if [ -f "${_src}.perms.zst" ]; then
		_perms_file="${_src}.perms.zst"
		_acl_file="${_src}.acl"
		_attrs_file="${_src}.attrs"
	elif [ -f "${_src}.perms" ]; then
		_perms_file="${_src}.perms"
		_acl_file="${_src}.acl"
		_attrs_file="${_src}.attrs"
	elif [ -f "$_src" ]; then
		_perms_file="$_src"
		_base="${_src%.zst}"
		_base="${_base%.perms}"
		_acl_file="${_base}.acl"
		_attrs_file="${_base}.attrs"
		unset _base
	else
		die "Snapshot source '$_src' not found." 1
	fi

	ui_progress 1 3 "Loading snapshot stream from $_perms_file..."
	_raw_stream="$WORK_DIR/raw_restore.txt"
	decompress_file "$_perms_file" >"$_raw_stream"

	if [ -f "$_acl_file" ] && [ -s "$_acl_file" ] && command -v setfacl >/dev/null 2>&1; then
		run_cmd setfacl --restore="$_acl_file" 2>/dev/null || true
	fi
	if [ -f "$_attrs_file" ] && [ -s "$_attrs_file" ] && command -v setfattr >/dev/null 2>&1; then
		run_cmd setfattr --restore="$_attrs_file" 2>/dev/null || true
	fi

	_first_line="$(head -n 1 "$_raw_stream" 2>/dev/null || true)"
	case "$_first_line" in
	*'|'*'|'*'|'*)
		cp "$_raw_stream" "$_vec_input"
		;;
	/*)
		case "$_first_line" in
		*,[0-7][0-7][0-7]*,*,*)
			awk -F',' 'NF >= 4 { printf "F|%s|%s|%s|%s\n", $2, $3, $4, $1 }' "$_raw_stream" >"$_vec_input"
			;;
		*)
			# Legacy perm_snapper format (%n %a %U %G %s %F %A): convert 3-digit mode + %A special bits into full 4-digit octal!
			awk '
			match($0, / [0-7][0-7][0-7][0-7]? [^ ]+ [^ ]+ [0-9]+ [a-zA-Z ]+ [-dlcbps?][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][.+]?$/) {
				path = substr($0, 1, RSTART - 1)
				rest = substr($0, RSTART + 1)
				n = split(rest, a, " ")
				mode = a[1]; owner = a[2]; group = a[3]; sym = a[n]
				sp = 0
				c4 = substr(sym, 4, 1); if (c4 == "s" || c4 == "S") sp += 4
				c7 = substr(sym, 7, 1); if (c7 == "s" || c7 == "S") sp += 2
				c10 = substr(sym, 10, 1); if (c10 == "t" || c10 == "T") sp += 1
				if (sp > 0 && length(mode) == 3) mode = sp mode
				printf "F|%s|%s|%s|%s\n", mode, owner, group, path
			}' "$_raw_stream" >"$_vec_input"
			;;
		esac
		;;
	*)
		# Legacy PermMaster space-delimited format (%a %U %G %n)
		awk 'NF >= 4 {
			m = $1; u = $2; g = $3
			p = substr($0, length($1)+length($2)+length($3)+4)
			printf "F|%s|%s|%s|%s\n", m, u, g, p
		}' "$_raw_stream" >"$_vec_input"
		;;
	esac

	ui_progress 2 3 "Computing delta & applying batched permission changes..."
	apply_vectorized_stream "$_vec_input" "$_dest_root" "$_old_u" "$_new_u"
	ui_progress 3 3 "Snapshot restoration finished."

	_elapsed=$(( $(date +%s) - _t0 ))
	log_msg OK "Snapshot restoration complete from $_perms_file (chmod=${LAST_VECTOR_CHMOD:-0}, chown=${LAST_VECTOR_CHOWN:-0} in ${_elapsed}s)"
	unset _src _dest_root _old_u _new_u _t0 _vec_input _perms_file _acl_file _attrs_file _raw_stream _first_line _elapsed
}

# ------------------------------------------------------------------------------
# 9. PACMAN MTREE AUDIT, REPAIR & SECURITY ANOMALY SCANNER
# ------------------------------------------------------------------------------

audit_pacman_permissions() {
	if ! command -v pacman >/dev/null 2>&1; then
		log_msg WARN "'pacman' not found on this host; skipping package database audit."
		return 0
	fi
	_audit_out="$WORK_DIR/pacman_audit.txt"
	run_with_spinner "Auditing installed packages against pacman mtree database (pacman -Qkk)" \
		sh -c 'pacman -Qkk 2>&1 | grep -E "Permissions differ|UID differs|GID differs|Ownership differs" > "'"$_audit_out"'" || true'

	if [ ! -s "$_audit_out" ]; then
		log_msg OK "All package-managed files match pacman database permissions and ownership."
		unset _audit_out
		return 0
	fi

	_mismatch_cnt="$(wc -l <"$_audit_out" | tr -d ' ')"
	log_msg WARN "Found $_mismatch_cnt package permission/ownership discrepancies:"
	cat "$_audit_out"
	unset _audit_out _mismatch_cnt
	return 1
}

audit_security_anomalies() {
	_scan_root="${1:-$TARGET_PATH}"
	[ ! -e "$_scan_root" ] && die "Audit path does not exist: $_scan_root" 1
	log_msg ACTION "Scanning '$_scan_root' for permission anomalies (single-pass vectorized find)..."

	_anom_file="$WORK_DIR/anomalies.txt"
	# Single-pass find across the tree classifying anomalies by tag instead of 4 separate tree walks!
	find "$_scan_root" -xdev \
		\( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path /tmp \) -prune -o \
		\( \
			\( -type f -perm -0002 -exec stat -c 'WW_FILE|%a|%U:%G|%n' {} + \) -o \
			\( -type d -perm -0002 ! -perm -1000 -exec stat -c 'WW_DIR|%a|%U:%G|%n' {} + \) -o \
			\( \( -nouser -o -nogroup \) -exec stat -c 'UNOWNED|%a|%u:%g|%n' {} + \) -o \
			\( -type f \( -perm -4000 -o -perm -2000 \) -exec stat -c 'SUID_SGID|%a|%U:%G|%n' {} + \) \
		\) >"$_anom_file" 2>/dev/null || true

	_ww_f="$(grep -c '^WW_FILE|' "$_anom_file" 2>/dev/null || true)"
	_ww_d="$(grep -c '^WW_DIR|' "$_anom_file" 2>/dev/null || true)"
	_uno="$(grep -c '^UNOWNED|' "$_anom_file" 2>/dev/null || true)"
	_suid="$(grep -c '^SUID_SGID|' "$_anom_file" 2>/dev/null || true)"
	: "${_ww_f:=0}" "${_ww_d:=0}" "${_uno:=0}" "${_suid:=0}"

	if [ "$_ww_f" -gt 0 ]; then
		log_msg WARN "Found $_ww_f world-writable regular file(s):"
		awk -F'|' '$1=="WW_FILE" { printf "  %s (%s) %s\n", $4, $2, $3 }' "$_anom_file"
	else
		log_msg OK "Zero world-writable regular files found."
	fi

	if [ "$_ww_d" -gt 0 ]; then
		log_msg WARN "Found $_ww_d world-writable directory/directories without sticky bit (+t):"
		awk -F'|' '$1=="WW_DIR" { printf "  %s (%s) %s\n", $4, $2, $3 }' "$_anom_file"
	else
		log_msg OK "Zero unstickied world-writable directories found."
	fi

	if [ "$_uno" -gt 0 ]; then
		log_msg WARN "Found $_uno unowned (-nouser/-nogroup) path(s):"
		awk -F'|' '$1=="UNOWNED" { printf "  %s (%s) %s\n", $4, $2, $3 }' "$_anom_file"
	else
		log_msg OK "Zero unowned (-nouser/-nogroup) paths found."
	fi

	if [ "$_suid" -gt 0 ]; then
		log_msg INFO "Enumerated $_suid SUID/SGID binary/binaries under $_scan_root:"
		awk -F'|' '$1=="SUID_SGID" { printf "  %s %s %s\n", $2, $3, $4 }' "$_anom_file"
	else
		log_msg OK "Zero SUID/SGID binaries present under $_scan_root."
	fi

	_issues=$((_ww_f + _ww_d + _uno))
	unset _scan_root _anom_file _ww_f _ww_d _uno _suid
	[ "$_issues" -eq 0 ] && return 0 || return 1
}

fix_pacman_permissions() {
	_strategy="${1:-$FIX_STRATEGY}"
	command -v pacman >/dev/null 2>&1 || die "'pacman' not found; cannot run fix-pacman." 1

	if [ "$_strategy" = "all-packages" ]; then
		log_msg ACTION "Reinstalling all native packages (pacman -Qqn)..."
		if confirm_action "Reinstall every native package on the system?"; then
			if [ "$DRY_RUN" -eq 1 ]; then
				log_msg DRY "Would run: pacman -Qqn | pacman -S --noconfirm --needed -"
			else
				pacman -Qqn | pacman -S --noconfirm --needed -
			fi
			log_msg OK "All native packages reinstalled."
		fi
		unset _strategy
		return 0
	fi

	_qkk_file="$WORK_DIR/pacman_qkk.txt"
	run_with_spinner "Scanning package database for permission drift (pacman -Qkk)" \
		sh -c 'pacman -Qkk 2>&1 | grep -E "Permissions differ|UID differs|GID differs|Ownership differs" > "'"$_qkk_file"'" || true'

	if [ ! -s "$_qkk_file" ]; then
		log_msg OK "Zero pacman permission/ownership discrepancies detected; nothing to fix."
		unset _strategy _qkk_file
		return 0
	fi

	case "$_strategy" in
	direct)
		log_msg ACTION "Repairing drifted package files directly from /var/lib/pacman/local/*/mtree..."
		_pkgs_to_reinstall="$WORK_DIR/pkgs_fallback.txt"
		: >"$_pkgs_to_reinstall"
		while IFS= read -r _line; do
			[ -z "$_line" ] && continue
			_pkg="$(printf '%s\n' "$_line" | sed -n 's/^warning: \([^:]*\): .*/\1/p')"
			_path="$(printf '%s\n' "$_line" | sed -n 's/^warning: [^:]*: \(.*\) ([^)]*)$/\1/p')"
			if [ -n "$_pkg" ] && [ -n "$_path" ] && [ -e "$_path" ]; then
				_mtree="$(ls -1 /var/lib/pacman/local/"${_pkg}"-[0-9]*/mtree 2>/dev/null | head -n 1 || true)"
				_fixed=0
				if [ -n "$_mtree" ] && [ -f "$_mtree" ]; then
					_rel_path=".${_path%/}"
					_mt_parsed="$(gzip -dc "$_mtree" 2>/dev/null | awk -v target="$_rel_path" '
					BEGIN { u="0"; g="0"; m="644" }
					/^\/set / {
						for (i=2; i<=NF; i++) {
							if ($i ~ /^uid=/) { s=$i; sub(/^uid=/, "", s); u=s }
							else if ($i ~ /^gid=/) { s=$i; sub(/^gid=/, "", s); g=s }
							else if ($i ~ /^mode=/) { s=$i; sub(/^mode=/, "", s); m=s }
						}
						next
					}
					$1 == target {
						cu=u; cg=g; cm=m
						for (i=2; i<=NF; i++) {
							if ($i ~ /^uid=/) { s=$i; sub(/^uid=/, "", s); cu=s }
							else if ($i ~ /^gid=/) { s=$i; sub(/^gid=/, "", s); cg=s }
							else if ($i ~ /^mode=/) { s=$i; sub(/^mode=/, "", s); cm=s }
						}
						printf "%s|%s|%s\n", cm, cu, cg
						exit
					}' || true)"
					if [ -n "$_mt_parsed" ]; then
						_exp_mode="${_mt_parsed%%|*}"
						_rest="${_mt_parsed#*|}"
						_exp_uid="${_rest%%|*}"
						_exp_gid="${_rest#*|}"
						[ -n "$_exp_uid" ] && [ -n "$_exp_gid" ] && run_cmd chown "$_exp_uid:$_exp_gid" "$_path"
						[ -n "$_exp_mode" ] && run_cmd chmod "$_exp_mode" "$_path"
						log_msg OK "Restored $_path from $_pkg mtree (uid=$_exp_uid, gid=$_exp_gid, mode=$_exp_mode)"
						_fixed=1
						unset _exp_mode _rest _exp_uid _exp_gid
					fi
					unset _rel_path _mt_parsed
				fi
				[ "$_fixed" -eq 0 ] && printf '%s\n' "$_pkg" >>"$_pkgs_to_reinstall"
				unset _mtree _fixed
			fi
			unset _pkg _path
		done <"$_qkk_file"

		if [ -s "$_pkgs_to_reinstall" ]; then
			sort -u "$_pkgs_to_reinstall" | while IFS= read -r _p; do
				[ -z "$_p" ] && continue
				log_msg INFO "Reinstalling package '$_p' to restore mtree metadata..."
				run_cmd pacman -S --noconfirm --needed "$_p" || log_msg WARN "Failed to reinstall $_p"
			done
		fi
		unset _pkgs_to_reinstall _line
		;;

	cache)
		log_msg ACTION "Restoring mismatched files from cached packages in $PACMAN_CACHE_DIR..."
		sed -n 's/^warning: \([^:]*\): \(.*\) ([^)]*)$/\1|\2/p' "$_qkk_file" | sort -u |
			while IFS='|' read -r _pkg _path; do
				[ -z "$_pkg" ] || [ -z "$_path" ] && continue
				_ver="$(pacman -Qi "$_pkg" 2>/dev/null | awk '/^Version/{print $3; exit}' || true)"
				_archive="$(find "$PACMAN_CACHE_DIR" -maxdepth 1 -type f -name "${_pkg}-${_ver}-*.pkg.tar.*" 2>/dev/null | head -n 1 || true)"
				if [ -z "$_archive" ]; then
					run_cmd pacman -Sw --noconfirm "$_pkg" || true
					_archive="$(find "$PACMAN_CACHE_DIR" -maxdepth 1 -type f -name "${_pkg}-${_ver}-*.pkg.tar.*" 2>/dev/null | head -n 1 || true)"
				fi
				if [ -n "$_archive" ] && command -v bsdtar >/dev/null 2>&1; then
					run_cmd bsdtar -xpf "$_archive" -C / "${_path#/}" --numeric-owner || log_msg WARN "bsdtar restore failed for $_path"
					log_msg OK "Restored $_path from $_archive"
				else
					run_cmd pacman -S --noconfirm --needed "$_pkg" || true
				fi
			done
		;;

	reinstall)
		log_msg ACTION "Reinstalling packages with permission discrepancies..."
		sed -n 's/^warning: \([^:]*\): .*/\1/p' "$_qkk_file" | sort -u |
			while IFS= read -r _pkg; do
				[ -z "$_pkg" ] && continue
				run_cmd pacman -S --noconfirm --needed "$_pkg" || log_msg WARN "Failed to reinstall $_pkg"
			done
		;;

	*)
		die "Unknown fix-pacman strategy '$_strategy' (expected: direct, cache, reinstall, all-packages)." 1
		;;
	esac

	log_msg OK "Package permission repair complete."
	unset _strategy _qkk_file
}

# ------------------------------------------------------------------------------
# 10. VECTORIZED AUTHORITATIVE POLICY ENGINE
#     Zero per-file shell loops! Uses:
#       - Single-pass streaming awk over `/var/lib/pacman/local/*/mtree`
#       - Canonical Arch security overrides
#       - Vectorized home directory discovery (pruning massive media/build/cache
#         trees and using single-process `awk FNR==1 ... nextfile` for magic-byte
#         detection!)
#       - Zstandard-compressed binary-speed index (`permctl.idx.zst`)
# ------------------------------------------------------------------------------

generate_policy() {
	_user="${1:-$TARGET_USER}"
	_src_mode="${2:-$POLICY_SOURCE}"
	_user_home="$(resolve_root_path "/home/$_user")"
	[ "$_user" = "root" ] && _user_home="$(resolve_root_path "/root")"
	if id -u "$_user" >/dev/null 2>&1; then
		_user_grp="$(id -gn "$_user" 2>/dev/null || echo "$_user")"
	else
		_user_grp="$_user"
	fi

	run_cmd mkdir -p "$(dirname "$POLICY_FILE")"
	_t0="$(date +%s)"

	if [ "$DRY_RUN" -eq 1 ]; then
		log_msg DRY "Would generate authoritative policy at $POLICY_FILE (and $INDEX_ZST_FILE)"
		unset _user _src_mode _user_home _user_grp _t0
		return 0
	fi

	_raw_pol="$WORK_DIR/policy_raw.tsv"
	_tmp_pol="$WORK_DIR/policy.tsv"
	: >"$_raw_pol"

	case "$_src_mode" in
	authoritative)
		# STEP 1/5: Authoritative Pacman Mtree Stream (1 awk process, 0 per-file forks)
		ui_progress 1 5 "Tier 1: Streaming /var/lib/pacman/local/*/mtree manifests..."
		_mtree_dir="$(resolve_root_path "/var/lib/pacman/local")"
		_passwd_f="$(resolve_root_path "/etc/passwd")"
		_group_f="$(resolve_root_path "/etc/group")"
		[ ! -f "$_passwd_f" ] && _passwd_f="/etc/passwd"
		[ ! -f "$_group_f" ] && _group_f="/etc/group"

		if [ -d "$_mtree_dir" ] && [ -n "$(ls -1 "$_mtree_dir"/*/mtree 2>/dev/null | head -n 1 || true)" ]; then
			gzip -dc "$_mtree_dir"/*/mtree 2>/dev/null | awk -v pw="$_passwd_f" -v gr="$_group_f" -v rprefix="$ROOT_PREFIX" '
			BEGIN {
				while ((getline line < pw) > 0) {
					split(line, f, ":")
					if (f[1] != "" && f[3] != "") uid_map[f[3]] = f[1]
				}
				close(pw)
				while ((getline line < gr) > 0) {
					split(line, f, ":")
					if (f[1] != "" && f[3] != "") gid_map[f[3]] = f[1]
				}
				close(gr)
				def_type = "file"; def_uid = "0"; def_gid = "0"; def_mode = "644"
				prefix = (rprefix == "/" ? "" : rprefix)
				sub(/\/$/, "", prefix)
			}
			/^#mtree/ {
				def_type = "file"; def_uid = "0"; def_gid = "0"; def_mode = "644"
				next
			}
			/^\/set / {
				for (i = 2; i <= NF; i++) {
					if ($i ~ /^type=/) { s = $i; sub(/^type=/, "", s); def_type = s }
					else if ($i ~ /^uid=/) { s = $i; sub(/^uid=/, "", s); def_uid = s }
					else if ($i ~ /^gid=/) { s = $i; sub(/^gid=/, "", s); def_gid = s }
					else if ($i ~ /^mode=/) { s = $i; sub(/^mode=/, "", s); def_mode = s }
				}
				next
			}
			/^\.\// {
				path = $1
				sub(/^\./, "", path)
				if (path ~ /^\/(\.BUILDINFO|\.MTREE|\.PKGINFO|\.INSTALL|\.CHANGELOG)/) next
				if (path !~ /^\/(bin|sbin|usr|lib|lib64|etc|var|opt|boot)(\/|$)/) next
				gsub(/\\040/, " ", path)
				gsub(/\\011/, "\t", path)
				t = def_type; u = def_uid; g = def_gid; m = def_mode
				for (i = 2; i <= NF; i++) {
					if ($i ~ /^type=/) { s = $i; sub(/^type=/, "", s); t = s }
					else if ($i ~ /^uid=/) { s = $i; sub(/^uid=/, "", s); u = s }
					else if ($i ~ /^gid=/) { s = $i; sub(/^gid=/, "", s); g = s }
					else if ($i ~ /^mode=/) { s = $i; sub(/^mode=/, "", s); m = s }
				}
				if (t != "dir" && t != "file") next
				rec_type = (t == "dir" ? "D" : "F")
				sub(/^0+/, "", m)
				if (m == "") m = "0"
				uname = (u in uid_map) ? uid_map[u] : u
				gname = (g in gid_map) ? gid_map[g] : g
				printf "%s|%s|%s|%s|%s%s\n", rec_type, m, uname, gname, prefix, path
			}' >>"$_raw_pol" || true
		fi
		unset _mtree_dir _passwd_f _group_f

		# STEP 2/5: Canonical Arch Linux System & Authentication Overrides
		ui_progress 2 5 "Tier 2: Overlaying canonical Arch security & /etc rules..."
		while IFS='|' read -r _ctype _cp _cm _cu _cg; do
			[ -z "$_cp" ] && continue
			_full_cp="$(resolve_root_path "$_cp")"
			if [ -e "$_full_cp" ] && [ ! -L "$_full_cp" ]; then
				if [ "$ROOT_PREFIX" = "/" ]; then
					getent group "$_cg" >/dev/null 2>&1 || _cg="root"
				else
					_cu="$(stat -c '%U' "$_full_cp" 2>/dev/null || echo "$_cu")"
					_cg="$(stat -c '%G' "$_full_cp" 2>/dev/null || echo "$_cg")"
				fi
				printf '%s|%s|%s|%s|%s\n' "$_ctype" "$_cm" "$_cu" "$_cg" "$_full_cp" >>"$_raw_pol"
			fi
			unset _full_cp
		done <<'EOF'
D|/bin|755|root|root
D|/boot|755|root|root
D|/boot/efi|755|root|root
D|/dev/shm|1777|root|root
D|/etc|755|root|root
D|/home|755|root|root
D|/lib|755|root|root
D|/lib64|755|root|root
D|/media|755|root|root
D|/mnt|755|root|root
D|/opt|755|root|root
D|/root|700|root|root
D|/run|755|root|root
D|/sbin|755|root|root
D|/srv|755|root|root
D|/tmp|1777|root|root
D|/usr|755|root|root
D|/usr/local|755|root|root
D|/usr/local/bin|755|root|root
D|/var|755|root|root
D|/var/log|755|root|root
D|/var/cache|755|root|root
F|/etc/shadow|600|root|root
F|/etc/shadow-|600|root|root
F|/etc/gshadow|600|root|root
F|/etc/gshadow-|600|root|root
F|/etc/passwd|644|root|root
F|/etc/passwd-|644|root|root
F|/etc/group|644|root|root
F|/etc/group-|644|root|root
F|/etc/fstab|644|root|root
F|/etc/hosts|644|root|root
F|/etc/hostname|644|root|root
F|/etc/sudoers|440|root|root
D|/etc/sudoers.d|750|root|root
F|/etc/default/useradd|644|root|root
F|/etc/ssh/sshd_config|600|root|root
F|/etc/ssh/ssh_config|644|root|root
D|/etc/cryptsetup-keys.d|700|root|root
D|/etc/refind.d/keys|700|root|root
D|/etc/polkit-1/rules.d|750|root|polkitd
D|/etc/pam.d|755|root|root
D|/etc/security|755|root|root
F|/usr/lib/utempter/utempter|2711|root|utmp
F|/usr/bin/sudo|4755|root|root
F|/usr/bin/su|4755|root|root
EOF
		unset _ctype _cp _cm _cu _cg

		_etc_r="$(resolve_root_path "/etc")"
		if [ -d "$_etc_r" ]; then
			_etc_o="root"
			_etc_g="root"
			if [ "$ROOT_PREFIX" != "/" ]; then
				_etc_o="$(stat -c '%U' "$_etc_r" 2>/dev/null || echo root)"
				_etc_g="$(stat -c '%G' "$_etc_r" 2>/dev/null || echo root)"
			fi
			find "$_etc_r" -type d 2>/dev/null | awk -v o="$_etc_o" -v g="$_etc_g" '
			$0 ~ /\/(sudoers\.d|polkit-1\/rules\.d|cryptsetup-keys\.d|refind\.d\/keys)$/ { next }
			{ printf "D|755|%s|%s|%s\n", o, g, $0 }' >>"$_raw_pol"
			if [ -d "$_etc_r/sudoers.d" ]; then
				find "$_etc_r/sudoers.d" -type f 2>/dev/null | awk -v o="$_etc_o" -v g="$_etc_g" '
				{ printf "F|440|%s|%s|%s\n", o, g, $0 }' >>"$_raw_pol"
			fi
			unset _etc_o _etc_g
		fi
		unset _etc_r

		# STEP 3/5: Vectorized Home Directory Policy Synthesis (ZERO per-file forks!)
		# Focuses strictly on security-sensitive dot-directories/configs/bins (~/.ssh,
		# ~/.gnupg, ~/.config, ~/.local/bin, ~/bin, shell rc files) and top-level
		# home directories, pruning massive bulk media/cache/build trees (node_modules,
		# .rustup, .cache, .local/share, gallery-dl, Videos, Pictures, ffmpeg_build).
		ui_progress 3 5 "Tier 3: Synthesizing vectorized home rules ($_user_home)..."
		if [ -d "$_user_home" ]; then
			printf 'D|700|%s|%s|%s\n' "$_user" "$_user_grp" "$_user_home" >>"$_raw_pol"
			for _priv_sub in ".ssh" ".gnupg" ".config" ".local" ".cache"; do
				[ -d "$_user_home/$_priv_sub" ] && printf 'D|700|%s|%s|%s\n' "$_user" "$_user_grp" "$_user_home/$_priv_sub" >>"$_raw_pol"
			done
			unset _priv_sub

			# Top-level user directories (depth 1 only for bulk media/work folders)
			for _top_d in "Downloads" "Documents" "Pictures" "Wallpapers" "Videos" "gallery-dl" "Avatars" ".jd" ".icons" ".themes" ".rustup"; do
				[ -d "$_user_home/$_top_d" ] && printf 'D|755|%s|%s|%s\n' "$_user" "$_user_grp" "$_user_home/$_top_d" >>"$_raw_pol"
			done
			unset _top_d

			# Top-level user dotfiles
			for _dot_f in ".chatgpt.conf" ".Xauthority" ".netrc"; do
				[ -f "$_user_home/$_dot_f" ] && printf 'F|600|%s|%s|%s\n' "$_user" "$_user_grp" "$_user_home/$_dot_f" >>"$_raw_pol"
			done
			for _dot_f in ".fzf.zsh" ".gitconfig" ".gitignore_global" ".gitmodules" ".gtkrc-2.0" ".profile" ".Xresources" ".yarnrc" ".zshrc" ".bashrc"; do
				[ -f "$_user_home/$_dot_f" ] && printf 'F|644|%s|%s|%s\n' "$_user" "$_user_grp" "$_user_home/$_dot_f" >>"$_raw_pol"
			done
			unset _dot_f

			# Vectorized scan of security-critical trees (~/.ssh, ~/.gnupg, ~/bin, ~/.local/bin, ~/.screenlayout, ~/.zsh, ~/.config)
			for _sec_tree in ".ssh" ".gnupg" "bin" ".local/bin" ".screenlayout" ".zsh" ".cheater" ".config"; do
				_st_path="$_user_home/$_sec_tree"
				[ ! -e "$_st_path" ] && continue
				# Prune heavy browser/electron caches inside ~/.config (Thorium, Chromium, Code, Discord, etc.)
				find -P "$_st_path" -maxdepth 4 \
					\( -name "Cache" -o -name "Code Cache" -o -name "GPUCache" -o -name "Service Worker" -o -name "node_modules" -o -name ".git" \) -prune -o \
					-type d -print 2>/dev/null | awk -v u="$_user" -v g="$_user_grp" -v uh="$_user_home" '
					$0 ~ uh "/\\.(ssh|gnupg)" || $0 == uh "/.config" { printf "D|700|%s|%s|%s\n", u, g, $0; next }
					{ printf "D|755|%s|%s|%s\n", u, g, $0 }' >>"$_raw_pol"

				_st_execs="$WORK_DIR/st_execs.txt"
				: >"$_st_execs"
				find -P "$_st_path" -maxdepth 4 \
					\( -name "Cache" -o -name "Code Cache" -o -name "GPUCache" -o -name "Service Worker" -o -name "node_modules" -o -name ".git" \) -prune -o \
					-type f \( -perm /111 -print -o -exec awk 'FNR==1 { if ($0 ~ /^#!/ || substr($0,1,4) == "\177ELF") print FILENAME; nextfile }' {} + \) >"$_st_execs" 2>/dev/null || true

				find -P "$_st_path" -maxdepth 4 \
					\( -name "Cache" -o -name "Code Cache" -o -name "GPUCache" -o -name "Service Worker" -o -name "node_modules" -o -name ".git" \) -prune -o \
					-type f -print 2>/dev/null | awk -v u="$_user" -v g="$_user_grp" -v uh="$_user_home" -v exfile="$_st_execs" '
					BEGIN {
						while ((getline line < exfile) > 0) is_ex[line] = 1
						close(exfile)
					}
					$0 ~ uh "/\\.ssh/.*\\.pub$" { printf "F|644|%s|%s|%s\n", u, g, $0; next }
					$0 ~ uh "/\\.(ssh|gnupg)/" { printf "F|600|%s|%s|%s\n", u, g, $0; next }
					($0 in is_ex) || $0 ~ uh "/(\\.local/bin|bin|\\.screenlayout)/" || $0 ~ /\\.(sh|bash|zsh|py|pl|rb|lua|AppImage|run|bin)$/ {
						printf "F|755|%s|%s|%s\n", u, g, $0; next
					}
					{ printf "F|644|%s|%s|%s\n", u, g, $0 }' >>"$_raw_pol"
				unset _st_execs
			done
			unset _sec_tree _st_path

			# Also scan top-level files in $_user_home (maxdepth 1) using single-process awk FNR==1 magic-byte check!
			_home_execs="$WORK_DIR/home_top_execs.txt"
			: >"$_home_execs"
			find "$_user_home" -maxdepth 1 -type f ! -name ".*" \
				-exec awk 'FNR==1 { if ($0 ~ /^#!/ || substr($0,1,4) == "\177ELF") print FILENAME; nextfile }' {} + >"$_home_execs" 2>/dev/null || true

			find "$_user_home" -maxdepth 1 -type f ! -name ".*" 2>/dev/null |
				awk -v u="$_user" -v g="$_user_grp" -v exfile="$_home_execs" '
				BEGIN {
					while ((getline line < exfile) > 0) is_ex[line] = 1
					close(exfile)
				}
				{
					if (($0 in is_ex) || $0 ~ /\.(sh|bash|zsh|py|pl|rb|lua|AppImage|run|bin)$/)
						printf "F|755|%s|%s|%s\n", u, g, $0
					else
						printf "F|644|%s|%s|%s\n", u, g, $0
				}' >>"$_raw_pol"
			unset _home_execs
		fi

		# STEP 4/5: Custom paths file (/etc/custom_paths.txt) vectorized scan
		ui_progress 4 5 "Tier 4: Processing custom paths ($CUSTOM_PATHS_FILE)..."
		if [ -f "$CUSTOM_PATHS_FILE" ]; then
			while IFS= read -r _cpath || [ -n "$_cpath" ]; do
				_cpath="$(printf '%s' "$_cpath" | sed 's/#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
				[ -z "$_cpath" ] || [ ! -e "$_cpath" ] && continue
				_co="root"
				_cg="root"
				if [ "$ROOT_PREFIX" != "/" ]; then
					_co="$(stat -c '%U' "$_cpath" 2>/dev/null || echo root)"
					_cg="$(stat -c '%G' "$_cpath" 2>/dev/null || echo root)"
				fi
				case "$_cpath" in
				"$_user_home"* | "/home/$_user"*)
					_co="$_user"
					_cg="$_user_grp"
					;;
				esac
				_cp_execs="$WORK_DIR/cp_execs.txt"
				: >"$_cp_execs"
				find -P "$_cpath" -maxdepth 4 \( -name "node_modules" -o -name ".git" -o -name ".cache" \) -prune -o \
					-type f \( -perm /111 -print -o -exec awk 'FNR==1 { if ($0 ~ /^#!/ || substr($0,1,4) == "\177ELF") print FILENAME; nextfile }' {} + \) >"$_cp_execs" 2>/dev/null || true

				find -P "$_cpath" -maxdepth 4 \( -name "node_modules" -o -name ".git" -o -name ".cache" \) -prune -o \
					-type d -print 2>/dev/null | awk -v co="$_co" -v cg="$_cg" '
					$0 ~ /^\/(proc|sys|run|dev)(\/|$)/ && $0 != "/dev/shm" { next }
					$0 ~ /\/(sudoers\.d|polkit-1\/rules\.d)$/ { printf "D|750|%s|%s|%s\n", co, cg, $0; next }
					$0 ~ /\/(cryptsetup-keys\.d|refind\.d\/keys)$/ { printf "D|700|%s|%s|%s\n", co, cg, $0; next }
					{ printf "D|755|%s|%s|%s\n", co, cg, $0 }' >>"$_raw_pol"
				find -P "$_cpath" -maxdepth 4 \( -name "node_modules" -o -name ".git" -o -name ".cache" \) -prune -o \
					-type f -print 2>/dev/null | awk -v co="$_co" -v cg="$_cg" -v exfile="$_cp_execs" '
					BEGIN {
						while ((getline line < exfile) > 0) is_ex[line] = 1
						close(exfile)
					}
					$0 ~ /^\/(proc|sys|run|dev)(\/|$)/ { next }
					$0 ~ /\/(shadow|shadow-|gshadow|gshadow-|sshd_config)$/ { printf "F|600|%s|%s|%s\n", co, cg, $0; next }
					$0 ~ /\/sudoers$/ || $0 ~ /\/sudoers\.d\// { printf "F|440|%s|%s|%s\n", co, cg, $0; next }
					($0 in is_ex) || $0 ~ /\.(sh|bash|zsh|py|pl|rb|lua|AppImage|run|bin)$/ || $0 ~ /\/bin\// { printf "F|755|%s|%s|%s\n", co, cg, $0; next }
					{ printf "F|644|%s|%s|%s\n", co, cg, $0 }' >>"$_raw_pol"
				unset _cp_execs
				unset _co _cg
			done <"$CUSTOM_PATHS_FILE"
			unset _cpath
		fi
		;;

	snapshot)
		[ -z "$RESTORE_SOURCE" ] && die "--from=SNAPSHOT_FILE is required when --policy-source=snapshot." 1
		[ ! -f "$RESTORE_SOURCE" ] && die "Snapshot file not found: $RESTORE_SOURCE" 1
		ui_progress 2 5 "Seeding policy from snapshot ($RESTORE_SOURCE)..."
		awk '
		match($0, / [0-7][0-7][0-7][0-7]? [^ ]+ [^ ]+ [0-9]+ [a-zA-Z ]+ [-dlcbps?][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][.+]?$/) {
			path = substr($0, 1, RSTART - 1)
			rest = substr($0, RSTART + 1)
			n = split(rest, a, " ")
			sym = a[n]
			rtype = (substr(sym, 1, 1) == "d" ? "D" : "F")
			printf "%s|%s|%s|%s|%s\n", rtype, a[1], a[2], a[3], path
		}' "$RESTORE_SOURCE" >>"$_raw_pol"
		;;

	live)
		ui_progress 2 5 "Capturing vectorized live filesystem permissions (--policy-source=live)..."
		for _sdir in /bin /sbin /usr/bin /usr/sbin /lib /lib64 /etc /var /opt /boot; do
			_full_sdir="$(resolve_root_path "$_sdir")"
			if [ -d "$_full_sdir" ]; then
				find "$_full_sdir" -maxdepth 3 ! -type l \( -type d -exec stat -c 'D|%a|%U|%G|%n' {} + -o -type f -exec stat -c 'F|%a|%U|%G|%n' {} + \) >>"$_raw_pol" 2>/dev/null || true
			fi
		done
		unset _sdir _full_sdir
		;;

	*)
		die "Invalid --policy-source='$_src_mode' (expected: authoritative, snapshot, or live)." 1
		;;
	esac

	# STEP 5/5: Deduplicate & Compress Init Index (`permctl.idx.zst` + `permissions_policy.tsv`)
	ui_progress 5 5 "Deduplicating & compressing Init Index ($INDEX_ZST_FILE)..."
	printf '# permctl policy v2 (TYPE|MODE|OWNER|GROUP|PATH) — source: %s\n' "$_src_mode" >"$_tmp_pol"
	awk -F'|' '
	NF >= 5 {
		p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
		if (p ~ /^\/(proc|sys|run|dev)(\/|$)/ && p != "/dev/shm") next
		if (p in seen) {
			if ($2 == "755" && $3 == "root" && $4 == "root" && prev_mode[p] != "755") next
			if ($2 == "644" && $3 == "root" && $4 == "root" && prev_mode[p] != "644") next
		}
		seen[p] = $1 "|" $2 "|" $3 "|" $4 "|" p
		prev_mode[p] = $2
		order[++cnt] = p
	}
	END {
		for (i = 1; i <= cnt; i++) {
			p = order[i]
			if (p in emitted) continue
			emitted[p] = 1
			print seen[p]
		}
	}' "$_raw_pol" >>"$_tmp_pol"

	mv "$_tmp_pol" "$POLICY_FILE"
	chmod 0600 "$POLICY_FILE" 2>/dev/null || true

	# Create compressed Zstandard index for fast streaming operations
	if command -v zstd >/dev/null 2>&1; then
		zstd -q -T0 -3 -f -k "$POLICY_FILE" -o "$INDEX_ZST_FILE" 2>/dev/null || true
		chmod 0600 "$INDEX_ZST_FILE" 2>/dev/null || true
	fi

	# Emit YAML companion policy if --export-yaml is requested or if policy is compact (< 25,000 entries)
	_pol_cnt="$(grep -cE '^[DF]\|' "$POLICY_FILE" 2>/dev/null || echo 0)"
	if [ "$EXPORT_YAML" -eq 1 ] || [ "$_pol_cnt" -le 25000 ]; then
		mkdir -p "$(dirname "$YAML_POLICY_FILE")" 2>/dev/null || true
		{
			printf 'directories:\n'
			awk -F'|' '$1=="D" {
				p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
				gsub(/\x27/, "\x27\x27", p)
				printf "  - path: \x27%s\x27\n    owner: \x27%s\x27\n    group: \x27%s\x27\n    permissions: \x27%s\x27\n", p, $3, $4, $2
			}' "$POLICY_FILE"
			printf 'files:\n'
			awk -F'|' '$1=="F" {
				p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
				gsub(/\x27/, "\x27\x27", p)
				printf "  - path: \x27%s\x27\n    owner: \x27%s\x27\n    group: \x27%s\x27\n    permissions: \x27%s\x27\n", p, $3, $4, $2
			}' "$POLICY_FILE"
		} >"$YAML_POLICY_FILE" 2>/dev/null || true
		chmod 0600 "$YAML_POLICY_FILE" 2>/dev/null || true
	fi

	_elapsed=$(( $(date +%s) - _t0 ))
	log_msg OK "Policy generated with $_pol_cnt authoritative entries in ${_elapsed}s -> $POLICY_FILE"
	ui_scorecard "AUTHORITATIVE INIT RECORD GENERATED" \
		"Policy Source: $_src_mode (mtree + canonical)" \
		"Total Records: $_pol_cnt" \
		"Primary Policy: $POLICY_FILE" \
		"Compressed Index: $INDEX_ZST_FILE" \
		"Elapsed Time: ${_elapsed}s"
	unset _user _src_mode _user_home _user_grp _t0 _raw_pol _tmp_pol _pol_cnt _elapsed
}

# Vectorized Policy Audit: compares live filesystem against $POLICY_FILE in ONE
# batched `xargs stat` + `awk` hash-join pass (0 per-file shell loops!).
audit_policy() {
	[ ! -f "$POLICY_FILE" ] && die "Policy file not found at $POLICY_FILE. Run '$SCRIPT_NAME policy-gen' first." 1
	_t0="$(date +%s)"
	ui_progress 1 3 "Loading policy index ($POLICY_FILE)..."

	_pol_paths="$WORK_DIR/pol_paths.txt"
	_live_stat="$WORK_DIR/pol_live_stat.tsv"
	_disc_file="$WORK_DIR/policy_discrepancies.txt"
	: >"$_live_stat"
	: >"$_disc_file"

	awk -F'|' '/^[DF]\|/ {
		p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
		if (p ~ /^\/(proc|sys|run|dev)(\/|$)/ && p != "/dev/shm") next
		print p
	}' "$POLICY_FILE" >"$_pol_paths"

	ui_progress 2 3 "Running vectorized stat pass across policy paths..."
	if [ -s "$_pol_paths" ]; then
		tr '\n' '\0' <"$_pol_paths" | xargs -0 -r stat -c '%a|%U|%G|%n' >>"$_live_stat" 2>/dev/null || true
	fi

	ui_progress 3 3 "Performing in-memory hash-join comparison..."
	awk -F'|' '
	FILENAME == ARGV[1] {
		p = substr($0, length($1)+length($2)+length($3)+4)
		m = $1; sub(/^0+/, "", m); if (m == "") m = "0"
		live_m[p] = m
		live_u[p] = $2
		live_g[p] = $3
		next
	}
	/^[DF]\|/ {
		p = substr($0, length($1)+length($2)+length($3)+length($4)+5)
		if (!(p in live_m)) next
		exp_m = $2; sub(/^0+/, "", exp_m); if (exp_m == "") exp_m = "0"
		exp_u = $3; exp_g = $4
		if (live_m[p] != exp_m || live_u[p] != exp_u || live_g[p] != exp_g) {
			printf "MISMATCH|%s|expected=%s:%s (0%s)|found=%s:%s (0%s)\n", \
				p, exp_u, exp_g, exp_m, live_u[p], live_g[p], live_m[p]
		}
	}' "$_live_stat" "$POLICY_FILE" >"$_disc_file"

	_disc_cnt="$(wc -l <"$_disc_file" | tr -d ' ')"
	_elapsed=$(( $(date +%s) - _t0 ))
	if [ "$_disc_cnt" -eq 0 ]; then
		log_msg OK "Audit passed: 0 discrepancies against $POLICY_FILE (${_elapsed}s)."
		unset _t0 _pol_paths _live_stat _disc_file _disc_cnt _elapsed
		return 0
	else
		log_msg WARN "Total policy discrepancies found: $_disc_cnt (${_elapsed}s)"
		head -n 25 "$_disc_file" | while IFS='|' read -r _ _p _exp _fnd; do
			log_msg WARN "Discrepancy in $_p: $_exp | $_fnd"
		done
		[ "$_disc_cnt" -gt 25 ] && log_msg INFO "(Showing first 25 of $_disc_cnt discrepancies)"
		unset _t0 _pol_paths _live_stat _disc_file _disc_cnt _elapsed
		return 1
	fi
}

# Vectorized Policy Fix: repairs all policy discrepancies using batched xargs chmod/chown!
fix_policy() {
	[ ! -f "$POLICY_FILE" ] && die "Policy file not found at $POLICY_FILE. Run '$SCRIPT_NAME policy-gen' first." 1
	_t0="$(date +%s)"
	ui_progress 1 2 "Computing vectorized delta against $POLICY_FILE..."
	apply_vectorized_stream "$POLICY_FILE" "/" "" ""
	# Self-healing post-flight verification for /dev/null
	if [ "$ROOT_PREFIX" = "/" ] && [ "$DRY_RUN" -eq 0 ]; then
		if [ ! -c /dev/null ] || [ "$(stat -c '%a' /dev/null 2>/dev/null || echo 0)" != "666" ]; then
			rm -f /dev/null 2>/dev/null || true
			mknod -m 0666 /dev/null c 1 3 2>/dev/null || true
			chmod 0666 /dev/null 2>/dev/null || true
			chown root:root /dev/null 2>/dev/null || true
		fi
	fi
	ui_progress 2 2 "Vectorized policy enforcement complete."
	_elapsed=$(( $(date +%s) - _t0 ))
	_tot_chg=$(( ${LAST_VECTOR_CHMOD:-0} + ${LAST_VECTOR_CHOWN:-0} ))
	log_msg OK "Policy enforcement completed ($_tot_chg changes: chmod=${LAST_VECTOR_CHMOD:-0}, chown=${LAST_VECTOR_CHOWN:-0} in ${_elapsed}s)."
	ui_scorecard "POLICY ENFORCEMENT COMPLETE" \
		"Policy File: $POLICY_FILE" \
		"Chmod Batches Applied: ${LAST_VECTOR_CHMOD:-0} path(s)" \
		"Chown Batches Applied: ${LAST_VECTOR_CHOWN:-0} path(s)" \
		"Elapsed Time: ${_elapsed}s"
	unset _t0 _elapsed _tot_chg
}

